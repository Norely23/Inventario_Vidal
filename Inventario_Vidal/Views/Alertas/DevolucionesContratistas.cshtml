@using Inventario_Vidal.DTOs
@model IEnumerable<ContratistaRecursoAsignadoDto>
@{
    ViewData["Title"] = "Devoluciones pendientes - Contratistas";
    ViewBag.Subtitle = "Recursos pendientes de devolución de contratistas";
    var registros = Model?.ToList() ?? new List<ContratistaRecursoAsignadoDto>();
    var hoy = DateOnly.FromDateTime(DateTime.Today);
    var total = registros.Count;
    var vencidas = registros.Count(r => r.FechaDevolucionEstimada.HasValue && r.FechaDevolucionEstimada.Value < hoy);
    var proximas = registros.Count(r => r.FechaDevolucionEstimada.HasValue && r.FechaDevolucionEstimada.Value >= hoy && r.FechaDevolucionEstimada.Value.DayNumber - hoy.DayNumber <= 3);
    var totalPendiente = registros.Sum(r => r.PendienteDevolucion);
}
<div class="users-page alertas-page devol-page">
    <!-- Encabezado oficial VIDAL -->
    <section class="users-hero">
        <div class="hero-left">
            <div class="hero-icon"><svg class="icon icon-xl"><use href="#icon-hardhat"></use></svg></div>
            <div>
                <h1>Devoluciones de contratistas</h1>
                <div class="hero-subtitle">
                    <svg class="icon icon-sm"><use href="#icon-info"></use></svg>
                    <span>Controla los recursos entregados a contratistas que aún deben devolverse.</span>
                </div>
            </div>
        </div>
        <div class="hero-actions">
            <a asp-action="Index" class="hero-secondary"><svg class="icon icon-sm"><use href="#icon-arrow-left"></use></svg>Centro de alertas</a>
            <button type="button" class="hero-secondary" id="btnActualizar"><svg class="icon icon-sm"><use href="#icon-refresh"></use></svg>Actualizar</button>
        </div>
    </section>
    @if (TempData["MensajeExito"] != null)
    {
        <div class="page-alert success" role="status">
            <svg class="icon"><use href="#icon-check-circle"></use></svg>
            <div class="page-alert-content"><strong>Operación realizada</strong><span>@TempData["MensajeExito"]</span></div>
        </div>
    }
    @if (TempData["MensajeError"] != null)
    {
        <div class="page-alert danger" role="alert">
            <svg class="icon"><use href="#icon-x-circle"></use></svg>
            <div class="page-alert-content"><strong>No se pudo completar la operación</strong><span>@TempData["MensajeError"]</span></div>
        </div>
    }
    <!-- Indicadores -->
    <section class="stats-grid" aria-label="Indicadores de devoluciones de contratistas">
        <div class="stat-card"><div class="stat-icon blue"><svg class="icon"><use href="#icon-list"></use></svg></div><div><span class="stat-label">Registros pendientes</span><strong class="stat-value">@total</strong></div></div>
        <div class="stat-card"><div class="stat-icon red"><svg class="icon"><use href="#icon-alert-triangle"></use></svg></div><div><span class="stat-label">Vencidas</span><strong class="stat-value">@vencidas</strong></div></div>
        <div class="stat-card"><div class="stat-icon gold"><svg class="icon"><use href="#icon-clock"></use></svg></div><div><span class="stat-label">Vencen en 3 días</span><strong class="stat-value">@proximas</strong></div></div>
        <div class="stat-card"><div class="stat-icon gray"><svg class="icon"><use href="#icon-box"></use></svg></div><div><span class="stat-label">Unidades pendientes</span><strong class="stat-value">@totalPendiente.ToString("N2")</strong></div></div>
    </section>
    <section class="users-card">
        <header class="users-card-header">
            <div class="card-heading">
                <div class="heading-icon"><svg class="icon"><use href="#icon-list"></use></svg></div><div>
                <span>SEGUIMIENTO LOGÍSTICO</span><h2>Devoluciones pendientes</h2>
                <p>Consulta los saldos y registra las devoluciones recibidas.</p>
            </div>
        </div>
        <span class="alert-total">@total registros</span>
    </header>
    <div class="alertas-toolbar">
        <nav class="alertas-tabs" aria-label="Categorías de alertas">
            <a asp-action="Index" class="alert-tab">Todas las alertas</a>
            <a asp-action="StockBajo" class="alert-tab">Stock bajo</a>
            <a asp-action="DevolucionesContratistas" class="alert-tab selected" aria-current="page">Contratistas <span>@total</span></a>
            <a asp-action="DevolucionesEmpleados" class="alert-tab">Empleados</a>
            <a asp-action="PrestamosVencidos" class="alert-tab">Préstamos</a>
        </nav>
        <div class="alert-filters">
            <label class="alert-search">
                <svg class="icon icon-sm"><use href="#icon-search"></use></svg>
                <input type="search" id="searchInput" placeholder="Buscar contratista, material o proyecto..." aria-label="Buscar devoluciones" autocomplete="off" />
            </label>
            <select id="estadoFiltro" aria-label="Filtrar vencimientos">
                <option value="">Todos los vencimientos</option>
                <option value="vencida">Vencidas</option>
                <option value="proxima">Vencen en 3 días</option>
                <option value="pendiente">Otras pendientes</option>
            </select>
        </div>
    </div>
    @if (registros.Any())
    {
        <div class="table-container">
            <table class="users-table alertas-table devol-table" id="devolucionesTable">
                <thead>
                    <tr>
                        <th>Contratista</th>
                        <th>Material</th>
                        <th>Entregado</th>
                        <th>Devuelto</th>
                        <th>Consumido</th>
                        <th>Dañado</th>
                        <th>Pendiente</th>
                        <th>Entrega</th>
                        <th>Dev. estimada</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in registros.OrderBy(r => r.FechaDevolucionEstimada))
                    {
                        var dias = item.FechaDevolucionEstimada.HasValue ? item.FechaDevolucionEstimada.Value.DayNumber - hoy.DayNumber : (int?)null;
                        var vencida = dias.HasValue && dias.Value < 0;
                        var proxima = dias.HasValue && dias.Value >= 0 && dias.Value <= 3;
                        var nivel = vencida ? "vencida" : proxima ? "proxima" : "pendiente";
                        var nombre = item.Contratista ?? "";
                        var partes = nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                        var iniciales = partes.Length == 0 ? "C" : partes.Length == 1 ? partes[0].Substring(0, Math.Min(2, partes[0].Length)).ToUpperInvariant() : (partes[0][0].ToString() + partes[^1][0]).ToUpperInvariant();
                        <tr class="devol-row @(vencida ? "row-critical" : proxima ? "row-warning" : "")" data-level="@nivel">
                            <td><div class="devol-person"><span class="contratista-avatar-mini">@iniciales</span><div><strong>@item.Contratista</strong><small>@item.CodigoProyecto</small></div></div></td>
                            <td><strong class="devol-material">@item.Material</strong></td>
                            <td class="devol-num">@item.Cantidad.ToString("N2")</td>
                            <td class="devol-num">@item.CantidadDevuelta.ToString("N2")</td>
                            <td class="devol-num">@item.CantidadConsumida.ToString("N2")</td>
                            <td class="devol-num">@item.CantidadDanada.ToString("N2")</td>
                            <td><strong class="devol-pending">@item.PendienteDevolucion.ToString("N2")</strong></td>
                            <td><span class="alert-muted">@item.FechaEntregaFormateada</span></td>
                            <td>
                                <div class="devol-date">
                                    <strong>@item.FechaDevolucionEstimadaFormateada</strong>
                                    @if (vencida)
                                    {
                                        <small class="devol-overdue">@Math.Abs(dias!.Value) días vencida</small>
                                    }
                                    else if (proxima)
                                    {

                                        <small class="devol-soon">@(dias == 0 ? "Vence hoy" : $"Faltan {dias} días")</small>
                                    }
                                    else if (dias.HasValue)
                                    {

                                        <small>Faltan @dias días</small>
                                    }
                                    else
                                    {

                                        <small>Sin fecha estimada</small>
                                    }
                                </div>
                            </td>
                            <td><span class="alert-chip @(vencida ? "danger" : proxima ? "warning" : "neutral")">@item.Estado</span></td>
                            <td>
                                <div class="devol-actions">
                                    <a asp-controller="Contratistas" asp-action="RegistrarDevolucion" asp-route-idAsignacion="@item.IdAsignacionRecurso" class="alert-action warning" title="Registrar devolución" aria-label="Registrar devolución de @item.Material"><svg class="icon icon-sm"><use href="#icon-arrow-left"></use></svg></a>
                                    <a asp-controller="Contratistas" asp-action="Detalles" asp-route-id="@item.IdContratista" class="alert-action" title="Ver contratista" aria-label="Ver detalles de @item.Contratista"><svg class="icon icon-sm"><use href="#icon-eye"></use></svg></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="devol-no-match" id="sinResultados" hidden><svg class="icon icon-xl"><use href="#icon-search"></use></svg><strong>No se encontraron devoluciones</strong><span>Modifica la búsqueda o el filtro de vencimiento.</span></div>
        <footer class="devol-footer"><span id="contadorVisible" aria-live="polite">Mostrando @total de @total registros</span></footer>
    }
    else
    {
        <div class="alertas-empty">
            <svg class="icon icon-xl"><use href="#icon-check-circle"></use></svg><strong>No hay devoluciones pendientes</strong><span>Los contratistas no tienen recursos pendientes de devolución.</span>
            <a asp-action="Index" class="devol-return"><svg class="icon icon-sm"><use href="#icon-arrow-left"></use></svg>Volver al centro de alertas</a>
        </div>
    }
</section>
</div>
@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const search = document.getElementById('searchInput');
            const level = document.getElementById('estadoFiltro');
            const table = document.getElementById('devolucionesTable');
            const noMatch = document.getElementById('sinResultados');
            const counter = document.getElementById('contadorVisible');
            document.getElementById('btnActualizar')?.addEventListener('click', () => window.location.reload());
            if (!table || !search || !level) return;
            const rows = Array.from(table.querySelectorAll('tbody tr.devol-row'));
            function filtrar() {
                const termino = search.value.trim().toLocaleLowerCase('es');
                const filtro = level.value;
                let visibles = 0;
                rows.forEach(row => {
                    const visible = row.textContent.toLocaleLowerCase('es').includes(termino) && (!filtro || row.dataset.level === filtro);
                    row.hidden = !visible;
                    if (visible) visibles++;
                });
                if (noMatch) noMatch.hidden = visibles !== 0;
                if (counter) counter.textContent = `Mostrando ${visibles} de ${rows.length} registros`;
            }
            search.addEventListener('input', filtrar);
            level.addEventListener('change', filtrar);
        });
    </script>
}

<style>

    /* ================================================================
               BASE
               ================================================================ */

    .users-page {
        --navy: #102947;
        --blue: #17488e;
        --blue-light: #226cc2;
        --border: #dce3eb;
        --text: #344357;
        --muted: #7d8999;
        --surface: #ffffff;
        --success: #168957;
        --danger: #d1475b;
        --warning: #d99a24;
    }

    /* ================================================================
               HERO
               ================================================================ */

    .users-hero {
        min-height: 114px;
        padding: 23px 30px;
        margin-bottom: 17px;
        border-radius: 20px;
        background: linear-gradient( 100deg, #102947 0%, #17488e 49%, #226cc2 100%);
        color: white;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        position: relative;
        overflow: hidden;
    }

        .users-hero::after {
            content: "";
            position: absolute;
            width: 280px;
            height: 280px;
            top: -130px;
            right: -80px;
            border-radius: 50%;
            background: rgba(255,255,255,.05);
        }

    .hero-left {
        display: flex;
        align-items: center;
        gap: 18px;
        position: relative;
        z-index: 1;
    }

    .hero-icon {
        width: 60px;
        height: 60px;
        border-radius: 14px;
        background: rgba(255,255,255,.11);
        border: 1px solid rgba(255,255,255,.12);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .users-hero h1 {
        margin: 0;
        font-size: 1.65rem;
        font-weight: 800;
    }

    .hero-subtitle {
        margin-top: 6px;
        display: flex;
        align-items: center;
        gap: 7px;
        color: rgba(255,255,255,.72);
        font-size: .8rem;
    }

    .hero-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        position: relative;
        z-index: 1;
    }

    .hero-primary,
    .hero-secondary {
        min-height: 41px;
        padding: 0 15px;
        border-radius: 9px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        font-size: .72rem;
        font-weight: 750;
        text-decoration: none;
        cursor: pointer;
        transition: .18s ease;
    }

    .hero-primary {
        border: 1px solid white;
        background: white;
        color: var(--navy);
    }

    .hero-secondary {
        border: 1px solid rgba(255,255,255,.3);
        background: rgba(255,255,255,.05);
        color: white;
    }

    .hero-primary:hover {
        background: #f3f7fb;
        color: var(--navy);
        transform: translateY(-1px);
    }

    .hero-secondary:hover {
        background: rgba(255,255,255,.12);
        transform: translateY(-1px);
    }

    /* ================================================================
               ALERTS
               ================================================================ */

    .page-alert {
        margin-bottom: 15px;
        padding: 12px 14px;
        border-radius: 11px;
        display: flex;
        align-items: flex-start;
        gap: 10px;
        transition: opacity .35s ease, transform .35s ease;
    }

        .page-alert.success {
            background: #edf9f3;
            color: #146f48;
            border-left: 4px solid var(--success);
        }

        .page-alert.danger {
            background: #fff1f3;
            color: #a73547;
            border-left: 4px solid var(--danger);
        }

    .page-alert-content {
        flex: 1;
    }

        .page-alert-content strong,
        .page-alert-content span {
            display: block;
        }

        .page-alert-content strong {
            font-size: .72rem;
        }

        .page-alert-content span {
            margin-top: 2px;
            font-size: .66rem;
        }

    .page-alert.closing {
        opacity: 0;
        transform: translateY(-8px);
    }

    .alert-close {
        border: none;
        padding: 2px;
        background: transparent;
        color: currentColor;
        opacity: .6;
        cursor: pointer;
    }

    /* ================================================================
               STATS
               ================================================================ */

    .stats-grid {
        margin-bottom: 17px;
        display: grid;
        grid-template-columns: repeat( 4, minmax(0,1fr));
        gap: 12px;
    }

    .stat-card {
        min-height: 84px;
        padding: 14px 16px;
        border: 1px solid var(--border);
        border-radius: 13px;
        background: white;
        display: flex;
        align-items: center;
        gap: 12px;
        box-shadow: 0 4px 15px rgba(16,41,71,.035);
    }

    .stat-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .stat-icon.blue {
            color: #306ca7;
            background: #eaf2fb;
        }

        .stat-icon.green {
            color: #168957;
            background: #e9f7f0;
        }

        .stat-icon.gray {
            color: #687587;
            background: #edf0f4;
        }

        .stat-icon.red {
            color: #c34d5f;
            background: #fff0f2;
        }

    .stat-label {
        display: block;
        color: #8995a5;
        font-size: .57rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    .stat-value {
        display: block;
        margin-top: 2px;
        color: var(--navy);
        font-size: 1.3rem;
        font-weight: 800;
        line-height: 1;
    }

    /* ================================================================
               CARD
               ================================================================ */

    .users-card {
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 16px;
        background: white;
        box-shadow: 0 4px 18px rgba(16,41,71,.045);
    }

    .users-card-header {
        padding: 16px 18px;
        border-bottom: 1px solid #edf1f5;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
    }

    .card-heading {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .heading-icon {
        width: 36px;
        height: 36px;
        border-radius: 9px;
        color: #356fa7;
        background: #eaf2fb;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .card-heading span {
        display: block;
        color: #929dab;
        font-size: .52rem;
        font-weight: 800;
        letter-spacing: .8px;
    }

    .card-heading h2 {
        margin: 1px 0 0;
        color: var(--navy);

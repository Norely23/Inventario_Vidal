        }

    .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
    }

    /* ================================================================
               LAST ACCESS
               ================================================================ */

    .last-access {
        min-width: 95px;
    }

        .last-access strong {
            display: block;
            color: #4d5c6f;
            font-size: .63rem;
        }

        .last-access span {
            display: block;
            margin-top: 1px;
            color: #939dab;
            font-size: .54rem;
        }

        .last-access .never-access {
            color: #8793a3;
        }

    /* ================================================================
               SECURITY
               ================================================================ */

    .security-state {
        min-width: 92px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-align: left;
    }

        .security-state > .icon {
            flex-shrink: 0;
        }

        .security-state strong {
            display: block;
            font-size: .57rem;
        }

        .security-state span {
            display: block;
            margin-top: 1px;
            font-size: .5rem;
        }

        .security-state.ok {
            color: #168957;
        }

        .security-state.warning {

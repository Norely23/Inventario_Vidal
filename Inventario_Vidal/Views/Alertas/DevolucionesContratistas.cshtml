            box-shadow: 0 0 0 3px rgba(34,108,194,.08);
        }

        .search-box > .icon {
            color: #8b97a7;
        }

        .search-box input {
            flex: 1;
            min-width: 0;
            border: none;
            outline: none;
            background: transparent;
            color: #445368;
            font-size: .67rem;
        }

    .search-clear {
        padding: 2px;
        border: none;
        background: transparent;
        color: #929dab;
        cursor: pointer;
    }

    .toolbar-select {
        min-height: 39px;
        padding: 0 29px 0 10px;
        border: 1px solid var(--border);
        border-radius: 9px;
        background: white;
        color: #536174;
        font-size: .66rem;
        outline: none;
    }

    /* ================================================================
               TABLE
               ================================================================ */

    .table-container {
        width: 100%;
        overflow-x: auto;
    }

    .users-table {
        width: 100%;
        border-collapse: collapse;
    }

        .users-table thead th {
            padding: 10px 12px;
            border-bottom: 1px solid #e8edf3;
            background: #f8fafc;
            color: #7d8999;
            font-size: .56rem;
            font-weight: 800;
            letter-spacing: .5px;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .users-table tbody td {
            padding: 11px 12px;
            border-bottom: 1px solid #eef2f6;
            color: #536174;
            font-size: .66rem;

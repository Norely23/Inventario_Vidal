        font-weight: 800;
    }

    .card-heading p {
        margin: 2px 0 0;
        color: #8793a3;
        font-size: .61rem;
    }

    /* ================================================================
               TOOLBAR
               ================================================================ */

    .users-toolbar {
        display: flex;
        align-items: center;
        gap: 7px;
    }

    .search-box {
        width: 245px;
        min-height: 39px;
        padding: 0 10px;
        border: 1px solid var(--border);
        border-radius: 9px;
        display: flex;
        align-items: center;
        gap: 7px;
    }

        .search-box:focus-within {

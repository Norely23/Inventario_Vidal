@using Inventario_Vidal.DTOs
@model IEnumerable<AlertasStockDto>
@{
    ViewData["Title"] = "Alertas de stock bajo";
    ViewBag.Subtitle = "Materiales con existencias por debajo del stock mínimo";
    var registros = Model?.ToList() ?? new List<AlertasStockDto>();
    var total = registros.Count;
    var criticas = registros.Count(m => m.PorcentajeAlerta > 50);
    var moderadas = registros.Count(m => m.PorcentajeAlerta <= 50);
}
<div class="users-page alertas-page stock-page">
    <!-- ENCABEZADO: MISMA ESTRUCTURA QUE USUARIOS Y CENTRO DE ALERTAS -->
    <section class="users-hero">
        <div class="hero-left">
            <div class="hero-icon"><svg class="icon icon-xl"><use href="#icon-box"></use></svg></div>
            <div>
                <h1>Alertas de stock bajo</h1>
                <div class="hero-subtitle">
                    <svg class="icon icon-sm"><use href="#icon-info"></use></svg>
                    <span>Consulta los materiales cuyas existencias requieren reposición.</span>
                </div>
            </div>
        </div>
        <div class="hero-actions">
            <a asp-action="Index" class="hero-secondary"><svg class="icon icon-sm"><use href="#icon-arrow-left"></use></svg>Centro de alertas</a>
            <button type="button" class="hero-secondary" id="btnActualizar"><svg class="icon icon-sm"><use href="#icon-refresh"></use></svg>Actualizar</button>
            <a asp-controller="Compras" asp-action="Registrar" class="hero-primary"><svg class="icon icon-sm"><use href="#icon-plus"></use></svg>Registrar compra</a>
        </div>
    </section>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="page-alert success" role="status">
            <svg class="icon"><use href="#icon-check-circle"></use></svg>
            <div class="page-alert-content"><strong>Operación realizada</strong><span>@TempData["MensajeExito"]</span></div>
        </div>
    }
    @if (TempData["MensajeError"] != null)
    {
        <div class="page-alert danger" role="alert">
            <svg class="icon"><use href="#icon-x-circle"></use></svg>
            <div class="page-alert-content"><strong>No se pudo completar la operación</strong><span>@TempData["MensajeError"]</span></div>
        </div>
    }

    <section class="stats-grid" aria-label="Indicadores de stock bajo">
        <div class="stat-card">
            <div class="stat-icon blue"><svg class="icon"><use href="#icon-box"></use></svg></div>
            <div><span class="stat-label">Materiales en alerta</span><strong class="stat-value">@total</strong></div>
        </div>
        <div class="stat-card">
            <div class="stat-icon red"><svg class="icon"><use href="#icon-alert-triangle"></use></svg></div>
            <div><span class="stat-label">Nivel crítico</span><strong class="stat-value">@criticas</strong></div>
        </div>
        <div class="stat-card">
            <div class="stat-icon gray"><svg class="icon"><use href="#icon-clock"></use></svg></div>
            <div><span class="stat-label">Nivel moderado</span><strong class="stat-value">@moderadas</strong></div>
        </div>
    </section>

    <section class="users-card">
        <header class="users-card-header">
            <div class="card-heading">
                <div class="heading-icon"><svg class="icon"><use href="#icon-list"></use></svg></div>
                <div>
                    <span>INVENTARIO</span><h2>Materiales con stock bajo</h2>
                    <p>Revisa las cantidades disponibles y consulta el detalle de cada material.</p>
                </div>
            </div>
            <span class="alert-total">@total registros</span>
        </header>
        <div class="alertas-toolbar">
            <nav class="alertas-tabs" aria-label="Categorías de alertas">
                <a asp-action="Index" class="alert-tab">Todas las alertas</a>
                <a asp-action="StockBajo" class="alert-tab selected" aria-current="page">Stock bajo <span>@total</span></a>
                <a asp-action="DevolucionesContratistas" class="alert-tab">Contratistas</a>
                <a asp-action="DevolucionesEmpleados" class="alert-tab">Empleados</a>
                <a asp-action="PrestamosVencidos" class="alert-tab">Préstamos</a>
            </nav>
            <div class="alert-filters">
                <label class="alert-search">
                    <svg class="icon icon-sm"><use href="#icon-search"></use></svg>
                    <input type="search" id="searchInput" placeholder="Buscar material..." aria-label="Buscar material" autocomplete="off" />
                </label>
                <select id="nivelFiltro" aria-label="Filtrar por nivel de alerta">
                    <option value="">Todos los niveles</option>
                    <option value="critico">Crítico</option>
                    <option value="moderado">Moderado</option>
                </select>
            </div>
        </div>
        @if (registros.Any())
        {
            <div class="table-container">
                <table class="users-table alertas-table stock-table" id="stockBajoTable">
                    <thead><tr><th>#</th><th>Material</th><th>Código</th><th>Categoría</th><th>Stock actual</th><th>Stock mínimo</th><th>Nivel</th><th>Unidad</th><th>Acciones</th></tr></thead>
                    <tbody>
                        @{
                            var numero = 1;
                        }
                        @foreach (var item in registros.OrderByDescending(m => m.PorcentajeAlerta))
                        {
                            var esCritico = item.PorcentajeAlerta > 50;
                            var nivel = esCritico ? "critico" : "moderado";
                            <tr class="stock-row" data-level="@nivel">
                                <td><span class="alert-muted">@numero</span></td>
                                <td>
                                    <div class="stock-material">
                                        @if (!string.IsNullOrWhiteSpace(item.ImagenUrl))
                                        {
                                            <img src="@item.ImagenUrl" alt="" loading="lazy" class="stock-thumb" onerror="this.style.display='none'" />
                                        }
                                        else
                                        {
                                            <span class="stock-thumb stock-placeholder"><svg class="icon"><use href="#icon-box"></use></svg></span>
                                        }
                                        <div class="stock-material-text">
                                            <strong>@item.Nombre</strong>
                                            <small>@item.Categoria</small>
                                        </div>
                                    </div>
                                </td>
                                <td><code class="stock-code">@item.CodigoBarras</code></td>
                                <td><span class="stock-muted">@item.Categoria</span></td>
                                <td><strong class="stock-current">@item.StockActual.ToString("N2")</strong></td>
                                <td><span class="stock-muted">@item.StockMinimo.ToString("N2")</span></td>
                                <td>
                                    <div class="stock-level">
                                        <span class="alert-chip @(esCritico ? "danger" : "warning")">@(esCritico ? "Crítico" : "Moderado")</span>
                                        <div class="stock-progress" role="progressbar" aria-label="Porcentaje de alerta" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@Math.Clamp(item.PorcentajeAlerta, 0, 100)">
                                            <span class="@(esCritico ? "critical" : "moderate")" style="width:@Math.Clamp(item.PorcentajeAlerta, 0, 100)%"></span>
                                        </div><small>@item.PorcentajeAlerta% de alerta</small>
                                    </div>
                                </td>
                                <td><span class="stock-unit">@item.UnidadConsumo</span></td>
                                <td>
                                    <div class="stock-actions">
                                        <a asp-controller="Materiales" asp-action="Detalles" asp-route-id="@item.IdMaterial" class="alert-action" aria-label="Ver material @item.Nombre" title="Ver material"><svg class="icon icon-sm"><use href="#icon-eye"></use></svg></a>
                                        <a asp-controller="Compras" asp-action="Registrar" class="alert-action positive" aria-label="Registrar compra" title="Registrar compra"><svg class="icon icon-sm"><use href="#icon-plus"></use></svg></a>
                                    </div>
                                </td>
                            </tr>
                            numero++;
                        }
                    </tbody>
                </table>
            </div>
            <div class="stock-no-match" id="sinResultados" hidden>
                <svg class="icon icon-xl"><use href="#icon-search"></use></svg>
                <strong>No se encontraron materiales</strong><span>Prueba otra búsqueda o cambia el nivel seleccionado.</span>
            </div>
            <footer class="stock-footer"><span id="contadorVisible" aria-live="polite">Mostrando @total de @total materiales</span></footer>
        }
        else
        {
            <div class="alertas-empty">
                <svg class="icon icon-xl"><use href="#icon-check-circle"></use></svg>
                <strong>No hay alertas de stock bajo</strong><span>Todos los materiales cumplen el nivel mínimo de existencias.</span>
                <a asp-action="Index" class="stock-return"><svg class="icon icon-sm"><use href="#icon-arrow-left"></use></svg>Volver al centro de alertas</a>
            </div>
        }
    </section>
</div>
@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const search = document.getElementById('searchInput');
            const level = document.getElementById('nivelFiltro');
            const table = document.getElementById('stockBajoTable');
            const noMatch = document.getElementById('sinResultados');
            const counter = document.getElementById('contadorVisible');
            document.getElementById('btnActualizar')?.addEventListener('click', () => window.location.reload());
            if (!table || !search || !level) return;
            const rows = Array.from(table.querySelectorAll('tbody tr.stock-row'));
            function filtrar() {
                const term = search.value.trim().toLocaleLowerCase('es');
                const selectedLevel = level.value;
                let visible = 0;
                rows.forEach(row => {
                    const matchText = row.textContent.toLocaleLowerCase('es').includes(term);
                    const matchLevel = !selectedLevel || row.dataset.level === selectedLevel;
                    const show = matchText && matchLevel;
                    row.hidden = !show;
                    if (show) visible++;
                });
                if (noMatch) noMatch.hidden = visible !== 0;
                if (counter) counter.textContent = `Mostrando ${visible} de ${rows.length} materiales`;
            }
            search.addEventListener('input', filtrar);
            level.addEventListener('change', filtrar);
        });
    </script>
}

<style>

    /* ================================================================
               BASE
               ================================================================ */

    .users-page {
        --navy: #102947;
        --blue: #17488e;
        --blue-light: #226cc2;
        --border: #dce3eb;
        --text: #344357;
        --muted: #7d8999;
        --surface: #ffffff;
        --success: #168957;
        --danger: #d1475b;
        --warning: #d99a24;
    }

    /* ================================================================
               HERO
               ================================================================ */

    .users-hero {
        min-height: 114px;
        padding: 23px 30px;
        margin-bottom: 17px;
        border-radius: 20px;
        background: linear-gradient( 100deg, #102947 0%, #17488e 49%, #226cc2 100%);
        color: white;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        position: relative;
        overflow: hidden;
    }

        .users-hero::after {
            content: "";
            position: absolute;
            width: 280px;
            height: 280px;
            top: -130px;
            right: -80px;
            border-radius: 50%;
            background: rgba(255,255,255,.05);
        }

    .hero-left {
        display: flex;
        align-items: center;
        gap: 18px;
        position: relative;
        z-index: 1;
    }

    .hero-icon {
        width: 60px;
        height: 60px;
        border-radius: 14px;
        background: rgba(255,255,255,.11);
        border: 1px solid rgba(255,255,255,.12);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .users-hero h1 {
        margin: 0;
        font-size: 1.65rem;
        font-weight: 800;
    }

    .hero-subtitle {
        margin-top: 6px;
        display: flex;
        align-items: center;
        gap: 7px;
        color: rgba(255,255,255,.72);
        font-size: .8rem;
    }

    .hero-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        position: relative;
        z-index: 1;
    }

    .hero-primary,
    .hero-secondary {
        min-height: 41px;
        padding: 0 15px;
        border-radius: 9px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        font-size: .72rem;
        font-weight: 750;
        text-decoration: none;
        cursor: pointer;
        transition: .18s ease;
    }

    .hero-primary {
        border: 1px solid white;
        background: white;
        color: var(--navy);
    }

    .hero-secondary {
        border: 1px solid rgba(255,255,255,.3);
        background: rgba(255,255,255,.05);
        color: white;
    }

    .hero-primary:hover {
        background: #f3f7fb;
        color: var(--navy);
        transform: translateY(-1px);
    }

    .hero-secondary:hover {
        background: rgba(255,255,255,.12);
        transform: translateY(-1px);
    }

    /* ================================================================
               ALERTS
               ================================================================ */

    .page-alert {
        margin-bottom: 15px;
        padding: 12px 14px;
        border-radius: 11px;
        display: flex;
        align-items: flex-start;
        gap: 10px;
        transition: opacity .35s ease, transform .35s ease;
    }

        .page-alert.success {
            background: #edf9f3;
            color: #146f48;
            border-left: 4px solid var(--success);
        }

        .page-alert.danger {
            background: #fff1f3;
            color: #a73547;
            border-left: 4px solid var(--danger);
        }

    .page-alert-content {
        flex: 1;
    }

        .page-alert-content strong,
        .page-alert-content span {
            display: block;
        }

        .page-alert-content strong {
            font-size: .72rem;
        }

        .page-alert-content span {
            margin-top: 2px;
            font-size: .66rem;
        }

    .page-alert.closing {
        opacity: 0;
        transform: translateY(-8px);
    }

    .alert-close {
        border: none;
        padding: 2px;
        background: transparent;
        color: currentColor;
        opacity: .6;
        cursor: pointer;
    }

    /* ================================================================
               STATS
               ================================================================ */

    .stats-grid {
        margin-bottom: 17px;
        display: grid;
        grid-template-columns: repeat( 4, minmax(0,1fr));
        gap: 12px;
    }

    .stat-card {
        min-height: 84px;
        padding: 14px 16px;
        border: 1px solid var(--border);
        border-radius: 13px;
        background: white;
        display: flex;
        align-items: center;
        gap: 12px;
        box-shadow: 0 4px 15px rgba(16,41,71,.035);
    }

    .stat-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .stat-icon.blue {
            color: #306ca7;
            background: #eaf2fb;
        }

        .stat-icon.green {
            color: #168957;
            background: #e9f7f0;
        }

        .stat-icon.gray {
            color: #687587;
            background: #edf0f4;
        }

        .stat-icon.red {
            color: #c34d5f;
            background: #fff0f2;
        }

    .stat-label {
        display: block;
        color: #8995a5;
        font-size: .57rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    .stat-value {
        display: block;
        margin-top: 2px;
        color: var(--navy);
        font-size: 1.3rem;
        font-weight: 800;
        line-height: 1;
    }

    /* ================================================================
               CARD
               ================================================================ */

    .users-card {
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 16px;
        background: white;
        box-shadow: 0 4px 18px rgba(16,41,71,.045);
    }

    .users-card-header {
        padding: 16px 18px;
        border-bottom: 1px solid #edf1f5;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
    }

    .card-heading {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .heading-icon {
        width: 36px;
        height: 36px;
        border-radius: 9px;
        color: #356fa7;
        background: #eaf2fb;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .card-heading span {
        display: block;
        color: #929dab;
        font-size: .52rem;
        font-weight: 800;
        letter-spacing: .8px;
    }

    .card-heading h2 {
        margin: 1px 0 0;
        color: var(--navy);
        font-size: .9rem;
        font-weight: 800;
    }

    .card-heading p {
        margin: 2px 0 0;
        color: #8793a3;
        font-size: .61rem;
    }

    /* ================================================================
               TOOLBAR
               ================================================================ */

    .users-toolbar {
        display: flex;
        align-items: center;
        gap: 7px;
    }

    .search-box {
        width: 245px;
        min-height: 39px;
        padding: 0 10px;
        border: 1px solid var(--border);
        border-radius: 9px;
        display: flex;
        align-items: center;
        gap: 7px;
    }

        .search-box:focus-within {
            border-color: #6f9ed0;
            box-shadow: 0 0 0 3px rgba(34,108,194,.08);
        }

        .search-box > .icon {
            color: #8b97a7;
        }

        .search-box input {
            flex: 1;
            min-width: 0;
            border: none;
            outline: none;
            background: transparent;
            color: #445368;
            font-size: .67rem;
        }

    .search-clear {
        padding: 2px;
        border: none;
        background: transparent;
        color: #929dab;
        cursor: pointer;
    }

    .toolbar-select {
        min-height: 39px;
        padding: 0 29px 0 10px;
        border: 1px solid var(--border);
        border-radius: 9px;
        background: white;
        color: #536174;
        font-size: .66rem;
        outline: none;
    }

    /* ================================================================
               TABLE
               ================================================================ */

    .table-container {
        width: 100%;
        overflow-x: auto;
    }

    .users-table {
        width: 100%;
        border-collapse: collapse;
    }

        .users-table thead th {
            padding: 10px 12px;
            border-bottom: 1px solid #e8edf3;
            background: #f8fafc;
            color: #7d8999;
            font-size: .56rem;
            font-weight: 800;
            letter-spacing: .5px;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .users-table tbody td {
            padding: 11px 12px;
            border-bottom: 1px solid #eef2f6;
            color: #536174;
            font-size: .66rem;
            vertical-align: middle;
        }

        .users-table tbody tr:last-child td {
            border-bottom: none;
        }

        .users-table tbody tr {
            transition: background .16s ease;
        }

            .users-table tbody tr:hover {
                background: #fafbfd;
            }

    /* ================================================================
               USER
               ================================================================ */

    .user-cell {
        min-width: 180px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .user-avatar {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        color: #346b9e;
        background: #eaf2fb;
        border: 1px solid #dce9f5;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .66rem;
        font-weight: 850;
        flex-shrink: 0;
    }

    .user-main strong {
        display: block;
        color: #344357;
        font-size: .7rem;
    }

    .user-main span {
        display: block;
        margin-top: 2px;
        color: #939dab;
        font-size: .54rem;
    }

    /* ================================================================
               ACCOUNT / MAIL
               ================================================================ */

    .account-cell,
    .mail-cell {
        min-width: 125px;
        display: flex;
        align-items: center;
        gap: 5px;
        color: #59687b;
    }

        .account-cell .icon,
        .mail-cell .icon {
            color: #8796a5;
            flex-shrink: 0;
        }

    .mail-cell {
        max-width: 220px;
    }

        .mail-cell span {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

    .empty-value {
        color: #a1aab6;
        font-style: italic;
    }

    /* ================================================================
               ROLE
               ================================================================ */

    .role-badge {
        padding: 5px 8px;
        border-radius: 999px;
        background: #edf3f8;
        color: #496783;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: .58rem;
        font-weight: 750;
        white-space: nowrap;
    }

    /* ================================================================
               STATUS
               ================================================================ */

    .status-badge {
        padding: 5px 8px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        font-size: .57rem;
        font-weight: 800;
        white-space: nowrap;
    }

        .status-badge.active {
            color: #15744b;
            background: #e9f7f0;
        }

        .status-badge.inactive {
            color: #667384;
            background: #edf0f4;
        }

        .status-badge.blocked {
            color: #b34052;
            background: #fff0f2;
        }

    .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
    }

    /* ================================================================
               LAST ACCESS
               ================================================================ */

    .last-access {
        min-width: 95px;
    }

        .last-access strong {
            display: block;
            color: #4d5c6f;
            font-size: .63rem;
        }

        .last-access span {
            display: block;
            margin-top: 1px;
            color: #939dab;
            font-size: .54rem;
        }

        .last-access .never-access {
            color: #8793a3;
        }

    /* ================================================================
               SECURITY
               ================================================================ */

    .security-state {
        min-width: 92px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-align: left;
    }

        .security-state > .icon {
            flex-shrink: 0;
        }

        .security-state strong {
            display: block;
            font-size: .57rem;
        }

        .security-state span {
            display: block;
            margin-top: 1px;
            font-size: .5rem;
        }

        .security-state.ok {
            color: #168957;
        }

        .security-state.warning {
            color: #ad7514;
        }

        .security-state.blocked {
            color: #ba4053;
        }

    /* ================================================================
               ACTIONS
               ================================================================ */

    .actions-column {
        width: 125px;
    }

    .action-group {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
    }

    .action-btn {
        width: 31px;
        height: 31px;
        padding: 0;
        border-radius: 7px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        cursor: pointer;
        transition: .16s ease;
    }

        .action-btn.view {
            border: 1px solid #cfe0f0;
            background: #f1f7fc;
            color: #3974aa;
        }

        .action-btn.edit {
            border: 1px solid #d9e3ee;
            background: #f7f9fc;
            color: #526e8b;
        }

        .action-btn.disable {
            border: 1px solid #f0ced4;
            background: #fff3f4;
            color: #c24d60;
        }

        .action-btn.enable {
            border: 1px solid #cce8da;
            background: #eefaf4;
            color: #168957;

@using Inventario_Vidal.DTOs
@{
    ViewData["Title"] = "Centro de Alertas";
    ViewBag.Subtitle = "Resumen de alertas y notificaciones del sistema";

    var resumen = ViewBag.Resumen as AlertaResumenDto ?? new AlertaResumenDto();
    var stockBajo = ViewBag.StockBajo as IEnumerable<AlertasStockDto> ?? new List<AlertasStockDto>();
    var devolucionesContratistas = ViewBag.DevolucionesContratistas as IEnumerable<ContratistaRecursoAsignadoDto> ?? new List<ContratistaRecursoAsignadoDto>();
    var devolucionesEmpleados = ViewBag.DevolucionesEmpleados as IEnumerable<EmpleadoRecursoAsignadoDto> ?? new List<EmpleadoRecursoAsignadoDto>();
    var prestamosVencidos = ViewBag.PrestamosVencidos as IEnumerable<PrestamoMaquinariaListDto> ?? new List<PrestamoMaquinariaListDto>();

    var totalAlertas = resumen.TotalAlertas;
    var tieneAlertas = totalAlertas > 0;
}

<div class="users-page alertas-page">
    <section class="users-hero">
        <div class="hero-left">
            <div class="hero-icon"><svg class="icon icon-xl"><use href="#icon-bell"></use></svg></div>
            <div><h1>Centro de alertas</h1><div class="hero-subtitle"><svg class="icon icon-sm"><use href="#icon-info"></use></svg><span>Supervisa existencias críticas, devoluciones pendientes y préstamos vencidos.</span></div></div>
        </div>
        <div class="hero-actions">
            <button type="button" class="hero-secondary" onclick="location.reload()"><svg class="icon icon-sm"><use href="#icon-refresh"></use></svg>Actualizar</button>
            @if (tieneAlertas)
            {
                <form asp-action="MarcarTodasLeidas" method="post" id="marcarLeidasForm" class="inline-form">@Html.AntiForgeryToken()<button type="submit" class="hero-primary" id="marcarTodasLeidasBtn"><svg class="icon icon-sm"><use href="#icon-check-double"></use></svg>Marcar todas como leídas</button></form>
            }
        </div>
    </section>
    @if (TempData["MensajeExito"] != null)
    {
        <div class="page-alert success"><svg class="icon"><use href="#icon-check-circle"></use></svg><div class="page-alert-content"><strong>Operación completada</strong><span>@TempData["MensajeExito"]</span></div></div>
    }
    @if (TempData["MensajeError"] != null)
    {
        <div class="page-alert danger"><svg class="icon"><use href="#icon-x-circle"></use></svg><div class="page-alert-content"><strong>No se pudo completar la operación</strong><span>@TempData["MensajeError"]</span></div></div>
    }
    <section class="stats-grid" aria-label="Resumen de alertas">
        <div class="stat-card"><div class="stat-icon blue"><svg class="icon"><use href="#icon-bell"></use></svg></div><div><span class="stat-label">Total de alertas</span><strong class="stat-value">@totalAlertas</strong></div></div>
        <div class="stat-card"><div class="stat-icon red"><svg class="icon"><use href="#icon-box"></use></svg></div><div><span class="stat-label">Stock bajo</span><strong class="stat-value">@resumen.StockBajo</strong></div></div>
        <div class="stat-card"><div class="stat-icon gray"><svg class="icon"><use href="#icon-users"></use></svg></div><div><span class="stat-label">Devoluciones pendientes</span><strong class="stat-value">@(resumen.DevolucionesContratistas + resumen.DevolucionesEmpleados)</strong></div></div>
        <div class="stat-card"><div class="stat-icon red"><svg class="icon"><use href="#icon-tools"></use></svg></div><div><span class="stat-label">Préstamos vencidos</span><strong class="stat-value">@resumen.PrestamosVencidos</strong></div></div>
    </section>
    <section class="users-card">
        <header class="users-card-header"><div class="card-heading"><div class="heading-icon"><svg class="icon"><use href="#icon-list"></use></svg></div><div><h2>Listado de alertas</h2><p>Consulta y gestiona los eventos que necesitan atención.</p></div></div><span class="alert-total">@totalAlertas alertas</span></header>
        <div class="alertas-toolbar">
            <div class="alertas-tabs"><a class="alert-tab selected" asp-action="Index">Todas <span>@totalAlertas</span></a><a class="alert-tab" asp-action="StockBajo">Stock bajo <span>@resumen.StockBajo</span></a><a class="alert-tab" asp-action="DevolucionesContratistas">Contratistas <span>@resumen.DevolucionesContratistas</span></a><a class="alert-tab" asp-action="DevolucionesEmpleados">Empleados <span>@resumen.DevolucionesEmpleados</span></a><a class="alert-tab" asp-action="PrestamosVencidos">Préstamos <span>@resumen.PrestamosVencidos</span></a></div>
            <div class="alert-filters"><label class="alert-search"><svg class="icon icon-sm"><use href="#icon-search"></use></svg><input type="search" id="searchInput" placeholder="Buscar alerta..." aria-label="Buscar alertas" /></label><select id="tipoFiltro" aria-label="Filtrar por tipo"><option value="">Todos los tipos</option><option value="stock_bajo">Stock bajo</option><option value="devolucion_contratista">Dev. contratista</option><option value="devolucion_empleado">Dev. empleado</option><option value="prestamo_vencido">Préstamo vencido</option></select></div>
        </div>
        @if (tieneAlertas)
        {
            <div class="table-container">
                <table class="users-table alertas-table" id="alertasTable">
                    <thead><tr><th>#</th><th>Tipo</th><th>Título / referencia</th><th>Descripción</th><th>Estado</th><th>Fecha</th><th>Prioridad</th><th>Acciones</th></tr></thead>
                    <tbody>
                        @{
                            int counter = 1;
                        }

                        <!-- ============================================================ -->
                        <!-- ALERTAS DE STOCK BAJO -->
                        <!-- ============================================================ -->
                        @foreach (var item in stockBajo)
                        {
                            <tr class="alerta-row tipo-stock_bajo">
                                <td>
                                    <span class="alert-muted">@counter</span>
                                </td>
                                <td>
                                    <span class="alert-chip danger">
                                        <svg class="icon icon-sm"><use href="#icon-box"></use></svg>
                                        Stock Bajo
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        @if (!string.IsNullOrEmpty(item.ImagenUrl))
                                        {
                                            <img src="@item.ImagenUrl" alt="@item.Nombre" style="width: 32px; height: 32px; object-fit: cover; border-radius: 6px;" onerror="this.style.display='none'" />
                                        }
                                        else
                                        {
                                            <div class="material-thumb-mini">
                                                <svg class="icon icon-sm"><use href="#icon-box"></use></svg>
                                            </div>
                                        }
                                        <div>
                                            <span class="alert-primary-text">@item.Nombre</span>
                                            <small class="text-muted">@item.CodigoBarras</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex flex-column">
                                        <span>Stock actual: <strong class="text-danger">@item.StockActual.ToString("N2")</strong> de @item.UnidadConsumo</span>
                                        <small class="text-muted">Mínimo: @item.StockMinimo.ToString("N2") - <span class="fw-bold">@item.PorcentajeAlerta% del mínimo</span></small>
                                        <div class="progress mt-1" style="height: 4px; width: 100%;">
                                            <div class="progress-bar bg-danger" role="progressbar" style="width: @Math.Min(item.PorcentajeAlerta, 100)%;" aria-valuenow="@item.PorcentajeAlerta" aria-valuemin="0" aria-valuemax="100"></div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="alert-chip danger">Crítico</span>
                                </td>
                                <td>
                                    <span class="alert-muted">@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</span>
                                </td>
                                <td>
                                    <span class="alert-chip danger">Alta</span>
                                </td>
                                <td class="text-center">
                                    <div class="d-flex gap-1 justify-content-center">
                                        <a asp-controller="Materiales" asp-action="Detalles" asp-route-id="@item.IdMaterial" class="alert-action" title="Ver material">
                                            <svg class="icon icon-sm"><use href="#icon-eye"></use></svg>
                                        </a>
                                        <a asp-controller="Compras" asp-action="Registrar" class="alert-action positive" title="Registrar compra">
                                            <svg class="icon icon-sm"><use href="#icon-plus"></use></svg>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            counter++;
                        }

                        <!-- ============================================================ -->
                        <!-- ALERTAS DE DEVOLUCIONES DE CONTRATISTAS -->
                        <!-- ============================================================ -->
                        @foreach (var item in devolucionesContratistas)
                        {
                            var diasRestantes = item.FechaDevolucionEstimada.HasValue
                                ? (item.FechaDevolucionEstimada.Value.DayNumber - DateOnly.FromDateTime(DateTime.Now).DayNumber)
                                : 0;
                            var isVencida = diasRestantes < 0;
                            var esUrgente = diasRestantes >= 0 && diasRestantes <= 3;
                            <tr class="alerta-row tipo-devolucion_contratista @(isVencida ? "table-danger" : esUrgente ? "table-warning" : "")">
                                <td>
                                    <span class="alert-muted">@counter</span>
                                </td>
                                <td>
                                    <span class="alert-chip warning">
                                        <svg class="icon icon-sm"><use href="#icon-hardhat"></use></svg>
                                        Contratista
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="contratista-avatar-mini" style="@ObtenerEstiloAvatar(item.IdContratista);">
                                            @ObtenerIniciales(item.Contratista)
                                        </div>
                                        <div>
                                            <span class="alert-primary-text">@item.Contratista</span>
                                            <small class="text-muted">@item.CodigoProyecto</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex flex-column">
                                        <span>Material: <strong>@item.Material</strong></span>
                                        <span>Pendiente: <strong class="text-danger">@item.PendienteDevolucion.ToString("N2")</strong> de @item.Cantidad.ToString("N2")</span>
                                        <small class="text-muted">Entregado: @item.FechaEntregaFormateada</small>
                                    </div>
                                </td>
                                <td>
                                    @if (isVencida)
                                    {
                                        <span class="alert-chip danger">Vencido</span>
                                    }
                                    else if (esUrgente)
                                    {
                                        <span class="alert-chip warning">Por vencer</span>
                                    }
                                    else
                                    {
                                        <span class="alert-chip neutral">Pendiente</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex flex-column">
                                        <span class="small">@item.FechaDevolucionEstimadaFormateada</span>
                                        @if (isVencida)
                                        {
                                            <small class="text-danger fw-bold">@Math.Abs(diasRestantes) días vencido</small>
                                        }
                                        else if (esUrgente)
                                        {
                                            <small class="text-warning">Vence en @diasRestantes días</small>
                                        }
                                        else if (diasRestantes > 0)
                                        {
                                            <small class="text-muted">@diasRestantes días restantes</small>
                                        }
                                    </div>
                                </td>
                                <td>
                                    @if (isVencida)
                                    {
                                        <span class="alert-chip danger">Alta</span>
                                    }
                                    else if (esUrgente)
                                    {
                                        <span class="alert-chip warning">Media</span>
                                    }
                                    else
                                    {
                                        <span class="alert-chip neutral">Baja</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-flex gap-1 justify-content-center">
                                        <a asp-controller="Contratistas" asp-action="RegistrarDevolucion" asp-route-idAsignacion="@item.IdAsignacionRecurso" class="alert-action warning" title="Registrar devolución">
                                            <svg class="icon icon-sm"><use href="#icon-arrow-left"></use></svg>
                                        </a>
                                        <a asp-controller="Contratistas" asp-action="Detalles" asp-route-id="@item.IdContratista" class="alert-action" title="Ver contratista">
                                            <svg class="icon icon-sm"><use href="#icon-eye"></use></svg>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            counter++;
                        }

                        <!-- ============================================================ -->
                        <!-- ALERTAS DE DEVOLUCIONES DE EMPLEADOS -->
                        <!-- ============================================================ -->
                        @foreach (var item in devolucionesEmpleados)
                        {
                            var diasRestantes = item.FechaDevolucionEstimada.HasValue
                                ? (item.FechaDevolucionEstimada.Value.DayNumber - DateOnly.FromDateTime(DateTime.Now).DayNumber)
                                : 0;
                            var isVencida = diasRestantes < 0;
                            var esUrgente = diasRestantes >= 0 && diasRestantes <= 3;
                            <tr class="alerta-row tipo-devolucion_empleado @(isVencida ? "table-danger" : esUrgente ? "table-warning" : "")">
                                <td>
                                    <span class="alert-muted">@counter</span>
                                </td>
                                <td>
                                    <span class="alert-chip warning">
                                        <svg class="icon icon-sm"><use href="#icon-user"></use></svg>
                                        Empleado
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="empleado-avatar-mini" style="@ObtenerEstiloAvatarEmpleado(item.IdEmpleado);">
                                            @ObtenerIniciales(item.Empleado)
                                        </div>
                                        <div>
                                            <span class="alert-primary-text">@item.Empleado</span>
                                            <small class="text-muted">@(item.CodigoProyecto ?? "Sin proyecto")</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex flex-column">
                                        <span>Material: <strong>@item.Material</strong></span>
                                        <span>Pendiente: <strong class="text-danger">@item.PendienteDevolucion.ToString("N2")</strong> de @item.Cantidad.ToString("N2")</span>
                                        <small class="text-muted">Entregado: @item.FechaEntregaFormateada</small>
                                    </div>
                                </td>
                                <td>
                                    @if (isVencida)
                                    {
                                        <span class="alert-chip danger">Vencido</span>
                                    }
                                    else if (esUrgente)
                                    {
                                        <span class="alert-chip warning">Por vencer</span>
                                    }
                                    else
                                    {
                                        <span class="alert-chip neutral">Pendiente</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex flex-column">
                                        <span class="small">@item.FechaDevolucionEstimadaFormateada</span>
                                        @if (isVencida)
                                        {
                                            <small class="text-danger fw-bold">@Math.Abs(diasRestantes) días vencido</small>
                                        }
                                        else if (esUrgente)
                                        {
                                            <small class="text-warning">Vence en @diasRestantes días</small>
                                        }
                                        else if (diasRestantes > 0)
                                        {
                                            <small class="text-muted">@diasRestantes días restantes</small>
                                        }
                                    </div>
                                </td>
                                <td>
                                    @if (isVencida)
                                    {
                                        <span class="alert-chip danger">Alta</span>
                                    }
                                    else if (esUrgente)
                                    {
                                        <span class="alert-chip warning">Media</span>
                                    }
                                    else
                                    {
                                        <span class="alert-chip neutral">Baja</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-flex gap-1 justify-content-center">
                                        <a asp-controller="Empleados" asp-action="RegistrarDevolucion" asp-route-idAsignacion="@item.IdAsignacionRecursoEmpleado" class="alert-action warning" title="Registrar devolución">
                                            <svg class="icon icon-sm"><use href="#icon-arrow-left"></use></svg>
                                        </a>
                                        <a asp-controller="Empleados" asp-action="Detalles" asp-route-id="@item.IdEmpleado" class="alert-action" title="Ver empleado">
                                            <svg class="icon icon-sm"><use href="#icon-eye"></use></svg>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            counter++;
                        }

                        <!-- ============================================================ -->
                        <!-- ALERTAS DE PRÉSTAMOS VENCIDOS -->
                        <!-- ============================================================ -->
                        @foreach (var item in prestamosVencidos)
                        {
                            var diasAtraso = item.FechaDevolucionEstimada.HasValue
                                ? (DateTime.Now.Date - item.FechaDevolucionEstimada.Value.ToDateTime(TimeOnly.MinValue)).Days
                                : 0;
                            <tr class="alerta-row tipo-prestamo_vencido table-danger">
                                <td>
                                    <span class="alert-muted">@counter</span>
                                </td>
                                <td>
                                    <span class="alert-chip danger">
                                        <svg class="icon icon-sm"><use href="#icon-tools"></use></svg>
                                        Préstamo
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="maquinaria-thumb-mini" style="background: @ObtenerColor(item.IdMaquinaria); color: white;">
                                            @ObtenerIniciales(item.Maquinaria)
                                        </div>
                                        <div>
                                            <span class="alert-primary-text">@item.Maquinaria</span>
                                            <small class="text-muted">@item.CodigoMaquinaria</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex flex-column">
                                        <span>Préstamo vencido desde <strong>@item.FechaDevolucionEstimadaFormateada</strong></span>
                                        <span class="text-danger fw-bold">@diasAtraso días de atraso</span>
                                        <small class="text-muted">@item.Destinatario</small>
                                    </div>
                                </td>
                                <td>
                                    <span class="alert-chip danger">Vencido</span>
                                </td>
                                <td>
                                    <span class="alert-muted">@item.FechaPrestamoFormateada</span>
                                </td>
                                <td>
                                    @if (diasAtraso > 30)
                                    {
                                        <span class="alert-chip danger">Crítica</span>
                                    }
                                    else if (diasAtraso > 15)
                                    {
                                        <span class="alert-chip danger">Urgente</span>
                                    }
                                    else
                                    {
                                        <span class="alert-chip warning">Alta</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-flex gap-1 justify-content-center">
                                        <a asp-controller="Maquinarias" asp-action="DevolverPrestamo" asp-route-idPrestamo="@item.IdPrestamo" class="alert-action positive" title="Registrar devolución" onclick="return confirm('¿Registrar devolución de esta maquinaria?')">
                                            <svg class="icon icon-sm"><use href="#icon-check"></use></svg>
                                        </a>
                                        <a asp-controller="Maquinarias" asp-action="Detalles" asp-route-id="@item.IdMaquinaria" class="alert-action" title="Ver maquinaria">
                                            <svg class="icon icon-sm"><use href="#icon-eye"></use></svg>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            counter++;
                        }

                    </tbody>
                </table>
            </div><div class="alertas-empty-search" id="emptySearch" hidden>No se encontraron alertas con los filtros seleccionados.</div>
        }
        else
        {

            <div class="alertas-empty"><svg class="icon icon-xl"><use href="#icon-check-circle"></use></svg><strong>No hay alertas activas</strong><span>Cuando se detecten incidencias, aparecerán aquí.</span></div>
        }
    </section>
</div>
@{
    string ObtenerIniciales(string nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre)) return "C";
        var partes = nombre.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (partes.Length == 1) return partes[0].Substring(0, 1).ToUpper();
        return (partes[0].Substring(0, 1) + partes[^1].Substring(0, 1)).ToUpper();
    }

    string ObtenerColor(int id)
    {
        var colores = new[] { "#0d6efd", "#198754", "#dc3545", "#ffc107", "#6f42c1", "#fd7e14", "#0dcaf0", "#d63384", "#20c997", "#e83e8c", "#6610f2", "#f59e0b", "#10b981", "#3b82f6", "#8b5cf6", "#ef4444", "#f97316", "#06b6d4", "#14b8a6" };
        return colores[id % colores.Length];
    }

    string ObtenerEstiloAvatar(int id)
    {
        var color = ObtenerColor(id);
        return $"background: {color}20; color: {color}; border: 2px solid {color}40;";
    }

    string ObtenerEstiloAvatarEmpleado(int id)
    {
        var color = ObtenerColor(id + 50);
        return $"background: {color}20; color: {color}; border: 2px solid {color}40;";
    }
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const search = document.getElementById('searchInput');
            const filter = document.getElementById('tipoFiltro');
            const rows = Array.from(document.querySelectorAll('#alertasTable tbody tr.alerta-row'));
            const empty = document.getElementById('emptySearch');
            function applyFilters() {
                const term = (search?.value || '').trim().toLocaleLowerCase();
                const type = filter?.value || '';
                let visible = 0;
                rows.forEach(row => { const matchesText = row.textContent.toLocaleLowerCase().includes(term); const matchesType = !type || row.classList.contains('tipo-' + type); const show = matchesText && matchesType; row.hidden = !show; row.style.display = show ? '' : 'none'; if (show) visible++; });
                if (empty) empty.hidden = visible !== 0;
            }
            search?.addEventListener('input', applyFilters);
            filter?.addEventListener('change', applyFilters);
            const form = document.getElementById('marcarLeidasForm');
            form?.addEventListener('submit', function(event) { if (!confirm('¿Marcar todas las alertas como leídas?')) { event.preventDefault(); return; } const btn = document.getElementById('marcarTodasLeidasBtn'); if (btn) { btn.disabled = true; btn.textContent = 'Procesando...'; } });
        });
    </script>
}
<style>

    /* ================================================================
               BASE
               ================================================================ */

    .users-page {
        --navy: #102947;
        --blue: #17488e;
        --blue-light: #226cc2;
        --border: #dce3eb;
        --text: #344357;
        --muted: #7d8999;
        --surface: #ffffff;
        --success: #168957;
        --danger: #d1475b;
        --warning: #d99a24;
    }

    /* ================================================================
               HERO
               ================================================================ */

    .users-hero {
        min-height: 114px;
        padding: 23px 30px;
        margin-bottom: 17px;
        border-radius: 20px;
        background: linear-gradient( 100deg, #102947 0%, #17488e 49%, #226cc2 100%);
        color: white;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        position: relative;
        overflow: hidden;
    }

        .users-hero::after {
            content: "";
            position: absolute;
            width: 280px;
            height: 280px;
            top: -130px;
            right: -80px;
            border-radius: 50%;
            background: rgba(255,255,255,.05);
        }

    .hero-left {
        display: flex;
        align-items: center;
        gap: 18px;
        position: relative;
        z-index: 1;
    }

    .hero-icon {
        width: 60px;
        height: 60px;
        border-radius: 14px;
        background: rgba(255,255,255,.11);
        border: 1px solid rgba(255,255,255,.12);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .users-hero h1 {
        margin: 0;
        font-size: 1.65rem;
        font-weight: 800;
    }

    .hero-subtitle {
        margin-top: 6px;
        display: flex;
        align-items: center;
        gap: 7px;
        color: rgba(255,255,255,.72);
        font-size: .8rem;
    }

    .hero-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        position: relative;
        z-index: 1;
    }

    .hero-primary,
    .hero-secondary {
        min-height: 41px;
        padding: 0 15px;
        border-radius: 9px;

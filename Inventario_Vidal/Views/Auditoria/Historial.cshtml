@using Inventario_Vidal.DTOs
@model List<AuditoriaDto>

@{
    ViewData["Title"] = "Historial de Auditoría";
    ViewBag.Subtitle = "Trazabilidad completa de un registro";

    var registros =
        Model ?? new List<AuditoriaDto>();

    string tabla =
        ViewBag.Tabla?.ToString()
        ?? string.Empty;

    string idRegistro =
        ViewBag.IdRegistro?.ToString()
        ?? string.Empty;

    int pagina =
        ViewBag.Page is int pageValue && pageValue > 0
            ? pageValue
            : 1;

    const int pageSize = 20;

    bool puedeAnterior =
        pagina > 1;

    bool puedeSiguiente =
        registros.Count >= pageSize;

    var creaciones =
        registros.Count(r =>
            new[]
            {
                "crear",
                "insert",
                "insertar"
            }
            .Contains(
                r.Accion?.Trim().ToLowerInvariant()));

    var modificaciones =
        registros.Count(r =>
            new[]
            {
                "editar",
                "update",
                "actualizar"
            }
            .Contains(
                r.Accion?.Trim().ToLowerInvariant()));

    var eliminaciones =
        registros.Count(r =>
            new[]
            {
                "eliminar",
                "delete",
                "borrar"
            }
            .Contains(
                r.Accion?.Trim().ToLowerInvariant()));

    string ClaseAccion(string? accion)
    {
        return accion?
            .Trim()
            .ToLowerInvariant() switch
        {
            "crear"
            or "insert"
            or "insertar"
                => "create",

            "editar"
            or "update"
            or "actualizar"
                => "update",

            "eliminar"
            or "delete"
            or "borrar"
                => "delete",

            "activar"
                => "activate",

            "desactivar"
                => "deactivate",

            _ => "other"
        };
    }

    string IconoAccion(string? accion)
    {
        return accion?
            .Trim()
            .ToLowerInvariant() switch
        {
            "crear"
            or "insert"
            or "insertar"
                => "plus-circle",

            "editar"
            or "update"
            or "actualizar"
                => "edit",

            "eliminar"
            or "delete"
            or "borrar"
                => "trash",

            "activar"
                => "check-circle",

            "desactivar"
                => "x-circle",

            _ => "history"
        };
    }

    string ObtenerIniciales(string? nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre))
            return "S";

        var partes =
            nombre
                .Trim()
                .Split(
                    ' ',
                    StringSplitOptions.RemoveEmptyEntries);

        if (partes.Length == 1)
        {
            return partes[0]
                .Substring(0, 1)
                .ToUpperInvariant();
        }

        return (
            partes[0].Substring(0, 1) +
            partes[^1].Substring(0, 1))
            .ToUpperInvariant();
    }
}

<div class="audit-history-page">

    <!-- ============================================================ -->
    <!-- HERO -->
    <!-- ============================================================ -->

    <section class="history-hero">

        <div class="hero-main">

            <div class="hero-icon">

                <svg class="icon icon-xl">
                    <use href="#icon-history"></use>
                </svg>

            </div>

            <div>

                <span class="hero-eyebrow">
                    AUDITORÍA Y TRAZABILIDAD
                </span>

                <h1>
                    Historial del registro
                </h1>

                <p>
                    Consulta todas las operaciones registradas
                    sobre el mismo elemento.
                </p>

            </div>

        </div>

        <div class="hero-actions">

            <a asp-action="Index"
               class="hero-btn outline">

                <svg class="icon icon-sm">
                    <use href="#icon-arrow-left"></use>
                </svg>

                Volver a auditoría

            </a>

        </div>

    </section>

    <!-- ============================================================ -->
    <!-- IDENTIFICACIÓN -->
    <!-- ============================================================ -->

    <section class="record-card">

        <div class="record-icon">

            <svg class="icon">
                <use href="#icon-file-text"></use>
            </svg>

        </div>

        <div class="record-info">

            <span>
                REGISTRO AUDITADO
            </span>

            <strong>
                @tabla
            </strong>

            <small>
                ID afectado: @idRegistro
            </small>

        </div>

        <span class="page-badge">
            Página @pagina
        </span>

    </section>

    <!-- ============================================================ -->
    <!-- RESUMEN -->
    <!-- ============================================================ -->

    <section class="summary-grid">

        <article class="summary-card">

            <div class="summary-icon blue">

                <svg class="icon">
                    <use href="#icon-history"></use>
                </svg>

            </div>

            <div>

                <span>Visibles</span>

                <strong>
                    @registros.Count
                </strong>

                <small>
                    Registros en esta página
                </small>

            </div>

        </article>

        <article class="summary-card">

            <div class="summary-icon green">

                <svg class="icon">
                    <use href="#icon-plus-circle"></use>
                </svg>

            </div>

            <div>

                <span>Creaciones</span>

                <strong>
                    @creaciones
                </strong>

                <small>
                    En esta página
                </small>

            </div>

        </article>

        <article class="summary-card">

            <div class="summary-icon gold">

                <svg class="icon">
                    <use href="#icon-edit"></use>
                </svg>

            </div>

            <div>

                <span>Modificaciones</span>

                <strong>
                    @modificaciones
                </strong>

                <small>
                    En esta página
                </small>

            </div>

        </article>

        <article class="summary-card">

            <div class="summary-icon red">

                <svg class="icon">
                    <use href="#icon-trash"></use>
                </svg>

            </div>

            <div>

                <span>Eliminaciones</span>

                <strong>
                    @eliminaciones
                </strong>

                <small>
                    En esta página
                </small>

            </div>

        </article>

    </section>

    <!-- ============================================================ -->
    <!-- HISTORIAL -->
    <!-- ============================================================ -->

    <section class="history-panel">

        <div class="panel-heading">

            <div class="heading-left">

                <div class="heading-icon">

                    <svg class="icon">
                        <use href="#icon-list"></use>
                    </svg>

                </div>

                <div>

                    <span>
                        TRAZABILIDAD
                    </span>

                    <h2>
                        Operaciones registradas
                    </h2>

                    <p>
                        Ordenadas desde la operación más reciente.
                    </p>

                </div>

            </div>

            @if (registros.Any())
            {
                <div class="local-search">

                    <svg class="icon icon-sm">
                        <use href="#icon-search"></use>
                    </svg>

                    <input type="search"
                           id="localSearch"
                           placeholder="Buscar en esta página..."
                           autocomplete="off" />

                </div>
            }

        </div>

        @if (registros.Any())
        {
            <div class="timeline"
                 id="historyTimeline">

                @foreach (var item in registros)
                {
                    var clase =
                        ClaseAccion(item.Accion);

                    <article class="timeline-item"
                             data-search="@($"{item.Accion} {item.UsuarioNombre} {item.NombreTabla} {item.IdRegistroAfectado} {item.ResumenCambio}").ToLowerInvariant()">

                        <div class="timeline-axis">

                            <div class="timeline-dot @clase">

                                <svg class="icon icon-sm">
                                    <use href="#icon-@IconoAccion(item.Accion)"></use>
                                </svg>

                            </div>

                            <div class="timeline-line"></div>

                        </div>

                        <div class="timeline-card">

                            <div class="timeline-head">

                                <div class="event-main">

                                    <span class="action-badge @clase">
                                        @item.AccionTexto
                                    </span>

                                    <div>

                                        <strong>
                                            @item.ResumenCambio
                                        </strong>

                                        <span>
                                            @item.FechaFormateada
                                        </span>

                                    </div>

                                </div>

                                <a asp-action="Detalles"
                                   asp-route-id="@item.IdAuditoria"
                                   class="detail-btn"
                                   title="Ver detalle">

                                    <svg class="icon icon-sm">
                                        <use href="#icon-eye"></use>
                                    </svg>

                                    Ver detalle

                                </a>

                            </div>

                            <div class="timeline-meta">

                                <div>

                                    <span>
                                        Usuario
                                    </span>

                                    <strong>
                                        <span class="user-avatar">
                                            @ObtenerIniciales(item.UsuarioNombre)
                                        </span>

                                        @(string.IsNullOrWhiteSpace(item.UsuarioNombre)
                                            ? "Sistema"
                                            : item.UsuarioNombre)
                                    </strong>

                                </div>

                                <div>

                                    <span>
                                        Tabla
                                    </span>

                                    <strong>
                                        @item.NombreTabla
                                    </strong>

                                </div>

                                <div>

                                    <span>
                                        Registro
                                    </span>

                                    <strong>
                                        @(string.IsNullOrWhiteSpace(item.IdRegistroAfectado)
                                            ? "Sin referencia"
                                            : item.IdRegistroAfectado)
                                    </strong>

                                </div>

                            </div>

                        </div>

                    </article>
                }

            </div>

            <div id="noSearchResults"
                 class="empty-state d-none">

                <div class="empty-icon">

                    <svg class="icon icon-xl">
                        <use href="#icon-search"></use>
                    </svg>

                </div>

                <h3>
                    Sin coincidencias
                </h3>

                <p>
                    No hay eventos que coincidan con tu búsqueda.
                </p>

            </div>

            <div class="history-footer">

                <span>
                    @registros.Count
                    @(registros.Count == 1
                        ? "registro visible"
                        : "registros visibles")
                </span>

                <div class="pagination-actions">

                    @if (puedeAnterior)
                    {
                        <a asp-action="Historial"
                           asp-route-tabla="@tabla"
                           asp-route-idRegistro="@idRegistro"
                           asp-route-page="@(pagina - 1)"
                           class="page-btn">

                            <svg class="icon icon-sm">
                                <use href="#icon-chevron-left"></use>
                            </svg>

                            Anterior

                        </a>
                    }

                    <span class="current-page">
                        Página @pagina
                    </span>

                    @if (puedeSiguiente)
                    {
                        <a asp-action="Historial"
                           asp-route-tabla="@tabla"
                           asp-route-idRegistro="@idRegistro"
                           asp-route-page="@(pagina + 1)"
                           class="page-btn">

                            Siguiente

                            <svg class="icon icon-sm">
                                <use href="#icon-chevron-right"></use>
                            </svg>

                        </a>
                    }

                </div>

            </div>
        }
        else
        {
            <div class="empty-state">

                <div class="empty-icon">

                    <svg class="icon icon-xl">
                        <use href="#icon-history"></use>
                    </svg>

                </div>

                <h3>
                    No hay historial disponible
                </h3>

                <p>
                    No se encontraron operaciones auditadas
                    para este registro en la página solicitada.
                </p>

                <a asp-action="Index"
                   class="primary-btn">

                    Volver a auditoría

                </a>

            </div>
        }

    </section>

</div>

@section Scripts
{
    <script>
        document.addEventListener(
            'DOMContentLoaded',
            function () {

                const search =
                    document.getElementById(
                        'localSearch');

                const items =
                    [...document.querySelectorAll(
                        '.timeline-item')];

                const empty =
                    document.getElementById(
                        'noSearchResults');

                search?.addEventListener(
                    'input',
                    function () {

                        const term =
                            this.value
                                .trim()
                                .toLowerCase();

                        let visible = 0;

                        items.forEach(
                            item => {

                                const show =
                                    !term ||
                                    item.dataset.search
                                        .includes(term);

                                item.style.display =
                                    show
                                        ? ''
                                        : 'none';

                                if (show)
                                    visible++;
                            });

                        empty?.classList.toggle(
                            'd-none',
                            visible > 0);
                    });
            });
    </script>
}


        font-size: .57rem;
        font-weight: 800;
        cursor: pointer;
    }

    .permission-grid {
        padding: 11px;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
    }

    .permission-item {
        min-height: 72px;
        padding: 10px;
        border: 1px solid #e3e9ef;
        border-radius: 9px;
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        cursor: pointer;
    }

    .permission-item:hover {
        background: #fafcfe;
        border-color: #cfdde9;
    }

    .permission-item-main {
        min-width: 0;
        display: flex;
        align-items: flex-start;
        gap: 8px;
    }

    .permission-item-icon {
        width: 31px;
        height: 31px;
        border-radius: 8px;
        background: #f0f4f7;
        color: #607890;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .permission-item-main strong,
    .permission-item-main span,
    .permission-item-main small {
        display: block;
    }

    .permission-item-main strong {
        color: #43566e;
        font-size: .62rem;
    }

    .permission-item-main span {
        margin-top: 2px;
        color: #8794a4;
        font-size: .55rem;
        line-height: 1.35;
    }

    .permission-item-main small {
        margin-top: 4px;
        color: #a47517;
        font-size: .52rem;
        font-weight: 800;
    }

    .permission-switch {
        position: relative;
        width: 42px;
        height: 23px;
        flex-shrink: 0;
    }

    .permission-switch input {
        opacity: 0;
        width: 0;
        height: 0;
    }

    .permission-slider {
        position: absolute;
        inset: 0;
        border-radius: 999px;
        background: #c8d0da;
        transition: .2s;
    }

    .permission-slider::before {
        content: "";
        position: absolute;
        width: 17px;
        height: 17px;
        left: 3px;
        top: 3px;
        border-radius: 50%;
        background: #fff;
        transition: .2s;
        box-shadow: 0 1px 4px rgba(0,0,0,.18);
    }

    .permission-switch input:checked + .permission-slider {
        background: #168957;
    }

    .permission-switch input:checked + .permission-slider::before {
        transform: translateX(19px);
    }

    .permission-footer {
        margin-top: 14px;
        padding: 12px 14px;
        border: 1px solid #dce4ec;
        border-radius: 10px;
        background: #fafbfd;
        color: #758599;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        font-size: .6rem;
    }

    .permission-footer > div:first-child {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .permission-footer-actions {
        display: flex;
        gap: 7px;
    }

    @@media (max-width: 900px) {
        .permission-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 650px) {
        .module-heading {
            align-items: flex-start;
            flex-direction: column;
        }

        .module-actions {
            width: 100%;
        }

        .module-toggle {
            flex: 1;
        }

        .permission-footer {
            align-items: stretch;
            flex-direction: column;
        }

        .permission-footer-actions {
            width: 100%;
        }

        .permission-footer-actions .primary-btn,
        .permission-footer-actions .secondary-btn {
            flex: 1;
        }
    }
</style>


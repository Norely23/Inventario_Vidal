@using Inventario_Vidal.DTOs
@model RolPermisosDto

@{
    ViewData["Title"] = "Permisos del rol";
    ViewBag.Subtitle = $"Configuración de accesos para {Model.NombreRol}";

    var permisos = Model.Permisos ?? new List<PermisoDto>();

    var totalPermisos = permisos.Count;
    var asignados = permisos.Count(p => p.Asignado);

    var modulos = permisos
        .GroupBy(p => string.IsNullOrWhiteSpace(p.Modulo)
            ? "General"
            : p.Modulo)
        .OrderBy(g => g.Key)
        .ToList();

    string IconoModulo(string? modulo)
    {
        return modulo?.Trim().ToLowerInvariant() switch
        {
            "seguridad" => "shield",
            "inventario" => "box",
            "compras" => "shopping-cart",
            "proyectos" => "folder",
            "reportes" => "chart-bar",
            "usuarios" => "users",
            "configuracion" => "settings",
            "configuración" => "settings",
            _ => "key"
        };
    }
}

<div class="security-page">

    <section class="page-hero">
        <div class="hero-left">
            <div class="hero-icon">
                <svg class="icon icon-xl">
                    <use href="#icon-key"></use>
                </svg>
            </div>

            <div>
                <span class="hero-eyebrow">
                    SEGURIDAD Y ACCESOS
                </span>

                <h1>Permisos del rol</h1>

                <p>
                    Configura las operaciones autorizadas para
                    <strong>@Model.NombreRol</strong>.
                </p>
            </div>
        </div>

        <div class="hero-actions">
            <a asp-action="Detalles"
               asp-route-id="@Model.IdRol"
               class="hero-btn outline">
                <svg class="icon icon-sm">
                    <use href="#icon-arrow-left"></use>
                </svg>
                Volver al rol
            </a>

            <button type="submit"
                    form="permisosForm"
                    class="hero-btn light"
                    id="btnGuardarHero">
                <svg class="icon icon-sm">
                    <use href="#icon-save"></use>
                </svg>
                Guardar permisos
            </button>
        </div>
    </section>

    <section class="summary-grid">
        <article class="summary-card">
            <div class="summary-icon blue">
                <svg class="icon">
                    <use href="#icon-key"></use>
                </svg>
            </div>

            <div>
                <span>Total permisos</span>
                <strong>@totalPermisos</strong>
                <small>Permisos activos del sistema</small>
            </div>
        </article>

        <article class="summary-card">
            <div class="summary-icon green">
                <svg class="icon">
                    <use href="#icon-check-circle"></use>
                </svg>
            </div>

            <div>
                <span>Asignados</span>
                <strong id="statAsignados">@asignados</strong>
                <small>Permisos concedidos al rol</small>
            </div>
        </article>

        <article class="summary-card">
            <div class="summary-icon purple">
                <svg class="icon">
                    <use href="#icon-list"></use>
                </svg>
            </div>

            <div>
                <span>Módulos</span>
                <strong>@modulos.Count</strong>
                <small>Áreas con permisos disponibles</small>
            </div>
        </article>

        <article class="summary-card">
            <div class="summary-icon gold">
                <svg class="icon">
                    <use href="#icon-shield"></use>
                </svg>
            </div>

            <div>
                <span>Rol</span>
                <strong>@Model.NombreRol</strong>
                <small>ID #@Model.IdRol</small>
            </div>
        </article>
    </section>

    <form asp-action="Permisos"
          asp-route-id="@Model.IdRol"
          method="post"
          id="permisosForm">
        @Html.AntiForgeryToken()

        <section class="panel-card">
            <div class="panel-heading">
                <div class="heading-left">
                    <div class="heading-icon gold">
                        <svg class="icon">
                            <use href="#icon-key"></use>
                        </svg>
                    </div>

                    <div>
                        <span>CONFIGURACIÓN</span>
                        <h2>Permisos por módulo</h2>
                        <p>
                            Marca únicamente las operaciones que este rol necesita.
                        </p>
                    </div>
                </div>

                <div class="heading-tools">
                    <button type="button"
                            class="secondary-btn"
                            id="btnSeleccionarTodos">
                        Seleccionar todos
                    </button>

                    <button type="button"
                            class="secondary-btn"
                            id="btnLimpiar">
                        Limpiar
                    </button>
                </div>
            </div>

            @if (modulos.Any())
            {
                <div class="permission-modules">
                    @foreach (var modulo in modulos)
                    {
                        var permisosModulo = modulo.ToList();
                        var asignadosModulo = permisosModulo.Count(p => p.Asignado);

                        <article class="permission-module">
                            <div class="module-heading">
                                <div class="module-title">
                                    <div class="module-icon">
                                        <svg class="icon">
                                            <use href="#icon-@IconoModulo(modulo.Key)"></use>
                                        </svg>
                                    </div>

                                    <div>
                                        <span>MÓDULO</span>
                                        <strong>@modulo.Key</strong>
                                    </div>
                                </div>

                                <div class="module-actions">
                                    <span class="module-count">
                                        <span class="module-assigned">
                                            @asignadosModulo
                                        </span>
                                        / @permisosModulo.Count
                                    </span>

                                    <button type="button"
                                            class="module-toggle"
                                            data-module="@modulo.Key">
                                        Marcar módulo
                                    </button>
                                </div>
                            </div>

                            <div class="permission-grid">
                                @foreach (var permiso in permisosModulo)
                                {
                                    <label class="permission-item">
                                        <div class="permission-item-main">
                                            <div class="permission-item-icon">
                                                <svg class="icon icon-sm">
                                                    <use href="#icon-key"></use>
                                                </svg>
                                            </div>

                                            <div>
                                                <strong>@permiso.Nombre</strong>

                                                @if (!string.IsNullOrWhiteSpace(permiso.Descripcion))
                                                {
                                                    <span>@permiso.Descripcion</span>
                                                }

                                                @if (!string.IsNullOrWhiteSpace(permiso.Categoria))
                                                {
                                                    <small>@permiso.Categoria</small>
                                                }
                                            </div>
                                        </div>

                                        <span class="permission-switch">
                                            <input type="checkbox"
                                                   name="permisosSeleccionados"
                                                   value="@permiso.IdPermiso"
                                                   data-module="@modulo.Key"
                                                   @(permiso.Asignado ? "checked" : null) />

                                            <span class="permission-slider"></span>
                                        </span>
                                    </label>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon">
                        <svg class="icon icon-xl">
                            <use href="#icon-key"></use>
                        </svg>
                    </div>

                    <h3>No hay permisos activos</h3>
                    <p>
                        No existen permisos disponibles para asignar.
                    </p>
                </div>
            }
        </section>

        <div class="permission-footer">
            <div>
                <svg class="icon icon-sm">
                    <use href="#icon-info"></use>
                </svg>

                <span>
                    Se guardarán exactamente los permisos marcados.
                </span>
            </div>

            <div class="permission-footer-actions">
                <a asp-action="Detalles"
                   asp-route-id="@Model.IdRol"
                   class="secondary-btn">
                    Cancelar
                </a>

                <button type="submit"
                        class="primary-btn"
                        id="btnGuardar">
                    <svg class="icon icon-sm">
                        <use href="#icon-save"></use>
                    </svg>
                    Guardar permisos
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts
{
    <script>
        document.addEventListener(
            'DOMContentLoaded',
            function () {

                const form =
                    document.getElementById('permisosForm');

                const checkboxes =
                    [...form.querySelectorAll(
                        'input[name="permisosSeleccionados"]')];

                const statAsignados =
                    document.getElementById('statAsignados');

                const btnGuardar =
                    document.getElementById('btnGuardar');

                const btnGuardarHero =
                    document.getElementById('btnGuardarHero');

                function actualizarConteos() {
                    const totalAsignados =
                        checkboxes.filter(
                            checkbox => checkbox.checked)
                            .length;

                    statAsignados.textContent =
                        totalAsignados;

                    document
                        .querySelectorAll('.permission-module')
                        .forEach(module => {

                            const moduleCheckboxes =
                                [...module.querySelectorAll(
                                    'input[name="permisosSeleccionados"]')];

                            const assigned =
                                moduleCheckboxes.filter(
                                    checkbox => checkbox.checked)
                                    .length;

                            const counter =
                                module.querySelector(
                                    '.module-assigned');

                            if (counter)
                                counter.textContent =
                                    assigned;
                        });
                }

                checkboxes.forEach(
                    checkbox =>
                        checkbox.addEventListener(
                            'change',
                            actualizarConteos));

                document
                    .getElementById('btnSeleccionarTodos')
                    ?.addEventListener(
                        'click',
                        function () {
                            checkboxes.forEach(
                                checkbox =>
                                    checkbox.checked = true);

                            actualizarConteos();
                        });

                document
                    .getElementById('btnLimpiar')
                    ?.addEventListener(
                        'click',
                        function () {
                            checkboxes.forEach(
                                checkbox =>
                                    checkbox.checked = false);

                            actualizarConteos();
                        });

                document
                    .querySelectorAll('.module-toggle')
                    .forEach(button => {
                        button.addEventListener(
                            'click',
                            function () {

                                const module =
                                    this.dataset.module;

                                const moduleCheckboxes =
                                    checkboxes.filter(
                                        checkbox =>
                                            checkbox.dataset.module === module);

                                const allChecked =
                                    moduleCheckboxes.every(
                                        checkbox => checkbox.checked);

                                moduleCheckboxes.forEach(
                                    checkbox =>
                                        checkbox.checked = !allChecked);

                                actualizarConteos();
                            });
                    });

                form.addEventListener(
                    'submit',
                    function () {

                        const html =
                            '<svg class="icon icon-sm"><use href="#icon-refresh"></use></svg> Guardando...';

                        if (btnGuardar) {
                            btnGuardar.disabled = true;
                            btnGuardar.innerHTML = html;
                        }

                        if (btnGuardarHero) {
                            btnGuardarHero.disabled = true;
                            btnGuardarHero.innerHTML = html;
                        }
                    });

                actualizarConteos();
            });
    </script>
}

<style>
    .permission-modules {
        padding: 14px;
        display: grid;
        gap: 12px;
    }

    .permission-module {
        overflow: hidden;
        border: 1px solid #dce4ec;

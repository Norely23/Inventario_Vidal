        color: #8a97a7;
        font-size: .54rem;
        font-weight: 800;
        letter-spacing: .5px;
    }

    .module-title strong {
        margin-top: 2px;
        color: #43566e;
        font-size: .69rem;
    }

    .module-actions {
        display: flex;
        align-items: center;

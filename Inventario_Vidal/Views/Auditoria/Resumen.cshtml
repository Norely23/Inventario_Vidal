@using Inventario_Vidal.DTOs
@model AuditoriaResumenDto

@{
    ViewData["Title"] = "Resumen de Auditoría";
    ViewBag.Subtitle = "Estadísticas y métricas de actividad del sistema";

    var porTabla =
        Model.RegistrosPorTabla
        ?? new Dictionary<string, int>();

    var porAccion =
        Model.RegistrosPorAccion
        ?? new Dictionary<string, int>();

    var porUsuario =
        Model.RegistrosPorUsuario
        ?? new Dictionary<string, int>();

    var maxTabla =
        porTabla.Any()
            ? porTabla.Values.Max()
            : 0;

    var maxAccion =
        porAccion.Any()
            ? porAccion.Values.Max()
            : 0;

    var maxUsuario =
        porUsuario.Any()
            ? porUsuario.Values.Max()
            : 0;

    var usuariosConActividad =
        porUsuario.Count;

    string ClaseAccion(string? accion)
    {
        return accion?
            .Trim()
            .ToLowerInvariant() switch
        {
            "crear"
            or "insert"
            or "insertar"
                => "create",

            "editar"
            or "update"
            or "actualizar"
                => "update",

            "eliminar"
            or "delete"
            or "borrar"
                => "delete",

            "activar"
                => "activate",

            "desactivar"
                => "deactivate",

            "login"
            or "iniciar sesion"
            or "iniciar sesión"
                => "login",

            "logout"
            or "cerrar sesion"
            or "cerrar sesión"
                => "logout",

            _ => "other"
        };
    }

    string IconoAccion(string? accion)
    {
        return accion?
            .Trim()
            .ToLowerInvariant() switch
        {
            "crear"
            or "insert"
            or "insertar"
                => "plus-circle",

            "editar"
            or "update"
            or "actualizar"
                => "edit",

            "eliminar"
            or "delete"
            or "borrar"
                => "trash",

            "activar"
                => "check-circle",

            "desactivar"
                => "x-circle",

            "login"
            or "iniciar sesion"
            or "iniciar sesión"
                => "log-in",

            "logout"
            or "cerrar sesion"
            or "cerrar sesión"
                => "log-out",

            _ => "info"
        };
    }

    string ObtenerIniciales(string? nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre))
            return "S";

        var partes =
            nombre
                .Trim()
                .Split(
                    ' ',
                    StringSplitOptions.RemoveEmptyEntries);

        if (partes.Length == 1)
        {
            return partes[0]
                .Substring(0, 1)
                .ToUpperInvariant();
        }

        return (
            partes[0].Substring(0, 1) +
            partes[^1].Substring(0, 1))
            .ToUpperInvariant();
    }
}

<div class="audit-summary-page">

    <!-- ============================================================
         HERO
         ============================================================ -->

    <section class="summary-hero">

        <div class="hero-main">

            <div class="hero-icon">

                <svg class="icon icon-xl">
                    <use href="#icon-chart-bar"></use>
                </svg>

            </div>

            <div>

                <div class="hero-eyebrow">
                    AUDITORÍA Y CONTROL
                </div>

                <h1>
                    Resumen de Auditoría
                </h1>

                <p>
                    Estadísticas generales de actividad
                    registrada en el sistema.
                </p>

            </div>

        </div>

        <div class="hero-actions">

            <a asp-action="Index"
               class="hero-button outline">

                <svg class="icon icon-sm">
                    <use href="#icon-arrow-left"></use>
                </svg>

                Volver al historial

            </a>

            <button type="button"
                    class="hero-button outline"
                    onclick="window.location.reload()">

                <svg class="icon icon-sm">
                    <use href="#icon-refresh"></use>
                </svg>

                Actualizar

            </button>

            <button type="button"
                    class="hero-button light"
                    onclick="window.print()">

                <svg class="icon icon-sm">
                    <use href="#icon-print"></use>
                </svg>

                Imprimir

            </button>

        </div>

    </section>

    <!-- ============================================================
         ALERTAS
         ============================================================ -->
    @if (TempData["MensajeExito"] != null)
    {
        <div class="audit-alert success">

            <svg class="icon">
                <use href="#icon-check-circle"></use>
            </svg>

            <div>

                <strong>
                    Operación completada
                </strong>

                <span>
                    @TempData["MensajeExito"]
                </span>

            </div>

            <button type="button"
                    class="alert-close">

                <svg class="icon icon-sm">
                    <use href="#icon-x"></use>
                </svg>

            </button>

        </div>
    }

    @if (TempData["MensajeError"] != null)
    {
        <div class="audit-alert danger">

            <svg class="icon">
                <use href="#icon-x-circle"></use>
            </svg>

            <div>

                <strong>
                    No se pudo cargar el resumen
                </strong>

                <span>
                    @TempData["MensajeError"]
                </span>

            </div>

            <button type="button"
                    class="alert-close">

                <svg class="icon icon-sm">
                    <use href="#icon-x"></use>
                </svg>

            </button>

        </div>
    }

    <!-- ============================================================
         MÉTRICAS PRINCIPALES
         ============================================================ -->

    <section class="metrics-grid">

        <article class="metric-card">

            <div class="metric-icon blue">

                <svg class="icon">
                    <use href="#icon-clipboard-list"></use>
                </svg>

            </div>

            <div>

                <span>
                    Total registros
                </span>

                <strong>
                    @Model.TotalRegistros.ToString("N0")
                </strong>

                <small>
                    Auditorías acumuladas
                </small>

            </div>

        </article>

        <article class="metric-card">

            <div class="metric-icon green">

                <svg class="icon">
                    <use href="#icon-calendar"></use>
                </svg>

            </div>

            <div>

                <span>
                    Hoy
                </span>

                <strong>
                    @Model.RegistrosHoy.ToString("N0")
                </strong>

                <small>
                    Registros del día
                </small>

            </div>

        </article>

        <article class="metric-card">

            <div class="metric-icon gold">

                <svg class="icon">
                    <use href="#icon-calendar"></use>
                </svg>

            </div>

            <div>

                <span>
                    Esta semana
                </span>

                <strong>
                    @Model.RegistrosSemana.ToString("N0")
                </strong>

                <small>
                    Actividad semanal
                </small>

            </div>

        </article>

        <article class="metric-card">

            <div class="metric-icon purple">

                <svg class="icon">
                    <use href="#icon-calendar"></use>
                </svg>

            </div>

            <div>

                <span>
                    Este mes
                </span>

                <strong>
                    @Model.RegistrosMes.ToString("N0")
                </strong>

                <small>
                    Actividad mensual
                </small>

            </div>

        </article>

    </section>

    <!-- ============================================================
         RESUMEN OPERATIVO
         ============================================================ -->

    <section class="overview-grid">

        <article class="overview-card">

            <div class="overview-icon">

                <svg class="icon">
                    <use href="#icon-database"></use>
                </svg>

            </div>

            <div>

                <span>
                    Tablas auditadas
                </span>

                <strong>
                    @porTabla.Count
                </strong>

            </div>

        </article>

        <article class="overview-card">

            <div class="overview-icon">

                <svg class="icon">
                    <use href="#icon-tag"></use>
                </svg>

            </div>

            <div>

                <span>
                    Tipos de acción
                </span>

                <strong>
                    @porAccion.Count
                </strong>

            </div>

        </article>

        <article class="overview-card">

            <div class="overview-icon">

                <svg class="icon">
                    <use href="#icon-users"></use>
                </svg>

            </div>

            <div>

                <span>
                    Usuarios con actividad
                </span>

                <strong>
                    @usuariosConActividad
                </strong>

            </div>

        </article>

        <article class="overview-card last">

            <div class="overview-icon">

                <svg class="icon">
                    <use href="#icon-clock"></use>
                </svg>

            </div>

            <div>

                <span>
                    Último registro
                </span>

                @if (Model.UltimoRegistro.HasValue)
                {
                    <strong>
                        @Model.UltimoRegistro.Value.ToString("dd/MM/yyyy")
                    </strong>

                    <small>
                        @Model.UltimoRegistro.Value.ToString("HH:mm:ss")
                    </small>
                }
                else
                {
                    <strong>
                        Sin registros
                    </strong>

                    <small>
                        —
                    </small>
                }

            </div>

        </article>

    </section>

    <!-- ============================================================
         DISTRIBUCIÓN
         ============================================================ -->

    <div class="summary-layout">

        <!-- ========================================================
             TABLAS AUDITADAS
             ======================================================== -->

        <section class="summary-card-large">

            <div class="card-header">

                <div class="card-heading">

                    <div class="section-icon blue">

                        <svg class="icon">
                            <use href="#icon-database"></use>
                        </svg>

                    </div>

                    <div>

                        <span>
                            DISTRIBUCIÓN
                        </span>

                        <h2>
                            Registros por tabla
                        </h2>

                        <p>
                            Módulos con mayor cantidad
                            de operaciones auditadas.
                        </p>

                    </div>

                </div>

                <span class="header-count">
                    @porTabla.Count
                    @(porTabla.Count == 1
                        ? "tabla"
                        : "tablas")
                </span>

            </div>

            <div class="card-body">

                @if (porTabla.Any())
                {
                    <div class="ranking-list">

                        @{
                            var posicionTabla = 0;
                        }

                        @foreach (
                            var item in porTabla
                                .OrderByDescending(x => x.Value))
                        {
                            posicionTabla++;

                            var porcentaje =
                                Model.TotalRegistros > 0
                                    ? Math.Round(
                                        (decimal)item.Value /
                                        Model.TotalRegistros *
                                        100,
                                        1)
                                    : 0;

                            var ancho =
                                maxTabla > 0
                                    ? Math.Round(
                                        (decimal)item.Value /
                                        maxTabla *
                                        100,
                                        1)
                                    : 0;

                            <article class="ranking-item">

                                <div class="ranking-position">
                                    @posicionTabla
                                </div>

                                <div class="ranking-content">

                                    <div class="ranking-title">

                                        <div>

                                            <strong>
                                                @item.Key
                                            </strong>

                                            <span>
                                                @item.Value.ToString("N0")
                                                @(item.Value == 1
                                                    ? "registro"
                                                    : "registros")
                                            </span>

                                        </div>

                                        <strong class="ranking-percent">
                                            @porcentaje.ToString("0.#")%
                                        </strong>

                                    </div>

                                    <div class="progress-track">

                                        <div class="progress-value blue"
                                             style="width:@ancho.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%">
                                        </div>

                                    </div>

                                </div>

                            </article>
                        }

                    </div>
                }
                else
                {
                    <div class="empty-state">

                        <div class="empty-icon">

                            <svg class="icon icon-xl">
                                <use href="#icon-database"></use>
                            </svg>

                        </div>

                        <strong>
                            Sin datos por tabla
                        </strong>

                        <span>
                            Aún no existen registros suficientes
                            para generar esta distribución.
                        </span>

                    </div>
                }

            </div>

        </section>

        <!-- ========================================================
             ACCIONES
             ======================================================== -->

        <section class="summary-card-large">

            <div class="card-header">

                <div class="card-heading">

                    <div class="section-icon gold">

                        <svg class="icon">
                            <use href="#icon-tag"></use>
                        </svg>

                    </div>

                    <div>

                        <span>
                            OPERACIONES
                        </span>

                        <h2>
                            Registros por acción
                        </h2>

                        <p>
                            Distribución según el tipo
                            de operación registrada.
                        </p>

                    </div>

                </div>

                <span class="header-count">
                    @porAccion.Count
                    @(porAccion.Count == 1
                        ? "acción"
                        : "acciones")
                </span>

            </div>

            <div class="card-body">

                @if (porAccion.Any())
                {
                    <div class="action-grid">

                        @foreach (
                            var item in porAccion
                                .OrderByDescending(x => x.Value))
                        {
                            var porcentaje =
                                Model.TotalRegistros > 0
                                    ? Math.Round(
                                        (decimal)item.Value /
                                        Model.TotalRegistros *
                                        100,
                                        1)
                                    : 0;

                            var ancho =
                                maxAccion > 0
                                    ? Math.Round(
                                        (decimal)item.Value /
                                        maxAccion *
                                        100,
                                        1)
                                    : 0;

                            var clase =
                                ClaseAccion(item.Key);

                            <article class="action-stat @clase">

                                <div class="action-stat-top">

                                    <div class="action-stat-icon">

                                        <svg class="icon">
                                            <use href="#icon-@IconoAccion(item.Key)"></use>
                                        </svg>

                                    </div>

                                    <div>

                                        <strong>
                                            @item.Key.ToUpperInvariant()
                                        </strong>

                                        <span>
                                            @item.Value.ToString("N0")
                                            @(item.Value == 1
                                                ? "registro"
                                                : "registros")
                                        </span>

                                    </div>

                                    <b>
                                        @porcentaje.ToString("0.#")%
                                    </b>

                                </div>

                                <div class="progress-track">

                                    <div class="progress-value action"
                                         style="width:@ancho.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%">
                                    </div>

                                </div>

                            </article>
                        }

                    </div>
                }
                else
                {
                    <div class="empty-state">

                        <div class="empty-icon">

                            <svg class="icon icon-xl">
                                <use href="#icon-tag"></use>
                            </svg>

                        </div>

                        <strong>
                            Sin datos por acción
                        </strong>

                        <span>
                            No existen operaciones auditadas
                            para mostrar.
                        </span>

                    </div>
                }

            </div>

        </section>

    </div>

    <!-- ============================================================
         USUARIOS
         ============================================================ -->

    <section class="users-summary-card">

        <div class="card-header">

            <div class="card-heading">

                <div class="section-icon purple">

                    <svg class="icon">
                        <use href="#icon-users"></use>
                    </svg>

                </div>

                <div>

                    <span>
                        ACTIVIDAD
                    </span>

                    <h2>
                        Registros por usuario
                    </h2>

                    <p>
                        Participación de los usuarios
                        en operaciones auditadas.
                    </p>

                </div>

            </div>

            <span class="header-count">
                @usuariosConActividad
                @(usuariosConActividad == 1
                    ? "usuario"
                    : "usuarios")
            </span>

        </div>

        <div class="card-body">

            @if (porUsuario.Any())
            {
                <div class="users-ranking">

                    @{
                        var posicionUsuario = 0;
                    }

                    @foreach (
                        var item in porUsuario
                            .OrderByDescending(x => x.Value))
                    {
                        posicionUsuario++;

                        var porcentaje =
                            Model.TotalRegistros > 0
                                ? Math.Round(
                                    (decimal)item.Value /
                                    Model.TotalRegistros *
                                    100,
                                    1)
                                : 0;

                        var ancho =
                            maxUsuario > 0
                                ? Math.Round(
                                    (decimal)item.Value /
                                    maxUsuario *
                                    100,
                                    1)
                                : 0;

                        <article class="user-stat-row">

                            <div class="user-position">
                                @posicionUsuario
                            </div>

                            <div class="user-avatar">
                                @ObtenerIniciales(item.Key)
                            </div>

                            <div class="user-stat-main">

                                <div class="user-stat-title">

                                    <div>

                                        <strong>
                                            @item.Key
                                        </strong>

                                        <span>
                                            @item.Value.ToString("N0")
                                            @(item.Value == 1
                                                ? "operación registrada"
                                                : "operaciones registradas")
                                        </span>

                                    </div>

                                    <strong class="user-percent">
                                        @porcentaje.ToString("0.#")%
                                    </strong>

                                </div>

                                <div class="progress-track">

                                    <div class="progress-value purple"
                                         style="width:@ancho.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%">
                                    </div>

                                </div>

                            </div>

                        </article>
                    }

                </div>
            }
            else
            {
                <div class="empty-state">

                    <div class="empty-icon">

                        <svg class="icon icon-xl">
                            <use href="#icon-users"></use>
                        </svg>

                    </div>

                    <strong>
                        Sin actividad por usuario
                    </strong>

                    <span>
                        No hay usuarios asociados a registros
                        de auditoría actualmente.
                    </span>

                </div>
            }

        </div>

    </section>

    <!-- ============================================================
         INTERPRETACIÓN DEL RESUMEN
         ============================================================ -->

    <section class="info-note">

        <div class="info-note-icon">

            <svg class="icon">
                <use href="#icon-info"></use>
            </svg>

        </div>

        <div>

            <strong>
                Alcance de estas métricas
            </strong>

            <p>
                Los valores mostrados corresponden a los
                registros almacenados actualmente en la tabla
                de auditoría. Las cifras de hoy, semana y mes
                se calculan directamente a partir de la fecha
                de cada evento.
            </p>

        </div>

    </section>

</div>

@section Scripts
{
    <script>

        document.addEventListener(
            'DOMContentLoaded',
            function() {

                // ========================================================
                // ALERTAS
                // ========================================================

                document
                    .querySelectorAll(
                        '.alert-close')
                    .forEach(
                        function(button) {

                            button.addEventListener(
                                'click',
                                function() {

                                    const alert =
                                        button.closest(
                                            '.audit-alert');

                                    if (alert) {
                                        alert.remove();
                                    }
                                });
                        });

                document
                    .querySelectorAll(
                        '.audit-alert')
                    .forEach(
                        function(alert) {

                            setTimeout(
                                function() {

                                    if (!alert.isConnected) {
                                        return;
                                    }

                                    alert.classList.add(
                                        'closing');

                                    setTimeout(
                                        function() {

                                            if (alert.isConnected) {
                                                alert.remove();
                                            }

                                        },
                                        350);

                                },
                                6000);
                        });

            });

    </script>
}

<style>

    /* ================================================================
           BASE
           ================================================================ */

    .audit-summary-page {
        --navy: #102947;
        --blue: #17488e;
        --blue-light: #226cc2;
        --border: #dce3eb;
        --text: #344357;
        --muted: #7d8999;
        --success: #168957;
        --danger: #d1475b;
        --warning: #c58918;
    }

    /* ================================================================
           HERO
           ================================================================ */

    .summary-hero {
        min-height: 118px;
        padding: 23px 30px;
        margin-bottom: 17px;
        border-radius: 20px;
        background: linear-gradient( 100deg, #102947 0%, #17488e 49%, #226cc2 100%);
        color: white;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        position: relative;
        overflow: hidden;
    }

        .summary-hero::after {
            content: "";
            position: absolute;
            width: 290px;
            height: 290px;
            top: -145px;
            right: -85px;
            border-radius: 50%;
            background: rgba(255,255,255,.05);
        }

    .hero-main {
        display: flex;
        align-items: center;
        gap: 17px;
        position: relative;
        z-index: 1;
    }

    .hero-icon {
        width: 60px;
        height: 60px;
        border-radius: 14px;
        background: rgba(255,255,255,.11);
        border: 1px solid rgba(255,255,255,.13);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .hero-eyebrow {
        margin-bottom: 3px;
        color: rgba(255,255,255,.55);
        font-size: .52rem;
        font-weight: 800;
        letter-spacing: 1px;
    }

    .summary-hero h1 {
        margin: 0;
        font-size: 1.55rem;
        font-weight: 800;
    }

    .summary-hero p {
        margin: 5px 0 0;
        color: rgba(255,255,255,.72);
        font-size: .73rem;
    }

    .hero-actions {
        display: flex;
        gap: 8px;
        position: relative;
        z-index: 1;
    }

    .hero-button {
        min-height: 40px;
        padding: 0 14px;
        border-radius: 9px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        text-decoration: none;
        font-size: .66rem;
        font-weight: 750;
        cursor: pointer;
    }

        .hero-button.light {
            border: 1px solid white;
            background: white;
            color: var(--navy);
        }

        .hero-button.outline {
            border: 1px solid rgba(255,255,255,.28);
            background: rgba(255,255,255,.05);
            color: white;
        }

        .hero-button.light:hover {
            color: var(--navy);
            background: #f3f7fb;
        }

        .hero-button.outline:hover {
            color: white;
            background: rgba(255,255,255,.12);
        }

    /* ================================================================
           ALERTAS
           ================================================================ */

    .audit-alert {
        margin-bottom: 15px;
        padding: 12px 14px;
        border-radius: 11px;
        display: flex;
        align-items: flex-start;
        gap: 10px;
        transition: opacity .35s ease, transform .35s ease;
    }

        .audit-alert.success {
            background: #edf9f3;
            color: #146f48;
            border-left: 4px solid var(--success);
        }

        .audit-alert.danger {
            background: #fff1f3;
            color: #a73547;
            border-left: 4px solid var(--danger);
        }

        .audit-alert > div {
            flex: 1;
        }

        .audit-alert strong,
        .audit-alert span {
            display: block;
        }

        .audit-alert strong {
            font-size: .69rem;
        }

        .audit-alert span {
            margin-top: 2px;
            font-size: .61rem;
        }

        .audit-alert.closing {
            opacity: 0;
            transform: translateY(-8px);
        }

    .alert-close {
        border: none;
        padding: 2px;
        background: transparent;
        color: currentColor;
        opacity: .65;
        cursor: pointer;
    }

    /* ================================================================
           METRICAS
           ================================================================ */

    .metrics-grid {
        margin-bottom: 13px;
        display: grid;
        grid-template-columns: repeat( 4, minmax(0,1fr));
        gap: 12px;
    }

    .metric-card {
        min-height: 87px;
        padding: 14px 16px;
        border: 1px solid var(--border);
        border-radius: 13px;
        background: white;
        display: flex;
        align-items: center;
        gap: 11px;
        box-shadow: 0 4px 15px rgba(16,41,71,.035);

@using Inventario_Vidal.DTOs
@model List<AuditoriaDto>

@{
    ViewData["Title"] = "Auditoría del Sistema";
    ViewBag.Subtitle = "Trazabilidad de cambios y actividades";

    var registros =
        Model ?? new List<AuditoriaDto>();

    var filtro =
        ViewBag.Filtro as AuditoriaFiltroDto
        ?? new AuditoriaFiltroDto();

    var totalPagina =
        registros.Count;

    var registrosCreacion =
        registros.Count(r =>
            new[]
            {
                "crear",
                "insert",
                "insertar"
            }
            .Contains(
                r.Accion?.ToLowerInvariant()));

    var registrosModificacion =
        registros.Count(r =>
            new[]
            {
                "editar",
                "update",
                "actualizar"
            }
            .Contains(
                r.Accion?.ToLowerInvariant()));

    var registrosEliminacion =
        registros.Count(r =>
            new[]
            {
                "eliminar",
                "delete",
                "borrar"
            }
            .Contains(
                r.Accion?.ToLowerInvariant()));

    var usuariosPagina =
        registros
            .Where(r =>
                r.IdUsuario.HasValue)
            .Select(r => r.IdUsuario)
            .Distinct()
            .Count();

    var paginaActual =
        filtro.Page <= 0
            ? 1
            : filtro.Page;

    var pageSize =
        filtro.PageSize <= 0
            ? 30
            : filtro.PageSize;

    var puedeAvanzar =
        registros.Count >= pageSize;

    string ObtenerIniciales(
        string? nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre))
            return "S";

        var partes =
            nombre
                .Trim()
                .Split(
                    ' ',
                    StringSplitOptions
                        .RemoveEmptyEntries);

        if (partes.Length == 1)
        {
            return partes[0]
                .Substring(0, 1)
                .ToUpperInvariant();
        }

        return (
            partes[0].Substring(0, 1) +
            partes[^1].Substring(0, 1))
            .ToUpperInvariant();
    }

    string ClaseAccion(
        string? accion)
    {
        return accion?
            .Trim()
            .ToLowerInvariant() switch
        {
            "crear"
            or "insert"
            or "insertar"
                => "create",

            "editar"
            or "update"
            or "actualizar"
                => "update",

            "eliminar"
            or "delete"
            or "borrar"
                => "delete",

            "activar"
                => "activate",

            "desactivar"
                => "deactivate",

            "login"
            or "iniciar sesion"
            or "iniciar sesión"
                => "login",

            "logout"
            or "cerrar sesion"
            or "cerrar sesión"
                => "logout",

            _ => "other"
        };
    }

    string IconoAccion(
        string? accion)
    {
        return accion?
            .Trim()
            .ToLowerInvariant() switch
        {
            "crear"
            or "insert"
            or "insertar"
                => "plus",

            "editar"
            or "update"
            or "actualizar"
                => "edit",

            "eliminar"
            or "delete"
            or "borrar"
                => "trash",

            "activar"
                => "check-circle",

            "desactivar"
                => "x-circle",

            "login"
            or "iniciar sesion"
            or "iniciar sesión"
                => "user",

            "logout"
            or "cerrar sesion"
            or "cerrar sesión"
                => "user",

            _ => "info"
        };
    }
}

<div class="audit-page">

    <!-- ============================================================
         HERO
         ============================================================ -->

    <section class="audit-hero">

        <div class="hero-main">

            <div class="hero-icon">

                <svg class="icon icon-xl">
                    <use href="#icon-history"></use>
                </svg>

            </div>

            <div>

                <div class="hero-eyebrow">
                    SEGURIDAD Y TRAZABILIDAD
                </div>

                <h1>
                    Auditoría del Sistema
                </h1>

                <p>
                    Consulta los cambios y operaciones
                    registrados dentro del sistema logístico.
                </p>

            </div>

        </div>

        <div class="hero-actions">

            <a asp-action="Resumen"
               class="hero-btn light">

                <svg class="icon icon-sm">
                    <use href="#icon-chart-bar"></use>
                </svg>

                Ver resumen

            </a>

            <button type="button"
                    class="hero-btn outline"
                    onclick="window.location.reload()">

                <svg class="icon icon-sm">
                    <use href="#icon-refresh"></use>
                </svg>

                Actualizar

            </button>

        </div>

    </section>

    <!-- ============================================================
         ALERTAS
         ============================================================ -->
    @if (TempData["MensajeExito"] != null)
    {
        <div class="audit-alert success">

            <svg class="icon">
                <use href="#icon-check-circle"></use>
            </svg>

            <div>

                <strong>
                    Operación completada
                </strong>

                <span>
                    @TempData["MensajeExito"]
                </span>

            </div>

            <button type="button"
                    class="alert-close">

                <svg class="icon icon-sm">
                    <use href="#icon-x"></use>
                </svg>

            </button>

        </div>
    }

    @if (TempData["MensajeError"] != null)
    {
        <div class="audit-alert danger">

            <svg class="icon">
                <use href="#icon-x-circle"></use>
            </svg>

            <div>

                <strong>
                    No se pudo completar la operación
                </strong>

                <span>
                    @TempData["MensajeError"]
                </span>

            </div>

            <button type="button"
                    class="alert-close">

                <svg class="icon icon-sm">
                    <use href="#icon-x"></use>
                </svg>

            </button>

        </div>
    }

    <!-- ============================================================
         MÉTRICAS DE LA PÁGINA ACTUAL
         ============================================================ -->

    <section class="metrics-grid">

        <article class="metric-card">

            <div class="metric-icon blue">

                <svg class="icon">
                    <use href="#icon-list"></use>
                </svg>

            </div>

            <div>

                <span>
                    Registros mostrados
                </span>

                <strong>
                    @totalPagina
                </strong>

                <small>
                    Página actual
                </small>

            </div>

        </article>

        <article class="metric-card">

            <div class="metric-icon green">

                <svg class="icon">
                    <use href="#icon-plus"></use>
                </svg>

            </div>

            <div>

                <span>
                    Creaciones
                </span>

                <strong>
                    @registrosCreacion
                </strong>

                <small>
                    En esta página
                </small>

            </div>

        </article>

        <article class="metric-card">

            <div class="metric-icon gold">

                <svg class="icon">
                    <use href="#icon-edit"></use>
                </svg>

            </div>

            <div>

                <span>
                    Modificaciones
                </span>

                <strong>
                    @registrosModificacion
                </strong>

                <small>
                    En esta página
                </small>

            </div>

        </article>

        <article class="metric-card">

            <div class="metric-icon purple">

                <svg class="icon">
                    <use href="#icon-users"></use>
                </svg>

            </div>

            <div>

                <span>
                    Usuarios
                </span>

                <strong>
                    @usuariosPagina
                </strong>

                <small>
                    Con actividad visible
                </small>

            </div>

        </article>

    </section>

    <!-- ============================================================
         FILTROS
         ============================================================ -->

    <section class="filter-card">

        <div class="filter-header">

            <div class="filter-title">

                <div class="section-icon">

                    <svg class="icon">
                        <use href="#icon-search"></use>
                    </svg>

                </div>

                <div>

                    <span>
                        CONSULTA
                    </span>

                    <h2>
                        Filtros de auditoría
                    </h2>

                    <p>
                        Limita los registros por módulo,
                        acción, usuario o fecha.
                    </p>

                </div>

            </div>

            <button type="button"
                    class="filter-toggle"
                    id="btnToggleFilters">

                <svg class="icon icon-sm">
                    <use href="#icon-search"></use>
                </svg>

                Filtros

            </button>

        </div>

        <form asp-action="Index"
              method="get"
              id="filterForm"
              class="filter-body">

            <input type="hidden"
                   name="page"
                   value="1" />

            <!-- TABLA -->

            <div class="filter-field">

                <label for="tabla">
                    Tabla / módulo
                </label>

                <select id="tabla"
                        name="tabla"
                        class="audit-control">

                    <option value="">
                        Todas las tablas
                    </option>

                    @foreach (
                        var tabla in filtro
                            .TablasDisponibles)
                    {
                        <option value="@tabla"
                                selected="@(filtro.Tabla == tabla)">

                            @tabla

                        </option>
                    }

                </select>

            </div>

            <!-- ACCIÓN -->

            <div class="filter-field">

                <label for="accion">
                    Acción
                </label>

                <select id="accion"
                        name="accion"
                        class="audit-control">

                    <option value="">
                        Todas las acciones
                    </option>

                    @foreach (
                        var accion in filtro
                            .AccionesDisponibles)
                    {
                        <option value="@accion"
                                selected="@(filtro.Accion == accion)">

                            @accion

                        </option>
                    }

                </select>

            </div>

            <!-- USUARIO -->

            <div class="filter-field">

                <label for="usuarioId">
                    Usuario
                </label>

                <select id="usuarioId"
                        name="usuarioId"
                        class="audit-control">

                    <option value="">
                        Todos los usuarios
                    </option>

                    @foreach (
                        var usuario in filtro
                            .UsuariosDisponibles
                            .OrderBy(x => x.Value))
                    {
                        <option value="@usuario.Key"
                                selected="@(filtro.UsuarioId == usuario.Key)">

                            @usuario.Value

                        </option>
                    }

                </select>

            </div>

            <!-- DESDE -->

            <div class="filter-field">

                <label for="desde">
                    Desde
                </label>

                <input id="desde"
                       name="desde"
                       type="date"
                       value="@(filtro.Desde?.ToString("yyyy-MM-dd"))"
                       class="audit-control" />

            </div>

            <!-- HASTA -->

            <div class="filter-field">

                <label for="hasta">
                    Hasta
                </label>

                <input id="hasta"
                       name="hasta"
                       type="date"
                       value="@(filtro.Hasta?.ToString("yyyy-MM-dd"))"
                       class="audit-control" />

            </div>

            <!-- TAMAÑO -->

            <div class="filter-field">

                <label for="pageSize">
                    Registros
                </label>

                <select id="pageSize"
                        name="pageSize"
                        class="audit-control">

                    <option value="15"
                            selected="@(pageSize == 15)">
                        15
                    </option>

                    <option value="30"
                            selected="@(pageSize == 30)">
                        30
                    </option>

                    <option value="50"
                            selected="@(pageSize == 50)">
                        50
                    </option>

                    <option value="100"
                            selected="@(pageSize == 100)">
                        100
                    </option>

                </select>

            </div>

            <div class="filter-actions">

                <a asp-action="Index"
                   class="btn-secondary">

                    Limpiar

                </a>

                <button type="submit"
                        class="btn-primary">

                    <svg class="icon icon-sm">
                        <use href="#icon-search"></use>
                    </svg>

                    Aplicar filtros

                </button>

            </div>

        </form>

    </section>

    <!-- ============================================================
         LISTADO
         ============================================================ -->

    <section class="audit-card">

        <div class="audit-card-header">

            <div class="card-heading">

                <div class="section-icon">

                    <svg class="icon">
                        <use href="#icon-history"></use>
                    </svg>

                </div>

                <div>

                    <span>
                        TRAZABILIDAD
                    </span>

                    <h2>
                        Historial de operaciones
                    </h2>

                    <p>
                        Página @paginaActual ·
                        @totalPagina
                        @(totalPagina == 1
                            ? "registro visible"
                            : "registros visibles")
                    </p>

                </div>

            </div>

            <div class="table-tools">

                <div class="local-search">

                    <svg class="icon icon-sm">
                        <use href="#icon-search"></use>
                    </svg>

                    <input type="search"
                           id="localSearch"
                           placeholder="Buscar en esta página..."
                           autocomplete="off" />

                    <button type="button"
                            id="btnClearLocal"
                            style="display:none;">

                        <svg class="icon icon-sm">
                            <use href="#icon-x"></use>
                        </svg>

                    </button>

                </div>

                <a asp-action="ExportarExcel"
                   asp-route-tabla="@filtro.Tabla"
                   asp-route-accion="@filtro.Accion"
                   asp-route-usuarioId="@filtro.UsuarioId"
                   asp-route-desde="@filtro.Desde"
                   asp-route-hasta="@filtro.Hasta"
                   class="coming-button"
                   title="La exportación está pendiente de implementación">

                    <svg class="icon icon-sm">
                        <use href="#icon-info"></use>
                    </svg>

                    Excel próximamente

                </a>

            </div>

        </div>

        @if (registros.Any())
        {
            <div class="table-wrap">

                <table class="audit-table"
                       id="auditTable">

                    <thead>

                        <tr>

                            <th>
                                Fecha y hora
                            </th>

                            <th>
                                Usuario
                            </th>

                            <th>
                                Tabla
                            </th>

                            <th>
                                Acción
                            </th>

                            <th>
                                Registro
                            </th>

                            <th>
                                Resumen
                            </th>

                            <th class="text-center">
                                Detalle
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in registros)
                        {
                            var clase =
                                ClaseAccion(
                                    item.Accion);

                            <tr>

                                <!-- FECHA -->

                                <td>

                                    <div class="date-cell">

                                        <strong>
                                            @item.FechaHora.ToString("dd/MM/yyyy")
                                        </strong>

                                        <span>
                                            @item.FechaHora.ToString("HH:mm:ss")
                                        </span>

                                    </div>

                                </td>

                                <!-- USUARIO -->

                                <td>

                                    <div class="user-cell">

                                        <div class="user-avatar">

                                            @ObtenerIniciales(
                                                item.UsuarioNombre)

                                        </div>

                                        <div>

                                            <strong>
                                                @(string.IsNullOrWhiteSpace(
                                                    item.UsuarioNombre)
                                                    ? "Sistema"
                                                    : item.UsuarioNombre)
                                            </strong>

                                            <span>
                                                @(item.IdUsuario.HasValue
                                                    ? $"Usuario #{item.IdUsuario}"
                                                    : "Proceso del sistema")
                                            </span>

                                        </div>

                                    </div>

                                </td>

                                <!-- TABLA -->

                                <td>

                                    <span class="table-badge">

                                        <svg class="icon icon-sm">
                                            <use href="#icon-list"></use>
                                        </svg>

                                        @item.NombreTabla

                                    </span>

                                </td>

                                <!-- ACCIÓN -->

                                <td>

                                    <span class="action-badge @clase">

                                        <svg class="icon icon-sm">
                                            <use href="#icon-@IconoAccion(item.Accion)"></use>
                                        </svg>

                                        @item.AccionTexto

                                    </span>

                                </td>

                                <!-- REGISTRO -->

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(
                                            item.IdRegistroAfectado))
                                    {
                                        <span class="record-id">
                                            #@item.IdRegistroAfectado
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="empty-value">
                                            —
                                        </span>
                                    }

                                </td>

                                <!-- RESUMEN -->

                                <td>

                                    <div class="change-summary">

                                        @item.ResumenCambio

                                    </div>

                                </td>

                                <!-- DETALLE -->

                                <td class="text-center">

                                    <a asp-action="Detalles"
                                       asp-route-id="@item.IdAuditoria"
                                       class="detail-button"
                                       title="Ver detalle">

                                        <svg class="icon icon-sm">
                                            <use href="#icon-eye"></use>
                                        </svg>

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <!-- SIN RESULTADO LOCAL -->

            <div class="empty-state"
                 id="noLocalResults"
                 style="display:none;">

                <div class="empty-icon">

                    <svg class="icon icon-xl">
                        <use href="#icon-search"></use>
                    </svg>

                </div>

                <h3>
                    No se encontraron coincidencias
                </h3>

                <p>
                    La búsqueda solo se aplica a los
                    registros cargados en esta página.
                </p>

                <button type="button"
                        id="btnResetLocal"
                        class="btn-secondary">

                    Limpiar búsqueda

                </button>

            </div>

            <!-- ====================================================
                 PAGINACIÓN
                 ==================================================== -->

            <div class="pagination-bar">

                <div class="pagination-info">

                    <span>
                        Página
                    </span>

                    <strong>
                        @paginaActual
                    </strong>

                    <span>
                        · Máximo @pageSize registros
                    </span>

                </div>

                <div class="pagination-actions">

                    @if (paginaActual > 1)
                    {
                        <a asp-action="Index"
                           asp-route-tabla="@filtro.Tabla"
                           asp-route-accion="@filtro.Accion"
                           asp-route-usuarioId="@filtro.UsuarioId"
                           asp-route-desde="@filtro.Desde"
                           asp-route-hasta="@filtro.Hasta"
                           asp-route-page="@(paginaActual - 1)"
                           asp-route-pageSize="@pageSize"
                           class="page-button">

                            <svg class="icon icon-sm">
                                <use href="#icon-arrow-left"></use>
                            </svg>

                            Anterior

                        </a>
                    }
                    else
                    {
                        <span class="page-button disabled">

                            <svg class="icon icon-sm">
                                <use href="#icon-arrow-left"></use>
                            </svg>

                            Anterior

                        </span>
                    }

                    <span class="page-current">
                        @paginaActual
                    </span>

                    @if (puedeAvanzar)
                    {
                        <a asp-action="Index"
                           asp-route-tabla="@filtro.Tabla"
                           asp-route-accion="@filtro.Accion"
                           asp-route-usuarioId="@filtro.UsuarioId"
                           asp-route-desde="@filtro.Desde"
                           asp-route-hasta="@filtro.Hasta"
                           asp-route-page="@(paginaActual + 1)"
                           asp-route-pageSize="@pageSize"
                           class="page-button">

                            Siguiente

                            <svg class="icon icon-sm">
                                <use href="#icon-arrow-right"></use>
                            </svg>

                        </a>
                    }
                    else
                    {
                        <span class="page-button disabled">

                            Siguiente

                            <svg class="icon icon-sm">
                                <use href="#icon-arrow-right"></use>
                            </svg>

                        </span>
                    }

                </div>

            </div>
        }
        else
        {
            <div class="empty-state">

                <div class="empty-icon">

                    <svg class="icon icon-xl">
                        <use href="#icon-history"></use>
                    </svg>

                </div>

                <h3>
                    No hay registros de auditoría
                </h3>

                <p>
                    No se encontraron operaciones para
                    los filtros seleccionados.
                </p>

                <a asp-action="Index"
                   class="btn-primary">

                    <svg class="icon icon-sm">
                        <use href="#icon-refresh"></use>
                    </svg>

                    Restablecer filtros

                </a>

            </div>
        }

    </section>

</div>

@section Scripts
{
    <script>

        document.addEventListener(
            'DOMContentLoaded',
            function() {

                // ========================================================
                // BÚSQUEDA LOCAL
                // ========================================================

                const localSearch =
                    document.getElementById(
                        'localSearch');

                const auditTable =
                    document.getElementById(
                        'auditTable');

                const noLocalResults =
                    document.getElementById(
                        'noLocalResults');

                const btnClearLocal =
                    document.getElementById(
                        'btnClearLocal');

                const btnResetLocal =
                    document.getElementById(
                        'btnResetLocal');

                function filtrarPagina() {

                    if (!auditTable) {
                        return;
                    }

                    const term =
                        (localSearch?.value || '')
                            .trim()
                            .toLowerCase();

                    const rows =
                        auditTable.querySelectorAll(
                            'tbody tr');

                    let visibles = 0;

                    rows.forEach(
                        function(row) {

                            const visible =
                                !term ||
                                row.textContent
                                    .toLowerCase()
                                    .includes(term);

                            row.style.display =
                                visible
                                    ? ''
                                    : 'none';

                            if (visible) {
                                visibles++;
                            }
                        });

                    if (noLocalResults) {

                        noLocalResults.style.display =
                            visibles === 0
                                ? 'flex'
                                : 'none';
                    }

                    if (btnClearLocal) {

                        btnClearLocal.style.display =
                            term
                                ? 'inline-flex'
                                : 'none';
                    }
                }

                if (localSearch) {

                    localSearch.addEventListener(
                        'input',
                        filtrarPagina);
                }

                function limpiarBusqueda() {

                    if (!localSearch) {
                        return;
                    }

                    localSearch.value = '';

                    filtrarPagina();

                    localSearch.focus();
                }

                if (btnClearLocal) {

                    btnClearLocal.addEventListener(
                        'click',
                        limpiarBusqueda);
                }

                if (btnResetLocal) {

                    btnResetLocal.addEventListener(
                        'click',
                        limpiarBusqueda);
                }

                // ========================================================
                // FILTROS RESPONSIVE
                // ========================================================

                const btnToggleFilters =
                    document.getElementById(
                        'btnToggleFilters');

                const filterForm =
                    document.getElementById(
                        'filterForm');

                if (btnToggleFilters &&
                    filterForm) {

                    btnToggleFilters.addEventListener(
                        'click',
                        function() {

                            filterForm.classList.toggle(
                                'mobile-open');
                        });
                }

                // ========================================================
                // VALIDACIÓN FECHAS
                // ========================================================

                const desde =
                    document.getElementById(
                        'desde');

                const hasta =
                    document.getElementById(
                        'hasta');

                if (desde &&
                    hasta) {

                    desde.addEventListener(
                        'change',
                        function() {

                            if (desde.value) {

                                hasta.min =
                                    desde.value;
                            }

                            if (
                                desde.value &&
                                hasta.value &&
                                hasta.value <
                                desde.value
                            ) {
                                hasta.value =
                                    desde.value;
                            }
                        });

                    hasta.addEventListener(
                        'change',
                        function() {

                            if (
                                desde.value &&
                                hasta.value &&
                                hasta.value <
                                desde.value
                            ) {
                                hasta.value =
                                    desde.value;
                            }
                        });
                }

                // ========================================================
                // ALERTAS
                // ========================================================

                document
                    .querySelectorAll(
                        '.alert-close')
                    .forEach(
                        function(button) {

                            button.addEventListener(
                                'click',
                                function() {

                                    const alert =
                                        button.closest(
                                            '.audit-alert');

                                    if (alert) {
                                        alert.remove();
                                    }
                                });
                        });

                document
                    .querySelectorAll(
                        '.audit-alert')
                    .forEach(
                        function(alert) {

                            setTimeout(
                                function() {

                                    if (!alert.isConnected) {
                                        return;
                                    }

                                    alert.classList.add(
                                        'closing');

                                    setTimeout(
                                        function() {

                                            if (alert.isConnected) {
                                                alert.remove();
                                            }
                                        },
                                        350);

                                },
                                6000);
                        });

            });

    </script>
}


@using Inventario_Vidal.DTOs
@model EmpresaDto

@{
    ViewData["Title"] = "Editar Empresa";
    ViewBag.Subtitle = "Actualizar información y configuración de la empresa";

    decimal? tipoCambioActual = ViewBag.TipoCambioActual != null
        ? Convert.ToDecimal(ViewBag.TipoCambioActual)
        : Model.TipoCambio;

    DateOnly? fechaTipoCambio = ViewBag.TipoCambioFecha is DateOnly fecha
        ? fecha
        : null;

    bool vieneDeCache = ViewBag.TipoCambioCache == true;
    bool vieneDeFallback = ViewBag.TipoCambioFallback == true;

    string estadoTipoCambio = vieneDeFallback
        ? "Último valor disponible"
        : vieneDeCache
            ? "Registrado hoy en BD"
            : "Actualizado automáticamente";
}

<div class="empresa-edit-page">

    <!-- HERO -->
    <section class="edit-hero">
        <div class="hero-left">
            <div class="hero-icon">
                <svg class="icon icon-xl"><use href="#icon-edit"></use></svg>
            </div>

            <div>
                <span class="hero-eyebrow">CONFIGURACIÓN GENERAL</span>
                <h1>Editar Empresa</h1>
                <p>Actualiza los datos institucionales, financieros y el logotipo.</p>
            </div>
        </div>

        <div class="hero-actions">
            <a asp-action="Index" class="hero-button secondary">
                <svg class="icon icon-sm"><use href="#icon-arrow-left"></use></svg>
                Volver
            </a>

            <button type="submit" form="empresaForm" class="hero-button light js-save-empresa">
                <svg class="icon icon-sm"><use href="#icon-save"></use></svg>
                Guardar cambios
            </button>
        </div>
    </section>

    <!-- ALERTAS -->
    @if (TempData["MensajeExito"] != null)
    {
        <div class="page-alert success">
            <svg class="icon"><use href="#icon-check-circle"></use></svg>
            <div>
                <strong>Operación completada</strong>
                <span>@TempData["MensajeExito"]</span>
            </div>
            <button type="button" class="alert-close">
                <svg class="icon icon-sm"><use href="#icon-x"></use></svg>
            </button>
        </div>
    }

    @if (TempData["MensajeError"] != null)
    {
        <div class="page-alert danger">
            <svg class="icon"><use href="#icon-x-circle"></use></svg>
            <div>
                <strong>No se pudo completar la operación</strong>
                <span>@TempData["MensajeError"]</span>
            </div>
            <button type="button" class="alert-close">
                <svg class="icon icon-sm"><use href="#icon-x"></use></svg>
            </button>
        </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="page-alert danger">
            <svg class="icon"><use href="#icon-alert-triangle"></use></svg>
            <div>
                <strong>Revisa la información ingresada</strong>
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            </div>
            <button type="button" class="alert-close">
                <svg class="icon icon-sm"><use href="#icon-x"></use></svg>
            </button>
        </div>
    }

    <div class="edit-layout">

        <!-- FORMULARIO PRINCIPAL -->
        <main>
            <form asp-action="Editar" method="post" id="empresaForm">
                @Html.AntiForgeryToken()

                <input asp-for="IdConfiguracion" type="hidden" />
                <input asp-for="LogoUrl" type="hidden" />

                <!-- DATOS GENERALES -->
                <section class="form-card">
                    <div class="card-header">
                        <div class="heading-left">
                            <div class="heading-icon blue">
                                <svg class="icon"><use href="#icon-building"></use></svg>
                            </div>

                            <div>
                                <span>INFORMACIÓN GENERAL</span>
                                <h2>Datos de la empresa</h2>
                                <p>Información institucional utilizada dentro del sistema.</p>
                            </div>
                        </div>

                        <span class="section-badge">Obligatorio</span>
                    </div>

                    <div class="card-body">
                        <div class="form-grid">

                            <div class="field-group full">
                                <label asp-for="NombreEmpresa" class="vidal-label">
                                    Nombre de la empresa *
                                </label>

                                <div class="control-icon">
                                    <svg class="icon icon-sm"><use href="#icon-building"></use></svg>

                                    <input asp-for="NombreEmpresa"
                                           class="vidal-control"
                                           maxlength="200"
                                           placeholder="Nombre o razón social"
                                           autocomplete="organization" />
                                </div>

                                <span asp-validation-for="NombreEmpresa" class="validation-text"></span>
                            </div>

                            <div class="field-group">
                                <label asp-for="Ruc" class="vidal-label">
                                    RUC *
                                </label>

                                <div class="control-icon">
                                    <svg class="icon icon-sm"><use href="#icon-file-text"></use></svg>

                                    <input asp-for="Ruc"
                                           id="Ruc"
                                           class="vidal-control"
                                           maxlength="20"
                                           inputmode="numeric"
                                           placeholder="Número de RUC" />
                                </div>

                                <span asp-validation-for="Ruc" class="validation-text"></span>

                                <small class="field-help">
                                    Solo se permiten caracteres numéricos.
                                </small>
                            </div>

                            <div class="field-group">
                                <label asp-for="SitioWeb" class="vidal-label">
                                    Sitio web
                                </label>

                                <div class="control-icon">
                                    <svg class="icon icon-sm"><use href="#icon-link"></use></svg>

                                    <input asp-for="SitioWeb"
                                           class="vidal-control"
                                           maxlength="150"
                                           placeholder="https://www.empresa.com"
                                           autocomplete="url" />
                                </div>

                                <span asp-validation-for="SitioWeb" class="validation-text"></span>
                            </div>

                            <div class="field-group full">
                                <label asp-for="Direccion" class="vidal-label">
                                    Dirección
                                </label>

                                <div class="control-icon">
                                    <svg class="icon icon-sm"><use href="#icon-location"></use></svg>

                                    <input asp-for="Direccion"
                                           class="vidal-control"
                                           maxlength="250"
                                           placeholder="Dirección de la empresa"
                                           autocomplete="street-address" />
                                </div>

                                <span asp-validation-for="Direccion" class="validation-text"></span>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- CONTACTO -->
                <section class="form-card">
                    <div class="card-header">
                        <div class="heading-left">
                            <div class="heading-icon purple">
                                <svg class="icon"><use href="#icon-mail"></use></svg>
                            </div>

                            <div>
                                <span>CONTACTO</span>
                                <h2>Información de contacto</h2>
                                <p>Datos utilizados para comunicación y documentos institucionales.</p>
                            </div>
                        </div>

                        <span class="section-badge optional">Opcional</span>
                    </div>

                    <div class="card-body">
                        <div class="form-grid">

                            <div class="field-group">
                                <label asp-for="Telefono" class="vidal-label">
                                    Teléfono
                                </label>

                                <div class="control-icon">
                                    <svg class="icon icon-sm"><use href="#icon-smartphone"></use></svg>

                                    <input asp-for="Telefono"
                                           class="vidal-control"
                                           maxlength="30"
                                           placeholder="Número de contacto"
                                           autocomplete="tel" />
                                </div>

                                <span asp-validation-for="Telefono" class="validation-text"></span>
                            </div>

                            <div class="field-group">
                                <label asp-for="CorreoElectronico" class="vidal-label">
                                    Correo electrónico
                                </label>

                                <div class="control-icon">
                                    <svg class="icon icon-sm"><use href="#icon-mail"></use></svg>

                                    <input asp-for="CorreoElectronico"
                                           type="email"
                                           class="vidal-control"
                                           maxlength="150"
                                           placeholder="correo@empresa.com"
                                           autocomplete="email" />
                                </div>

                                <span asp-validation-for="CorreoElectronico" class="validation-text"></span>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- CONFIGURACIÓN FINANCIERA -->
                <section class="form-card">
                    <div class="card-header">
                        <div class="heading-left">
                            <div class="heading-icon gold">
                                <svg class="icon"><use href="#icon-dollar"></use></svg>
                            </div>

                            <div>
                                <span>CONFIGURACIÓN FINANCIERA</span>
                                <h2>Monedas e impuestos</h2>
                                <p>Define la moneda principal, secundaria y porcentaje de IGV.</p>
                            </div>
                        </div>
                    </div>

                    <div class="card-body">
                        <div class="form-grid">

                            <div class="field-group">
                                <label asp-for="Moneda" class="vidal-label">
                                    Moneda principal *
                                </label>

                                <div class="control-icon">
                                    <svg class="icon icon-sm"><use href="#icon-dollar"></use></svg>

                                    <select asp-for="Moneda" class="vidal-control select-control">
                                        <option value="PEN">PEN - Sol peruano</option>
                                        <option value="USD">USD - Dólar estadounidense</option>
                                        <option value="EUR">EUR - Euro</option>
                                    </select>
                                </div>

                                <span asp-validation-for="Moneda" class="validation-text"></span>
                            </div>

                            <div class="field-group">
                                <label asp-for="MonedaSecundaria" class="vidal-label">
                                    Moneda secundaria
                                </label>

                                <div class="control-icon">
                                    <svg class="icon icon-sm"><use href="#icon-exchange"></use></svg>

                                    <select asp-for="MonedaSecundaria" class="vidal-control select-control">
                                        <option value="">Sin moneda secundaria</option>
                                        <option value="USD">USD - Dólar estadounidense</option>
                                        <option value="PEN">PEN - Sol peruano</option>
                                        <option value="EUR">EUR - Euro</option>
                                    </select>
                                </div>

                                <span asp-validation-for="MonedaSecundaria" class="validation-text"></span>
                            </div>

                            <div class="field-group">
                                <label asp-for="Igv" class="vidal-label">
                                    IGV (%) *
                                </label>

                                <div class="control-icon suffix-control">
                                    <svg class="icon icon-sm"><use href="#icon-calculator"></use></svg>

                                    <input asp-for="Igv"
                                           id="Igv"
                                           type="number"
                                           min="0"
                                           max="100"
                                           step="0.01"
                                           class="vidal-control"
                                           placeholder="18.00" />

                                    <span class="suffix">%</span>
                                </div>

                                <span asp-validation-for="Igv" class="validation-text"></span>

                                <small class="field-help">
                                    Porcentaje utilizado para el cálculo del impuesto.
                                </small>
                            </div>

                            <!-- TIPO DE CAMBIO SOLO LECTURA -->
                            <div class="field-group">
                                <label class="vidal-label">
                                    Tipo de cambio USD/PEN
                                </label>

                                <div class="readonly-rate">
                                    <div class="readonly-rate-icon">
                                        <svg class="icon"><use href="#icon-exchange"></use></svg>
                                    </div>

                                    <div class="readonly-rate-content">
                                        <span>Valor actual</span>

                                        <strong>
                                            @(tipoCambioActual.HasValue
                                                ? tipoCambioActual.Value.ToString("0.0000")
                                                : "No disponible")
                                        </strong>
                                    </div>

                                    <div class="readonly-lock">
                                        <svg class="icon icon-sm"><use href="#icon-lock"></use></svg>
                                    </div>
                                </div>

                                <small class="field-help">
                                    @estadoTipoCambio
                                    @if (fechaTipoCambio.HasValue)
                                    {
                                        <text> · @fechaTipoCambio.Value.ToString("dd/MM/yyyy")</text>
                                    }
                                </small>
                            </div>

                            <div class="automatic-rate-info full">
                                <div class="automatic-icon">
                                    <svg class="icon"><use href="#icon-info"></use></svg>
                                </div>

                                <div>
                                    <strong>El tipo de cambio no se modifica desde esta pantalla</strong>

                                    <span>
                                        El sistema consulta el tipo de cambio USD/PEN mediante el servicio configurado.
                                        Si ya existe el registro del día en la base de datos, reutiliza ese valor.
                                        Si todavía no existe, obtiene el valor y lo registra para utilizarlo durante el día.
                                    </span>
                                </div>

                                <a asp-controller="TiposCambio" asp-action="Index">
                                    <svg class="icon icon-sm"><use href="#icon-history"></use></svg>
                                    Ver historial
                                </a>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- DOCUMENTOS -->
                <section class="form-card">
                    <div class="card-header">
                        <div class="heading-left">
                            <div class="heading-icon gray">
                                <svg class="icon"><use href="#icon-file-text"></use></svg>
                            </div>

                            <div>
                                <span>DOCUMENTOS</span>
                                <h2>Pie de página</h2>
                                <p>Texto institucional que podrá utilizarse en reportes y documentos.</p>
                            </div>
                        </div>

                        <span class="section-badge optional">Opcional</span>
                    </div>

                    <div class="card-body">
                        <div class="field-group">
                            <label asp-for="PiePagina" class="vidal-label">
                                Texto de pie de página
                            </label>

                            <textarea asp-for="PiePagina"
                                      id="PiePagina"
                                      class="vidal-control textarea-control"
                                      maxlength="500"
                                      rows="5"
                                      placeholder="Texto institucional para reportes y documentos..."></textarea>

                            <div class="field-footer">
                                <span asp-validation-for="PiePagina" class="validation-text"></span>
                                <span id="pieCounter">0 / 500</span>
                            </div>
                        </div>

                        <div class="footer-preview">
                            <div class="preview-icon">
                                <svg class="icon"><use href="#icon-file-text"></use></svg>
                            </div>

                            <div>
                                <span>Vista previa</span>
                                <p id="piePreview">
                                    @(string.IsNullOrWhiteSpace(Model.PiePagina)
                                        ? "El texto aparecerá aquí mientras escribes."
                                        : Model.PiePagina)
                                </p>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- BOTONES -->
                <div class="main-actions">
                    <button type="submit" class="primary-button js-save-empresa" id="btnGuardar">
                        <svg class="icon icon-sm"><use href="#icon-save"></use></svg>
                        Guardar cambios
                    </button>

                    <button type="button" class="secondary-button" id="btnRestablecer">
                        <svg class="icon icon-sm"><use href="#icon-refresh"></use></svg>
                        Restablecer
                    </button>

                    <a asp-action="Index" class="secondary-button cancel">
                        <svg class="icon icon-sm"><use href="#icon-arrow-left"></use></svg>
                        Cancelar
                    </a>
                </div>
            </form>
        </main>

        <!-- COLUMNA DERECHA -->
        <aside>

            <!-- LOGO -->
            <section class="side-card logo-card">
                <div class="side-header">
                    <div>
                        <span>IDENTIDAD</span>
                        <h3>Logotipo de la empresa</h3>
                    </div>

                    <div class="side-header-icon">
                        <svg class="icon"><use href="#icon-image"></use></svg>
                    </div>
                </div>

                <div class="logo-body">

                    <div class="logo-preview" id="logoPreview">
                        @if (!string.IsNullOrWhiteSpace(Model.LogoUrl))
                        {
                            <img src="@Model.LogoUrl"
                                 alt="Logo de la empresa"
                                 id="logoImage" />
                        }
                        else
                        {
                            <div class="logo-empty" id="logoEmpty">
                                <svg class="icon icon-xl"><use href="#icon-building"></use></svg>
                                <strong>Sin logotipo</strong>
                                <span>Selecciona una imagen para agregar el logo.</span>
                            </div>
                        }
                    </div>

                    <form asp-action="UploadLogo"
                          method="post"
                          enctype="multipart/form-data"
                          id="logoForm">

                        @Html.AntiForgeryToken()

                        <input type="file"
                               name="logo"
                               id="logoInput"
                               accept=".jpg,.jpeg,.png,.gif,.svg,.webp"
                               hidden />

                        <button type="button"
                                class="upload-button"
                                id="btnSeleccionarLogo">

                            <svg class="icon icon-sm"><use href="#icon-upload"></use></svg>
                            Seleccionar imagen
                        </button>

                        <button type="submit"
                                class="save-logo-button"
                                id="btnSubirLogo"
                                disabled>

                            <svg class="icon icon-sm"><use href="#icon-save"></use></svg>
                            Guardar logo
                        </button>
                    </form>

                    <div class="logo-file-info" id="logoFileInfo" style="display:none;">
                        <svg class="icon icon-sm"><use href="#icon-file"></use></svg>

                        <div>
                            <strong id="logoFileName">-</strong>
                            <span id="logoFileSize">-</span>
                        </div>
                    </div>

                    <div class="logo-requirements">
                        <div>
                            <svg class="icon icon-sm"><use href="#icon-check"></use></svg>
                            JPG, JPEG, PNG, GIF, SVG o WEBP
                        </div>

                        <div>
                            <svg class="icon icon-sm"><use href="#icon-check"></use></svg>
                            Tamaño máximo: 2 MB
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.LogoUrl))
                    {
                        <button type="button"
                                class="delete-logo-button"
                                id="btnEliminarLogo">

                            <svg class="icon icon-sm"><use href="#icon-trash"></use></svg>
                            Eliminar logo actual
                        </button>
                    }
                </div>
            </section>

            <!-- RESUMEN -->
            <section class="side-card">
                <div class="side-header normal">
                    <div>
                        <span>CONFIGURACIÓN</span>
                        <h3>Resumen actual</h3>
                    </div>

                    <div class="side-header-icon soft">
                        <svg class="icon"><use href="#icon-settings"></use></svg>
                    </div>
                </div>

                <div class="summary-list">
                    <div class="summary-row">
                        <div class="summary-row-icon">
                            <svg class="icon icon-sm"><use href="#icon-building"></use></svg>
                        </div>

                        <div>
                            <span>Empresa</span>
                            <strong id="summaryNombre">
                                @(!string.IsNullOrWhiteSpace(Model.NombreEmpresa)
                                    ? Model.NombreEmpresa
                                    : "Pendiente")
                            </strong>
                        </div>
                    </div>

                    <div class="summary-row">
                        <div class="summary-row-icon">
                            <svg class="icon icon-sm"><use href="#icon-file-text"></use></svg>
                        </div>

                        <div>
                            <span>RUC</span>
                            <strong id="summaryRuc">
                                @(!string.IsNullOrWhiteSpace(Model.Ruc)
                                    ? Model.Ruc
                                    : "Pendiente")
                            </strong>
                        </div>
                    </div>

                    <div class="summary-row">
                        <div class="summary-row-icon">
                            <svg class="icon icon-sm"><use href="#icon-dollar"></use></svg>
                        </div>

                        <div>
                            <span>Moneda principal</span>
                            <strong id="summaryMoneda">@Model.Moneda</strong>
                        </div>
                    </div>

                    <div class="summary-row">
                        <div class="summary-row-icon">
                            <svg class="icon icon-sm"><use href="#icon-calculator"></use></svg>
                        </div>

                        <div>
                            <span>IGV</span>
                            <strong id="summaryIgv">@Model.Igv.ToString("0.##")%</strong>
                        </div>
                    </div>

                    <div class="summary-row">
                        <div class="summary-row-icon">
                            <svg class="icon icon-sm"><use href="#icon-exchange"></use></svg>
                        </div>

                        <div>
                            <span>USD/PEN</span>
                            <strong>
                                @(tipoCambioActual.HasValue
                                    ? tipoCambioActual.Value.ToString("0.0000")
                                    : "No disponible")
                            </strong>
                        </div>
                    </div>
                </div>
            </section>

            <!-- AYUDA -->
            <section class="side-card">
                <div class="side-header normal">
                    <div>
                        <span>AYUDA</span>
                        <h3>Consideraciones</h3>
                    </div>

                    <div class="side-header-icon soft">
                        <svg class="icon"><use href="#icon-info"></use></svg>
                    </div>
                </div>

                <div class="tips-list">
                    <div class="tip-item">
                        <div class="tip-icon blue">
                            <svg class="icon icon-sm"><use href="#icon-save"></use></svg>
                        </div>

                        <div>
                            <strong>Datos generales</strong>
                            <span>Guarda los cambios del formulario principal con el botón Guardar cambios.</span>
                        </div>
                    </div>

                    <div class="tip-item">
                        <div class="tip-icon purple">
                            <svg class="icon icon-sm"><use href="#icon-image"></use></svg>
                        </div>

                        <div>
                            <strong>Logotipo independiente</strong>
                            <span>El logo se guarda de forma independiente de los demás datos.</span>
                        </div>
                    </div>

                    <div class="tip-item">
                        <div class="tip-icon green">
                            <svg class="icon icon-sm"><use href="#icon-exchange"></use></svg>
                        </div>

                        <div>
                            <strong>Tipo de cambio automático</strong>
                            <span>El valor USD/PEN no se edita desde la configuración de empresa.</span>
                        </div>
                    </div>
                </div>
            </section>
        </aside>
    </div>

    <!-- FORM ELIMINAR LOGO -->
    <form asp-action="DeleteLogo"
          method="post"
          id="deleteLogoForm"
          style="display:none;">

        @Html.AntiForgeryToken()
    </form>

    <!-- MODAL ELIMINAR LOGO -->
    <div class="modal-overlay" id="deleteLogoModal" style="display:none;">
        <div class="confirm-modal">
            <div class="confirm-icon danger">
                <svg class="icon icon-xl"><use href="#icon-trash"></use></svg>
            </div>

            <h3>Eliminar logotipo</h3>

            <p>
                ¿Deseas eliminar el logo actual de la empresa?
                Esta acción quitará la imagen de la configuración.
            </p>

            <div class="confirm-actions">
                <button type="button"
                        class="secondary-button"
                        id="btnCancelarEliminar">

                    Cancelar
                </button>

                <button type="button"
                        class="danger-button"
                        id="btnConfirmarEliminar">

                    <svg class="icon icon-sm"><use href="#icon-trash"></use></svg>
                    Eliminar logo
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const empresaForm = document.getElementById('empresaForm');
            const botonesGuardar = document.querySelectorAll('.js-save-empresa');
            const btnRestablecer = document.getElementById('btnRestablecer');

            const nombreInput = document.getElementById('NombreEmpresa');
            const rucInput = document.getElementById('Ruc');
            const monedaInput = document.getElementById('Moneda');
            const igvInput = document.getElementById('Igv');

            const summaryNombre = document.getElementById('summaryNombre');
            const summaryRuc = document.getElementById('summaryRuc');
            const summaryMoneda = document.getElementById('summaryMoneda');
            const summaryIgv = document.getElementById('summaryIgv');

            const pieInput = document.getElementById('PiePagina');
            const pieCounter = document.getElementById('pieCounter');
            const piePreview = document.getElementById('piePreview');

            const logoForm = document.getElementById('logoForm');
            const logoInput = document.getElementById('logoInput');
            const btnSeleccionarLogo = document.getElementById('btnSeleccionarLogo');
            const btnSubirLogo = document.getElementById('btnSubirLogo');
            const logoPreview = document.getElementById('logoPreview');
            const logoFileInfo = document.getElementById('logoFileInfo');
            const logoFileName = document.getElementById('logoFileName');
            const logoFileSize = document.getElementById('logoFileSize');

            const btnEliminarLogo = document.getElementById('btnEliminarLogo');
            const deleteLogoModal = document.getElementById('deleteLogoModal');
            const btnCancelarEliminar = document.getElementById('btnCancelarEliminar');
            const btnConfirmarEliminar = document.getElementById('btnConfirmarEliminar');
            const deleteLogoForm = document.getElementById('deleteLogoForm');

            const extensionesPermitidas = ['jpg', 'jpeg', 'png', 'gif', 'svg', 'webp'];
            const maxFileSize = 2 * 1024 * 1024;

            function actualizarResumen() {
                if (summaryNombre && nombreInput)
                    summaryNombre.textContent = nombreInput.value.trim() || 'Pendiente';

                if (summaryRuc && rucInput)
                    summaryRuc.textContent = rucInput.value.trim() || 'Pendiente';

                if (summaryMoneda && monedaInput)
                    summaryMoneda.textContent = monedaInput.value || 'PEN';

                if (summaryIgv && igvInput) {
                    const valor = parseFloat(igvInput.value);
                    summaryIgv.textContent = Number.isFinite(valor)
                        ? valor.toFixed(2).replace(/\.?0+$/, '') + '%'
                        : '—';
                }
            }

            function actualizarPie() {
                if (!pieInput)
                    return;

                const texto = pieInput.value || '';

                if (pieCounter)
                    pieCounter.textContent = texto.length + ' / 500';

                if (piePreview)
                    piePreview.textContent = texto.trim() || 'El texto aparecerá aquí mientras escribes.';
            }

            if (rucInput) {
                rucInput.addEventListener('input', function() {
                    this.value = this.value.replace(/\D/g, '').slice(0, 20);
                    actualizarResumen();
                });
            }

            nombreInput?.addEventListener('input', actualizarResumen);
            monedaInput?.addEventListener('change', actualizarResumen);
            igvInput?.addEventListener('input', actualizarResumen);
            pieInput?.addEventListener('input', actualizarPie);

            actualizarResumen();
            actualizarPie();

            if (btnRestablecer && empresaForm) {
                btnRestablecer.addEventListener('click', function() {
                    empresaForm.reset();

                    setTimeout(function() {
                        actualizarResumen();
                        actualizarPie();
                    }, 0);
                });
            }

            if (empresaForm) {
                empresaForm.addEventListener('submit', function(event) {
                    const htmlValido = empresaForm.checkValidity();
                    const jqueryValido = window.jQuery && $.validator
                        ? $(empresaForm).valid()
                        : true;

                    if (!htmlValido || !jqueryValido) {
                        event.preventDefault();
                        empresaForm.reportValidity();
                        return;
                    }

                    botonesGuardar.forEach(function(boton) {
                        boton.disabled = true;
                        boton.innerHTML =
                            '<svg class="icon icon-sm icon-spin"><use href="#icon-refresh"></use></svg> Guardando...';
                    });
                });
            }

            if (btnSeleccionarLogo && logoInput) {
                btnSeleccionarLogo.addEventListener('click', function() {
                    logoInput.click();
                });
            }

            if (logoInput) {
                logoInput.addEventListener('change', function() {
                    const file = this.files && this.files.length
                        ? this.files[0]
                        : null;

                    if (!file) {
                        if (btnSubirLogo)
                            btnSubirLogo.disabled = true;

                        if (logoFileInfo)
                            logoFileInfo.style.display = 'none';

                        return;
                    }

                    const extension = file.name.includes('.')
                        ? file.name.split('.').pop().toLowerCase()
                        : '';

                    if (!extensionesPermitidas.includes(extension)) {
                        alert('Formato no permitido. Use JPG, JPEG, PNG, GIF, SVG o WEBP.');
                        this.value = '';

                        if (btnSubirLogo)
                            btnSubirLogo.disabled = true;

                        return;
                    }

                    if (file.size > maxFileSize) {
                        alert('El archivo supera el tamaño máximo permitido de 2 MB.');
                        this.value = '';

                        if (btnSubirLogo)
                            btnSubirLogo.disabled = true;

                        return;
                    }

                    if (logoFileName)
                        logoFileName.textContent = file.name;

                    if (logoFileSize)
                        logoFileSize.textContent = (file.size / 1024).toFixed(1) + ' KB';

                    if (logoFileInfo)
                        logoFileInfo.style.display = 'flex';

                    if (btnSubirLogo)
                        btnSubirLogo.disabled = false;

                    const reader = new FileReader();

                    reader.onload = function(event) {
                        if (!logoPreview)
                            return;

                        logoPreview.innerHTML =
                            '<img src="' + event.target.result +
                            '" alt="Vista previa del logo" id="logoImage" />';
                    };

                    reader.readAsDataURL(file);
                });
            }

            if (logoForm && btnSubirLogo) {
                logoForm.addEventListener('submit', function() {
                    if (!logoInput?.files?.length)
                        return;

                    btnSubirLogo.disabled = true;
                    btnSubirLogo.innerHTML =
                        '<svg class="icon icon-sm icon-spin"><use href="#icon-refresh"></use></svg> Guardando...';
                });
            }

            if (btnEliminarLogo && deleteLogoModal) {
                btnEliminarLogo.addEventListener('click', function() {
                    deleteLogoModal.style.display = 'flex';
                });
            }

            if (btnCancelarEliminar && deleteLogoModal) {
                btnCancelarEliminar.addEventListener('click', function() {
                    deleteLogoModal.style.display = 'none';
                });
            }

            if (deleteLogoModal) {
                deleteLogoModal.addEventListener('click', function(event) {
                    if (event.target === deleteLogoModal)
                        deleteLogoModal.style.display = 'none';
                });
            }

            if (btnConfirmarEliminar && deleteLogoForm) {
                btnConfirmarEliminar.addEventListener('click', function() {
                    btnConfirmarEliminar.disabled = true;
                    deleteLogoForm.submit();
                });
            }

            document.querySelectorAll('.alert-close').forEach(function(button) {
                button.addEventListener('click', function() {
                    const alert = button.closest('.page-alert');

                    if (alert)
                        alert.remove();
                });
            });
        });
    </script>
}


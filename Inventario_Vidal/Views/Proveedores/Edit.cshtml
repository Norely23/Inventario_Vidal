@model Inventario_Vidal.Models.Proveedore

@{
    ViewData["Title"] = "Editar Proveedor";
}

<div class="container mt-4">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-warning text-dark">
            <h4 class="mb-0"><i class="bi bi-pencil-square"></i> Editar Proveedor</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <input type="hidden" asp-for="IdProveedor" />
                <input type="hidden" asp-for="FechaRegistro" />

                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="Ruc" class="form-label fw-semibold">RUC <span class="text-danger">*</span></label>
                        <input asp-for="Ruc" class="form-control" maxlength="11" />
                        <span asp-validation-for="Ruc" class="text-danger small"></span>
                    </div>
                    <div class="col-md-8">
                        <label asp-for="RazonSocial" class="form-label fw-semibold">Razón Social <span class="text-danger">*</span></label>
                        <input asp-for="RazonSocial" class="form-control" />
                        <span asp-validation-for="RazonSocial" class="text-danger small"></span>
                    </div>

                    <div class="col-md-8">
                        <label asp-for="Direccion" class="form-label fw-semibold">Dirección</label>
                        <input asp-for="Direccion" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Telefono" class="form-label fw-semibold">Teléfono</label>
                        <input asp-for="Telefono" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CorreoElectronico" class="form-label fw-semibold">Email</label>
                        <input asp-for="CorreoElectronico" type="email" class="form-control" />
                        <span asp-validation-for="CorreoElectronico" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ContactoNombre" class="form-label fw-semibold">Nombre de Contacto</label>
                        <input asp-for="ContactoNombre" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CondicionesPago" class="form-label fw-semibold">Condiciones de Pago</label>
                        <input asp-for="CondicionesPago" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Clasificacion" class="form-label fw-semibold">Clasificación</label>
                        <input asp-for="Clasificacion" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Calificacion" class="form-label fw-semibold">Calificación (1-5)</label>
                        <input asp-for="Calificacion" type="number" min="1" max="5" class="form-control" />
                        <span asp-validation-for="Calificacion" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Observaciones" class="form-label fw-semibold">Observaciones</label>
                        <textarea asp-for="Observaciones" class="form-control" rows="2"></textarea>
                    </div>

                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input class="form-check-input" asp-for="Activo" />
                            <label class="form-check-label fw-semibold" asp-for="Activo">Proveedor Activo</label>
                        </div>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle"></i> Cancelar
                    </a>
                    <button type="submit" class="btn btn-warning">
                        <i class="bi bi-save"></i> Guardar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
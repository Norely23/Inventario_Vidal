@model Inventario_Vidal.Models.Proveedore

@{
    ViewData["Title"] = "Eliminar Proveedor";
}

<div class="container mt-4">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Eliminar Proveedor</h4>
        </div>
        <div class="card-body p-4">
            <div class="alert alert-warning">
                <i class="bi bi-exclamation-circle"></i> ¿Estás seguro que deseas eliminar este proveedor? Si tiene compras asociadas, se desactivará en lugar de eliminarse.
            </div>

            <dl class="row">
                <dt class="col-sm-3 fw-semibold">RUC</dt>
                <dd class="col-sm-9">@Model.Ruc</dd>

                <dt class="col-sm-3 fw-semibold">Razón Social</dt>
                <dd class="col-sm-9">@Model.RazonSocial</dd>

                <dt class="col-sm-3 fw-semibold">Contacto</dt>
                <dd class="col-sm-9">@Model.ContactoNombre</dd>

                <dt class="col-sm-3 fw-semibold">Teléfono</dt>
                <dd class="col-sm-9">@Model.Telefono</dd>
            </dl>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="IdProveedor" />
                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle"></i> Cancelar
                    </a>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Confirmar Eliminación
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
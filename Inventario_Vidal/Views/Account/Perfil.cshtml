@model Inventario_Vidal.DTOs.PerfilUsuarioDto
@{
    ViewData["Title"] = "Mi perfil";
    var inicial = string.IsNullOrWhiteSpace(Model.NombreCompleto)
        ? "U"
        : Model.NombreCompleto[..1].ToUpperInvariant();
}

<style>
    .account-hero{min-height:120px;padding:24px 28px;border-radius:20px;background:linear-gradient(135deg,#102947,#17488e 62%,#226cc2);color:#fff;display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:18px;overflow:hidden;position:relative}
    .account-hero:after{content:"";position:absolute;width:260px;height:260px;border-radius:50%;right:-110px;top:-120px;border:1px solid rgba(255,255,255,.11);box-shadow:0 0 0 45px rgba(255,255,255,.025),0 0 0 90px rgba(255,255,255,.015)}
    .account-hero h1{font-size:1.55rem;font-weight:800;margin:0}
    .account-hero p{margin:5px 0 0;color:rgba(255,255,255,.72);font-size:.78rem}
    .hero-actions{display:flex;gap:8px;position:relative;z-index:1}
    .hero-btn{height:38px;padding:0 13px;border-radius:10px;border:1px solid rgba(255,255,255,.2);background:rgba(255,255,255,.1);color:#fff;display:inline-flex;align-items:center;gap:7px;text-decoration:none;font-size:.68rem;font-weight:700}
    .profile-grid{display:grid;grid-template-columns:300px minmax(0,1fr);gap:18px}
    .panel-card{background:#fff;border:1px solid #e2e8f0;border-radius:18px;box-shadow:0 8px 28px rgba(16,41,71,.06)}
    .profile-card{padding:24px}
    .avatar{width:82px;height:82px;margin:0 auto;border-radius:22px;background:linear-gradient(135deg,#102947,#226cc2);color:#fff;display:flex;align-items:center;justify-content:center;font-size:2rem;font-weight:800;box-shadow:0 14px 30px rgba(23,72,142,.18)}
    .profile-name{text-align:center;margin-top:14px;font-size:1rem;font-weight:800;color:#102947}
    .role{text-align:center;margin-top:5px;color:#17488e;font-size:.68rem;font-weight:700}
    .profile-meta{margin-top:20px;border-top:1px solid #edf1f5}
    .meta-row{padding:12px 0;border-bottom:1px solid #edf1f5}
    .meta-row span{display:block;color:#8a97a6;font-size:.57rem}
    .meta-row strong{display:block;margin-top:3px;color:#45596f;font-size:.70rem;font-weight:700;overflow-wrap:anywhere}
    .form-card{padding:24px}
    .section-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:20px}
    .section-head h2{font-size:1rem;color:#102947;margin:0}
    .section-head p{font-size:.64rem;color:#8794a3;margin:4px 0 0}
    .field{margin-bottom:16px}
    .field label{display:block;margin-bottom:6px;color:#55687d;font-size:.65rem;font-weight:700}
    .field input{width:100%;height:44px;border:1px solid #dbe3eb;border-radius:10px;padding:0 12px;color:#35495f;font-size:.72rem;outline:none}
    .field input:focus{border-color:#7da8d1;box-shadow:0 0 0 4px rgba(23,72,142,.08)}
    .readonly{background:#f6f8fa!important;color:#7f8c99!important}
    .validation-summary-errors{margin-bottom:14px;padding:10px 12px;border-radius:10px;background:#fff2f4;color:#b2384c;font-size:.63rem}
    .field-validation-error{display:block;margin-top:5px;color:#c53f55;font-size:.58rem}
    .form-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:20px}
    .btn-secondary-v{height:40px;padding:0 15px;border:1px solid #d8e1ea;border-radius:10px;background:#fff;color:#53667b;text-decoration:none;display:inline-flex;align-items:center;font-size:.67rem;font-weight:700}
    .btn-primary-v{height:40px;padding:0 16px;border:0;border-radius:10px;background:linear-gradient(135deg,#102947,#17488e);color:#fff;font-size:.67rem;font-weight:800;cursor:pointer}
    .success-msg{margin-bottom:16px;padding:11px 13px;border-radius:10px;background:#edf8f2;color:#18704d;font-size:.65rem;border:1px solid #d3eddf}
    @@media(max-width:900px){.profile-grid{grid-template-columns:1fr}.account-hero{align-items:flex-start;flex-direction:column}.hero-actions{flex-wrap:wrap}}
</style>

<div class="account-hero">
    <div>
        <h1>Mi perfil</h1>
        <p>Administra tus datos personales y revisa la información principal de tu cuenta.</p>
    </div>
    <div class="hero-actions">
        <a asp-action="CambiarPassword" class="hero-btn">Cambiar contraseña</a>
        <a asp-action="MisSesiones" class="hero-btn">Mis sesiones</a>
    </div>
</div>

@if (TempData["MensajeExito"] != null)
{
    <div class="success-msg">@TempData["MensajeExito"]</div>
}

<div class="profile-grid">
    <aside class="panel-card profile-card">
        <div class="avatar">@inicial</div>
        <div class="profile-name">@Model.NombreCompleto</div>
        <div class="role">@Model.NombreRol</div>

        <div class="profile-meta">
            <div class="meta-row">
                <span>Usuario</span>
                <strong>@Model.NombreUsuario</strong>
            </div>
            <div class="meta-row">
                <span>Correo electrónico</span>
                <strong>@(string.IsNullOrWhiteSpace(Model.CorreoElectronico) ? "No registrado" : Model.CorreoElectronico)</strong>
            </div>
            <div class="meta-row">
                <span>Miembro desde</span>
                <strong>@Model.FechaCreacion.ToString("dd/MM/yyyy")</strong>
            </div>
            <div class="meta-row">
                <span>Último acceso</span>
                <strong>@(Model.UltimoAcceso?.ToString("dd/MM/yyyy HH:mm") ?? "Nunca")</strong>
            </div>
        </div>
    </aside>

    <section class="panel-card form-card">
        <div class="section-head">
            <div>
                <h2>Información personal</h2>
                <p>Actualiza los datos que sí pueden ser modificados por tu cuenta.</p>
            </div>
        </div>

        <form asp-action="Perfil" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="IdUsuario" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <div class="field">
                <label asp-for="NombreUsuario">Nombre de usuario</label>
                <input asp-for="NombreUsuario" class="readonly" readonly />
            </div>

            <div class="field">
                <label asp-for="NombreCompleto"></label>
                <input asp-for="NombreCompleto" autocomplete="name" />
                <span asp-validation-for="NombreCompleto"></span>
            </div>

            <div class="field">
                <label asp-for="CorreoElectronico"></label>
                <input asp-for="CorreoElectronico" autocomplete="email" />
                <span asp-validation-for="CorreoElectronico"></span>
            </div>

            <div class="field">
                <label>Rol</label>
                <input value="@Model.NombreRol" class="readonly" readonly />
            </div>

            <div class="form-actions">
                <a asp-controller="Home" asp-action="Index" class="btn-secondary-v">Volver</a>
                <button type="submit" class="btn-primary-v">Guardar cambios</button>
            </div>
        </form>
    </section>
</div>

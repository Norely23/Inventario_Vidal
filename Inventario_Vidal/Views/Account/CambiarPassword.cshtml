@model Inventario_Vidal.DTOs.CambiarPasswordDto
@{
    ViewData["Title"] = "Cambiar contraseña";
}

<style>
    .security-hero{min-height:120px;padding:24px 28px;border-radius:20px;background:linear-gradient(135deg,#102947,#17488e 62%,#226cc2);color:#fff;display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:18px}
    .security-hero h1{font-size:1.55rem;font-weight:800;margin:0}
    .security-hero p{margin:5px 0 0;color:rgba(255,255,255,.72);font-size:.78rem}
    .hero-link{height:38px;padding:0 13px;border-radius:10px;border:1px solid rgba(255,255,255,.2);background:rgba(255,255,255,.1);color:#fff;display:inline-flex;align-items:center;text-decoration:none;font-size:.68rem;font-weight:700}
    .security-layout{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:18px}
    .panel-card{background:#fff;border:1px solid #e2e8f0;border-radius:18px;box-shadow:0 8px 28px rgba(16,41,71,.06);padding:24px}
    .panel-card h2{font-size:1rem;color:#102947;margin:0}
    .panel-card>p{font-size:.64rem;color:#8794a3;margin:5px 0 20px}
    .field{margin-bottom:16px}
    .field label{display:block;margin-bottom:6px;color:#55687d;font-size:.65rem;font-weight:700}
    .input-wrap{position:relative}
    .field input{width:100%;height:46px;border:1px solid #dbe3eb;border-radius:10px;padding:0 44px 0 12px;color:#35495f;font-size:.72rem;outline:none}
    .field input:focus{border-color:#7da8d1;box-shadow:0 0 0 4px rgba(23,72,142,.08)}
    .toggle-pass{position:absolute;right:7px;top:7px;width:32px;height:32px;border:0;border-radius:8px;background:#f2f5f8;color:#63768a;cursor:pointer;font-size:.58rem}
    .validation-summary-errors{margin-bottom:14px;padding:10px 12px;border-radius:10px;background:#fff2f4;color:#b2384c;font-size:.63rem}
    .field-validation-error{display:block;margin-top:5px;color:#c53f55;font-size:.58rem}
    .actions{display:flex;justify-content:flex-end;gap:8px;margin-top:20px}
    .btn-secondary-v,.btn-primary-v{height:40px;padding:0 15px;border-radius:10px;display:inline-flex;align-items:center;text-decoration:none;font-size:.67rem;font-weight:700}
    .btn-secondary-v{border:1px solid #d8e1ea;background:#fff;color:#53667b}
    .btn-primary-v{border:0;background:linear-gradient(135deg,#102947,#17488e);color:#fff;cursor:pointer}
    .rule{padding:11px 0;border-bottom:1px solid #edf1f5;color:#586b80;font-size:.64rem;line-height:1.45}
    .rule strong{color:#102947}
    @@media(max-width:900px){.security-layout{grid-template-columns:1fr}.security-hero{align-items:flex-start;flex-direction:column}}
</style>

<div class="security-hero">
    <div>
        <h1>Cambiar contraseña</h1>
        <p>Actualiza tu credencial de acceso. Al finalizar se cerrarán todas las sesiones por seguridad.</p>
    </div>
    <a asp-action="Perfil" class="hero-link">Volver al perfil</a>
</div>

<div class="security-layout">
    <section class="panel-card">
        <h2>Nueva credencial</h2>
        <p>Confirma tu contraseña actual antes de registrar una nueva.</p>

        <form asp-action="CambiarPassword" method="post" id="passwordForm">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <div class="field">
                <label asp-for="PasswordActual"></label>
                <div class="input-wrap">
                    <input asp-for="PasswordActual" autocomplete="current-password" />
                    <button type="button" class="toggle-pass" data-target="PasswordActual">Ver</button>
                </div>
                <span asp-validation-for="PasswordActual"></span>
            </div>

            <div class="field">
                <label asp-for="PasswordNueva"></label>
                <div class="input-wrap">
                    <input asp-for="PasswordNueva" autocomplete="new-password" />
                    <button type="button" class="toggle-pass" data-target="PasswordNueva">Ver</button>
                </div>
                <span asp-validation-for="PasswordNueva"></span>
            </div>

            <div class="field">
                <label asp-for="ConfirmarPassword"></label>
                <div class="input-wrap">
                    <input asp-for="ConfirmarPassword" autocomplete="new-password" />
                    <button type="button" class="toggle-pass" data-target="ConfirmarPassword">Ver</button>
                </div>
                <span asp-validation-for="ConfirmarPassword"></span>
            </div>

            <div class="actions">
                <a asp-action="Perfil" class="btn-secondary-v">Cancelar</a>
                <button type="submit" class="btn-primary-v">Actualizar contraseña</button>
            </div>
        </form>
    </section>

    <aside class="panel-card">
        <h2>Seguridad</h2>
        <p>Recomendaciones para proteger la cuenta.</p>
        <div class="rule"><strong>Mínimo 6 caracteres.</strong><br />Usa una contraseña distinta a la actual.</div>
        <div class="rule"><strong>No compartas tu credencial.</strong><br />Cada usuario debe utilizar su propia cuenta.</div>
        <div class="rule"><strong>Cierre global.</strong><br />Después del cambio se invalidan todas las sesiones activas.</div>
    </aside>
</div>

<script>
document.querySelectorAll('.toggle-pass').forEach(button => {
    button.addEventListener('click', () => {
        const input = document.getElementById(button.dataset.target);
        const visible = input.type === 'text';
        input.type = visible ? 'password' : 'text';
        button.textContent = visible ? 'Ver' : 'Ocultar';
    });
});
</script>
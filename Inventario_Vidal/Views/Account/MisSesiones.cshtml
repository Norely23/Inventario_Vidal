@model List<Inventario_Vidal.DTOs.SesionUsuarioDto>
@{
    ViewData["Title"] = "Mis sesiones";
    var activas = Model.Count(x => x.Activa);
    var remotas = Model.Count(x => x.Activa && !x.EsSesionActual);
}

<style>
    .sessions-hero{min-height:120px;padding:24px 28px;border-radius:20px;background:linear-gradient(135deg,#102947,#17488e 62%,#226cc2);color:#fff;display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:18px}
    .sessions-hero h1{font-size:1.55rem;font-weight:800;margin:0}
    .sessions-hero p{margin:5px 0 0;color:rgba(255,255,255,.72);font-size:.78rem}
    .hero-actions{display:flex;gap:8px;flex-wrap:wrap}
    .hero-btn{height:38px;padding:0 13px;border-radius:10px;border:1px solid rgba(255,255,255,.2);background:rgba(255,255,255,.1);color:#fff;display:inline-flex;align-items:center;text-decoration:none;font-size:.68rem;font-weight:700;cursor:pointer}
    .summary{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-bottom:18px}
    .summary-card{padding:16px 18px;background:#fff;border:1px solid #e2e8f0;border-radius:15px}
    .summary-card span{display:block;color:#8794a3;font-size:.58rem}
    .summary-card strong{display:block;margin-top:4px;color:#102947;font-size:1.15rem}
    .panel-card{background:#fff;border:1px solid #e2e8f0;border-radius:18px;box-shadow:0 8px 28px rgba(16,41,71,.06);overflow:hidden}
    .panel-head{padding:18px 20px;border-bottom:1px solid #e9eef3;display:flex;align-items:center;justify-content:space-between}
    .panel-head h2{font-size:.92rem;color:#102947;margin:0}
    .panel-head p{font-size:.60rem;color:#8794a3;margin:4px 0 0}
    .table-wrap{overflow:auto}
    .sessions-table{width:100%;border-collapse:collapse;min-width:860px}
    .sessions-table th{padding:10px 14px;background:#f6f8fb;color:#687a8d;font-size:.58rem;text-align:left;font-weight:800;border-bottom:1px solid #e5ebf1}
    .sessions-table td{padding:13px 14px;color:#4e6277;font-size:.64rem;border-bottom:1px solid #edf1f5;vertical-align:middle}
    .badge{display:inline-flex;align-items:center;padding:5px 8px;border-radius:999px;font-size:.55rem;font-weight:800}
    .badge-current{background:#eaf3fd;color:#17488e}
    .badge-active{background:#eaf7f0;color:#19704d}
    .badge-closed{background:#f0f2f5;color:#7a8794}
    .close-btn{height:32px;padding:0 10px;border:1px solid #eed0d6;border-radius:8px;background:#fff5f6;color:#b63d50;font-size:.57rem;font-weight:700;cursor:pointer}
    .empty{padding:38px;text-align:center;color:#8492a1;font-size:.68rem}
    .notice{display:none;margin-bottom:14px;padding:11px 13px;border-radius:10px;font-size:.64rem}
    .notice.show{display:block}
    .notice.ok{background:#edf8f2;color:#18704d;border:1px solid #d3eddf}
    .notice.error{background:#fff2f4;color:#b2384c;border:1px solid #efcfd5}
    @@media(max-width:800px){.summary{grid-template-columns:1fr}.sessions-hero{align-items:flex-start;flex-direction:column}}
</style>

<div class="sessions-hero">
    <div>
        <h1>Mis sesiones</h1>
        <p>Revisa los dispositivos que han iniciado sesión con tu cuenta y cierra accesos remotos.</p>
    </div>
    <div class="hero-actions">
        <a asp-action="Perfil" class="hero-btn">Volver al perfil</a>
        @if (remotas > 0)
        {
            <button type="button" class="hero-btn" id="btnCerrarTodas">Cerrar sesiones remotas</button>
        }
    </div>
</div>

<div class="summary">
    <div class="summary-card"><span>Sesiones activas</span><strong>@activas</strong></div>
    <div class="summary-card"><span>Sesiones remotas activas</span><strong>@remotas</strong></div>
    <div class="summary-card"><span>Historial registrado</span><strong>@Model.Count</strong></div>
</div>

<div id="notice" class="notice"></div>

<section class="panel-card">
    <div class="panel-head">
        <div>
            <h2>Historial de sesiones</h2>
            <p>Las sesiones vencidas se muestran como cerradas.</p>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty">No hay sesiones registradas.</div>
    }
    else
    {
        <div class="table-wrap">
            <table class="sessions-table">
                <thead>
                    <tr>
                        <th>Dispositivo</th>
                        <th>Navegador</th>
                        <th>IP</th>
                        <th>Inicio</th>
                        <th>Expira</th>
                        <th>Estado</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var sesion in Model)
                {
                    <tr data-token="@sesion.TokenId">
                        <td>
                            @sesion.Dispositivo
                            @if (sesion.EsSesionActual)
                            {
                                <span class="badge badge-current">Actual</span>
                            }
                        </td>
                        <td>@sesion.Navegador</td>
                        <td>@(string.IsNullOrWhiteSpace(sesion.Ip) ? "N/D" : sesion.Ip)</td>
                        <td>@sesion.FechaFormateada</td>
                        <td>@sesion.FechaExpiracionFormateada</td>
                        <td>
                            <span class="badge @(sesion.Activa ? "badge-active" : "badge-closed")">
                                @sesion.Estado
                            </span>
                        </td>
                        <td>
                            @if (sesion.Activa && !sesion.EsSesionActual)
                            {
                                <button type="button" class="close-btn" data-token="@sesion.TokenId">Cerrar</button>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<form id="antiForgeryForm" method="post" style="display:none">
    @Html.AntiForgeryToken()
</form>

<script>
const token = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]').value;
const notice = document.getElementById('notice');

function showNotice(message, ok) {
    notice.textContent = message;
    notice.className = `notice show ${ok ? 'ok' : 'error'}`;
}

async function postForm(url, data = {}) {
    const formData = new FormData();
    formData.append('__RequestVerificationToken', token);
    Object.entries(data).forEach(([key, value]) => formData.append(key, value));

    const response = await fetch(url, { method: 'POST', body: formData });
    return response.json();
}

document.querySelectorAll('.close-btn').forEach(button => {
    button.addEventListener('click', async () => {
        if (!confirm('¿Deseas cerrar esta sesión remota?')) return;

        button.disabled = true;

        try {
            const data = await postForm('@Url.Action("CerrarSesionRemota", "Account")', {
                tokenId: button.dataset.token
            });

            if (!data.success) {
                showNotice(data.message || 'No se pudo cerrar la sesión.', false);
                button.disabled = false;
                return;
            }

            showNotice(data.message || 'Sesión cerrada correctamente.', true);
            setTimeout(() => location.reload(), 650);
        } catch {
            showNotice('No se pudo comunicar con el servidor.', false);
            button.disabled = false;
        }
    });
});

document.getElementById('btnCerrarTodas')?.addEventListener('click', async function () {
    if (!confirm('¿Deseas cerrar todas las sesiones remotas activas?')) return;

    this.disabled = true;

    try {
        const data = await postForm('@Url.Action("CerrarTodasSesionesRemotas", "Account")');

        if (!data.success) {
            showNotice(data.message || 'No se pudieron cerrar las sesiones.', false);
            this.disabled = false;
            return;
        }

        showNotice(data.message || 'Sesiones remotas cerradas.', true);
        setTimeout(() => location.reload(), 650);
    } catch {
        showNotice('No se pudo comunicar con el servidor.', false);
        this.disabled = false;
    }
});
</script>

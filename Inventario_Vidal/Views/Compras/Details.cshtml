@model Inventario_Vidal.Models.Compra

@{
    ViewData["Title"] = "Detalles de Compra";
}

<div class="container-fluid mt-4">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-info text-white">
            <div class="d-flex justify-content-between align-items-center">
                <h4 class="mb-0"><i class="bi bi-receipt"></i> Compra #@Model.IdCompra</h4>
                <span class="badge bg-light text-dark fs-6">@Model.Estado</span>
            </div>
        </div>
        <div class="card-body p-4">

            <div class="row mb-4">
                <div class="col-md-6">
                    <h6 class="text-muted mb-3"><i class="bi bi-truck"></i> Proveedor</h6>
                    <dl class="row">
                        <dt class="col-sm-4 fw-semibold">RUC</dt>
                        <dd class="col-sm-8">@Model.IdProveedorNavigation?.Ruc</dd>

                        <dt class="col-sm-4 fw-semibold">Razón Social</dt>
                        <dd class="col-sm-8">@Model.IdProveedorNavigation?.RazonSocial</dd>
                    </dl>
                </div>
                <div class="col-md-6">
                    <h6 class="text-muted mb-3"><i class="bi bi-file-earmark-text"></i> Comprobante</h6>
                    <dl class="row">
                        <dt class="col-sm-4 fw-semibold">Tipo</dt>
                        <dd class="col-sm-8">@Model.TipoComprobante</dd>

                        <dt class="col-sm-4 fw-semibold">Número</dt>
                        <dd class="col-sm-8">@Model.NumeroComprobante</dd>

                        <dt class="col-sm-4 fw-semibold">Fecha</dt>
                        <dd class="col-sm-8">@Model.FechaCompra.ToString("dd/MM/yyyy HH:mm")</dd>
                    </dl>
                </div>
            </div>

            <hr />

            <h6 class="text-muted mb-3"><i class="bi bi-box-seam"></i> Materiales Comprados</h6>

            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Material</th>
                            <th>Presentación</th>
                            <th class="text-end">Cantidad</th>
                            <th class="text-end">Costo Unit.</th>
                            <th class="text-end">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var detalle in Model.DetalleCompras)
                        {
                            <tr>
                                <td>
                                    <strong>@detalle.IdMaterialNavigation?.Nombre</strong><br />
                                    <small class="text-muted">@detalle.IdMaterialNavigation?.CodigoBarras</small>
                                </td>
                                <td>@(detalle.IdPresentacionNavigation?.Nombre ?? "Unidad base")</td>
                                <td class="text-end">@detalle.Cantidad.ToString("N2")</td>
                                <td class="text-end">@Model.Moneda @detalle.CostoUnitario.ToString("N2")</td>
                                <td class="text-end fw-bold">@Model.Moneda @((detalle.Cantidad * detalle.CostoUnitario).ToString("N2"))</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="4" class="text-end fw-semibold">Subtotal:</td>
                            <td class="text-end">@Model.Moneda @Model.Subtotal.ToString("N2")</td>
                        </tr>
                        <tr>
                            <td colspan="4" class="text-end fw-semibold">IGV:</td>
                            <td class="text-end">@Model.Moneda @Model.Igv.ToString("N2")</td>
                        </tr>
                        <tr class="table-primary">
                            <td colspan="4" class="text-end fw-bold">TOTAL:</td>
                            <td class="text-end fw-bold">@Model.Moneda @Model.Total.ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <hr />

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Volver
                </a>
                @if (Model.Estado != "Anulada")
                {
                    <a asp-action="Delete" asp-route-id="@Model.IdCompra" class="btn btn-danger">
                        <i class="bi bi-x-circle"></i> Anular Compra
                    </a>
                }
            </div>
        </div>
    </div>
</div>
@using Inventario_Vidal.DTOs
@model IEnumerable<TipoCambioDto>
@{
    ViewData["Title"] = "Tipos de Cambio";
    ViewBag.Subtitle = "Consulta del tipo de cambio actual e historial registrado";
    var registros = Model?.ToList() ?? new List<TipoCambioDto>();
    var ultimo = ViewBag.Ultimo as TipoCambioDto;
    decimal? tipoCambioActual = ViewBag.TipoCambioActual != null ? Convert.ToDecimal(ViewBag.TipoCambioActual) : null;
    DateOnly? fechaActual = ViewBag.FechaTipoCambioActual is DateOnly fecha ? fecha : null;
    bool vieneDeCache = ViewBag.VieneDeCache == true;
    bool vieneDeFallback = ViewBag.VieneDeFallback == true;
    DateTime? desde = ViewBag.Desde as DateTime?;
    DateTime? hasta = ViewBag.Hasta as DateTime?;
    string origenActual = vieneDeFallback ? "Último valor disponible" : vieneDeCache ? "Registrado hoy" : "Actualizado automáticamente";
    var registrosActuales = registros.Count(r => fechaActual.HasValue && r.Fecha == fechaActual.Value &&
        string.Equals(r.MonedaOrigen, "USD", StringComparison.OrdinalIgnoreCase) &&
        string.Equals(r.MonedaDestino, "PEN", StringComparison.OrdinalIgnoreCase));
}
<div class="audit-page exchange-audit-page">
    <section class="audit-hero">
        <div class="hero-main">
            <div class="hero-icon"><svg class="icon icon-xl"><use href="#icon-exchange"></use></svg></div>
            <div><div class="hero-eyebrow">CONFIGURACIÓN FINANCIERA</div><h1>Tipos de Cambio</h1><p>Consulta el valor USD/PEN utilizado por el sistema y su historial diario.</p></div>
        </div>
        <div class="hero-actions">
            <a asp-controller="Empresa" asp-action="Index" class="hero-btn outline"><svg class="icon icon-sm"><use href="#icon-arrow-left"></use></svg>Configuración</a>
            <a asp-action="Crear" class="hero-btn light"><svg class="icon icon-sm"><use href="#icon-plus"></use></svg>Registro manual</a>
        </div>
    </section>

    <section class="metrics-grid">
        <article class="metric-card"><div class="metric-icon blue"><svg class="icon"><use href="#icon-exchange"></use></svg></div><div><span>USD / PEN vigente</span><strong>@(tipoCambioActual.HasValue ? tipoCambioActual.Value.ToString("0.0000") : "—")</strong><small>@(fechaActual.HasValue ? fechaActual.Value.ToString("dd/MM/yyyy") : "Fecha no disponible")</small></div></article>
        <article class="metric-card"><div class="metric-icon green"><svg class="icon"><use href="#icon-database"></use></svg></div><div><span>Registros mostrados</span><strong>@registros.Count</strong><small>Historial del filtro actual</small></div></article>
        <article class="metric-card"><div class="metric-icon gold"><svg class="icon"><use href="#icon-calendar"></use></svg></div><div><span>Último registro</span><strong class="exchange-date-metric">@(ultimo != null ? ultimo.Fecha.ToString("dd/MM/yyyy") : "—")</strong><small>Fecha más reciente en BD</small></div></article>
        <article class="metric-card"><div class="metric-icon purple"><svg class="icon"><use href="#icon-dollar"></use></svg></div><div><span>Último valor BD</span><strong>@(ultimo != null ? ultimo.Valor.ToString("0.0000") : "—")</strong><small>USD / PEN registrado</small></div></article>
    </section>
    <section class="exchange-note" aria-label="Información sobre actualización automática">
        <div class="section-icon"><svg class="icon"><use href="#icon-info"></use></svg></div>
        <div><strong>Actualización automática diaria</strong><p>El sistema utiliza el tipo de cambio registrado para el día. Cuando no existe un valor diario, consulta la API configurada y lo guarda para reutilizarlo.</p><small>Origen del valor vigente: @origenActual</small></div>
        <span class="action-badge activate"><svg class="icon icon-sm"><use href="#icon-check-circle"></use></svg>Automático</span>
    </section>
    <section class="filter-card">
        <div class="filter-header"><div class="filter-title"><div class="section-icon"><svg class="icon"><use href="#icon-search"></use></svg></div><div><span>CONSULTA</span><h2>Filtros de tipo de cambio</h2><p>Consulta los valores registrados dentro de un rango de fechas.</p></div></div><button type="button" class="filter-toggle" id="btnToggleFilters"><svg class="icon icon-sm"><use href="#icon-search"></use></svg>Filtros</button></div>
        <form asp-action="Index" method="get" id="filterForm" class="filter-body exchange-filter-body">
            <div class="filter-field"><label for="desde">Desde</label><input id="desde" name="desde" type="date" value="@(desde?.ToString("yyyy-MM-dd"))" class="audit-control" /></div>
            <div class="filter-field"><label for="hasta">Hasta</label><input id="hasta" name="hasta" type="date" value="@(hasta?.ToString("yyyy-MM-dd"))" class="audit-control" /></div>
            <div class="filter-field"><label for="pageSize">Registros por página</label><select id="pageSize" class="audit-control"><option value="15">15</option><option value="30" selected>30</option><option value="50">50</option><option value="100">100</option></select></div>
            <div class="filter-actions"><a asp-action="Index" class="btn-secondary">Limpiar</a><button type="submit" class="btn-primary"><svg class="icon icon-sm"><use href="#icon-search"></use></svg>Aplicar filtros</button></div>
        </form>
    </section>
    <section class="audit-card">
        <div class="audit-card-header"><div class="card-heading"><div class="section-icon"><svg class="icon"><use href="#icon-history"></use></svg></div><div><span>HISTORIAL</span><h2>Tipos de cambio registrados</h2><p>Los valores históricos se conservan sin edición ni eliminación.</p></div></div><div class="table-tools"><div class="local-search"><svg class="icon icon-sm"><use href="#icon-search"></use></svg><input type="search" id="localSearch" placeholder="Buscar en esta página..." autocomplete="off" aria-label="Buscar registros" /><button type="button" id="btnClearLocal" style="display:none" aria-label="Limpiar búsqueda"><svg class="icon icon-sm"><use href="#icon-x"></use></svg></button></div><button type="button" class="btn-secondary" id="btnRefresh"><svg class="icon icon-sm"><use href="#icon-refresh"></use></svg>Actualizar</button></div></div>
        @if (registros.Any())
        {
            <div class="table-wrap">
                <table class="audit-table" id="auditTable">
                    <thead><tr><th>Registro</th><th>Fecha</th><th>Par de monedas</th><th class="text-end">Valor</th><th>Registrado por</th><th>Fecha de registro</th><th class="text-center">Estado</th></tr></thead>
                    <tbody>
                        @foreach (var item in registros)
                        {
                            var esActual = fechaActual.HasValue && item.Fecha == fechaActual.Value && string.Equals(item.MonedaOrigen, "USD", StringComparison.OrdinalIgnoreCase) && string.Equals(item.MonedaDestino, "PEN", StringComparison.OrdinalIgnoreCase);
                            <tr><td><span class="record-id">#@item.IdTipoCambio</span></td><td><div class="date-cell"><strong>@item.Fecha.ToString("dd/MM/yyyy")</strong></div></td><td><span class="table-badge"><svg class="icon icon-sm"><use href="#icon-exchange"></use></svg>@item.MonedaOrigen / @item.MonedaDestino</span></td><td class="text-end"><strong class="exchange-value">@item.Valor.ToString("0.0000")</strong></td><td><div class="user-cell"><div class="user-avatar"><svg class="icon icon-sm"><use href="#icon-user"></use></svg></div><div><strong>@(string.IsNullOrWhiteSpace(item.UsuarioNombre) ? "Sistema" : item.UsuarioNombre)</strong><span>Origen del registro</span></div></div></td><td><div class="date-cell"><strong>@item.FechaRegistro.ToString("dd/MM/yyyy")</strong><span>@item.FechaRegistro.ToString("HH:mm")</span></div></td><td class="text-center"><span class="action-badge @(esActual ? "activate" : "other")"><svg class="icon icon-sm"><use href="@(esActual ? "#icon-check-circle" : "#icon-history")"></use></svg>@(esActual ? "Actual" : "Histórico")</span></td></tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="empty-state" id="noLocalResults" style="display:none"><div class="empty-icon"><svg class="icon icon-xl"><use href="#icon-search"></use></svg></div><h3>No se encontraron coincidencias</h3><p>La búsqueda se aplica a los registros cargados en esta página.</p><button type="button" id="btnResetLocal" class="btn-secondary">Limpiar búsqueda</button></div>
            <div class="pagination-bar"><div class="pagination-info"><span>Mostrando</span><strong id="visibleCount">0</strong><span>de @registros.Count registros · Página <strong id="currentPageText">1</strong></span></div><div class="pagination-actions"><button type="button" id="btnPrev" class="page-button"><svg class="icon icon-sm"><use href="#icon-arrow-left"></use></svg>Anterior</button><span class="page-current" id="currentPage">1</span><button type="button" id="btnNext" class="page-button">Siguiente<svg class="icon icon-sm"><use href="#icon-arrow-right"></use></svg></button></div></div>
        }
        else
        {
            <div class="empty-state"><div class="empty-icon"><svg class="icon icon-xl"><use href="#icon-exchange"></use></svg></div><h3>No hay registros para mostrar</h3><p>No se encontraron tipos de cambio para el rango seleccionado.</p><a asp-action="Index" class="btn-secondary">Restablecer filtros</a></div>
        }
    </section>
    <section class="exchange-note manual-note"><div class="section-icon"><svg class="icon"><use href="#icon-lock"></use></svg></div><div><strong>Registro manual excepcional</strong><p>La consulta habitual es automática. El registro manual permite incorporar valores históricos o excepcionales que todavía no existan.</p></div><a asp-action="Crear" class="btn-secondary"><svg class="icon icon-sm"><use href="#icon-plus"></use></svg>Registrar manualmente</a></section>
</div>
@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const table = document.getElementById('auditTable'), search = document.getElementById('localSearch'), size = document.getElementById('pageSize'), clear = document.getElementById('btnClearLocal'), empty = document.getElementById('noLocalResults');
            const rows = table ? Array.from(table.querySelectorAll('tbody tr')) : [];
            let page = 1;
            function render() {
                const query = (search?.value || '').trim().toLocaleLowerCase(); const matches = rows.filter(r => r.textContent.toLocaleLowerCase().includes(query)); const per = Math.max(1, Number(size?.value) || 30); const totalPages = Math.max(1, Math.ceil(matches.length / per)); page = Math.min(Math.max(1, page), totalPages);
                rows.forEach(r => r.style.display = 'none'); matches.slice((page - 1) * per, page * per).forEach(r => r.style.display = '');
                const count = document.getElementById('visibleCount'); if (count) count.textContent = String(matches.slice((page - 1) * per, page * per).length);
                const pg = document.getElementById('currentPage'), txt = document.getElementById('currentPageText'); if (pg) pg.textContent = String(page); if (txt) txt.textContent = String(page);
                const prev = document.getElementById('btnPrev'), next = document.getElementById('btnNext'); if (prev) { prev.disabled = page === 1; prev.classList.toggle('disabled', page === 1) } if (next) { next.disabled = page >= totalPages; next.classList.toggle('disabled', page >= totalPages) }
                if (empty) empty.style.display = matches.length === 0 ? 'flex' : 'none'; if (clear) clear.style.display = query ? 'inline-flex' : 'none';
            }
            search?.addEventListener('input', () => { page = 1; render() }); size?.addEventListener('change', () => { page = 1; render() });
            function resetSearch() { if (search) { search.value = ''; page = 1; render(); search.focus() } }
            clear?.addEventListener('click', resetSearch); document.getElementById('btnResetLocal')?.addEventListener('click', resetSearch);
            document.getElementById('btnPrev')?.addEventListener('click', () => { page--; render() }); document.getElementById('btnNext')?.addEventListener('click', () => { page++; render() });
            document.getElementById('btnRefresh')?.addEventListener('click', () => window.location.reload());
            document.getElementById('btnToggleFilters')?.addEventListener('click', () => document.getElementById('filterForm')?.classList.toggle('mobile-open'));
            const desde = document.getElementById('desde'), hasta = document.getElementById('hasta'); function checkDates() { if (desde && hasta) { hasta.min = desde.value || ''; if (desde.value && hasta.value && hasta.value < desde.value) hasta.value = desde.value } } desde?.addEventListener('change', checkDates); hasta?.addEventListener('change', checkDates); checkDates();
            document.querySelectorAll('.alert-close').forEach(b => b.addEventListener('click', () => b.closest('.audit-alert')?.remove()));
            render();
        });
    </script>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {

            var estadoLabels = @Html.Raw(Json.Serialize(Model.ProyectosPorEstado.Select(p => p.Estado)));
            var estadoData = @Html.Raw(Json.Serialize(Model.ProyectosPorEstado.Select(p => p.Cantidad)));
            var estadoColors = @Html.Raw(Json.Serialize(Model.ProyectosPorEstado.Select(p => p.Color)));

            if (estadoLabels.length > 0) {
                var ctx1 = document.getElementById('estadosChart');
                if (ctx1) {
                    new Chart(ctx1, {
                        type: 'bar',
                        data: {
                            labels: estadoLabels,
                            datasets: [{
                                label: 'Cantidad de Proyectos',
                                data: estadoData,
                                backgroundColor: estadoColors.map(function(c) {
                                    var colors = {
                                        'primary': 'rgba(13, 110, 253, 0.8)',
                                        'success': 'rgba(25, 135, 84, 0.8)',
                                        'warning': 'rgba(255, 193, 7, 0.8)',
                                        'danger': 'rgba(220, 53, 69, 0.8)',
                                        'secondary': 'rgba(108, 117, 125, 0.8)',
                                        'info': 'rgba(13, 202, 240, 0.8)'
                                    };
                                    return colors[c] || 'rgba(108, 117, 125, 0.8)';
                                }),
                                borderColor: estadoColors.map(function(c) {
                                    var colors = {
                                        'primary': 'rgba(13, 110, 253, 1)',
                                        'success': 'rgba(25, 135, 84, 1)',
                                        'warning': 'rgba(255, 193, 7, 1)',
                                        'danger': 'rgba(220, 53, 69, 1)',
                                        'secondary': 'rgba(108, 117, 125, 1)',
                                        'info': 'rgba(13, 202, 240, 1)'
                                    };
                                    return colors[c] || 'rgba(108, 117, 125, 1)';
                                }),
                                borderWidth: 2,
                                borderRadius: 9,
                                maxBarThickness: 46
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: {
                                    display: false
                                }
                            },
                            scales: {
                                y: {
                                    beginAtZero: true,
                                    ticks: {
                                        stepSize: 1,
                                        font: { size: 11 }
                                    },
                                    grid: {
                                        color: 'rgba(0,0,0,0.05)'
                                    }
                                },
                                x: {
                                    grid: {
                                        display: false
                                    },
                                    ticks: {
                                        font: { size: 11 }
                                    }
                                }
                            }
                        }
                    });
                }
            }

            var materialLabels = @Html.Raw(Json.Serialize(Model.MaterialesMasUsados.Select(m => m.Material)));
            var materialData = @Html.Raw(Json.Serialize(Model.MaterialesMasUsados.Select(m => m.Cantidad)));

            if (materialLabels.length > 0) {
                var ctx2 = document.getElementById('materialesChart');
                if (ctx2) {
                    new Chart(ctx2, {
                        type: 'doughnut',

                        data: {
                            labels: materialLabels.map(function(label, i) {
                                var cantidad = materialData[i];
                                return label + ' (' + cantidad.toFixed(1) + ')';
                            }),
                            datasets: [{
                                data: materialData,
                                backgroundColor: [
                                    '#17488e',
                                    '#3675bb',
                                    '#78a9df',
                                    '#9cbddd',
                                    '#c5d8ed'
                                ],
                                borderColor: '#ffffff',
                                borderWidth: 3
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: {
                                    position: 'bottom',
                                    labels: {
                                        font: { size: 11 },
                                        padding: 15,
                                        usePointStyle: true,
                                        pointStyle: 'circle'
                                    }
                                }
                            }
                        }
                    });
                }
            }

            var comprasData = @Html.Raw(Json.Serialize(Model.ComprasPorMes));
            var comprasLabels = comprasData.map(function(c) { return c.Mes; });
            var comprasValues = comprasData.map(function(c) { return c.Total; });

            if (comprasLabels.length > 0) {
                var ctx3 = document.getElementById('comprasChart');
                if (ctx3) {
                    new Chart(ctx3, {
                        type: 'line',
                        data: {
                            labels: comprasLabels,
                            datasets: [{
                                label: 'Total Compras',
                                data: comprasValues,
                                borderColor: '#17488e',
                                backgroundColor: 'rgba(23, 72, 142, 0.09)',
                                fill: true,
                                tension: 0.4,
                                pointBackgroundColor: '#17488e',
                                pointBorderColor: '#ffffff',
                                pointBorderWidth: 2,
                                pointRadius: 4,
                                pointHoverRadius: 7,
                                borderWidth: 3
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: {
                                    display: false
                                }
                            },
                            scales: {
                                y: {
                                    beginAtZero: true,
                                    ticks: {
                                        font: { size: 11 },
                                        callback: function(value) {
                                            return 'S/ ' + value.toLocaleString();
                                        }
                                    },
                                    grid: {
                                        color: 'rgba(0,0,0,0.05)'
                                    }
                                },
                                x: {
                                    grid: {
                                        display: false
                                    },
                                    ticks: {
                                        font: { size: 10 },
                                        maxTicksLimit: 12
                                    }
                                }
                            }
                        }
                    });
                }
            }

        });

        function generarPdfDashboard() {
            var btn = document.querySelector('.vidal-dashboard-hero-btn.light');
            if (!btn) return;
            var originalHtml = btn.innerHTML;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Generando...';
            btn.disabled = true;

            fetch('@Url.Action("ExportarDashboardPdf", "Home")')
                .then(function(response) {
                    if (!response.ok) throw new Error('Error al generar el PDF');
                    return response.blob();
                })
                .then(function(blob) {
                    var url = window.URL.createObjectURL(blob);
                    var a = document.createElement('a');
                    a.href = url;
                    a.download = 'Dashboard_' + new Date().toISOString().slice(0, 10) + '.pdf';
                    document.body.appendChild(a);
                    a.click();
                    window.URL.revokeObjectURL(url);
                    a.remove();
                })
                .catch(function(error) {
                    console.error('Error:', error);
                    alert('Error al generar el PDF. Intente nuevamente.');
                })
                .finally(function() {
                    btn.innerHTML = originalHtml;
                    btn.disabled = false;
                });
        }
    </script>
}


</style>@using Inventario_Vidal.DTOs
@model DashboardViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Dashboard";
    ViewBag.Subtitle = "Panel de control e inteligencia de negocios";
    var comprasBI = ViewBag.ResumenComprasBI as Inventario_Vidal.DTOs.ResumenComprasBiDto;
    var esPE = CultureInfo.GetCultureInfo("es-PE");
}

<div class="vidal-dashboard-page">
    <header class="vidal-dashboard-hero">
        <div class="vidal-dashboard-hero-main">
            <span class="vidal-dashboard-hero-icon"><svg class="icon icon-xl"><use href="#icon-grid"></use></svg></span>
            <div>
                <span class="vidal-dashboard-overline">CENTRO DE CONTROL · VIDAL E.I.R.L.</span><h1>Dashboard</h1>
                <p>Inventario, compras, proyectos y actividad operativa en un solo lugar.</p>
            </div>
        </div>
        <div class="vidal-dashboard-hero-actions">
            <span class="vidal-dashboard-updated"><svg class="icon icon-sm"><use href="#icon-clock"></use></svg> Actualizado @Model.FechaActualizacion.ToString("dd/MM/yyyy HH:mm")</span>
            <button type="button" class="vidal-dashboard-hero-btn outline" onclick="window.location.reload()"><svg class="icon icon-sm"><use href="#icon-refresh"></use></svg> Actualizar</button>
            <button type="button" class="vidal-dashboard-hero-btn light" onclick="generarPdfDashboard()"><svg class="icon icon-sm"><use href="#icon-file-pdf"></use></svg> Exportar reporte</button>
        </div>
    </header>

    @* Análisis BI: conclusiones derivadas de los datos reales ya cargados por HomeService. *@
    @{
        var proyectosEnSeguimiento = Model.ProyectosPorEstado
            .Where(p => p.Estado != null && (p.Estado.Contains("proceso", StringComparison.OrdinalIgnoreCase)
                || p.Estado.Contains("activo", StringComparison.OrdinalIgnoreCase)
                || p.Estado.Contains("progreso", StringComparison.OrdinalIgnoreCase)))
            .Sum(p => p.Cantidad);
        var materialLider = Model.MaterialesMasUsados
            .OrderByDescending(m => m.Cantidad)
            .FirstOrDefault();
        var requiereCambio = comprasBI != null && !comprasBI.TotalConsolidadoPEN.HasValue;
    }
    <section class="vd-bi-insights" aria-label="Hallazgos de inteligencia de negocios">
        <div class="vd-bi-insights-head">
            <div class="vd-bi-insights-title">
                <span class="vd-bi-insights-eyebrow">INTELIGENCIA DE NEGOCIOS</span>
                <h2>Hallazgos y prioridades</h2>
                <p>Indicadores interpretados a partir de los datos registrados, sin estimaciones.</p>
            </div>
            <span class="vd-bi-data-label">Datos del sistema · @Model.FechaActualizacion.ToString("dd/MM/yyyy HH:mm")</span>
        </div>
        <div class="vd-bi-insights-grid">
            <article class="vd-bi-insight @(Model.NumeroAlertasStock > 0 ? "vd-bi-attention" : "vd-bi-normal")">
                <div class="vd-bi-insight-top"><span>INVENTARIO</span><strong>@Model.NumeroAlertasStock</strong></div>
                <h3>@(Model.NumeroAlertasStock > 0 ? "Materiales que requieren revisión" : "Sin alertas de stock bajo")</h3>
                <p>@(Model.NumeroAlertasStock > 0 ? "Hay materiales con existencias por debajo del mínimo configurado. Revisa el detalle antes de planificar nuevas entregas." : "No hay alertas de stock bajo reportadas en la consulta actual.")</p>
                <a asp-controller="Materiales" asp-action="Index">Revisar materiales <span aria-hidden="true">→</span></a>
            </article>
            <article class="vd-bi-insight">
                <div class="vd-bi-insight-top"><span>PROYECTOS EN ACTIVIDAD</span><strong>@proyectosEnSeguimiento</strong></div>
                <h3>Proyectos en seguimiento</h3>
                <p>Conteo de los estados activos o en proceso devueltos por el sistema. Consulta el avance y las asignaciones para identificar necesidades operativas.</p>
                <a asp-controller="Proyectos" asp-action="Index">Revisar proyectos <span aria-hidden="true">→</span></a>
            </article>
            <article class="vd-bi-insight">
                <div class="vd-bi-insight-top"><span>CONSUMO DE MATERIALES</span><strong>@(materialLider == null ? "—" : materialLider.Cantidad.ToString("N2", esPE))</strong></div>
                <h3>@(materialLider?.Material ?? "Sin consumo registrado")</h3>
                <p>@(materialLider == null ? "Todavía no hay información suficiente para identificar el material más utilizado." : "Material con mayor cantidad registrada en el análisis de consumo de los últimos 30 días. Unidad: " + materialLider.Unidad + ".")</p>
                <a asp-controller="Materiales" asp-action="Index">Consultar inventario <span aria-hidden="true">→</span></a>
            </article>
            <article class="vd-bi-insight @(requiereCambio ? "vd-bi-attention" : "vd-bi-normal")">
                <div class="vd-bi-insight-top"><span>CONSISTENCIA FINANCIERA</span><strong>@(comprasBI == null ? "—" : comprasBI.CantidadComprobantes.ToString("N0"))</strong></div>
                <h3>@(comprasBI == null ? "Resumen de compras no disponible" : requiereCambio ? "Consolidado pendiente de validar" : "Consolidado en soles disponible")</h3>
                <p>@(comprasBI == null ? "No se pudo consultar el resumen financiero." : requiereCambio ? "Faltan tipos de cambio o existen monedas sin identificar. No se mostrará una conversión incompleta como total definitivo." : "Los importes del período se consolidaron en soles utilizando los tipos de cambio históricos registrados.")</p>
                <a asp-controller="Compras" asp-action="Index">Revisar compras <span aria-hidden="true">→</span></a>
            </article>
        </div>
    </section>

    <div id="vd-resumen" class="vidal-dashboard-section-title"><div><span>INDICADORES CLAVE</span><h2>Panorama general</h2><p>Información consolidada de los módulos operativos.</p></div><a asp-controller="Materiales" asp-action="Index" class="vidal-dashboard-textlink">Ver inventario <svg class="icon icon-sm"><use href="#icon-arrow-right"></use></svg></a></div>
    <div class="row g-3 mb-4">

        <div class="col-xl-3 col-lg-6 col-md-6">
            <div class="kpi-card kpi-primary">
                <div class="kpi-icon">
                    <svg class="icon icon-lg"><use href="#icon-box"></use></svg>
                </div>
                <div class="kpi-content">
                    <span class="kpi-value">@Model.TotalMateriales.ToString("N0")</span>
                    <span class="kpi-label">Materiales</span>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-lg-6 col-md-6">
            <div class="kpi-card kpi-success">
                <div class="kpi-icon">
                    <svg class="icon icon-lg"><use href="#icon-folder"></use></svg>
                </div>
                <div class="kpi-content">
                    <span class="kpi-value">@Model.TotalProyectos.ToString("N0")</span>
                    <span class="kpi-label">Proyectos</span>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-lg-6 col-md-6">
            <div class="kpi-card kpi-warning">
                <div class="kpi-icon">
                    <svg class="icon icon-lg"><use href="#icon-truck"></use></svg>
                </div>
                <div class="kpi-content">
                    <span class="kpi-value">@Model.TotalProveedores.ToString("N0")</span>
                    <span class="kpi-label">Proveedores</span>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-lg-6 col-md-6">
            <div class="kpi-card kpi-danger">
                <div class="kpi-icon">
                    <svg class="icon icon-lg"><use href="#icon-users"></use></svg>
                </div>
                <div class="kpi-content">
                    <span class="kpi-value">@Model.TotalClientes.ToString("N0")</span>
                    <span class="kpi-label">Clientes</span>
                </div>
            </div>
        </div>

    </div>

    <div class="row g-3 mb-4">

        <div class="col-xl-3 col-lg-6 col-md-6">
            <div class="kpi-card kpi-info">
                <div class="kpi-icon">
                    <svg class="icon icon-lg"><use href="#icon-hardhat"></use></svg>
                </div>
                <div class="kpi-content">
                    <span class="kpi-value">@Model.TotalContratistas.ToString("N0")</span>
                    <span class="kpi-label">Contratistas</span>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-lg-6 col-md-6">
            <div class="kpi-card kpi-secondary">
                <div class="kpi-icon">
                    <svg class="icon icon-lg"><use href="#icon-user"></use></svg>
                </div>
                <div class="kpi-content">
                    <span class="kpi-value">@Model.TotalEmpleados.ToString("N0")</span>
                    <span class="kpi-label">Empleados</span>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-lg-6 col-md-6">
            <div class="kpi-card kpi-dark">
                <div class="kpi-icon">
                    <svg class="icon icon-lg"><use href="#icon-tools"></use></svg>
                </div>
                <div class="kpi-content">
                    <span class="kpi-value">@Model.TotalMaquinarias.ToString("N0")</span>
                    <span class="kpi-label">Maquinarias</span>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-lg-6 col-md-6">
            <div class="kpi-card kpi-purple">
                <div class="kpi-icon">
                    <svg class="icon icon-lg"><use href="#icon-dollar"></use></svg>
                </div>
                <div class="kpi-content">
                    <span class="kpi-value">@((comprasBI == null || !comprasBI.TotalConsolidadoPEN.HasValue) ? "—" : "S/ " + comprasBI.TotalConsolidadoPEN.Value.ToString("N2", esPE))</span>
                    <span class="kpi-label">Compras consolidadas del período (PEN)</span>
                </div>
            </div>
        </div>

    </div>

    <section id="vd-finanzas" class="vidal-dashboard-section-title"><div><span>GESTIÓN DE COMPRAS</span><h2>Resumen financiero</h2><p>Importes, moneda y equivalencias calculadas desde los registros de VIDAL.</p></div><a asp-controller="Compras" asp-action="Index" class="vidal-dashboard-textlink">Ir a Compras <svg class="icon icon-sm"><use href="#icon-arrow-right"></use></svg></a></section>
    <section id="vidal-bi-compras" class="vidal-bi-compras vidal-dashboard-finance">
        <div class="vidal-bi-heading">
            <div class="vidal-bi-heading-title">
                <span class="vidal-bi-eyebrow">CONTROL FINANCIERO</span>
                <h2>Compras y conversión monetaria</h2>
                <p>Soles y dólares separados, con consolidación en PEN según el tipo de cambio de cada operación.</p>
            </div>
        </div>
        <form method="get" asp-controller="Home" asp-action="Index" class="vidal-bi-filter" aria-label="Filtrar compras por fechas">
            <label>Desde <input type="date" name="desde" value="@(comprasBI?.Desde.ToString("yyyy-MM-dd"))" required /></label>
            <label>Hasta <input type="date" name="hasta" value="@(comprasBI?.Hasta.ToString("yyyy-MM-dd"))" required /></label>
            <button type="submit">Aplicar filtros</button>
        </form>
        @if (comprasBI != null)
        {
            <div class="vidal-bi-metrics">
                <article><span>Total compras en soles</span><strong>S/ @comprasBI.TotalPEN.ToString("N2", esPE)</strong><small>Importe original PEN</small></article>
                <article><span>Total compras en dólares</span><strong>US$ @comprasBI.TotalUSD.ToString("N2", esPE)</strong><small>Importe original USD</small></article>
                <article class="vidal-bi-total">
                    <span>Total consolidado en soles</span>
                    <strong>@(comprasBI.TotalConsolidadoPEN.HasValue ? "S/ " + comprasBI.TotalConsolidadoPEN.Value.ToString("N2", esPE) : "No disponible")</strong>
                    <small>@comprasBI.CantidadComprobantes comprobantes en el período</small>
                </article>
            </div>
            @if (!comprasBI.TotalConsolidadoPEN.HasValue)
            {
                <div class="vidal-bi-warning" role="alert">
                    <strong>Consolidado pendiente:</strong> faltan tipos de cambio históricos para @comprasBI.ComprobantesSinTipoCambio compras en USD
                    @if (comprasBI.FechasSinTipoCambio.Any())
                    {
                        <span>(fechas: @string.Join(", ", comprasBI.FechasSinTipoCambio))</span>
                    }
                    @if (comprasBI.MonedasNoReconocidas > 0)
                    {
                        <span>; @comprasBI.MonedasNoReconocidas compras tienen moneda no reconocida</span>
                    }
                    . Registra los datos correctos en Tipos de cambio y vuelve a consultar.
                </div>
            }
            <p class="vidal-bi-method">Conversión: cada compra USD × tipo de cambio USD/PEN almacenado en Configuración.TiposCambio para su fecha de compra. No se emplea el tipo de cambio actual. Compras anuladas excluidas.</p>
        }
        else
        {
            <div class="vidal-bi-warning">@((string?)ViewBag.ErrorComprasBI ?? "No hay datos de compras disponibles.")</div>
        }
    </section>
    <div id="vd-analisis" class="vidal-dashboard-section-title"><div><span>ANÁLISIS OPERATIVO</span><h2>Indicadores y tendencias</h2><p>Comportamiento de proyectos, materiales y movimientos.</p></div></div>
    <div class="row g-3 mb-4">

        <div class="col-xl-6">
            <div class="card-modern">
                <div class="card-header">
                    <svg class="icon"><use href="#icon-chart-bar"></use></svg>
                    Proyectos por Estado
                    <span class="badge bg-secondary ms-2">@Model.ProyectosPorEstado.Sum(p => p.Cantidad) total</span>
                </div>
                <div class="card-body">
                    <canvas id="estadosChart" height="250"></canvas>
                </div>
            </div>
        </div>

        <div class="col-xl-6">
            <div class="card-modern">
                <div class="card-header">
                    <svg class="icon"><use href="#icon-chart-pie"></use></svg>
                    Materiales más Utilizados
                    <span class="badge bg-secondary ms-2">Últimos 30 días</span>
                </div>
                <div class="card-body">
                    <canvas id="materialesChart" height="250"></canvas>
                </div>
            </div>
        </div>

    </div>

    <div class="row g-3 mb-4">

        <div class="col-xl-8">
            <div class="card-modern">
                <div class="card-header">
                    <svg class="icon"><use href="#icon-chart-line"></use></svg>
                    Compras por Mes
                    <span class="badge bg-secondary ms-2">Últimos 12 meses</span>
                </div>
                <div class="card-body">
                    <canvas id="comprasChart" height="200"></canvas>
                </div>
            </div>
        </div>

        <div class="col-xl-4">
            <div class="card-modern">
                <div class="card-header">
                    <svg class="icon"><use href="#icon-clock"></use></svg>
                    Resumen Rápido
                </div>
                <div class="card-body">
                    <div class="quick-stats">
                        <div class="quick-stat">
                            <span class="quick-stat-value">@Model.ProyectosActivos</span>
                            <span class="quick-stat-label">Proyectos Activos</span>
                        </div>
                        <div class="quick-stat">
                            <span class="quick-stat-value">@Model.ProyectosCompletados</span>
                            <span class="quick-stat-label">Proyectos Completados</span>
                        </div>
                        <div class="quick-stat">
                            <span class="quick-stat-value">@Model.NumeroAlertasStock</span>
                            <span class="quick-stat-label">Alertas de Stock</span>
                        </div>
                        <div class="quick-stat">
                            <span class="quick-stat-value">@Model.TotalUsuarios</span>
                            <span class="quick-stat-label">Usuarios Activos</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    @if (Model.AlertasStockBajo.Any())
    {
        <div class="card-modern mb-4">
            <div class="card-header">
                <svg class="icon"><use href="#icon-alert-triangle"></use></svg>
                Alertas de Stock Bajo
                <span class="badge bg-danger ms-2">@Model.NumeroAlertasStock alertas</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table-modern table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Material</th>
                                <th>Categoría</th>
                                <th>Stock Actual</th>
                                <th>Stock Mínimo</th>
                                <th>Nivel</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.AlertasStockBajo.Take(8))
                            {
                                <tr>
                                    <td><code>@item.CodigoBarras</code></td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            @if (!string.IsNullOrEmpty(item.ImagenUrl))
                                            {
                                                <img src="@item.ImagenUrl" alt="@item.Nombre" style="width: 32px; height: 32px; object-fit: cover; border-radius: 6px;" />
                                            }
                                            else
                                            {
                                                <div class="material-thumb">
                                                    <svg class="icon"><use href="#icon-box"></use></svg>
                                                </div>
                                            }
                                            <span>@item.Nombre</span>
                                        </div>
                                    </td>
                                    <td>@item.Categoria</td>
                                    <td>@item.StockActual.ToString("N2")</td>
                                    <td>@item.StockMinimo.ToString("N2")</td>
                                    <td>
                                        <div class="progress" style="width: 80px; height: 6px;">
                                            <div class="progress-bar @(item.PorcentajeAlerta > 50 ? "bg-danger" : "bg-warning")"
                                                 role="progressbar"
                                                 style="width: @item.PorcentajeAlerta%;"
                                                 aria-valuenow="@item.PorcentajeAlerta" aria-valuemin="0" aria-valuemax="100">
                                            </div>
                                        </div>
                                        <small class="text-muted ms-1">@item.PorcentajeAlerta%</small>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (Model.AlertasStockBajo.Count > 8)
                {
                    <div class="text-center py-2 border-top">
                        <a asp-controller="Alertas" asp-action="StockBajo" class="text-primary fw-semibold small">
                            Ver todas las alertas (@Model.AlertasStockBajo.Count)
                            <svg class="icon icon-sm"><use href="#icon-arrow-right"></use></svg>
                        </a>
                    </div>
                }
            </div>
        </div>
    }

    <div id="vd-actividad" class="vidal-dashboard-section-title"><div><span>OPERACIÓN DIARIA</span><h2>Actividad reciente</h2><p>Movimientos de inventario y últimos proyectos registrados.</p></div></div>
    <div class="row g-3">

        <div class="col-xl-6">
            <div class="card-modern">
                <div class="card-header">
                    <svg class="icon"><use href="#icon-history"></use></svg>
                    Últimos Movimientos de Inventario
                    <span class="badge bg-secondary ms-2">@Model.UltimosMovimientos.Count registros</span>
                </div>
                <div class="card-body p-0">
                    @if (Model.UltimosMovimientos.Any())
                    {
                        <div class="table-responsive">
                            <table class="table-modern table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Material</th>
                                        <th>Cantidad</th>
                                        <th>Tipo</th>
                                        <th>Usuario</th>
                                        <th>Fecha</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.UltimosMovimientos)
                                    {
                                        <tr>
                                            <td>
                                                <span class="fw-semibold">@item.Material</span>
                                                <small class="text-muted d-block">@item.CodigoBarras</small>
                                            </td>
                                            <td>@item.Cantidad.ToString("N2")</td>
                                            <td>
                                                <span class="badge bg-@item.TipoBadge">@item.TipoMovimiento</span>
                                            </td>
                                            <td>@item.Usuario</td>
                                            <td>
                                                <span class="small">@item.FechaFormateada</span>
                                                @if (!string.IsNullOrEmpty(item.Proyecto))
                                                {
                                                    <small class="text-muted d-block">Proyecto: @item.Proyecto</small>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="text-center py-2 border-top">
                            <a asp-controller="Kardex" asp-action="Index" class="text-primary fw-semibold small">
                                Ver todos los movimientos
                                <svg class="icon icon-sm"><use href="#icon-arrow-right"></use></svg>
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <svg class="icon icon-xl"><use href="#icon-history"></use></svg>
                            <p class="mt-2 small">No hay movimientos recientes</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-xl-6">
            <div class="card-modern">
                <div class="card-header">
                    <svg class="icon"><use href="#icon-folder"></use></svg>
                    Proyectos Recientes
                    <span class="badge bg-secondary ms-2">@Model.ProyectosRecientes.Count proyectos</span>
                </div>
                <div class="card-body p-0">
                    @if (Model.ProyectosRecientes.Any())
                    {
                        <div class="table-responsive">
                            <table class="table-modern table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Código</th>
                                        <th>Cliente</th>
                                        <th>Estado</th>
                                        <th>Inicio</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.ProyectosRecientes)
                                    {
                                        <tr>
                                            <td>
                                                <a asp-controller="Proyectos" asp-action="Detalles" asp-route-id="@item.IdProyecto" class="fw-semibold text-primary">
                                                    @item.CodigoProyecto
                                                </a>
                                            </td>
                                            <td>@item.Cliente</td>
                                            <td>
                                                <span class="badge bg-@item.EstadoBadge">@item.Estado</span>
                                            </td>
                                            <td>@item.FechaInicio.ToString("dd/MM/yyyy")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="text-center py-2 border-top">
                            <a asp-controller="Proyectos" asp-action="Index" class="text-primary fw-semibold small">
                                Ver todos los proyectos
                                <svg class="icon icon-sm"><use href="#icon-arrow-right"></use></svg>
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <svg class="icon icon-xl"><use href="#icon-folder"></use></svg>
                            <p class="mt-2 small">No hay proyectos recientes</p>
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>

    @if (Model.UsuariosActivos.Any())
    {
        <div class="card-modern mt-3">
            <div class="card-header">
                <svg class="icon"><use href="#icon-users"></use></svg>
                Usuarios en Línea
                <span class="badge bg-success ms-2">@Model.UsuariosActivos.Count conectados</span>
            </div>
            <div class="card-body">
                <div class="d-flex flex-wrap gap-3">
                    @foreach (var item in Model.UsuariosActivos)
                    {
                        <div class="user-online">
                            <div class="user-online-avatar">
                                @item.Iniciales
                                <span class="online-dot"></span>
                            </div>
                            <div class="user-online-info">
                                <span class="user-online-name">@item.NombreCompleto</span>

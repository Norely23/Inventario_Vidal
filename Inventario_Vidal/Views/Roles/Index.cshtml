@using Inventario_Vidal.DTOs
@model IEnumerable<RolListDto>
@{
    ViewData["Title"] = "Roles y permisos";
    ViewBag.Subtitle = "Administración de perfiles de acceso";
    var roles = Model?.ToList() ?? new List<RolListDto>();
    var totalRoles = roles.Count;
    var rolesActivos = roles.Count(r => r.Activo);
    var rolesInactivos = roles.Count(r => !r.Activo);
    var totalUsuarios = roles.Sum(r => r.CantidadUsuarios);
}
<div class="audit-page roles-audit-page">
    <section class="audit-hero">
        <div class="hero-main">
            <div class="hero-icon"><svg class="icon icon-xl"><use href="#icon-shield"></use></svg></div>
            <div><div class="hero-eyebrow">SEGURIDAD Y ACCESOS</div><h1>Roles y permisos</h1><p>Administra los perfiles de acceso y sus permisos en el sistema.</p></div>
        </div>
        <div class="hero-actions">
            <button type="button" class="hero-btn outline" id="btnActualizar"><svg class="icon icon-sm"><use href="#icon-refresh"></use></svg>Actualizar</button>
        </div>
    </section>
    @if (TempData["MensajeExito"] != null)
    {
        <div class="audit-alert success"><svg class="icon"><use href="#icon-check-circle"></use></svg><div><strong>Operación completada</strong><span>@TempData["MensajeExito"]</span></div><button type="button" class="alert-close" aria-label="Cerrar alerta"><svg class="icon icon-sm"><use href="#icon-x"></use></svg></button></div>
    }
    @if (TempData["MensajeError"] != null)
    {
        <div class="audit-alert danger"><svg class="icon"><use href="#icon-x-circle"></use></svg><div><strong>No se pudo completar la operación</strong><span>@TempData["MensajeError"]</span></div><button type="button" class="alert-close" aria-label="Cerrar alerta"><svg class="icon icon-sm"><use href="#icon-x"></use></svg></button></div>
    }
    <section class="metrics-grid">
        <article class="metric-card"><div class="metric-icon blue"><svg class="icon"><use href="#icon-shield"></use></svg></div><div><span>Total roles</span><strong>@totalRoles</strong><small>Perfiles registrados</small></div></article>
        <article class="metric-card"><div class="metric-icon green"><svg class="icon"><use href="#icon-check-circle"></use></svg></div><div><span>Activos</span><strong>@rolesActivos</strong><small>Disponibles para asignación</small></div></article>
        <article class="metric-card"><div class="metric-icon gold"><svg class="icon"><use href="#icon-x-circle"></use></svg></div><div><span>Inactivos</span><strong>@rolesInactivos</strong><small>Sin asignación activa</small></div></article>
        <article class="metric-card"><div class="metric-icon purple"><svg class="icon"><use href="#icon-users"></use></svg></div><div><span>Usuarios asignados</span><strong>@totalUsuarios</strong><small>Vínculos con perfiles</small></div></article>
    </section>
    <section class="filter-card">
        <div class="filter-header"><div class="filter-title"><div class="section-icon"><svg class="icon"><use href="#icon-search"></use></svg></div><div><span>CONSULTA</span><h2>Filtros de roles</h2><p>Busca por nombre, descripción o estado.</p></div></div><button type="button" class="filter-toggle" id="btnToggleFilters"><svg class="icon icon-sm"><use href="#icon-search"></use></svg>Filtros</button></div>
        <div id="filterForm" class="filter-body">
            <div class="filter-field"><label for="filtroNombre">Nombre o descripción</label><input type="search" id="filtroNombre" class="audit-control" placeholder="Buscar rol..." autocomplete="off" /></div>
            <div class="filter-field"><label for="filtroEstado">Estado</label><select id="filtroEstado" class="audit-control"><option value="">Todos los estados</option><option value="activo">Activos</option><option value="inactivo">Inactivos</option></select></div>
            <div class="filter-field"><label for="pageSize">Registros</label><select id="pageSize" class="audit-control"><option value="15">15</option><option value="30" selected>30</option><option value="50">50</option><option value="100">100</option></select></div>
            <div class="filter-actions"><button type="button" class="btn-secondary" id="btnLimpiar">Limpiar</button><button type="button" class="btn-primary" id="btnAplicar"><svg class="icon icon-sm"><use href="#icon-search"></use></svg>Aplicar filtros</button></div>
        </div>
    </section>
    <section class="audit-card">
        <div class="audit-card-header"><div class="card-heading"><div class="section-icon"><svg class="icon"><use href="#icon-list"></use></svg></div><div><span>DIRECTORIO</span><h2>Listado de roles</h2><p id="resultadosTexto">@totalRoles @(totalRoles == 1 ? "rol registrado" : "roles registrados")</p></div></div><div class="table-tools"><div class="local-search"><svg class="icon icon-sm"><use href="#icon-search"></use></svg><input type="search" id="localSearch" placeholder="Buscar en el listado..." autocomplete="off" /><button type="button" id="btnClearLocal" aria-label="Limpiar búsqueda" style="display:none;"><svg class="icon icon-sm"><use href="#icon-x"></use></svg></button></div></div></div>
        @if (roles.Any())
        {
            <div class="table-wrap">
                <table class="audit-table" id="rolesTable">
                    <thead><tr><th>Rol</th><th>Descripción</th><th class="text-center">Usuarios</th><th>Creado</th><th class="text-center">Estado</th><th class="text-center">Acciones</th></tr></thead>
                    <tbody>
                        @foreach (var item in roles)
                        {
                            <tr data-status="@(item.Activo ? "activo" : "inactivo")">
                                <td><div class="user-cell"><div class="user-avatar">@item.Iniciales</div><div><strong>@item.NombreRol</strong><span>ID #@item.IdRol</span></div></div></td>
                                <td><div class="role-description-cell"><strong>@(string.IsNullOrWhiteSpace(item.Descripcion) ? "Sin descripción" : item.Descripcion)</strong><span>Perfil de acceso</span></div></td>
                                <td class="text-center"><span class="table-badge"><svg class="icon icon-sm"><use href="#icon-users"></use></svg>@item.CantidadUsuarios</span></td>
                                <td><div class="date-cell"><strong>@item.FechaCreacion.ToString("dd/MM/yyyy")</strong><span>@item.FechaCreacion.ToString("HH:mm")</span></div></td>
                                <td class="text-center"><span class="action-badge @(item.Activo ? "activate" : "deactivate")"><svg class="icon icon-sm"><use href="#icon-@(item.Activo ? "check-circle" : "x-circle")"></use></svg>@item.EstadoTexto</span></td>
                                <td class="text-center">
                                    <div class="role-actions">
                                        <a asp-action="Detalles" asp-route-id="@item.IdRol" class="detail-button" title="Ver detalles" aria-label="Ver detalles de @item.NombreRol"><svg class="icon icon-sm"><use href="#icon-eye"></use></svg></a>
                                        <a asp-action="Editar" asp-route-id="@item.IdRol" class="role-action-edit" title="Editar rol" aria-label="Editar @item.NombreRol"><svg class="icon icon-sm"><use href="#icon-edit"></use></svg></a>
                                        <a asp-action="Permisos" asp-route-id="@item.IdRol" class="role-action-permissions" title="Configurar permisos" aria-label="Configurar permisos de @item.NombreRol"><svg class="icon icon-sm"><use href="#icon-key"></use></svg></a>
                                        <form asp-action="ToggleActivo" asp-route-id="@item.IdRol" method="post" class="toggle-form" data-name="@item.NombreRol" data-active="@item.Activo.ToString().ToLowerInvariant()">@Html.AntiForgeryToken()<button type="submit" class="role-action-toggle @(item.Activo ? "disable" : "enable")" title="@(item.Activo ? "Desactivar rol" : "Activar rol")" aria-label="@(item.Activo ? "Desactivar" : "Activar") @item.NombreRol"><svg class="icon icon-sm"><use href="#icon-@(item.Activo ? "x-circle" : "check-circle")"></use></svg></button></form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="empty-state" id="noLocalResults" style="display:none;"><div class="empty-icon"><svg class="icon icon-xl"><use href="#icon-search"></use></svg></div><h3>No se encontraron coincidencias</h3><p>Modifica los filtros o limpia la búsqueda para ver más roles.</p><button type="button" class="btn-secondary" id="btnResetLocal">Limpiar búsqueda</button></div>
            <div class="pagination-bar"><div class="pagination-info"><span>Mostrando</span><strong id="visibleCount">@totalRoles</strong><span>de @totalRoles roles · Página <strong id="pageInfo">1</strong></span></div><div class="pagination-actions"><button type="button" class="page-button" id="btnPrev"><svg class="icon icon-sm"><use href="#icon-arrow-left"></use></svg>Anterior</button><span class="page-current" id="pageCurrent">1</span><button type="button" class="page-button" id="btnNext">Siguiente<svg class="icon icon-sm"><use href="#icon-arrow-right"></use></svg></button></div></div>
        }
        else
        {
            <div class="empty-state"><div class="empty-icon"><svg class="icon icon-xl"><use href="#icon-shield"></use></svg></div><h3>No hay roles registrados</h3><p>Los roles oficiales se configuran desde la base de datos.</p></div>
        }
    </section>
</div>
@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const table = document.getElementById('rolesTable');
            const search = document.getElementById('localSearch');
            const name = document.getElementById('filtroNombre');
            const state = document.getElementById('filtroEstado');
            const pageSize = document.getElementById('pageSize');
            const all = table ? Array.from(table.querySelectorAll('tbody tr')) : [];
            let page = 1;
            function filter() {
                const terms = [search?.value || '', name?.value || ''].map(v => v.trim().toLocaleLowerCase());
                const estado = state?.value || '';
                const match = all.filter(row => terms.every(t => !t || row.textContent.toLocaleLowerCase().includes(t)) && (!estado || row.dataset.status === estado));
                const size = Math.max(1, Number(pageSize?.value) || 30);
                const pages = Math.max(1, Math.ceil(match.length / size));
                page = Math.min(Math.max(1, page), pages);
                const start = (page - 1) * size;
                all.forEach(r => r.style.display = 'none');
                match.slice(start, start + size).forEach(r => r.style.display = '');
                const noResults = document.getElementById('noLocalResults');
                if (noResults) noResults.style.display = match.length ? 'none' : 'flex';
                const clear = document.getElementById('btnClearLocal');
                if (clear) clear.style.display = search?.value ? 'inline-flex' : 'none';
                const visible = document.getElementById('visibleCount'); if (visible) visible.textContent = String(Math.min(size, Math.max(0, match.length - start)));
                const current = document.getElementById('pageCurrent'); if (current) current.textContent = String(page);
                const info = document.getElementById('pageInfo'); if (info) info.textContent = String(page);
                const result = document.getElementById('resultadosTexto'); if (result) result.textContent = match.length + (match.length === 1 ? ' rol encontrado' : ' roles encontrados');
                const prev = document.getElementById('btnPrev'); if (prev) prev.disabled = page <= 1;
                const next = document.getElementById('btnNext'); if (next) next.disabled = page >= pages;
            }
            [search, name].forEach(el => el?.addEventListener('input', () => { page = 1; filter(); }));
            [state, pageSize].forEach(el => el?.addEventListener('change', () => { page = 1; filter(); }));
            document.getElementById('btnAplicar')?.addEventListener('click', () => { page = 1; filter(); });
            function reset() { if (search) search.value = ''; if (name) name.value = ''; if (state) state.value = ''; if (pageSize) pageSize.value = '30'; page = 1; filter(); }
            document.getElementById('btnLimpiar')?.addEventListener('click', reset);
            document.getElementById('btnResetLocal')?.addEventListener('click', reset);
            document.getElementById('btnClearLocal')?.addEventListener('click', () => { if (search) search.value = ''; page = 1; filter(); search?.focus(); });
            document.getElementById('btnPrev')?.addEventListener('click', () => { if (page > 1) { page--; filter(); } });
            document.getElementById('btnNext')?.addEventListener('click', () => { page++; filter(); });
            document.getElementById('btnActualizar')?.addEventListener('click', () => location.reload());
            document.getElementById('btnToggleFilters')?.addEventListener('click', () => document.getElementById('filterForm')?.classList.toggle('mobile-open'));
            document.querySelectorAll('.toggle-form').forEach(form => form.addEventListener('submit', e => { const active = form.dataset.active === 'true'; const name = form.dataset.name || 'este rol'; if (!confirm((active ? '¿Desactivar' : '¿Activar') + ' el rol "' + name + '"?')) e.preventDefault(); }));
            document.querySelectorAll('.alert-close').forEach(btn => btn.addEventListener('click', () => btn.closest('.audit-alert')?.remove()));
            filter();
        });
    </script>
}
<style>

    /* ================================================================
               BASE
               ================================================================ */

    .audit-page {
        --navy: #102947;
        --blue: #17488e;
        --blue-light: #226cc2;
        --border: #dce3eb;
        --text: #344357;
        --muted: #7d8999;
        --success: #168957;
        --danger: #d1475b;
        --warning: #c58918;
    }

    /* ================================================================
               HERO
               ================================================================ */

    .audit-hero {
        min-height: 118px;
        padding: 23px 30px;
        margin-bottom: 17px;
        border-radius: 20px;
        background: linear-gradient( 100deg, #102947 0%, #17488e 49%, #226cc2 100%);
        color: white;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        position: relative;
        overflow: hidden;
    }

        .audit-hero::after {
            content: "";
            position: absolute;
            width: 290px;
            height: 290px;
            top: -145px;
            right: -85px;
            border-radius: 50%;
            background: rgba(255,255,255,.05);
        }

    .hero-main {
        display: flex;
        align-items: center;
        gap: 17px;
        position: relative;
        z-index: 1;
    }

    .hero-icon {
        width: 60px;
        height: 60px;
        border-radius: 14px;
        background: rgba(255,255,255,.11);
        border: 1px solid rgba(255,255,255,.13);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .hero-eyebrow {
        margin-bottom: 3px;
        color: rgba(255,255,255,.55);
        font-size: .53rem;
        font-weight: 800;
        letter-spacing: 1px;
    }

    .audit-hero h1 {
        margin: 0;
        font-size: 1.58rem;
        font-weight: 800;
    }

    .audit-hero p {
        margin: 5px 0 0;
        color: rgba(255,255,255,.72);
        font-size: .75rem;
    }

    .hero-actions {
        display: flex;
        gap: 8px;
        position: relative;
        z-index: 1;
    }

    .hero-btn {
        min-height: 41px;
        padding: 0 14px;
        border-radius: 9px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        text-decoration: none;
        font-size: .68rem;
        font-weight: 750;
        cursor: pointer;
    }

        .hero-btn.light {
            border: 1px solid white;
            background: white;
            color: var(--navy);
        }

        .hero-btn.outline {
            border: 1px solid rgba(255,255,255,.28);
            background: rgba(255,255,255,.05);
            color: white;
        }

        .hero-btn.light:hover {
            color: var(--navy);
            background: #f3f7fb;
        }

        .hero-btn.outline:hover {
            color: white;
            background: rgba(255,255,255,.12);
        }

    /* ================================================================
               ALERTAS
               ================================================================ */

    .audit-alert {
        margin-bottom: 15px;
        padding: 12px 14px;
        border-radius: 11px;
        display: flex;
        align-items: flex-start;
        gap: 10px;
        transition: opacity .35s ease, transform .35s ease;
    }

        .audit-alert.success {
            background: #edf9f3;
            color: #146f48;
            border-left: 4px solid var(--success);
        }

        .audit-alert.danger {
            background: #fff1f3;
            color: #a73547;
            border-left: 4px solid var(--danger);
        }

        .audit-alert > div {
            flex: 1;
        }

        .audit-alert strong,
        .audit-alert span {
            display: block;
        }

        .audit-alert strong {
            font-size: .7rem;
        }

        .audit-alert span {
            margin-top: 2px;
            font-size: .62rem;
        }

        .audit-alert.closing {
            opacity: 0;
            transform: translateY(-8px);
        }

    .alert-close {
        border: none;
        padding: 2px;
        background: transparent;
        color: currentColor;
        opacity: .65;
        cursor: pointer;
    }

    /* ================================================================
               METRICAS
               ================================================================ */

    .metrics-grid {
        margin-bottom: 17px;
        display: grid;
        grid-template-columns: repeat( 4, minmax(0,1fr));
        gap: 12px;
    }

    .metric-card {
        min-height: 86px;
        padding: 14px 16px;
        border: 1px solid var(--border);
        border-radius: 13px;
        background: white;
        display: flex;
        align-items: center;
        gap: 11px;
        box-shadow: 0 4px 15px rgba(16,41,71,.035);
    }

    .metric-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .metric-icon.blue {
            background: #eaf2fb;
            color: #306ca7;
        }

        .metric-icon.green {
            background: #e9f7f0;
            color: #168957;
        }

        .metric-icon.gold {
            background: #fff7e5;
            color: #a47517;
        }

        .metric-icon.purple {
            background: #f0ebf8;
            color: #7554aa;
        }

    .metric-card span {
        display: block;
        color: #8995a5;
        font-size: .54rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .45px;
    }

    .metric-card strong {
        display: block;
        margin-top: 2px;
        color: var(--navy);
        font-size: 1.25rem;
        font-weight: 800;
        line-height: 1;
    }

    .metric-card small {
        display: block;
        margin-top: 4px;
        color: #99a3b0;
        font-size: .5rem;
    }

    /* ================================================================
               FILTROS
               ================================================================ */

    .filter-card,
    .audit-card {
        border: 1px solid var(--border);
        border-radius: 16px;
        background: white;
        box-shadow: 0 4px 18px rgba(16,41,71,.045);
    }

    .filter-card {
        margin-bottom: 17px;
        overflow: hidden;
    }

    .filter-header,
    .audit-card-header {
        padding: 16px 18px;
        border-bottom: 1px solid #edf1f5;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
    }

    .filter-title,
    .card-heading {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .section-icon {
        width: 36px;
        height: 36px;
        border-radius: 9px;
        background: #eaf2fb;
        color: #356fa7;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .filter-title span,
    .card-heading span {
        display: block;
        color: #929dab;
        font-size: .51rem;
        font-weight: 800;
        letter-spacing: .8px;
    }

    .filter-title h2,
    .card-heading h2 {
        margin: 1px 0 0;
        color: var(--navy);
        font-size: .88rem;
        font-weight: 800;
    }

    .filter-title p,
    .card-heading p {
        margin: 2px 0 0;
        color: #8793a3;
        font-size: .59rem;
    }

    .filter-toggle {
        display: none;
        min-height: 36px;
        padding: 0 11px;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: white;
        color: #536579;
        font-size: .61rem;
        font-weight: 750;
        cursor: pointer;
    }

    .filter-body {
        padding: 16px 18px;
        display: grid;
        grid-template-columns: repeat( 6, minmax(0,1fr)) auto;
        gap: 10px;
        align-items: end;
    }

    .filter-field label {
        display: block;
        margin-bottom: 5px;
        color: #526174;
        font-size: .58rem;
        font-weight: 750;
    }

    .audit-control {
        width: 100%;
        min-height: 39px;
        padding: 7px 9px;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: white;
        color: #47566a;
        font-size: .62rem;
        outline: none;
    }

        .audit-control:focus {
            border-color: #6b9bce;
            box-shadow: 0 0 0 3px rgba(34,108,194,.07);
        }

    .filter-actions {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    /* ================================================================
               BOTONES
               ================================================================ */

    .btn-primary,
    .btn-secondary,
    .coming-button {
        min-height: 38px;
        padding: 0 13px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        text-decoration: none;
        font-size: .61rem;
        font-weight: 750;
        white-space: nowrap;
        cursor: pointer;
    }

    .btn-primary {
        border: none;
        background: linear-gradient( 135deg, #102947, #17488e);
        color: white;
    }

        .btn-primary:hover {
            color: white;
        }

    .btn-secondary {
        border: 1px solid #d8e0e9;
        background: white;
        color: #586779;
    }

    .coming-button {
        border: 1px solid #e6dfc8;
        background: #fffaf0;
        color: #8c711f;
    }

    /* ================================================================
               CABECERA TABLA
               ================================================================ */

    .table-tools {
        display: flex;
        align-items: center;
        gap: 7px;
    }

    .local-search {
        width: 230px;
        min-height: 38px;
        padding: 0 9px;
        border: 1px solid var(--border);
        border-radius: 8px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .local-search > .icon {
            color: #8995a5;
        }

        .local-search input {
            flex: 1;
            min-width: 0;
            border: none;
            outline: none;
            background: transparent;
            color: #465569;
            font-size: .61rem;
        }

        .local-search button {
            border: none;
            padding: 2px;
            background: transparent;
            color: #8a96a6;
            cursor: pointer;
        }

    /* ================================================================
               TABLA
               ================================================================ */

    .table-wrap {
        width: 100%;
        overflow-x: auto;
    }

    .audit-table {
        width: 100%;
        border-collapse: collapse;
    }

        .audit-table thead th {
            padding: 10px 12px;
            border-bottom: 1px solid #e8edf3;
            background: #f8fafc;
            color: #7d8999;
            font-size: .54rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .48px;
            white-space: nowrap;
        }

        .audit-table tbody td {
            padding: 11px 12px;
            border-bottom: 1px solid #eef2f6;
            color: #536174;
            font-size: .63rem;
            vertical-align: middle;
        }

        .audit-table tbody tr:last-child td {
            border-bottom: none;
        }

        .audit-table tbody tr {
            transition: background .15s ease;
        }

            .audit-table tbody tr:hover {
                background: #fafbfd;
            }

    /* ================================================================
               CELDAS
               ================================================================ */

    .date-cell {
        min-width: 95px;
    }

        .date-cell strong {
            display: block;
            color: #48576a;
            font-size: .61rem;
        }

        .date-cell span {

@using Inventario_Vidal.DTOs
@model RolCreateDto

@{
    ViewData["Title"] = "Nuevo rol";
    ViewBag.Subtitle = "Crear un perfil de acceso";
}

<div class="security-page">

    <section class="page-hero">
        <div class="hero-left">
            <div class="hero-icon">
                <svg class="icon icon-xl">
                    <use href="#icon-shield"></use>
                </svg>
            </div>

            <div>
                <span class="hero-eyebrow">
                    SEGURIDAD Y ACCESOS
                </span>

                <h1>Nuevo rol</h1>

                <p>
                    Define un perfil de acceso. Los permisos se configuran después de crear el rol.
                </p>
            </div>
        </div>

        <div class="hero-actions">
            <a asp-action="Index"
               class="hero-btn outline">
                <svg class="icon icon-sm">
                    <use href="#icon-arrow-left"></use>
                </svg>
                Volver
            </a>
        </div>
    </section>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="model-errors"
             asp-validation-summary="ModelOnly">
        </div>
    }

    <form asp-action="Crear"
          method="post"
          id="rolForm">
        @Html.AntiForgeryToken()

        <div class="form-layout">
            <main>
                <section class="panel-card">
                    <div class="panel-heading">
                        <div class="heading-left">
                            <div class="heading-icon">
                                <svg class="icon">
                                    <use href="#icon-shield"></use>
                                </svg>
                            </div>

                            <div>
                                <span>INFORMACIÓN</span>
                                <h2>Datos del rol</h2>
                                <p>
                                    Identifica el perfil y define su estado inicial.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="form-body">
                        <div class="field-group">
                            <label asp-for="NombreRol">
                                Nombre del rol *
                            </label>

                            <input asp-for="NombreRol"
                                   id="NombreRol"
                                   class="vidal-control"
                                   maxlength="50"
                                   autocomplete="off"
                                   placeholder="Ej. Supervisor de almacén" />

                            <div class="field-footer">
                                <span asp-validation-for="NombreRol"
                                      class="validation-text">
                                </span>

                                <span id="nombreStatus"
                                      class="field-help">
                                </span>
                            </div>
                        </div>

                        <div class="field-group">
                            <label asp-for="Descripcion">
                                Descripción
                            </label>

                            <textarea asp-for="Descripcion"
                                      id="Descripcion"
                                      class="vidal-control"
                                      maxlength="200"
                                      placeholder="Describe las responsabilidades y alcance del rol"></textarea>

                            <div class="field-footer">
                                <span asp-validation-for="Descripcion"
                                      class="validation-text">
                                </span>

                                <span id="contadorDescripcion"
                                      class="field-counter">
                                    0 / 200
                                </span>
                            </div>
                        </div>

                        <div class="status-box">
                            <div class="status-box-icon">
                                <svg class="icon">
                                    <use href="#icon-check-circle"></use>
                                </svg>
                            </div>

                            <div class="status-box-content">
                                <strong>Estado del rol</strong>
                                <span>
                                    Un rol activo puede asignarse inmediatamente a los usuarios.
                                </span>
                            </div>

                            <label class="switch">
                                <input asp-for="Activo"
                                       id="Activo" />
                                <span class="switch-slider"></span>
                            </label>
                        </div>
                    </div>
                </section>

                <div class="form-actions">
                    <a asp-action="Index"
                       class="secondary-btn">
                        Cancelar
                    </a>

                    <button type="submit"
                            class="primary-btn"
                            id="btnGuardar">
                        <svg class="icon icon-sm">
                            <use href="#icon-save"></use>
                        </svg>
                        Crear rol
                    </button>
                </div>
            </main>

            <aside>
                <section class="preview-card">
                    <div class="preview-header">
                        <svg class="icon icon-sm">
                            <use href="#icon-eye"></use>
                        </svg>
                        Vista previa
                    </div>

                    <div class="preview-body">
                        <div class="preview-avatar"
                             id="previewAvatar">
                            R
                        </div>

                        <h3 id="previewNombre">
                            Nuevo rol
                        </h3>

                        <p id="previewDescripcion">
                            Sin descripción registrada.
                        </p>

                        <span class="preview-status active"
                              id="previewEstado">
                            <span class="status-dot"></span>
                            Activo
                        </span>
                    </div>
                </section>
            </aside>
        </div>
    </form>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener(
            'DOMContentLoaded',
            function () {

                const nombre =
                    document.getElementById('NombreRol');

                const descripcion =
                    document.getElementById('Descripcion');

                const activo =
                    document.getElementById('Activo');

                const previewNombre =
                    document.getElementById('previewNombre');

                const previewDescripcion =
                    document.getElementById('previewDescripcion');

                const previewEstado =
                    document.getElementById('previewEstado');

                const previewAvatar =
                    document.getElementById('previewAvatar');

                const contador =
                    document.getElementById('contadorDescripcion');

                const nombreStatus =
                    document.getElementById('nombreStatus');

                const form =
                    document.getElementById('rolForm');

                const btnGuardar =
                    document.getElementById('btnGuardar');

                let nombreDisponible = true;
                let verificandoNombre = false;
                let timer;

                function iniciales(value) {
                    const parts =
                        String(value || '')
                            .trim()
                            .split(/\s+/)
                            .filter(Boolean);

                    if (!parts.length)
                        return 'R';

                    return (
                        parts.length === 1
                            ? parts[0][0]
                            : parts[0][0] +
                                parts[parts.length - 1][0]
                    ).toUpperCase();
                }

                function actualizarVista() {
                    const name =
                        nombre.value.trim();

                    const description =
                        descripcion.value.trim();

                    previewNombre.textContent =
                        name || 'Nuevo rol';

                    previewDescripcion.textContent =
                        description ||
                        'Sin descripción registrada.';

                    previewAvatar.textContent =
                        iniciales(name);

                    previewEstado.className =
                        activo.checked
                            ? 'preview-status active'
                            : 'preview-status inactive';

                    previewEstado.innerHTML =
                        '<span class="status-dot"></span>' +
                        (activo.checked
                            ? 'Activo'
                            : 'Inactivo');

                    contador.textContent =
                        `${descripcion.value.length} / 200`;
                }

                async function verificarNombre() {
                    const value =
                        nombre.value.trim();

                    if (value.length < 3) {
                        nombreStatus.textContent = '';
                        nombreDisponible = true;
                        return;
                    }

                    verificandoNombre = true;
                    nombreDisponible = false;
                    nombreStatus.textContent =
                        'Verificando disponibilidad...';

                    try {
                        const response =
                            await fetch(
                                '@Url.Action("VerificarNombre", "Roles")' +
                                '?nombre=' +
                                encodeURIComponent(value));

                        const data =
                            await response.json();

                        if (data.error) {
                            nombreDisponible = false;
                            nombreStatus.textContent =
                                'No se pudo verificar el nombre.';
                            return;
                        }

                        nombreDisponible =
                            data.exists !== true;

                        nombreStatus.textContent =
                            nombreDisponible
                                ? 'Nombre disponible.'
                                : 'Ya existe un rol con este nombre.';
                    }
                    catch {
                        nombreDisponible = false;
                        nombreStatus.textContent =
                            'No se pudo verificar el nombre.';
                    }
                    finally {
                        verificandoNombre = false;
                    }
                }

                nombre.addEventListener(
                    'input',
                    function () {
                        actualizarVista();

                        clearTimeout(timer);

                        nombreDisponible = true;
                        nombreStatus.textContent = '';

                        timer =
                            setTimeout(
                                verificarNombre,
                                400);
                    });

                descripcion.addEventListener(
                    'input',
                    actualizarVista);

                activo.addEventListener(
                    'change',
                    actualizarVista);

                form.addEventListener(
                    'submit',
                    function (event) {
                        if (verificandoNombre ||
                            !nombreDisponible)
                        {
                            event.preventDefault();
                            nombre.focus();
                            return;
                        }

                        if (!form.checkValidity())
                            return;

                        btnGuardar.disabled = true;
                        btnGuardar.innerHTML =
                            '<svg class="icon icon-sm"><use href="#icon-refresh"></use></svg> Guardando...';
                    });

                actualizarVista();
            });
    </script>
}


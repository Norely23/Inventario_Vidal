@model Inventario_Vidal.Models.Materiale

@{
    ViewData["Title"] = "Crear Material";
}

<div class="container mt-4">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="bi bi-plus-circle"></i> Crear Nuevo Material</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="CodigoBarras" class="form-label fw-semibold">Código de Barras <span class="text-danger">*</span></label>
                        <input asp-for="CodigoBarras" class="form-control" placeholder="Ej: TUB-2026-00001" />
                        <span asp-validation-for="CodigoBarras" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Nombre" class="form-label fw-semibold">Nombre <span class="text-danger">*</span></label>
                        <input asp-for="Nombre" class="form-control" placeholder="Ej: Tubo cuadrado 2x2" />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Descripcion" class="form-label fw-semibold">Descripción</label>
                        <textarea asp-for="Descripcion" class="form-control" rows="2" placeholder="Descripción opcional..."></textarea>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="IdCategoria" class="form-label fw-semibold">Categoría <span class="text-danger">*</span></label>
                        <select asp-for="IdCategoria" class="form-select" asp-items="ViewBag.IdCategoria">
                            <option value="">-- Seleccione --</option>
                        </select>
                        <span asp-validation-for="IdCategoria" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="IdMarca" class="form-label fw-semibold">Marca</label>
                        <select asp-for="IdMarca" class="form-select" asp-items="ViewBag.IdMarca">
                            <option value="">-- Sin Marca --</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="IdUnidadCompra" class="form-label fw-semibold">Unidad de Compra <span class="text-danger">*</span></label>
                        <select asp-for="IdUnidadCompra" class="form-select" asp-items="ViewBag.IdUnidadCompra"></select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="IdUnidadConsumo" class="form-label fw-semibold">Unidad de Consumo <span class="text-danger">*</span></label>
                        <select asp-for="IdUnidadConsumo" class="form-select" asp-items="ViewBag.IdUnidadConsumo"></select>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="StockActual" class="form-label fw-semibold">Stock Actual</label>
                        <input asp-for="StockActual" class="form-control" value="0" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="StockMinimo" class="form-label fw-semibold">Stock Mínimo</label>
                        <input asp-for="StockMinimo" class="form-control" value="0" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="StockMaximo" class="form-label fw-semibold">Stock Máximo</label>
                        <input asp-for="StockMaximo" class="form-control" />
                    </div>

                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input class="form-check-input" asp-for="Activo" checked />
                            <label class="form-check-label fw-semibold" asp-for="Activo">Material Activo</label>
                        </div>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle"></i> Cancelar
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Guardar Material
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
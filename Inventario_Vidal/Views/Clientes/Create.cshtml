@model Inventario_Vidal.Models.Cliente

@{
    ViewData["Title"] = "Crear Cliente";
}

<div class="container mt-4">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="bi bi-person-plus-fill"></i> Crear Nuevo Cliente</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <h6 class="text-muted mb-3">Datos de Identificación</h6>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="TipoCliente" class="form-label fw-semibold">Tipo de Cliente <span class="text-danger">*</span></label>
                        <select asp-for="TipoCliente" class="form-select" required>
                            <option value="">-- Seleccione --</option>
                            <option value="Natural">Persona Natural</option>
                            <option value="Juridico">Persona Jurídica</option>
                        </select>
                        <span asp-validation-for="TipoCliente" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="TipoDocumento" class="form-label fw-semibold">Tipo de Documento <span class="text-danger">*</span></label>
                        <select asp-for="TipoDocumento" class="form-select" required>
                            <option value="">-- Seleccione --</option>
                            <option value="DNI">DNI</option>
                            <option value="RUC">RUC</option>
                            <option value="CE">Carnet de Extranjería</option>
                            <option value="Pasaporte">Pasaporte</option>
                        </select>
                        <span asp-validation-for="TipoDocumento" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="NumeroDocumento" class="form-label fw-semibold">Número de Documento <span class="text-danger">*</span></label>
                        <input asp-for="NumeroDocumento" class="form-control" />
                        <span asp-validation-for="NumeroDocumento" class="text-danger small"></span>
                    </div>

                    <div class="col-md-8">
                        <label asp-for="NombreOrazonSocial" class="form-label fw-semibold">Razón Social / Nombre Completo <span class="text-danger">*</span></label>
                        <input asp-for="NombreOrazonSocial" class="form-control" />
                        <span asp-validation-for="NombreOrazonSocial" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="NombreComercial" class="form-label fw-semibold">Nombre Comercial</label>
                        <input asp-for="NombreComercial" class="form-control" />
                    </div>
                </div>

                <h6 class="text-muted mt-4 mb-3">Datos de Contacto</h6>
                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Direccion" class="form-label fw-semibold">Dirección</label>
                        <input asp-for="Direccion" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Telefono" class="form-label fw-semibold">Teléfono</label>
                        <input asp-for="Telefono" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Distrito" class="form-label fw-semibold">Distrito</label>
                        <input asp-for="Distrito" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Provincia" class="form-label fw-semibold">Provincia</label>
                        <input asp-for="Provincia" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Departamento" class="form-label fw-semibold">Departamento</label>
                        <input asp-for="Departamento" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CorreoElectronico" class="form-label fw-semibold">Email</label>
                        <input asp-for="CorreoElectronico" type="email" class="form-control" />
                        <span asp-validation-for="CorreoElectronico" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ContactoNombre" class="form-label fw-semibold">Nombre del Contacto</label>
                        <input asp-for="ContactoNombre" class="form-control" />
                    </div>

                    <div class="col-12">
                        <label asp-for="Observaciones" class="form-label fw-semibold">Observaciones</label>
                        <textarea asp-for="Observaciones" class="form-control" rows="2"></textarea>
                    </div>

                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input class="form-check-input" asp-for="Activo" checked />
                            <label class="form-check-label fw-semibold" asp-for="Activo">Cliente Activo</label>
                        </div>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle"></i> Cancelar
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Guardar Cliente
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
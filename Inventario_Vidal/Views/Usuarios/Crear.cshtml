@using Inventario_Vidal.DTOs
@model UsuarioCreateDto

@{
    ViewData["Title"] = "Nuevo Usuario";
    ViewBag.Subtitle = "Registrar una nueva cuenta de acceso";

    var roles =
        ViewBag.Roles as IEnumerable<UsuarioRolDto>
        ?? new List<UsuarioRolDto>();
}

<div class="user-create-page">

    <!-- ============================================================
    HERO
    ============================================================ -->
    <section class="create-hero">

        <div class="hero-left">

            <div class="hero-icon">
                <svg class="icon icon-xl">
                    <use href="#icon-user-plus"></use>
                </svg>
            </div>

            <div>

                <h1>
                    Nuevo usuario
                </h1>

                <div class="hero-subtitle">

                    <svg class="icon icon-sm">
                        <use href="#icon-info"></use>
                    </svg>

                    <span>
                        Registra una nueva cuenta y asigna su nivel de acceso.
                    </span>

                </div>

            </div>

        </div>

        <a asp-action="Index"
           class="hero-back">

            <svg class="icon icon-sm">
                <use href="#icon-arrow-left"></use>
            </svg>

            Volver a usuarios

        </a>

    </section>

    <!-- ============================================================
    ALERTAS
    ============================================================ -->

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="page-alert danger">

            <svg class="icon">
                <use href="#icon-alert-triangle"></use>
            </svg>

            <div>

                <strong>
                    Revisa la información ingresada
                </strong>

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary">
                </div>

            </div>

        </div>
    }

    <!-- ============================================================
    FORMULARIO
    ============================================================ -->
    <form asp-action="Crear"
          method="post"
          id="usuarioForm">

        @Html.AntiForgeryToken()

        <div class="create-layout">

            <!-- ========================================================
            CONTENIDO PRINCIPAL
            ======================================================== -->
            <main>

                <!-- ====================================================
                DATOS PERSONALES
                ==================================================== -->
                <section class="form-card">

                    <div class="card-header">

                        <div class="section-icon blue">

                            <svg class="icon">
                                <use href="#icon-user"></use>
                            </svg>

                        </div>

                        <div>

                            <span>
                                PASO 1
                            </span>

                            <h2>
                                Datos personales
                            </h2>

                            <p>
                                Información principal de la persona que utilizará la cuenta.
                            </p>

                        </div>

                    </div>

                    <div class="card-body">

                        <div class="field-group">

                            <label asp-for="NombreCompleto"
                                   class="vidal-label">
                                Nombre completo *
                            </label>

                            <div class="input-with-icon">

                                <svg class="icon icon-sm">
                                    <use href="#icon-user"></use>
                                </svg>

                                <input asp-for="NombreCompleto"
                                       id="NombreCompleto"
                                       class="vidal-control with-icon"
                                       maxlength="150"
                                       autocomplete="name"
                                       placeholder="Ej. Elizabeth Morales Lázaro" />

                            </div>

                            <span asp-validation-for="NombreCompleto"
                                  class="validation-text">
                            </span>

                            <small class="field-help">
                                Ingresa los nombres y apellidos completos del usuario.
                            </small>

                        </div>

                        <div class="field-group">

                            <label asp-for="CorreoElectronico"
                                   class="vidal-label">
                                Correo electrónico
                            </label>

                            <div class="input-with-icon">

                                <svg class="icon icon-sm">
                                    <use href="#icon-mail"></use>
                                </svg>

                                <input asp-for="CorreoElectronico"
                                       id="CorreoElectronico"
                                       type="email"
                                       class="vidal-control with-icon"
                                       maxlength="150"
                                       autocomplete="email"
                                       placeholder="usuario@correo.com" />

                            </div>

                            <span asp-validation-for="CorreoElectronico"
                                  class="validation-text">
                            </span>

                            <small class="field-help">
                                Campo opcional. Se utilizará como información de contacto.
                            </small>

                        </div>

                    </div>

                </section>

                <!-- ====================================================
                CUENTA
                ==================================================== -->
                <section class="form-card mt-card">

                    <div class="card-header">

                        <div class="section-icon purple">

                            <svg class="icon">
                                <use href="#icon-lock"></use>
                            </svg>

                        </div>

                        <div>

                            <span>
                                PASO 2
                            </span>

                            <h2>
                                Datos de acceso
                            </h2>

                            <p>
                                Define el usuario y contraseña para ingresar al sistema.
                            </p>

                        </div>

                    </div>

                    <div class="card-body">

                        <!-- ============================================
                        NOMBRE USUARIO
                        ============================================ -->
                        <div class="field-group">

                            <label asp-for="NombreUsuario"
                                   class="vidal-label">
                                Nombre de usuario *
                            </label>

                            <div class="input-with-icon">

                                <svg class="icon icon-sm">
                                    <use href="#icon-user"></use>
                                </svg>

                                <input asp-for="NombreUsuario"
                                       id="NombreUsuario"
                                       class="vidal-control with-icon"
                                       maxlength="50"
                                       autocomplete="username"
                                       autocapitalize="none"
                                       spellcheck="false"
                                       placeholder="Ej. emorales" />

                            </div>

                            <span asp-validation-for="NombreUsuario"
                                  class="validation-text">
                            </span>

                            <small class="field-help">
                                Solo letras, números, puntos, guiones y guiones bajos.
                            </small>

                        </div>

                        <div class="password-grid">

                            <!-- ========================================
                            CONTRASEÑA
                            ======================================== -->
                            <div class="field-group">

                                <label asp-for="Contrasena"
                                       class="vidal-label">
                                    Contraseña *
                                </label>

                                <div class="password-control">

                                    <svg class="icon icon-sm field-icon">
                                        <use href="#icon-lock"></use>
                                    </svg>

                                    <input asp-for="Contrasena"
                                           id="Contrasena"
                                           type="password"
                                           class="vidal-control password-input"
                                           maxlength="100"
                                           autocomplete="new-password"
                                           placeholder="Mínimo 6 caracteres" />

                                    <button type="button"
                                            class="password-toggle"
                                            data-target="Contrasena"
                                            title="Mostrar contraseña">

                                        <svg class="icon icon-sm">
                                            <use href="#icon-eye"></use>
                                        </svg>

                                    </button>

                                </div>

                                <span asp-validation-for="Contrasena"
                                      class="validation-text">
                                </span>

                            </div>

                            <!-- ========================================
                            CONFIRMAR CONTRASEÑA
                            ======================================== -->
                            <div class="field-group">

                                <label asp-for="ConfirmarContrasena"
                                       class="vidal-label">
                                    Confirmar contraseña *
                                </label>

                                <div class="password-control">

                                    <svg class="icon icon-sm field-icon">
                                        <use href="#icon-lock"></use>
                                    </svg>

                                    <input asp-for="ConfirmarContrasena"
                                           id="ConfirmarContrasena"
                                           type="password"
                                           class="vidal-control password-input"
                                           maxlength="100"
                                           autocomplete="new-password"
                                           placeholder="Repite la contraseña" />

                                    <button type="button"
                                            class="password-toggle"
                                            data-target="ConfirmarContrasena"
                                            title="Mostrar contraseña">

                                        <svg class="icon icon-sm">
                                            <use href="#icon-eye"></use>
                                        </svg>

                                    </button>

                                </div>

                                <span asp-validation-for="ConfirmarContrasena"
                                      class="validation-text">
                                </span>

                            </div>

                        </div>

                        <!-- ============================================
                        INDICADOR DE CONTRASEÑA
                        ============================================ -->
                        <div class="password-status"
                             id="passwordStatus">

                            <div class="password-status-header">

                                <span>
                                    Seguridad de la contraseña
                                </span>

                                <strong id="passwordStrengthText">
                                    Sin evaluar
                                </strong>

                            </div>

                            <div class="password-track">

                                <div class="password-value"
                                     id="passwordStrengthBar">
                                </div>

                            </div>

                            <div class="password-requirements">

                                <span id="reqLength">

                                    <svg class="icon icon-sm">
                                        <use href="#icon-circle"></use>
                                    </svg>

                                    Mínimo 6 caracteres

                                </span>

                                <span id="reqMatch">

                                    <svg class="icon icon-sm">
                                        <use href="#icon-circle"></use>
                                    </svg>

                                    Las contraseñas coinciden

                                </span>

                            </div>

                        </div>

                    </div>

                </section>

                <!-- ====================================================
                ROL Y ESTADO
                ==================================================== -->
                <section class="form-card mt-card">

                    <div class="card-header">

                        <div class="section-icon gold">

                            <svg class="icon">
                                <use href="#icon-shield"></use>
                            </svg>

                        </div>

                        <div>

                            <span>
                                PASO 3
                            </span>

                            <h2>
                                Rol y estado
                            </h2>

                            <p>
                                Define el nivel de acceso inicial de la cuenta.
                            </p>

                        </div>

                    </div>

                    <div class="card-body">

                        <div class="field-group">

                            <label asp-for="IdRol"
                                   class="vidal-label">
                                Rol *
                            </label>

                            <div class="input-with-icon">

                                <svg class="icon icon-sm">
                                    <use href="#icon-shield"></use>
                                </svg>

                                <select asp-for="IdRol"
                                        id="IdRol"
                                        class="vidal-control with-icon">

                                    <option value="">
                                        Seleccione un rol...
                                    </option>

                                    @foreach (var rol in roles)
                                    {
                                        <option value="@rol.IdRol"
                                                data-description="@rol.Descripcion">
                                            @rol.NombreRol
                                        </option>
                                    }

                                </select>

                            </div>

                            <span asp-validation-for="IdRol"
                                  class="validation-text">
                            </span>

                            <div class="role-description"
                                 id="roleDescription">

                                <svg class="icon icon-sm">
                                    <use href="#icon-info"></use>
                                </svg>

                                <span>
                                    Selecciona un rol para ver su descripción.
                                </span>

                            </div>

                        </div>

                        <!-- ============================================
                        ESTADO
                        ============================================ -->
                        <div class="status-box">

                            <div class="status-icon">

                                <svg class="icon">
                                    <use href="#icon-check-circle"></use>
                                </svg>

                            </div>

                            <div class="status-content">

                                <strong>
                                    Cuenta activa
                                </strong>

                                <span>
                                    Una cuenta activa podrá iniciar sesión después de ser registrada.
                                </span>

                            </div>

                            <label class="switch-control">

                                <input asp-for="Activo"
                                       id="Activo"
                                       type="checkbox" />

                                <span class="switch-slider"></span>

                            </label>

                        </div>

                    </div>

                </section>

            </main>

            <!-- ========================================================
            RESUMEN LATERAL
            ======================================================== -->
            <aside>

                <section class="summary-card">

                    <div class="summary-title">

                        <svg class="icon">
                            <use href="#icon-eye"></use>
                        </svg>

                        Vista previa

                    </div>

                    <div class="profile-preview">

                        <div class="profile-avatar"
                             id="previewAvatar">
                            NU
                        </div>

                        <div class="profile-info">

                            <strong id="previewNombre">
                                Nuevo usuario
                            </strong>

                            <span id="previewUsername">
                                @@usuario
                            </span>

                        </div>

                    </div>

                    <div class="preview-status-row">

                        <span>
                            Estado
                        </span>

                        <span id="previewEstado"
                              class="status-preview active">
                            Activo
                        </span>

                    </div>

                    <div class="preview-data">

                        <div>

                            <span>
                                Correo
                            </span>

                            <strong id="previewCorreo">
                                Sin correo
                            </strong>

                        </div>

                        <div>

                            <span>
                                Rol
                            </span>

                            <strong id="previewRol">
                                Sin seleccionar
                            </strong>

                        </div>

                    </div>

                    <div class="summary-divider"></div>

                    <div class="summary-note">

                        <svg class="icon icon-sm">
                            <use href="#icon-shield"></use>
                        </svg>

                        <span>
                            Los permisos efectivos dependerán del rol asignado.
                        </span>

                    </div>

                </section>

                <!-- ====================================================
                SEGURIDAD
                ==================================================== -->
                <section class="security-card">

                    <div class="security-card-icon">

                        <svg class="icon">
                            <use href="#icon-lock"></use>
                        </svg>

                    </div>

                    <div>

                        <strong>
                            Seguridad de acceso
                        </strong>

                        <span>
                            La contraseña se almacenará protegida por el mecanismo de seguridad configurado en el sistema.
                        </span>

                    </div>

                </section>

                <!-- ====================================================
                ROLES
                ==================================================== -->
                <section class="role-info-card">

                    <div class="role-info-header">

                        <svg class="icon">
                            <use href="#icon-shield"></use>
                        </svg>

                        <strong>
                            Roles disponibles
                        </strong>

                    </div>

                    <span class="role-count">
                        @roles.Count()
                        @(roles.Count() == 1
                            ? "rol activo disponible"
                            : "roles activos disponibles")
                    </span>

                    <a asp-controller="Roles"
                       asp-action="Index">

                        Administrar roles

                        <svg class="icon icon-sm">
                            <use href="#icon-arrow-right"></use>
                        </svg>

                    </a>

                </section>

            </aside>

        </div>

        <!-- ============================================================
        ACCIONES
        ============================================================ -->
        <div class="form-actions">

            <a asp-action="Index"
               class="cancel-button">

                Cancelar

            </a>

            <button type="reset"
                    class="reset-button"
                    id="btnReset">

                <svg class="icon icon-sm">
                    <use href="#icon-refresh"></use>
                </svg>

                Limpiar

            </button>

            <button type="submit"
                    class="submit-button"
                    id="btnSubmit">

                <svg class="icon icon-sm">
                    <use href="#icon-save"></use>
                </svg>

                Registrar usuario

            </button>

        </div>

    </form>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener(
            'DOMContentLoaded',
            function() {

                // ========================================================
                // ELEMENTOS
                // ========================================================

                const nombreCompleto =
                    document.getElementById(
                        'NombreCompleto');

                const nombreUsuario =
                    document.getElementById(
                        'NombreUsuario');

                const correo =
                    document.getElementById(
                        'CorreoElectronico');

                const contrasena =
                    document.getElementById(
                        'Contrasena');

                const confirmarContrasena =
                    document.getElementById(
                        'ConfirmarContrasena');

                const rolSelect =
                    document.getElementById(
                        'IdRol');

                const activo =
                    document.getElementById(
                        'Activo');

                const btnReset =
                    document.getElementById(
                        'btnReset');

                const form =
                    document.getElementById(
                        'usuarioForm');

                const btnSubmit =
                    document.getElementById(
                        'btnSubmit');

                // ========================================================
                // PREVIEW
                // ========================================================

                const previewAvatar =
                    document.getElementById(
                        'previewAvatar');

                const previewNombre =
                    document.getElementById(
                        'previewNombre');

                const previewUsername =
                    document.getElementById(
                        'previewUsername');

                const previewCorreo =
                    document.getElementById(
                        'previewCorreo');

                const previewRol =
                    document.getElementById(
                        'previewRol');

                const previewEstado =
                    document.getElementById(
                        'previewEstado');

                const roleDescription =
                    document.getElementById(
                        'roleDescription');

                // ========================================================
                // CONTRASEÑA
                // ========================================================

                const passwordStrengthBar =
                    document.getElementById(
                        'passwordStrengthBar');

                const passwordStrengthText =
                    document.getElementById(
                        'passwordStrengthText');

                const reqLength =
                    document.getElementById(
                        'reqLength');

                const reqMatch =
                    document.getElementById(
                        'reqMatch');

                // ========================================================
                // INICIALES
                // ========================================================

                function obtenerIniciales(nombre) {

                    if (!nombre ||
                        !nombre.trim()) {

                        return 'NU';
                    }

                    const partes =
                        nombre
                            .trim()
                            .split(/\s+/)
                            .filter(Boolean);

                    if (partes.length === 1) {

                        return partes[0]
                            .substring(0, 2)
                            .toUpperCase();
                    }

                    return (
                        partes[0][0] +
                        partes[partes.length - 1][0]
                    ).toUpperCase();
                }

                // ========================================================
                // ACTUALIZAR PREVIEW
                // ========================================================

                function actualizarPreview() {

                    const nombre =
                        nombreCompleto.value.trim();

                    const username =
                        nombreUsuario.value.trim();

                    const correoTexto =
                        correo.value.trim();

                    const selectedOption =
                        rolSelect.options[
                        rolSelect.selectedIndex];

                    const rolTexto =
                        rolSelect.value
                            ? selectedOption.text.trim()
                            : 'Sin seleccionar';

                    previewAvatar.textContent =
                        obtenerIniciales(nombre);

                    previewNombre.textContent =
                        nombre ||
                        'Nuevo usuario';

                    previewUsername.textContent =
                        username
                            ? '@@' + username
                            : '@@usuario';

                    previewCorreo.textContent =
                        correoTexto ||
                        'Sin correo';

                    previewRol.textContent =
                        rolTexto;

                    previewEstado.textContent =
                        activo.checked
                            ? 'Activo'
                            : 'Inactivo';

                    previewEstado.className =
                        activo.checked
                            ? 'status-preview active'
                            : 'status-preview inactive';

                    actualizarDescripcionRol();
                }

                // ========================================================
                // DESCRIPCIÓN DEL ROL
                // ========================================================

                function actualizarDescripcionRol() {

                    const option =
                        rolSelect.options[
                        rolSelect.selectedIndex];

                    const descripcion =
                        option &&
                            option.value
                            ? option.dataset.description
                            : '';

                    roleDescription.innerHTML =
                        '<svg class="icon icon-sm">' +
                        '<use href="#icon-info"></use>' +
                        '</svg>' +
                        '<span>' +
                        escaparHtml(
                            descripcion ||
                            'Selecciona un rol para ver su descripción.') +
                        '</span>';
                }

                // ========================================================
                // ESCAPAR HTML
                // ========================================================

                function escaparHtml(value) {

                    return String(value || '')
                        .replaceAll('&', '&amp;')
                        .replaceAll('<', '&lt;')
                        .replaceAll('>', '&gt;')
                        .replaceAll('"', '&quot;')
                        .replaceAll("'", '&#039;');
                }

                // ========================================================
                // FORTALEZA DE CONTRASEÑA
                // ========================================================

                function actualizarPassword() {

                    const valor =
                        contrasena.value || '';

                    const confirmacion =
                        confirmarContrasena.value || '';

                    let puntos = 0;

                    if (valor.length >= 6) {
                        puntos++;
                    }

                    if (valor.length >= 10) {
                        puntos++;
                    }

                    if (/[A-Z]/.test(valor) &&
                        /[a-z]/.test(valor)) {
                        puntos++;
                    }

                    if (/\d/.test(valor)) {
                        puntos++;
                    }

                    if (/[^A-Za-z0-9]/.test(valor)) {
                        puntos++;
                    }

                    let porcentaje = 0;
                    let texto = 'Sin evaluar';
                    let clase = '';

                    if (valor.length > 0) {

                        porcentaje =
                            Math.min(
                                100,
                                puntos * 20);

                        if (puntos <= 1) {
                            texto = 'Débil';
                            clase = 'weak';
                        }
                        else if (puntos <= 3) {
                            texto = 'Media';
                            clase = 'medium';
                        }
                        else {
                            texto = 'Fuerte';
                            clase = 'strong';
                        }
                    }

                    passwordStrengthBar.style.width =
                        porcentaje + '%';

                    passwordStrengthBar.className =
                        'password-value ' +
                        clase;

                    passwordStrengthText.textContent =
                        texto;

                    passwordStrengthText.className =
                        clase;

                    actualizarRequisito(
                        reqLength,
                        valor.length >= 6);

                    actualizarRequisito(
                        reqMatch,
                        valor.length > 0 &&
                        confirmacion.length > 0 &&
                        valor === confirmacion);
                }

                // ========================================================
                // REQUISITO
                // ========================================================

                function actualizarRequisito(
                    elemento,
                    cumplido) {

                    if (!elemento) {
                        return;
                    }

                    elemento.className =
                        cumplido
                            ? 'requirement ok'
                            : 'requirement';

                    const use =
                        elemento.querySelector(
                            'use');

                    if (use) {

                        use.setAttribute(
                            'href',
                            cumplido
                                ? '#icon-check-circle'
                                : '#icon-circle');
                    }
                }

                // ========================================================
                // MOSTRAR / OCULTAR PASSWORD
                // ========================================================

                document
                    .querySelectorAll(
                        '.password-toggle')
                    .forEach(
                        function(button) {

                            button.addEventListener(
                                'click',
                                function() {

                                    const target =
                                        document.getElementById(
                                            button.dataset.target);

                                    if (!target) {
                                        return;
                                    }

                                    const mostrar =
                                        target.type ===
                                        'password';

                                    target.type =
                                        mostrar
                                            ? 'text'
                                            : 'password';

                                    button.title =
                                        mostrar
                                            ? 'Ocultar contraseña'
                                            : 'Mostrar contraseña';
                                });
                        });

                // ========================================================
                // NORMALIZAR NOMBRE DE USUARIO
                // ========================================================

                nombreUsuario.addEventListener(
                    'input',
                    function() {

                        const posicion =
                            nombreUsuario.selectionStart;

                        nombreUsuario.value =
                            nombreUsuario.value
                                .replace(/\s+/g, '')
                                .toLowerCase();

                        try {

                            nombreUsuario.setSelectionRange(
                                posicion,
                                posicion);
                        }
                        catch {
                        }

                        actualizarPreview();
                    });

                // ========================================================
                // LISTENERS
                // ========================================================

                nombreCompleto.addEventListener(
                    'input',
                    actualizarPreview);

                correo.addEventListener(
                    'input',
                    actualizarPreview);

                rolSelect.addEventListener(
                    'change',
                    actualizarPreview);

                activo.addEventListener(
                    'change',
                    actualizarPreview);

                contrasena.addEventListener(
                    'input',
                    actualizarPassword);

                confirmarContrasena.addEventListener(
                    'input',
                    actualizarPassword);

                // ========================================================
                // RESET
                // ========================================================

                btnReset.addEventListener(
                    'click',
                    function() {

                        setTimeout(
                            function() {

                                actualizarPreview();
                                actualizarPassword();

                            },
                            0);
                    });

                // ========================================================
                // SUBMIT
                // ========================================================

                form.addEventListener(
                    'submit',
                    function() {

                        if (!form.checkValidity()) {
                            return;
                        }

                        btnSubmit.disabled =
                            true;

                        btnSubmit.innerHTML =
                            '<svg class="icon icon-sm icon-spin">' +
                            '<use href="#icon-refresh"></use>' +
                            '</svg>' +
                            ' Registrando...';
                    });

                // ========================================================
                // ESTADO INICIAL
                // ========================================================

                actualizarPreview();
                actualizarPassword();
            });

    </script>
}

<style>

    /* ================================================================
           BASE
           ================================================================ */

    .user-create-page {
        --navy: #102947;
        --blue: #17488e;
        --blue-light: #226cc2;
        --border: #dce3eb;
        --text: #344357;
        --muted: #7d8999;
        --success: #168957;
        --danger: #d1475b;
        --warning: #d99a24;
    }

    /* ================================================================
           HERO
           ================================================================ */


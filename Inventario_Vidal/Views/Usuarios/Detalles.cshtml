@using Inventario_Vidal.DTOs
@model UsuarioDetailDto

@{
    ViewData["Title"] = "Detalles del Usuario";
    ViewBag.Subtitle = "Información y actividad de la cuenta";

    var tieneActividad =
        Model.ActividadesRecientes != null &&
        Model.ActividadesRecientes.Any();
}

<div class="user-detail-page">

    <!-- ============================================================
    HERO
    ============================================================ -->
    <section class="detail-hero">

        <div class="hero-left">

            <div class="hero-avatar">
                @Model.Iniciales
            </div>

            <div>

                <div class="hero-title-row">

                    <h1>
                        @Model.NombreCompleto
                    </h1>

                    @if (Model.EstaBloqueado)
                    {
                        <span class="hero-status blocked">

                            <span class="status-dot"></span>

                            Bloqueado

                        </span>
                    }
                    else
                    {
                        <span class="hero-status @(Model.Activo ? "active" : "inactive")">

                            <span class="status-dot"></span>

                            @Model.EstadoTexto

                        </span>
                    }

                </div>

                <div class="hero-subtitle">

                    <span>
                        @@Model.NombreUsuario
                    </span>

                    <span class="separator">
                        ·
                    </span>

                    <span>
                        @Model.NombreRol
                    </span>

                    <span class="hero-id">
                        ID #@Model.IdUsuario
                    </span>

                </div>

            </div>

        </div>

        <div class="hero-actions">

            <a asp-action="Index"
               class="hero-button outline">

                <svg class="icon icon-sm">
                    <use href="#icon-arrow-left"></use>
                </svg>

                Volver

            </a>

            <a asp-action="Editar"
               asp-route-id="@Model.IdUsuario"
               class="hero-button light">

                <svg class="icon icon-sm">
                    <use href="#icon-edit"></use>
                </svg>

                Editar usuario

            </a>

        </div>

    </section>

    <!-- ============================================================
    ESTADÍSTICAS
    ============================================================ -->
    <section class="stats-grid">

        <article class="stat-card">

            <div class="stat-icon blue">

                <svg class="icon">
                    <use href="#icon-folder"></use>
                </svg>

            </div>

            <div>

                <span>
                    Proyectos
                </span>

                <strong>
                    @Model.TotalProyectosCreados
                </strong>

                <small>
                    Como responsable
                </small>

            </div>

        </article>

        <article class="stat-card">

            <div class="stat-icon purple">

                <svg class="icon">
                    <use href="#icon-history"></use>
                </svg>

            </div>

            <div>

                <span>
                    Movimientos
                </span>

                <strong>
                    @Model.TotalMovimientosKardex
                </strong>

                <small>
                    Registros Kardex
                </small>

            </div>

        </article>

        <article class="stat-card">

            <div class="stat-icon gold">

                <svg class="icon">
                    <use href="#icon-shopping-cart"></use>
                </svg>

            </div>

            <div>

                <span>
                    Compras
                </span>

                <strong>
                    @Model.TotalComprasRegistradas
                </strong>

                <small>
                    Registradas
                </small>

            </div>

        </article>

        <article class="stat-card">

            <div class="stat-icon green">

                <svg class="icon">
                    <use href="#icon-lock"></use>
                </svg>

            </div>

            <div>

                <span>
                    Sesiones activas
                </span>

                <strong>
                    @Model.SesionesActivas
                </strong>

                <small>
                    Actualmente
                </small>

            </div>

        </article>

    </section>

    <!-- ============================================================
    LAYOUT
    ============================================================ -->
    <div class="detail-layout">

        <!-- ========================================================
        PRINCIPAL
        ======================================================== -->
        <main>

            <!-- ====================================================
            INFORMACIÓN DE CUENTA
            ==================================================== -->
            <section class="detail-card">

                <div class="card-header">

                    <div class="section-icon blue">

                        <svg class="icon">
                            <use href="#icon-user"></use>
                        </svg>

                    </div>

                    <div>

                        <span>
                            INFORMACIÓN
                        </span>

                        <h2>
                            Datos de la cuenta
                        </h2>

                        <p>
                            Información registrada para identificar al usuario.
                        </p>

                    </div>

                </div>

                <div class="card-body">

                    <div class="information-grid">

                        <!-- NOMBRE -->
                        <div class="information-item">

                            <div class="information-icon">

                                <svg class="icon icon-sm">
                                    <use href="#icon-user"></use>
                                </svg>

                            </div>

                            <div>

                                <span>
                                    Nombre completo
                                </span>

                                <strong>
                                    @Model.NombreCompleto
                                </strong>

                            </div>

                        </div>

                        <!-- USUARIO -->
                        <div class="information-item">

                            <div class="information-icon">

                                <svg class="icon icon-sm">
                                    <use href="#icon-user"></use>
                                </svg>

                            </div>

                            <div>

                                <span>
                                    Nombre de usuario
                                </span>

                                <strong>
                                    @@Model.NombreUsuario
                                </strong>

                            </div>

                        </div>

                        <!-- CORREO -->
                        <div class="information-item">

                            <div class="information-icon">

                                <svg class="icon icon-sm">
                                    <use href="#icon-mail"></use>
                                </svg>

                            </div>

                            <div>

                                <span>
                                    Correo electrónico
                                </span>

                                @if (!string.IsNullOrWhiteSpace(
                                        Model.CorreoElectronico))
                                {
                                    <strong>
                                        @Model.CorreoElectronico
                                    </strong>
                                }
                                else
                                {
                                    <strong class="empty-value">
                                        Sin correo registrado
                                    </strong>
                                }

                            </div>

                        </div>

                        <!-- ROL -->
                        <div class="information-item">

                            <div class="information-icon">

                                <svg class="icon icon-sm">
                                    <use href="#icon-shield"></use>
                                </svg>

                            </div>

                            <div>

                                <span>
                                    Rol
                                </span>

                                <strong>
                                    @Model.NombreRol
                                </strong>

                            </div>

                        </div>

                        <!-- REGISTRO -->
                        <div class="information-item">

                            <div class="information-icon">

                                <svg class="icon icon-sm">
                                    <use href="#icon-calendar"></use>
                                </svg>

                            </div>

                            <div>

                                <span>
                                    Fecha de registro
                                </span>

                                <strong>
                                    @Model.FechaCreacion.ToString("dd/MM/yyyy")
                                </strong>

                                <small>
                                    @Model.FechaCreacion.ToString("HH:mm")
                                </small>

                            </div>

                        </div>

                        <!-- ULTIMO ACCESO -->
                        <div class="information-item">

                            <div class="information-icon">

                                <svg class="icon icon-sm">
                                    <use href="#icon-history"></use>
                                </svg>

                            </div>

                            <div>

                                <span>
                                    Último acceso
                                </span>

                                @if (Model.UltimoAcceso.HasValue)
                                {
                                    <strong>
                                        @Model.UltimoAcceso.Value.ToString("dd/MM/yyyy")
                                    </strong>

                                    <small>
                                        @Model.UltimoAcceso.Value.ToString("HH:mm")
                                    </small>
                                }
                                else
                                {
                                    <strong class="empty-value">
                                        Nunca
                                    </strong>
                                }

                            </div>

                        </div>

                    </div>

                </div>

            </section>

            <!-- ====================================================
            SEGURIDAD
            ==================================================== -->
            <section class="detail-card mt-card">

                <div class="card-header">

                    <div class="section-icon red">

                        <svg class="icon">
                            <use href="#icon-lock"></use>
                        </svg>

                    </div>

                    <div>

                        <span>
                            SEGURIDAD
                        </span>

                        <h2>
                            Estado de acceso
                        </h2>

                        <p>
                            Estado actual, bloqueos e intentos fallidos.
                        </p>

                    </div>

                </div>

                <div class="card-body">

                    <div class="security-grid">

                        <!-- ESTADO -->
                        <div class="security-box">

                            <div class="security-box-header">

                                <span>
                                    Estado de la cuenta
                                </span>

                                <svg class="icon">
                                    <use href="#icon-@(Model.Activo ? "check-circle" : "x-circle")"></use>
                                </svg>

                            </div>

                            <strong class="account-state @(Model.Activo ? "active" : "inactive")">

                                <span class="status-dot"></span>

                                @Model.EstadoTexto

                            </strong>

                            <p>
                                @(Model.Activo
                                    ? "La cuenta está habilitada para utilizar el sistema."
                                    : "La cuenta está deshabilitada y no debe permitir acceso.")
                            </p>

                        </div>

                        <!-- BLOQUEO -->
                        <div class="security-box">

                            <div class="security-box-header">

                                <span>
                                    Bloqueo de seguridad
                                </span>

                                <svg class="icon">
                                    <use href="#icon-lock"></use>
                                </svg>

                            </div>

                            @if (Model.EstaBloqueado)
                            {
                                <strong class="account-state blocked">

                                    <span class="status-dot"></span>

                                    Bloqueado

                                </strong>

                                <p>
                                    Bloqueado hasta
                                    @Model.BloqueadoHastaFormateado.
                                </p>
                            }
                            else
                            {
                                <strong class="account-state active">

                                    <span class="status-dot"></span>

                                    Sin bloqueo

                                </strong>

                                <p>
                                    No existe un bloqueo temporal vigente.
                                </p>
                            }

                        </div>

                        <!-- INTENTOS -->
                        <div class="security-box">

                            <div class="security-box-header">

                                <span>
                                    Intentos fallidos
                                </span>

                                <svg class="icon">
                                    <use href="#icon-alert-triangle"></use>
                                </svg>

                            </div>

                            <strong class="security-number @(Model.IntentosFallidos > 0 ? "warning" : "")">
                                @Model.IntentosFallidos
                            </strong>

                            <p>
                                @(Model.IntentosFallidos == 0
                                    ? "No se registran intentos fallidos."
                                    : "Se registran intentos de acceso fallidos para esta cuenta.")
                            </p>

                        </div>

                        <!-- SESIONES -->
                        <div class="security-box">

                            <div class="security-box-header">

                                <span>
                                    Sesiones activas
                                </span>

                                <svg class="icon">
                                    <use href="#icon-monitor"></use>
                                </svg>

                            </div>

                            <strong class="security-number">
                                @Model.SesionesActivas
                            </strong>

                            <p>
                                @(Model.SesionesActivas == 1
                                    ? "Existe una sesión activa asociada a la cuenta."
                                    : $"Existen {Model.SesionesActivas} sesiones activas asociadas a la cuenta.")
                            </p>

                        </div>

                    </div>

                </div>

            </section>

            <!-- ====================================================
            ACTIVIDAD
            ==================================================== -->
            <section class="detail-card mt-card">

                <div class="card-header">

                    <div class="section-icon purple">

                        <svg class="icon">
                            <use href="#icon-history"></use>
                        </svg>

                    </div>

                    <div>

                        <span>
                            TRAZABILIDAD
                        </span>

                        <h2>
                            Actividad reciente
                        </h2>

                        <p>
                            Historial reciente relacionado con esta cuenta.
                        </p>

                    </div>

                </div>

                <div class="card-body">

                    @if (tieneActividad)
                    {
                        <div class="activity-list">

                            @foreach (
                                var actividad in Model.ActividadesRecientes
                                    .OrderByDescending(a => a.FechaHora))
                            {
                                <article class="activity-item">

                                    <div class="activity-marker">

                                        <svg class="icon icon-sm">
                                            <use href="#icon-history"></use>
                                        </svg>

                                    </div>

                                    <div class="activity-content">

                                        <div class="activity-title">

                                            <strong>
                                                @actividad.Accion
                                            </strong>

                                            <span>
                                                @actividad.TiempoTranscurrido
                                            </span>

                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(
                                                actividad.Descripcion))
                                        {
                                            <p>
                                                @actividad.Descripcion
                                            </p>
                                        }

                                        <div class="activity-meta">

                                            <span>
                                                @actividad.Tabla
                                            </span>

                                            @if (!string.IsNullOrWhiteSpace(
                                                    actividad.IdRegistro))
                                            {
                                                <span>
                                                    Registro #@actividad.IdRegistro
                                                </span>
                                            }

                                            <span>
                                                @actividad.FechaFormateada
                                            </span>

                                        </div>

                                    </div>

                                </article>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="activity-empty">

                            <div class="empty-icon">

                                <svg class="icon icon-xl">
                                    <use href="#icon-history"></use>
                                </svg>

                            </div>

                            <strong>
                                Sin actividad detallada disponible
                            </strong>

                            <span>
                                El detalle de actividades recientes aún no está cargado para esta vista.
                            </span>

                            @if (Model.UltimaActividad.HasValue)
                            {
                                <small>
                                    Última actividad registrada:
                                    @Model.UltimaActividad.Value.ToString("dd/MM/yyyy HH:mm")
                                </small>
                            }

                        </div>
                    }

                </div>

            </section>

        </main>

        <!-- ========================================================
        ASIDE
        ======================================================== -->
        <aside>

            <!-- ====================================================
            PERFIL
            ==================================================== -->
            <section class="profile-card">

                <div class="profile-avatar">
                    @Model.Iniciales
                </div>

                <h2>
                    @Model.NombreCompleto
                </h2>

                <span class="profile-username">
                    @@Model.NombreUsuario
                </span>

                @if (Model.EstaBloqueado)
                {
                    <span class="profile-status blocked">

                        <span class="status-dot"></span>

                        Bloqueado

                    </span>
                }
                else
                {
                    <span class="profile-status @(Model.Activo ? "active" : "inactive")">

                        <span class="status-dot"></span>

                        @Model.EstadoTexto

                    </span>
                }

                <div class="profile-divider"></div>

                <div class="profile-role">

                    <span>
                        Rol asignado
                    </span>

                    <strong>
                        @Model.NombreRol
                    </strong>

                </div>

                <div class="profile-divider"></div>

                <div class="profile-details">

                    <div>

                        <span>
                            ID
                        </span>

                        <strong>
                            #@Model.IdUsuario
                        </strong>

                    </div>

                    <div>

                        <span>
                            Registrado
                        </span>

                        <strong>
                            @Model.FechaCreacion.ToString("dd/MM/yyyy")
                        </strong>

                    </div>

                    <div>

                        <span>
                            Último acceso
                        </span>

                        <strong>
                            @(Model.UltimoAcceso.HasValue
                                ? Model.UltimoAcceso.Value.ToString("dd/MM/yyyy HH:mm")
                                : "Nunca")
                        </strong>

                    </div>

                </div>

                <a asp-action="Editar"
                   asp-route-id="@Model.IdUsuario"
                   class="profile-edit">

                    <svg class="icon icon-sm">
                        <use href="#icon-edit"></use>
                    </svg>

                    Editar usuario

                </a>

            </section>

            <!-- ====================================================
            ÚLTIMA ACTIVIDAD
            ==================================================== -->
            <section class="side-card">

                <div class="side-card-title">

                    <svg class="icon">
                        <use href="#icon-history"></use>
                    </svg>

                    <strong>
                        Última actividad
                    </strong>

                </div>

                @if (Model.UltimaActividad.HasValue)
                {
                    <strong class="last-activity-date">
                        @Model.UltimaActividad.Value.ToString("dd/MM/yyyy")
                    </strong>

                    <span>
                        @Model.UltimaActividad.Value.ToString("HH:mm")
                    </span>
                }
                else
                {
                    <strong class="last-activity-date muted">
                        Sin registro
                    </strong>

                    <span>
                        No se encontró actividad de auditoría.
                    </span>
                }

            </section>

            <!-- ====================================================
            ADMINISTRACIÓN
            ==================================================== -->
            <section class="side-card">

                <div class="side-card-title">

                    <svg class="icon">
                        <use href="#icon-settings"></use>
                    </svg>

                    <strong>
                        Administración
                    </strong>

                </div>

                <p>
                    Puedes modificar los datos del usuario o cambiar el estado de la cuenta.
                </p>

                <form asp-action="ToggleActivo"
                      asp-route-id="@Model.IdUsuario"
                      method="post"
                      id="toggleForm">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="state-button @(Model.Activo ? "disable" : "enable")"
                            id="btnToggle"
                            data-active="@Model.Activo.ToString().ToLowerInvariant()">

                        <svg class="icon icon-sm">
                            <use href="#icon-@(Model.Activo ? "x-circle" : "check-circle")"></use>
                        </svg>

                        @(Model.Activo
                            ? "Desactivar usuario"
                            : "Activar usuario")

                    </button>

                </form>

            </section>

        </aside>

    </div>

</div>

<!-- ============================================================
CONFIRMACIÓN CAMBIO DE ESTADO
============================================================ -->
<div class="confirm-overlay"
     id="confirmOverlay"
     style="display:none;">

    <div class="confirm-modal">

        <div class="confirm-icon">

            <svg class="icon icon-lg">
                <use href="#icon-user"></use>
            </svg>

        </div>

        <h3 id="confirmTitle">
            Confirmar cambio
        </h3>

        <p id="confirmText">
        </p>

        <div class="confirm-actions">

            <button type="button"
                    class="secondary-button"
                    id="btnCancel">

                Cancelar

            </button>

            <button type="button"
                    class="confirm-button"
                    id="btnConfirm">

                Confirmar

            </button>

        </div>

    </div>

</div>

@section Scripts
{
    <script>

        document.addEventListener(
            'DOMContentLoaded',
            function() {

                // ========================================================
                // ALERTAS AUTOMATICAS
                // ========================================================

                document
                    .querySelectorAll(
                        '.page-alert')
                    .forEach(
                        function(alert) {

                            setTimeout(
                                function() {

                                    if (!alert.isConnected) {
                                        return;
                                    }

                                    alert.classList.add(
                                        'closing');

                                    setTimeout(
                                        function() {

                                            if (alert.isConnected) {
                                                alert.remove();
                                            }

                                        },
                                        350);

                                },
                                6000);
                        });

                // ========================================================
                // CONFIRMACIÓN TOGGLE
                // ========================================================

                const form =
                    document.getElementById(
                        'toggleForm');

                const overlay =
                    document.getElementById(
                        'confirmOverlay');

                const title =
                    document.getElementById(
                        'confirmTitle');

                const text =
                    document.getElementById(
                        'confirmText');

                const btnCancel =
                    document.getElementById(
                        'btnCancel');

                const btnConfirm =
                    document.getElementById(
                        'btnConfirm');

                if (!form ||
                    !overlay) {

                    return;
                }

                form.addEventListener(
                    'submit',
                    function(event) {

                        event.preventDefault();

                        const active =
                            document
                                .getElementById(
                                    'btnToggle')
                                .dataset.active ===
                            'true';

                        title.textContent =
                            active
                                ? 'Desactivar usuario'
                                : 'Activar usuario';

                        text.textContent =
                            active
                                ? '¿Deseas desactivar esta cuenta? El usuario dejará de tener acceso al sistema.'
                                : '¿Deseas activar esta cuenta y permitir nuevamente el acceso al sistema?';

                        btnConfirm.textContent =
                            active
                                ? 'Desactivar'
                                : 'Activar';

                        btnConfirm.className =
                            active
                                ? 'confirm-button danger'
                                : 'confirm-button success';

                        overlay.style.display =
                            'flex';
                    });

                btnCancel.addEventListener(
                    'click',
                    function() {

                        overlay.style.display =
                            'none';
                    });

                btnConfirm.addEventListener(
                    'click',
                    function() {

                        overlay.style.display =
                            'none';

                        form.submit();
                    });

                overlay.addEventListener(
                    'click',
                    function(event) {

                        if (event.target ===
                            overlay) {

                            overlay.style.display =
                                'none';
                        }
                    });

            });

    </script>
}

<style>

    /* ================================================================
           BASE
           ================================================================ */

    .user-detail-page {
        --navy: #102947;
        --blue: #17488e;
        --blue-light: #226cc2;
        --border: #dce3eb;
        --text: #344357;
        --muted: #7d8999;
        --success: #168957;
        --danger: #d1475b;
        --warning: #d99a24;
    }

    /* ================================================================
           HERO
           ================================================================ */

    .detail-hero {
        min-height: 120px;
        padding: 24px 30px;
        margin-bottom: 17px;
        border-radius: 20px;
        background: linear-gradient( 100deg, #102947 0%, #17488e 49%, #226cc2 100%);
        color: white;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        position: relative;
        overflow: hidden;
    }

        .detail-hero::after {
            content: "";
            position: absolute;
            width: 290px;
            height: 290px;
            top: -140px;
            right: -85px;
            border-radius: 50%;
            background: rgba(255,255,255,.05);
        }

    .hero-left {
        display: flex;
        align-items: center;
        gap: 17px;
        position: relative;
        z-index: 1;
    }

    .hero-avatar {
        width: 62px;
        height: 62px;
        border-radius: 16px;
        background: rgba(255,255,255,.13);
        border: 1px solid rgba(255,255,255,.15);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        font-weight: 850;
        flex-shrink: 0;
    }

    .hero-title-row {
        display: flex;
        align-items: center;
        gap: 9px;
        flex-wrap: wrap;
    }

        .hero-title-row h1 {
            margin: 0;
            font-size: 1.55rem;
            font-weight: 800;
        }

    .hero-status {
        padding: 4px 8px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: .56rem;
        font-weight: 800;
    }

        .hero-status.active {
            background: rgba(62,199,132,.16);
            color: #d7f8e8;
        }

        .hero-status.inactive {
            background: rgba(255,255,255,.1);
            color: rgba(255,255,255,.76);
        }

        .hero-status.blocked {
            background: rgba(231,91,111,.19);
            color: #ffe6ea;
        }

    .hero-subtitle {
        margin-top: 6px;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 6px;
        color: rgba(255,255,255,.72);
        font-size: .72rem;
    }

    .separator {
        opacity: .5;
    }

    .hero-id {
        padding: 3px 7px;
        border-radius: 999px;
        background: rgba(255,255,255,.1);
        color: rgba(255,255,255,.86);
        font-size: .54rem;
        font-weight: 750;
    }

    .hero-actions {
        display: flex;
        gap: 8px;
        position: relative;
        z-index: 1;

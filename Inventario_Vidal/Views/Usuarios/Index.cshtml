@using Inventario_Vidal.DTOs
@model IEnumerable<UsuarioListDto>
@{
    ViewData["Title"] = "Usuarios";
    ViewBag.Subtitle = "Administración de usuarios del sistema";
    var usuarios = Model?.ToList() ?? new List<UsuarioListDto>();
    var totalUsuarios = usuarios.Count;
    var usuariosActivos = usuarios.Count(u => u.Activo);
    var usuariosInactivos = usuarios.Count(u => !u.Activo);
    var usuariosBloqueados = usuarios.Count(u => u.EstaBloqueado);
    var rolesDisponibles = usuarios.Select(u => u.NombreRol).Where(r => !string.IsNullOrWhiteSpace(r)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(r => r).ToList();
}
<div class="audit-page users-audit-page">
    <section class="audit-hero">
        <div class="hero-main">
            <div class="hero-icon"><svg class="icon icon-xl"><use href="#icon-users"></use></svg></div>
            <div><div class="hero-eyebrow">SEGURIDAD Y ACCESOS</div><h1>Usuarios</h1><p>Administra las cuentas, roles y estados de acceso al sistema.</p></div>
        </div>
        <div class="hero-actions">
            <a asp-action="Crear" class="hero-btn light"><svg class="icon icon-sm"><use href="#icon-plus"></use></svg>Nuevo usuario</a>
            <button type="button" class="hero-btn outline" id="btnActualizar"><svg class="icon icon-sm"><use href="#icon-refresh"></use></svg>Actualizar</button>
        </div>
    </section>

    <section class="metrics-grid">
        <article class="metric-card"><div class="metric-icon blue"><svg class="icon"><use href="#icon-users"></use></svg></div><div><span>Total usuarios</span><strong>@totalUsuarios</strong><small>Cuentas registradas</small></div></article>
        <article class="metric-card"><div class="metric-icon green"><svg class="icon"><use href="#icon-check-circle"></use></svg></div><div><span>Activos</span><strong>@usuariosActivos</strong><small>Cuentas habilitadas</small></div></article>
        <article class="metric-card"><div class="metric-icon gold"><svg class="icon"><use href="#icon-x-circle"></use></svg></div><div><span>Inactivos</span><strong>@usuariosInactivos</strong><small>Cuentas deshabilitadas</small></div></article>
        <article class="metric-card"><div class="metric-icon purple"><svg class="icon"><use href="#icon-lock"></use></svg></div><div><span>Bloqueados</span><strong>@usuariosBloqueados</strong><small>Restricción de seguridad</small></div></article>
    </section>
    <section class="filter-card">
        <div class="filter-header"><div class="filter-title"><div class="section-icon"><svg class="icon"><use href="#icon-search"></use></svg></div><div><span>CONSULTA</span><h2>Filtros de usuarios</h2><p>Consulta cuentas por nombre, rol y estado de seguridad.</p></div></div><button type="button" class="filter-toggle" id="btnToggleFilters"><svg class="icon icon-sm"><use href="#icon-search"></use></svg>Filtros</button></div>
        <div id="filterForm" class="filter-body">
            <div class="filter-field"><label for="filtroNombre">Nombre o cuenta</label><input type="search" id="filtroNombre" class="audit-control" placeholder="Buscar usuario..." autocomplete="off" /></div>
            <div class="filter-field"><label for="filtroRol">Rol</label><select id="filtroRol" class="audit-control"><option value="">Todos los roles</option>@foreach (var rol in rolesDisponibles) {
                <option value="@rol">@rol</option>
            }
        </select></div>
        <div class="filter-field"><label for="filtroEstado">Estado</label><select id="filtroEstado" class="audit-control"><option value="">Todos</option><option value="activo">Activos</option><option value="inactivo">Inactivos</option><option value="bloqueado">Bloqueados</option></select></div>
        <div class="filter-field"><label for="pageSize">Registros</label><select id="pageSize" class="audit-control"><option value="15">15</option><option value="30" selected>30</option><option value="50">50</option><option value="100">100</option></select></div>
        <div class="filter-actions"><button type="button" class="btn-secondary" id="btnLimpiar">Limpiar</button><button type="button" class="btn-primary" id="btnAplicar"><svg class="icon icon-sm"><use href="#icon-search"></use></svg>Aplicar filtros</button></div>
    </div>
</section>
<section class="audit-card">
    <div class="audit-card-header"><div class="card-heading"><div class="section-icon"><svg class="icon"><use href="#icon-list"></use></svg></div><div><span>DIRECTORIO</span><h2>Listado de usuarios</h2><p id="resultadosTexto">@totalUsuarios @(totalUsuarios == 1 ? "usuario registrado" : "usuarios registrados")</p></div></div><div class="table-tools"><div class="local-search"><svg class="icon icon-sm"><use href="#icon-search"></use></svg><input type="search" id="localSearch" placeholder="Buscar en el listado..." autocomplete="off" /><button type="button" id="btnClearLocal" aria-label="Limpiar búsqueda" style="display:none;"><svg class="icon icon-sm"><use href="#icon-x"></use></svg></button></div></div></div>
    @if (usuarios.Any())
    {
        <div class="table-wrap">
            <table class="audit-table" id="usuariosTable">
                <thead><tr><th>Usuario</th><th>Cuenta</th><th>Correo</th><th>Rol</th><th class="text-center">Estado</th><th>Último acceso</th><th class="text-center">Seguridad</th><th class="text-center">Acciones</th></tr></thead>
                <tbody>
                    @foreach (var item in usuarios)
                    {
                        var estado = item.EstaBloqueado ? "bloqueado" : item.Activo ? "activo" : "inactivo";
                        <tr data-status="@estado" data-role="@item.NombreRol">
                            <td><div class="user-cell"><div class="user-avatar">@item.Iniciales</div><div><strong>@item.NombreCompleto</strong><span>ID #@item.IdUsuario</span></div></div></td>
                            <td><div class="account-cell"><svg class="icon icon-sm"><use href="#icon-user"></use></svg><span>@item.NombreUsuario</span></div></td>
                            <td>@if (!string.IsNullOrWhiteSpace(item.CorreoElectronico)) {
                                <span class="mail-cell">@item.CorreoElectronico</span>
                            } else
                            {

                                <span class="empty-value">Sin correo</span>
                            }
                        </td>
                        <td><span class="table-badge"><svg class="icon icon-sm"><use href="#icon-shield"></use></svg>@item.NombreRol</span></td>
                        <td class="text-center">@if (item.EstaBloqueado) {
                            <span class="action-badge deactivate"><svg class="icon icon-sm"><use href="#icon-lock"></use></svg>Bloqueado</span>
                        } else
                        {

                            <span class="action-badge @(item.Activo ? "activate" : "logout")"><svg class="icon icon-sm"><use href="#icon-@(item.Activo ? "check-circle" : "x-circle")"></use></svg>@item.EstadoTexto</span>
                        }
                    </td>
                    <td><div class="date-cell">@if (item.UltimoAcceso.HasValue) {
                        <strong>@item.UltimoAcceso.Value.ToString("dd/MM/yyyy")</strong><span>@item.UltimoAcceso.Value.ToString("HH:mm")</span>
                    } else
                    {

                        <strong>Nunca</strong><span>Sin acceso registrado</span>
                    }
                </div></td>
                <td class="text-center">@if (item.EstaBloqueado) {
                    <span class="action-badge deactivate" title="@item.BloqueadoHastaFormateado"><svg class="icon icon-sm"><use href="#icon-lock"></use></svg>Bloqueado</span>
                } else if (item.IntentosFallidos > 0)
                {

                    <span class="action-badge update" title="Intentos de acceso fallidos"><svg class="icon icon-sm"><use href="#icon-alert-triangle"></use></svg>@item.IntentosFallidos @(item.IntentosFallidos == 1 ? "intento" : "intentos")</span>
                }
                else
                {

                    <span class="action-badge activate"><svg class="icon icon-sm"><use href="#icon-check-circle"></use></svg>Normal</span>
                }
            </td>
            <td class="text-center">
                <div class="role-actions">
                    <a asp-action="Detalles" asp-route-id="@item.IdUsuario" class="detail-button" title="Ver detalles" aria-label="Ver detalles de @item.NombreCompleto"><svg class="icon icon-sm"><use href="#icon-eye"></use></svg></a>
                    <a asp-action="Editar" asp-route-id="@item.IdUsuario" class="role-action-edit" title="Editar usuario" aria-label="Editar @item.NombreCompleto"><svg class="icon icon-sm"><use href="#icon-edit"></use></svg></a>
                    <form asp-action="ToggleActivo" asp-route-id="@item.IdUsuario" method="post" class="toggle-form" data-name="@item.NombreCompleto" data-active="@item.Activo.ToString().ToLowerInvariant()">@Html.AntiForgeryToken()<button type="submit" class="role-action-toggle @(item.Activo ? "disable" : "enable")" title="@(item.Activo ? "Desactivar usuario" : "Activar usuario")" aria-label="@(item.Activo ? "Desactivar" : "Activar") @item.NombreCompleto"><svg class="icon icon-sm"><use href="#icon-@(item.Activo ? "x-circle" : "check-circle")"></use></svg></button></form>
                </div>
            </td>
        </tr>
    }
</tbody>
</table>
</div>
<div class="empty-state" id="noLocalResults" style="display:none;"><div class="empty-icon"><svg class="icon icon-xl"><use href="#icon-search"></use></svg></div><h3>No se encontraron coincidencias</h3><p>Modifica los filtros o limpia la búsqueda para ver usuarios.</p><button type="button" class="btn-secondary" id="btnResetLocal">Limpiar búsqueda</button></div>
<div class="pagination-bar"><div class="pagination-info"><span>Mostrando</span><strong id="visibleCount">@totalUsuarios</strong><span>de @totalUsuarios usuarios · Página <strong id="pageInfo">1</strong></span></div><div class="pagination-actions"><button type="button" class="page-button" id="btnPrev"><svg class="icon icon-sm"><use href="#icon-arrow-left"></use></svg>Anterior</button><span class="page-current" id="pageCurrent">1</span><button type="button" class="page-button" id="btnNext">Siguiente<svg class="icon icon-sm"><use href="#icon-arrow-right"></use></svg></button></div></div>
        } else
{
    <div class="empty-state"><div class="empty-icon"><svg class="icon icon-xl"><use href="#icon-users"></use></svg></div><h3>No hay usuarios registrados</h3><p>Registra un usuario para comenzar a administrar sus accesos.</p><a asp-action="Crear" class="btn-primary"><svg class="icon icon-sm"><use href="#icon-plus"></use></svg>Nuevo usuario</a></div>
}
</section>
</div>
@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const table = document.getElementById('usuariosTable');
            const search = document.getElementById('localSearch');
            const name = document.getElementById('filtroNombre');
            const role = document.getElementById('filtroRol');
            const state = document.getElementById('filtroEstado');
            const pageSize = document.getElementById('pageSize');
            const all = table ? Array.from(table.querySelectorAll('tbody tr')) : [];
            let page = 1;
            function filter() {
                const terms = [search?.value || '', name?.value || ''].map(v => v.trim().toLocaleLowerCase());
                const estado = state?.value || '';
                const rol = (role?.value || '').trim().toLocaleLowerCase();
                const match = all.filter(row => terms.every(t => !t || row.textContent.toLocaleLowerCase().includes(t)) && (!estado || row.dataset.status === estado) && (!rol || (row.dataset.role || '').toLocaleLowerCase() === rol));
                const size = Math.max(1, Number(pageSize?.value) || 30);
                const pages = Math.max(1, Math.ceil(match.length / size));
                page = Math.min(Math.max(1, page), pages);
                const start = (page - 1) * size;
                all.forEach(r => r.style.display = 'none');
                match.slice(start, start + size).forEach(r => r.style.display = '');
                document.getElementById('noLocalResults')?.style.setProperty('display', match.length ? 'none' : 'flex');
                const clear = document.getElementById('btnClearLocal'); if (clear) clear.style.display = search?.value ? 'inline-flex' : 'none';
                const visible = document.getElementById('visibleCount'); if (visible) visible.textContent = String(Math.min(size, Math.max(0, match.length - start)));
                const current = document.getElementById('pageCurrent'); if (current) current.textContent = String(page);
                const info = document.getElementById('pageInfo'); if (info) info.textContent = String(page);
                const result = document.getElementById('resultadosTexto'); if (result) result.textContent = match.length + (match.length === 1 ? ' usuario encontrado' : ' usuarios encontrados');
                const prev = document.getElementById('btnPrev'); if (prev) prev.disabled = page <= 1;
                const next = document.getElementById('btnNext'); if (next) next.disabled = page >= pages;
            }
            [search, name].forEach(el => el?.addEventListener('input', () => { page = 1; filter(); }));
            [role, state, pageSize].forEach(el => el?.addEventListener('change', () => { page = 1; filter(); }));
            document.getElementById('btnAplicar')?.addEventListener('click', () => { page = 1; filter(); });
            function reset() { if (search) search.value = ''; if (name) name.value = ''; if (role) role.value = ''; if (state) state.value = ''; if (pageSize) pageSize.value = '30'; page = 1; filter(); }
            document.getElementById('btnLimpiar')?.addEventListener('click', reset);
            document.getElementById('btnResetLocal')?.addEventListener('click', reset);
            document.getElementById('btnClearLocal')?.addEventListener('click', () => { if (search) search.value = ''; page = 1; filter(); search?.focus(); });
            document.getElementById('btnPrev')?.addEventListener('click', () => { if (page > 1) { page--; filter(); } });
            document.getElementById('btnNext')?.addEventListener('click', () => { page++; filter(); });
            document.getElementById('btnActualizar')?.addEventListener('click', () => location.reload());
            document.getElementById('btnToggleFilters')?.addEventListener('click', () => document.getElementById('filterForm')?.classList.toggle('mobile-open'));
            document.querySelectorAll('.toggle-form').forEach(form => form.addEventListener('submit', e => { const active = form.dataset.active === 'true'; const name = form.dataset.name || 'este usuario'; if (!confirm((active ? '¿Desactivar' : '¿Activar') + ' la cuenta de "' + name + '"?')) e.preventDefault(); }));
            document.querySelectorAll('.alert-close').forEach(btn => btn.addEventListener('click', () => btn.closest('.audit-alert')?.remove()));
            filter();
        });
    </script>
}

             PANEL VISUAL
             ======================================================== -->

        <section class="visual-stage">

            <div class="visual-slides"
                 id="visualSlides">

                <div class="visual-slide is-active"
                     data-title="Fabricación especializada"
                     data-caption="Tolvas y soluciones metálicas para operaciones de alta exigencia.">

                    <img src="/images/tolvas-graneleras.jpg"
                         alt="Tolvas graneleras VIDAL"
                         draggable="false"
                         onerror="handleSlideError(this)" />

                </div>

                <div class="visual-slide"
                     data-title="Estructuras con trazabilidad"
                     data-caption="Controla materiales desde el ingreso hasta su utilización en cada proyecto.">

                    <img src="/images/estructuras-metalicas.jpg"
                         alt="Estructuras metálicas VIDAL"
                         draggable="false"
                         onerror="handleSlideError(this)" />

                </div>

                <div class="visual-slide"
                     data-title="Operación industrial integrada"
                     data-caption="Inventario, compras y proyectos conectados en un mismo flujo de trabajo.">

                    <img src="/images/plataformas-industriales.jpg"
                         alt="Plataformas industriales VIDAL"
                         draggable="false"
                         onerror="handleSlideError(this)" />

                </div>

                <div class="visual-slide"
                     data-title="Soluciones a medida"
                     data-caption="Información disponible para identificar materiales y controlar movimientos.">

                    <img src="/images/carrocerias-camionetas.jpg"
                         alt="Carrocerías VIDAL"
                         draggable="false"
                         onerror="handleSlideError(this)" />

                </div>

            </div>

            <div class="visual-overlay"></div>

            <div class="visual-glow"></div>

            <div class="visual-grid"></div>

            <div class="orbit orbit-one"></div>

            <div class="orbit orbit-two"></div>

            <div class="visual-layout">

                <!-- HEADER -->

                <header class="visual-header">

                    <div class="company-brand">

                        <div class="company-logo">

                            <img src="/images/Logo_Vidal.png"
                                 alt="Logo Fabricaciones Vidal"
                                 draggable="false" />

                        </div>

                        <div class="company-copy">

                            <strong>
                                Fabricaciones de Estructuras
                                Metálicas Vidal E.I.R.L.
                            </strong>

                            <span>
                                Sistema logístico integral
                            </span>

                        </div>

                    </div>

                    <div class="online-pill">

                        <span class="online-dot"></span>

                        Plataforma operativa

                    </div>

                </header>

                <!-- HERO -->

                <main class="visual-copy">

                    <div class="visual-kicker">

                        <span class="visual-kicker-dot"></span>

                        GESTIÓN · CONTROL · TRAZABILIDAD

                    </div>

                    <h1 class="visual-title">

                        La operación de VIDAL,

                        <span>
                            conectada de principio a fin.
                        </span>

                    </h1>

                    <p class="visual-description">

                        Una plataforma central para gestionar
                        materiales, presentaciones, proveedores,
                        compras, existencias, proyectos y movimientos
                        con información organizada y trazable.

                    </p>

                    <div class="slide-info">

                        <div class="slide-number"
                             id="slideNumber">
                            01
                        </div>

                        <div class="slide-copy">

                            <strong id="slideTitle">
                                Fabricación especializada
                            </strong>

                            <span id="slideCaption">
                                Tolvas y soluciones metálicas para
                                operaciones de alta exigencia.
                            </span>

                        </div>

                    </div>

                </main>

                <!-- FOOTER -->

                <footer class="visual-footer">

                    <div class="copyright">

                        © @anioActual Fabricaciones Vidal

                        <br />

                        Plataforma logística empresarial

                    </div>

                    <div class="carousel-controls">

                        <button type="button"
                                class="carousel-button"
                                id="btnPrevious"
                                aria-label="Imagen anterior">

                            <svg viewBox="0 0 24 24">

                                <path d="M15 18l-6-6 6-6"></path>

                            </svg>

                        </button>

                        <div class="carousel-timeline">

                            <button type="button"
                                    class="timeline-item is-active"
                                    data-index="0"
                                    aria-label="Ver imagen 1">
                                <span></span>
                            </button>

                            <button type="button"
                                    class="timeline-item"
                                    data-index="1"
                                    aria-label="Ver imagen 2">
                                <span></span>
                            </button>

                            <button type="button"
                                    class="timeline-item"
                                    data-index="2"
                                    aria-label="Ver imagen 3">
                                <span></span>
                            </button>

                            <button type="button"
                                    class="timeline-item"
                                    data-index="3"
                                    aria-label="Ver imagen 4">
                                <span></span>
                            </button>

                        </div>

                        <button type="button"
                                class="carousel-button"
                                id="btnNext"
                                aria-label="Imagen siguiente">

                            <svg viewBox="0 0 24 24">

                                <path d="M9 18l6-6-6-6"></path>

                            </svg>

                        </button>

                    </div>

                </footer>

            </div>

        </section>

        <!-- ========================================================
             PANEL LOGIN
             ======================================================== -->

        <section class="auth-panel">

            <div class="auth-grid"></div>

            <!-- FORMULARIO CENTRAL -->

            <main class="auth-main">

                <div class="auth-kicker">

                    <span></span>

                    ACCESO AL SISTEMA

                </div>

                <h2 class="auth-title">
                    Bienvenido nuevamente
                </h2>

                <p class="auth-description">

                    Identifícate para continuar con la gestión
                    logística y acceder a las herramientas
                    disponibles según tu rol.

                </p>

                @if (
                    !ViewData.ModelState.IsValid &&
                    ViewData.ModelState.Values
                        .Any(
                            value =>
                                value.Errors.Count > 0))
                {
                    <div class="validation-panel">

                        @Html.ValidationSummary(
                            true,
                            "",
                            new
                            {
                                @class =
                                    "mb-0"
                            })

                    </div>
                }

                <form asp-action="Login"
                      asp-controller="Auth"
                      method="post"
                      class="auth-form"
                      id="loginForm">

                    @Html.AntiForgeryToken()

                    <input asp-for="ReturnUrl"
                           type="hidden" />

                    <!-- USUARIO -->

                    <div class="field">

                        <div class="field-head">

                            <label asp-for="Username">
                                Usuario
                            </label>

                            <span class="field-meta">
                                OBLIGATORIO
                            </span>

                        </div>

                        <div class="control">

                            <div class="control-icon">

                                <svg viewBox="0 0 24 24">

                                    <circle cx="12"
                                            cy="8"
                                            r="4"></circle>

                                    <path d="M4.5 20c.8-4 3.2-6 7.5-6s6.7 2 7.5 6"></path>

                                </svg>

                            </div>

                            <input asp-for="Username"
                                   id="Username"
                                   autocomplete="username"
                                   autocapitalize="none"
                                   spellcheck="false"
                                   placeholder="Ingresa tu usuario"
                                   autofocus />

                        </div>

                        <span asp-validation-for="Username"
                              class="field-validation-error">
                        </span>

                    </div>

                    <!-- CONTRASEÑA -->

                    <div class="field">

                        <div class="field-head">

                            <label asp-for="Password">
                                Contraseña
                            </label>

                            <span class="field-meta">
                                OBLIGATORIO
                            </span>

                        </div>

                        <div class="control">

                            <div class="control-icon">

                                <svg viewBox="0 0 24 24">

                                    <rect x="5"
                                          y="10"
                                          width="14"
                                          height="10"
                                          rx="2"></rect>

                                    <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>

                                </svg>

                            </div>

                            <input asp-for="Password"
                                   id="Password"
                                   type="password"
                                   autocomplete="current-password"
                                   placeholder="Ingresa tu contraseña" />

                            <button type="button"
                                    class="password-button"
                                    id="btnTogglePassword"
                                    aria-label="Mostrar contraseña"
                                    title="Mostrar u ocultar contraseña">

                                <svg viewBox="0 0 24 24">

                                    <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"></path>

                                    <circle cx="12"
                                            cy="12"
                                            r="2.7"></circle>

                                </svg>

                            </button>

                        </div>

                        <div class="caps-warning"
                             id="capsLockWarning">

                            Bloq Mayús está activado.

                        </div>

                        <span asp-validation-for="Password"
                              class="field-validation-error">
                        </span>

                    </div>

                    <!-- RECORDAR -->

                    <div class="remember-row">

                        <div class="remember-left">

                            <div class="remember-icon">

                                <svg viewBox="0 0 24 24">

                                    <path d="M7 4h10a2 2 0 0 1 2 2v14l-7-4-7 4V6a2 2 0 0 1 2-2Z"></path>

                                </svg>

                            </div>

                            <div class="remember-copy">

                                <strong>
                                    Recordar sesión
                                </strong>

                                <span>
                                    Mantén el acceso en este dispositivo
                                    durante 30 días.
                                </span>

                            </div>

                        </div>

                        <label class="remember-switch">

                            <input asp-for="RecordarSesion"
                                   id="RecordarSesion" />

                            <span class="remember-track"></span>

                        </label>

                    </div>

                    <!-- BOTÓN -->

                    <button type="submit"
                            class="login-button"
                            id="btnLogin">

                        <span>
                            Ingresar al sistema
                        </span>

                        <svg viewBox="0 0 24 24">

                            <path d="M5 12h14"></path>

                            <path d="M13 6l6 6-6 6"></path>

                        </svg>

                    </button>

                </form>

            </main>

            <!-- FOOTER -->

            <footer class="auth-footer">

                <div class="security-line">

                    <span class="security-item">

                        <svg viewBox="0 0 24 24">

                            <path d="M12 3l7 3v5c0 4.8-2.8 8.2-7 10-4.2-1.8-7-5.2-7-10V6l7-3Z"></path>

                        </svg>

                        Acceso protegido

                    </span>

                    <span class="security-item">

                        <svg viewBox="0 0 24 24">

                            <circle cx="12"
                                    cy="12"
                                    r="9"></circle>

                            <path d="M12 8v4l2.5 2"></path>

                        </svg>

                        Sesión controlada

                    </span>

                    <span class="security-item">

                        <svg viewBox="0 0 24 24">

                            <path d="M4 19V8l8-4 8 4v11"></path>

                            <path d="M8 19v-5h8v5"></path>

                        </svg>

                        Uso empresarial

                    </span>

                </div>

                <div class="footer-copy">

                    Fabricaciones de Estructuras Metálicas
                    Vidal E.I.R.L. · Sistema Logístico
                    · @anioActual

                </div>

            </footer>

        </section>

    </div>

    <script>

        // ============================================================
        // FALLBACK IMÁGENES
        // ============================================================

        function handleSlideError(
            image)
        {
            const slide =
                image.closest(
                    '.visual-slide');

            image.style.display =
                'none';

            if (slide)
            {
                slide.style.background =
                    'linear-gradient(135deg,#07182c,#102947 55%,#17488e)';
            }
        }

        // ============================================================
        // APP
        // ============================================================

        document.addEventListener(
            'DOMContentLoaded',
            function ()
            {
                const slides =
                    Array.from(
                        document.querySelectorAll(
                            '.visual-slide'));

                const timelineItems =
                    Array.from(
                        document.querySelectorAll(
                            '.timeline-item'));

                const previousButton =
                    document.getElementById(
                        'btnPrevious');

                const nextButton =
                    document.getElementById(
                        'btnNext');

                const slideNumber =
                    document.getElementById(
                        'slideNumber');

                const slideTitle =
                    document.getElementById(
                        'slideTitle');

                const slideCaption =
                    document.getElementById(
                        'slideCaption');

                const password =
                    document.getElementById(
                        'Password');

                const togglePassword =
                    document.getElementById(
                        'btnTogglePassword');

                const capsWarning =
                    document.getElementById(
                        'capsLockWarning');

                const loginForm =
                    document.getElementById(
                        'loginForm');

                const loginButton =
                    document.getElementById(
                        'btnLogin');

                const reducedMotion =
                    window.matchMedia(
                        '(prefers-reduced-motion: reduce)')
                        .matches;

                const SLIDE_TIME =
                    reducedMotion
                        ? 12000
                        : 6000;

                let currentSlide =
                    0;

                let carouselTimer =
                    null;

                // ====================================================
                // PRELOAD
                // ====================================================

                slides.forEach(
                    function (slide)
                    {
                        const source =
                            slide.querySelector(
                                'img')
                                ?.src;

                        if (!source)
                            return;

                        const preloaded =
                            new Image();

                        preloaded.src =
                            source;
                    });

                // ====================================================
                // INFORMACIÓN SLIDE
                // ====================================================

                function updateSlideInfo(
                    index)
                {
                    const slide =
                        slides[index];

                    if (!slide)
                        return;

                    slideNumber.textContent =
                        String(
                            index + 1)
                            .padStart(
                                2,
                                '0');

                    slideTitle.textContent =
                        slide.dataset.title
                        ?? '';

                    slideCaption.textContent =
                        slide.dataset.caption
                        ?? '';
                }

                // ====================================================
                // TIMELINE
                // ====================================================

                function updateTimeline(
                    index)
                {
                    timelineItems.forEach(
                        function (
                            item,
                            itemIndex)
                        {
                            item.classList.remove(
                                'is-active');

                            if (
                                itemIndex ===
                                index)
                            {
                                void item.offsetWidth;

                                item.classList.add(
                                    'is-active');
                            }
                        });
                }

                // ====================================================
                // TIMER
                // ====================================================

                function clearTimer()
                {
                    if (!carouselTimer)
                        return;

                    window.clearTimeout(
                        carouselTimer);

                    carouselTimer =
                        null;
                }

                function scheduleNext()
                {
                    clearTimer();

                    if (
                        slides.length <= 1 ||
                        document.hidden)
                    {
                        return;
                    }

                    carouselTimer =
                        window.setTimeout(
                            function ()
                            {
                                showSlide(
                                    currentSlide + 1);
                            },
                            SLIDE_TIME);
                }

                // ====================================================
                // MOSTRAR SLIDE
                // ====================================================

                function showSlide(
                    index)
                {
                    if (!slides.length)
                        return;

                    currentSlide =
                        (
                            index +
                            slides.length
                        ) %
                        slides.length;

                    slides.forEach(
                        function (
                            slide,
                            slideIndex)
                        {
                            slide.classList.toggle(
                                'is-active',
                                slideIndex ===
                                    currentSlide);
                        });

                    updateSlideInfo(
                        currentSlide);

                    updateTimeline(
                        currentSlide);

                    scheduleNext();
                }

                // ====================================================
                // BOTONES
                // ====================================================

                previousButton
                    ?.addEventListener(
                        'click',
                        function ()
                        {
                            showSlide(
                                currentSlide - 1);
                        });

                nextButton
                    ?.addEventListener(
                        'click',
                        function ()
                        {
                            showSlide(
                                currentSlide + 1);
                        });

                timelineItems.forEach(
                    function (item)
                    {
                        item.addEventListener(
                            'click',
                            function ()
                            {
                                const index =
                                    Number(
                                        item.dataset.index);

                                if (
                                    Number.isNaN(
                                        index))
                                {
                                    return;
                                }

                                showSlide(
                                    index);
                            });
                    });

                // ====================================================
                // VISIBILITY
                // ====================================================

                document.addEventListener(
                    'visibilitychange',
                    function ()
                    {
                        if (document.hidden)
                        {
                            clearTimer();
                        }
                        else
                        {
                            scheduleNext();
                        }
                    });

                // ====================================================
                // PASSWORD
                // ====================================================

                togglePassword
                    ?.addEventListener(
                        'click',
                        function ()
                        {
                            if (!password)
                                return;

                            const visible =
                                password.type ===
                                'text';

                            password.type =
                                visible
                                    ? 'password'
                                    : 'text';

                            togglePassword
                                .setAttribute(
                                    'aria-label',
                                    visible
                                        ? 'Mostrar contraseña'
                                        : 'Ocultar contraseña');

                            password.focus();
                        });

                // ====================================================
                // CAPS LOCK
                // ====================================================

                function updateCapsLock(
                    event)
                {
                    if (!capsWarning)
                        return;

                    const active =
                        event.getModifierState &&
                        event.getModifierState(
                            'CapsLock');

                    capsWarning
                        .classList
                        .toggle(
                            'is-visible',
                            Boolean(
                                active));
                }

                password
                    ?.addEventListener(
                        'keydown',
                        updateCapsLock);

                password
                    ?.addEventListener(
                        'keyup',
                        updateCapsLock);

                password
                    ?.addEventListener(
                        'blur',
                        function ()
                        {
                            capsWarning
                                ?.classList
                                .remove(
                                    'is-visible');
                        });

                // ====================================================
                // SUBMIT
                // ====================================================
                // No mostramos una pantalla intermedia.
                // El POST va directo al AuthController y, si las
                // credenciales son correctas, abre Bienvenida.

                loginForm
                    ?.addEventListener(
                        'submit',
                        function ()
                        {
                            if (loginButton)
                            {
                                loginButton.disabled = true;
                            }
                        });

                // ====================================================
                // INICIO
                // ====================================================

                updateSlideInfo(
                    currentSlide);

                updateTimeline(
                    currentSlide);

                scheduleNext();
            });

    </script>

</body>

</html>

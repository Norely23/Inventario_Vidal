@model Inventario_Vidal.DTOs.LoginRequestDto

@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = null;

    var empresaNombre =
        ViewBag.EmpresaNombre as string
        ?? "Fabricaciones de Estructuras Metálicas Vidal E.I.R.L.";

    var anioActual =
        DateTime.Now.Year;
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <meta name="theme-color"
          content="#0b203a" />

    <title>
        Iniciar sesión - @empresaNombre
    </title>

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
          rel="stylesheet" />

    <style>

        /* ============================================================
           01. TOKENS
           ============================================================ */

        :root {

            --navy-1000:
                #061426;

            --navy-950:
                #081a30;

            --navy-900:
                #0d2441;

            --navy-850:
                #102947;

            --navy-800:
                #12365f;

            --blue-750:
                #16427c;

            --blue-700:
                #17488e;

            --blue-650:
                #1c579f;

            --blue-600:
                #226cc2;

            --blue-550:
                #2b78d0;

            --blue-500:
                #3a88d9;

            --blue-400:
                #67a8e9;

            --blue-300:
                #8fc4ff;

            --blue-200:
                #cbe3fb;

            --blue-100:
                #eaf3fd;

            --blue-75:
                #f3f8fd;

            --green-700:
                #0f724c;

            --green-600:
                #168957;

            --green-500:
                #22a36c;

            --green-100:
                #e9f7f0;

            --red-700:
                #a73448;

            --red-600:
                #c93f55;

            --red-100:
                #fff0f2;

            --amber-700:
                #946215;

            --amber-600:
                #b67916;

            --amber-100:
                #fff6e4;

            --ink-950:
                #152638;

            --ink-900:
                #20334a;

            --ink-850:
                #2a3e55;

            --ink-800:
                #34485e;

            --ink-700:
                #4b6075;

            --ink-600:
                #637689;

            --ink-500:
                #7d8d9f;

            --ink-450:
                #8998a7;

            --ink-400:
                #9aa7b5;

            --line-300:
                #c8d3df;

            --line-250:
                #d1dbe5;

            --line-200:
                #dce4ec;

            --line-150:
                #e7edf3;

            --surface-100:
                #eef3f8;

            --surface-75:
                #f4f7fb;

            --surface-50:
                #f9fbfd;

            --white:
                #ffffff;

            --radius-xs:
                8px;

            --radius-sm:
                10px;

            --radius-md:
                14px;

            --radius-lg:
                18px;

            --radius-xl:
                22px;

            --radius-pill:
                999px;

            --shadow-control:
                0 10px 28px
                rgba(23, 72, 142, .10);

            --shadow-primary:
                0 18px 42px
                rgba(23, 72, 142, .26);

            --ease:
                cubic-bezier(
                    .2,
                    .74,
                    .2,
                    1);

            --font:
                "Inter",
                "Segoe UI",
                Roboto,
                Arial,
                sans-serif;
        }

        /* ============================================================
           02. RESET
           ============================================================ */

        *,
        *::before,
        *::after {

            box-sizing:
                border-box;

        }

        html,
        body {

            width:
                100%;

            min-height:
                100%;

            margin:
                0;

            padding:
                0;

        }

        html {

            background:
                var(
                    --navy-950);

        }

        body {

            min-height:
                100vh;

            overflow:
                hidden;

            font-family:
                var(
                    --font);

            color:
                var(
                    --ink-900);

            background:
                var(
                    --navy-950);

            -webkit-font-smoothing:
                antialiased;

            text-rendering:
                optimizeLegibility;

        }

        button,
        input {

            font:
                inherit;

        }

        button {

            -webkit-tap-highlight-color:
                transparent;

        }

        ::selection {

            color:
                #fff;

            background:
                var(
                    --blue-700);

        }

        /* ============================================================
           03. LAYOUT GENERAL
           ============================================================ */

        .login-shell {

            width:
                100%;

            height:
                100vh;

            display:
                grid;

            grid-template-columns:
                minmax(
                    0,
                    66%)
                minmax(
                    400px,
                    34%);

            overflow:
                hidden;

            background:
                #fff;

        }

        /* ============================================================
           04. LADO VISUAL
           ============================================================ */

        .visual-stage {

            min-width:
                0;

            height:
                100vh;

            position:
                relative;

            overflow:
                hidden;

            isolation:
                isolate;

            color:
                #fff;

            background:
                var(
                    --navy-950);

        }

        /* ============================================================
           05. SLIDES
           ============================================================ */

        .visual-slides {

            position:
                absolute;

            inset:
                0;

            z-index:
                -6;

            overflow:
                hidden;

            background:
                linear-gradient(
                    135deg,
                    var(--navy-950),
                    var(--blue-700));

        }

        .visual-slide {

            position:
                absolute;

            inset:
                0;

            opacity:
                0;

            visibility:
                hidden;

            transform:
                scale(
                    1.07);

            transition:

                opacity
                    1.25s
                    ease,

                visibility
                    1.25s
                    ease,

                transform
                    8s
                    linear;

            will-change:
                opacity,
                transform;

        }

        .visual-slide.is-active {

            opacity:
                1;

            visibility:
                visible;

            transform:
                scale(
                    1);

        }

        .visual-slide img {

            width:
                100%;

            height:
                100%;

            display:
                block;

            object-fit:
                cover;

            object-position:
                center;

            user-select:
                none;

            pointer-events:
                none;

        }

        /* ============================================================
           06. OVERLAY
           ============================================================ */

        .visual-overlay {

            position:
                absolute;

            inset:
                0;

            z-index:
                -5;

            pointer-events:
                none;

            background:

                linear-gradient(
                    92deg,
                    rgba(
                        5,
                        20,
                        38,
                        .95)
                        0%,
                    rgba(
                        7,
                        29,
                        54,
                        .82)
                        36%,
                    rgba(
                        10,
                        48,
                        91,
                        .54)
                        68%,
                    rgba(
                        15,
                        65,
                        121,
                        .24)
                        100%),

                linear-gradient(
                    to top,
                    rgba(
                        5,
                        20,
                        38,
                        .85)
                        0%,
                    transparent
                        52%);

        }

        .visual-glow {

            position:
                absolute;

            inset:
                0;

            z-index:
                -4;

            pointer-events:
                none;

            background:

                radial-gradient(
                    circle
                    at
                    18%
                    16%,
                    rgba(
                        123,
                        193,
                        255,
                        .17),
                    transparent
                        24%),

                radial-gradient(
                    circle
                    at
                    75%
                    86%,
                    rgba(
                        34,
                        108,
                        194,
                        .21),
                    transparent
                        35%);

        }

        .visual-grid {

            position:
                absolute;

            inset:
                0;

            z-index:
                -3;

            opacity:
                .075;

            pointer-events:
                none;

            background-image:

                linear-gradient(
                    rgba(
                        255,
                        255,
                        255,
                        .18)
                        1px,
                    transparent
                        1px),

                linear-gradient(
                    90deg,
                    rgba(
                        255,
                        255,
                        255,
                        .18)
                        1px,
                    transparent
                        1px);

            background-size:
                62px
                62px;

            mask-image:
                linear-gradient(
                    90deg,
                    #000
                        0%,
                    rgba(
                        0,
                        0,
                        0,
                        .85)
                        67%,
                    transparent
                        100%);

        }

        /* ============================================================
           07. ORBITAS
           ============================================================ */

        .orbit {

            position:
                absolute;

            z-index:
                -2;

            border-radius:
                50%;

            pointer-events:
                none;

        }

        .orbit-one {

            width:
                540px;

            height:
                540px;

            right:
                -245px;

            top:
                -225px;

            border:
                1px solid
                rgba(
                    255,
                    255,
                    255,
                    .09);

            box-shadow:

                0
                0
                0
                76px
                rgba(
                    255,
                    255,
                    255,
                    .024),

                0
                0
                0
                150px
                rgba(
                    255,
                    255,
                    255,
                    .013);

            animation:
                orbitMove
                10s
                ease-in-out
                infinite;

        }

        .orbit-two {

            width:
                440px;

            height:
                440px;

            left:
                -225px;

            bottom:
                -215px;

            background:
                radial-gradient(
                    circle,
                    rgba(
                        79,
                        164,
                        241,
                        .30),
                    transparent
                        69%);

            animation:
                orbitMove
                12s
                ease-in-out
                infinite
                reverse;

        }

        @@keyframes orbitMove {

            0%,
            100% {

                transform:
                    translateY(
                        0);

            }

            50% {

                transform:
                    translateY(
                        -20px);

            }

        }

        /* ============================================================
           08. ESTRUCTURA VISUAL
           ============================================================ */

        .visual-layout {

            height:
                100%;

            padding:
                34px
                clamp(
                    32px,
                    4.5vw,
                    70px)
                32px;

            display:
                flex;

            flex-direction:
                column;

            justify-content:
                space-between;

            gap:
                28px;

        }

        /* ============================================================
           09. BRAND
           ============================================================ */

        .visual-header {

            display:
                flex;

            align-items:
                center;

            justify-content:
                space-between;

            gap:
                18px;

        }

        .company-brand {

            min-width:
                0;

            display:
                flex;

            align-items:
                center;

            gap:
                15px;

        }

        .company-logo {

            width:
                82px;

            height:
                82px;

            flex-shrink:
                0;

            position:
                relative;

            overflow:
                hidden;

            border:
                1px solid
                rgba(
                    255,
                    255,
                    255,
                    .18);

            border-radius:
                18px;

            background:
                rgba(
                    7,
                    25,
                    46,
                    .55);

            display:
                flex;

            align-items:
                center;

            justify-content:
                center;

            box-shadow:
                0
                14px
                38px
                rgba(
                    0,
                    0,
                    0,
                    .22);

            backdrop-filter:
                blur(
                    10px);

        }

        .company-logo img {

            width:
                100%;

            height:
                100%;

            display:
                block;

            object-fit:
                contain;

            padding:
                5px;

            filter:
                drop-shadow(
                    0
                    7px
                    12px
                    rgba(
                        0,
                        0,
                        0,
                        .20));

        }

        .company-copy strong,
        .company-copy span {

            display:
                block;

        }

        .company-copy strong {

            max-width:
                430px;

            color:
                #fff;

            font-size:
                1.05rem;

            font-weight:
                850;

            line-height:
                1.25;

        }

        .company-copy span {

            margin-top:
                5px;

            color:
                rgba(
                    255,
                    255,
                    255,
                    .62);

            font-size:
                .72rem;

            font-weight:
                650;

            letter-spacing:
                .70px;

            text-transform:
                uppercase;

        }

        .online-pill {

            min-height:
                42px;

            padding:
                0
                14px;

            border:
                1px solid
                rgba(
                    255,
                    255,
                    255,
                    .14);

            border-radius:
                var(
                    --radius-pill);

            background:
                rgba(
                    255,
                    255,
                    255,
                    .085);

            display:
                inline-flex;

            align-items:
                center;

            gap:
                9px;

            color:
                rgba(
                    255,
                    255,
                    255,
                    .86);

            font-size:
                .70rem;

            font-weight:
                720;

            backdrop-filter:
                blur(
                    12px);

        }

        .online-dot {

            width:
                8px;

            height:
                8px;

            border-radius:
                50%;

            background:
                #63d7a7;

            box-shadow:
                0
                0
                0
                5px
                rgba(
                    99,
                    215,
                    167,
                    .11);

            animation:
                onlinePulse
                2.2s
                ease-in-out
                infinite;

        }

        @@keyframes onlinePulse {

            0%,
            100% {

                box-shadow:
                    0
                    0
                    0
                    5px
                    rgba(
                        99,
                        215,
                        167,
                        .11);

            }

            50% {

                box-shadow:
                    0
                    0
                    0
                    9px
                    rgba(
                        99,
                        215,
                        167,
                        .03);

            }

        }

        /* ============================================================
           10. HERO
           ============================================================ */

        .visual-copy {

            width:
                min(
                    790px,
                    93%);

            margin:
                auto
                0;

        }

        .visual-kicker {

            min-height:
                36px;

            padding:
                0
                13px;

            border:
                1px solid
                rgba(
                    255,
                    255,
                    255,
                    .14);

            border-radius:
                var(
                    --radius-pill);

            background:
                rgba(
                    255,
                    255,
                    255,
                    .075);

            display:
                inline-flex;

            align-items:
                center;

            gap:
                9px;

            color:
                rgba(
                    255,
                    255,
                    255,
                    .86);

            font-size:
                .68rem;

            font-weight:
                840;

            letter-spacing:
                .96px;

            backdrop-filter:
                blur(
                    10px);

        }

        .visual-kicker-dot {

            width:
                8px;

            height:
                8px;

            border-radius:
                50%;

            background:
                var(
                    --blue-300);

            box-shadow:
                0
                0
                0
                5px
                rgba(
                    143,
                    196,
                    255,
                    .10);

        }

        .visual-title {

            max-width:
                790px;

            margin:
                20px
                0
                0;

            color:
                #fff;

            font-size:
                clamp(
                    2.70rem,
                    4.35vw,
                    5.20rem);

            font-weight:
                880;

            line-height:
                .98;

            letter-spacing:
                -2.7px;

            text-wrap:
                balance;

        }

        .visual-title span {

            color:
                #acd5ff;

        }

        .visual-description {

            max-width:
                650px;

            margin:
                21px
                0
                0;

            color:
                rgba(
                    255,
                    255,
                    255,
                    .72);

            font-size:
                1.03rem;

            font-weight:
                430;

            line-height:
                1.72;

        }

        /* ============================================================
           11. SLIDE INFO
           ============================================================ */

        .slide-info {

            width:
                min(
                    690px,
                    100%);

            min-height:
                92px;

            margin-top:
                30px;

            padding:
                15px
                17px;

            position:
                relative;

            overflow:
                hidden;

            border:
                1px solid
                rgba(
                    255,
                    255,
                    255,
                    .12);

            border-radius:
                16px;

            background:
                rgba(
                    7,
                    27,
                    49,
                    .34);

            display:
                flex;

            align-items:
                center;

            gap:
                15px;

            backdrop-filter:
                blur(
                    13px);

        }

        .slide-info::before {

            content:
                "";

            position:
                absolute;

            left:
                0;

            top:
                0;

            bottom:
                0;

            width:
                3px;

            background:
                linear-gradient(
                    to bottom,
                    var(
                        --blue-300),
                    var(
                        --blue-600));

        }

        .slide-number {

            width:
                48px;

            height:
                48px;

            flex-shrink:
                0;

            border:
                1px solid
                rgba(
                    255,
                    255,
                    255,
                    .12);

            border-radius:
                12px;

            background:
                rgba(
                    255,
                    255,
                    255,
                    .10);

            color:
                #fff;

            display:
                flex;

            align-items:
                center;

            justify-content:
                center;

            font-size:
                .78rem;

            font-weight:
                900;

        }

        .slide-copy strong,
        .slide-copy span {

            display:
                block;

        }

        .slide-copy strong {

            color:
                #fff;

            font-size:
                .82rem;

            font-weight:
                810;

        }

        .slide-copy span {

            margin-top:
                4px;

            color:
                rgba(
                    255,
                    255,
                    255,
                    .62);

            font-size:
                .69rem;

            line-height:
                1.48;

        }

        /* ============================================================
           12. FOOTER VISUAL
           ============================================================ */

        .visual-footer {

            display:
                flex;

            align-items:
                flex-end;

            justify-content:
                space-between;

            gap:
                20px;

        }

        .copyright {

            color:
                rgba(
                    255,
                    255,
                    255,
                    .48);

            font-size:
                .64rem;

            line-height:
                1.5;

        }

        .carousel-controls {

            display:
                flex;

            align-items:
                center;

            gap:
                10px;

        }

        .carousel-button {

            width:
                42px;

            height:
                42px;

            border:
                1px solid
                rgba(
                    255,
                    255,
                    255,
                    .15);

            border-radius:
                11px;

            background:
                rgba(
                    255,
                    255,
                    255,
                    .075);

            color:
                #fff;

            display:
                flex;

            align-items:
                center;

            justify-content:
                center;

            cursor:
                pointer;

            backdrop-filter:
                blur(
                    9px);

            transition:

                background
                    .18s
                    ease,

                border-color
                    .18s
                    ease,

                transform
                    .18s
                    ease;

        }

        .carousel-button:hover {

            background:
                rgba(
                    255,
                    255,
                    255,
                    .15);

            border-color:
                rgba(
                    255,
                    255,
                    255,
                    .26);

            transform:
                translateY(
                    -1px);

        }

        .carousel-button svg {

            width:
                19px;

            height:
                19px;

            fill:
                none;

            stroke:
                currentColor;

            stroke-width:
                2;

            stroke-linecap:
                round;

            stroke-linejoin:
                round;

        }

        .carousel-timeline {

            display:
                flex;

            align-items:
                center;

            gap:
                7px;

        }

        .timeline-item {

            width:
                40px;

            height:
                5px;

            padding:
                0;

            overflow:
                hidden;

            border:
                0;

            border-radius:
                var(
                    --radius-pill);

            background:
                rgba(
                    255,
                    255,
                    255,
                    .20);

            cursor:
                pointer;

        }

        .timeline-item span {

            width:
                100%;

            height:
                100%;

            display:
                block;

            background:
                #fff;

            border-radius:
                inherit;

            transform:
                scaleX(
                    0);

            transform-origin:
                left;

        }

        .timeline-item.is-active span {

            animation:
                timelineFill
                6s
                linear
                forwards;

        }

        @@keyframes timelineFill {

            from {

                transform:
                    scaleX(
                        0);

            }

            to {

                transform:
                    scaleX(
                        1);

            }

        }

        /* ============================================================
           13. PANEL DERECHO
           ============================================================ */

        .auth-panel {

            min-width:
                0;

            height:
                100vh;

            position:
                relative;

            overflow:
                hidden;

            background:
                linear-gradient(
                    180deg,
                    #fbfcfe
                        0%,
                    #f3f7fb
                        100%);

            display:
                grid;

            grid-template-rows:
                1fr
                auto;

            padding:
                32px
                clamp(
                    34px,
                    4vw,
                    58px)
                28px;

            z-index:
                4;

            box-shadow:
                -20px
                0
                60px
                rgba(
                    5,
                    25,
                    47,
                    .09);

        }

        .auth-panel::before {

            content:
                "";

            position:
                absolute;

            width:
                520px;

            height:
                520px;

            right:
                -310px;

            top:
                -260px;

            border-radius:
                50%;

            background:
                radial-gradient(
                    circle,
                    rgba(
                        34,
                        108,
                        194,
                        .14),
                    transparent
                        70%);

            animation:
                panelGlow
                11s
                ease-in-out
                infinite;

            pointer-events:
                none;

        }

        .auth-panel::after {

            content:
                "";

            position:
                absolute;

            width:
                420px;

            height:
                420px;

            left:
                -285px;

            bottom:
                -235px;

            border-radius:
                50%;

            background:
                radial-gradient(
                    circle,
                    rgba(
                        88,
                        158,
                        226,
                        .12),
                    transparent
                        70%);

            animation:
                panelGlow
                13s
                ease-in-out
                infinite
                reverse;

            pointer-events:
                none;

        }

        @@keyframes panelGlow {

            0%,
            100% {

                transform:
                    translateY(
                        0)
                    scale(
                        1);

            }

            50% {

                transform:
                    translateY(
                        20px)

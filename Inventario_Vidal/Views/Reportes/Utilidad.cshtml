@using Inventario_Vidal.DTOs
@model IEnumerable<ReporteUtilidadDto>

@{
    ViewData["Title"] = "Reporte de Utilidad por Proyecto";
    ViewBag.Subtitle = "Rentabilidad de cada proyecto";

    var totalRegistros = ViewBag.TotalRegistros ?? 0;
    var totalIngresos = ViewBag.TotalIngresos ?? 0m;
    var totalCostos = ViewBag.TotalCostos ?? 0m;
    var totalUtilidad = ViewBag.TotalUtilidad ?? 0m;
    var margenPromedio = ViewBag.MargenPromedio ?? 0m;
    var proyectosGanancia = ViewBag.ProyectosGanancia ?? 0;
    var proyectosPerdida = ViewBag.ProyectosPerdida ?? 0;
}

<div class="reports-unified-page users-page">
    <section class="vidal-report-hero" aria-labelledby="report-utilidad-title">
        <div class="vidal-report-hero-main">
            <div class="vidal-report-hero-icon">
                <svg class="icon icon-xl"><use href="#icon-dollar"></use></svg>
            </div>
            <div class="vidal-report-hero-copy">
                <span class="vidal-report-hero-eyebrow">CENTRO DE REPORTES</span>
                <h1 id="report-utilidad-title">Reporte de utilidad por proyecto</h1>
                <p>Consulta ingresos, costos y rentabilidad de cada proyecto.</p>
            </div>
        </div>
        <div class="vidal-report-hero-actions">
            <a asp-action="Index" class="vidal-report-hero-btn outline">
                <svg class="icon icon-sm"><use href="#icon-arrow-left"></use></svg>Volver a reportes
            </a>
            <a asp-action="ExportarUtilidadExcel" class="vidal-report-hero-btn light">
                <svg class="icon icon-sm"><use href="#icon-download"></use></svg>Excel
            </a>
            <a asp-action="ExportarUtilidadPdf" class="vidal-report-hero-btn light">
                <svg class="icon icon-sm"><use href="#icon-printer"></use></svg>PDF
            </a>
            <button type="button" class="vidal-report-hero-btn outline" onclick="window.print()">
                <svg class="icon icon-sm"><use href="#icon-print"></use></svg>Imprimir
            </button>
        </div>
    </section>

    @* Indicadores en la parte superior, siguiendo el patrón oficial de Proveedores. *@
    <div class="row g-3 mb-4">

        <div class="col-md-3 col-6">
            <div class="stat-card">
                <div class="stat-card-icon" style="background: rgba(13, 110, 253, 0.12); color: #0d6efd;">
                    <svg class="icon"><use href="#icon-folder"></use></svg>
                </div>
                <div class="stat-card-info">
                    <span class="stat-card-label">Total Proyectos</span>

                    <span class="stat-card-value">@totalRegistros</span>

                    <span class="stat-card-description">Proyectos incluidos en el reporte</span>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-6">
            <div class="stat-card">
                <div class="stat-card-icon" style="background: rgba(25, 135, 84, 0.12); color: #198754;">
                    <svg class="icon"><use href="#icon-check-circle"></use></svg>
                </div>
                <div class="stat-card-info">
                    <span class="stat-card-label">En Ganancia</span>

                    <span class="stat-card-value">@proyectosGanancia</span>

                    <span class="stat-card-description">Proyectos con utilidad positiva</span>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-6">
            <div class="stat-card">
                <div class="stat-card-icon" style="background: rgba(220, 53, 69, 0.12); color: #dc3545;">
                    <svg class="icon"><use href="#icon-x-circle"></use></svg>
                </div>
                <div class="stat-card-info">
                    <span class="stat-card-label">En Pérdida</span>

                    <span class="stat-card-value">@proyectosPerdida</span>

                    <span class="stat-card-description">Proyectos con resultado negativo</span>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-6">
            <div class="stat-card">
                <div class="stat-card-icon" style="background: rgba(111, 66, 193, 0.12); color: #6f42c1;">
                    <svg class="icon"><use href="#icon-dollar"></use></svg>
                </div>
                <div class="stat-card-info">
                    <span class="stat-card-label">Margen Promedio</span>

                    <span class="stat-card-value">@margenPromedio.ToString("N1")%</span>

                    <span class="stat-card-description">Rentabilidad promedio del reporte</span>
                </div>
            </div>
        </div>

    </div>

    @* Los filtros se colocan debajo de los indicadores. *@
    <div class="card-modern mb-4">
        <div class="card-header">
            <div class="d-flex align-items-center gap-2">
                <svg class="icon"><use href="#icon-filter"></use></svg>
                <div class="vidal-section-copy">
                    <span class="vidal-section-eyebrow">CONSULTA</span>
                    <strong class="vidal-section-title">Filtros de utilidad</strong>
                    <small class="vidal-section-description">Consulta los proyectos por resultado y período.</small>
                </div>
            </div>
            <div class="ms-auto">
                <span class="badge bg-secondary">@totalRegistros proyectos</span>
            </div>
        </div>
        <div class="card-body">
            <form method="get" asp-action="Utilidad" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label small fw-bold">Buscar Proyecto</label>
                    <input type="text" name="search" class="form-control" placeholder="Código o nombre..." value="@ViewBag.Search" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold">Resultado</label>
                    <select name="resultado" class="form-control">
                        <option value="">-- Todos --</option>
                        <option value="ganancia" selected="@(ViewBag.Resultado == "ganancia" ? "selected" : null)">Con Ganancia</option>
                        <option value="perdida" selected="@(ViewBag.Resultado == "perdida" ? "selected" : null)">Con Pérdida</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold">Desde</label>
                    <input type="date" name="desde" class="form-control" value="@ViewBag.Desde?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold">Hasta</label>
                    <input type="date" name="hasta" class="form-control" value="@ViewBag.Hasta?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary-dark w-100">
                        <svg class="icon icon-sm"><use href="#icon-search"></use></svg>
                        Filtrar
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="card-modern">
        <div class="card-header">
            <div class="d-flex align-items-center gap-2">
                <svg class="icon"><use href="#icon-list"></use></svg>
                <div class="vidal-section-copy">
                    <span class="vidal-section-eyebrow">RESULTADOS</span>
                    <strong class="vidal-section-title">Listado de utilidad por proyecto</strong>
                    <small class="vidal-section-description">Ingresos, costos, utilidad y margen de cada proyecto.</small>
                </div>
                <span class="badge bg-secondary ms-2">@totalRegistros registros</span>
            </div>
            <div class="ms-auto">
                <div class="input-group" style="width: 250px;">
                    <span class="input-group-text bg-transparent border-end-0">
                        <svg class="icon icon-sm"><use href="#icon-search"></use></svg>
                    </span>
                    <input type="text" class="form-control border-start-0" id="searchInput" placeholder="Buscar proyecto..." />
                </div>
            </div>
        </div>
        <div class="card-body p-0">

            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table-modern table-hover mb-0" id="utilidadTable">
                        <thead>
                            <tr>
                                <th style="width: 5%;">#</th>
                                <th style="width: 12%;">Código</th>
                                <th style="width: 20%;">Proyecto</th>
                                <th style="width: 12%;">Cliente</th>
                                <th style="width: 10%;">Fecha</th>
                                <th style="width: 12%;">Ingresos</th>
                                <th style="width: 12%;">Costos</th>
                                <th style="width: 10%;">Utilidad</th>
                                <th style="width: 7%;">Margen</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int counter = 1;
                            }
                            @foreach (var item in Model)
                            {
                                var utilidadColor = item.Utilidad >= 0 ? "text-success" : "text-danger";
                                var margenColor = item.Margen >= 10 ? "bg-success" : item.Margen >= 0 ? "bg-warning" : "bg-danger";
                                <tr class="@(item.Utilidad < 0 ? "table-danger opacity-75" : "")">
                                    <td>@counter</td>
                                    <td>
                                        <code>@item.Codigo</code>
                                    </td>
                                    <td>
                                        <span class="fw-semibold">@item.Nombre</span>
                                    </td>
                                    <td>
                                        <span>@item.Cliente</span>
                                    </td>
                                    <td>
                                        <span class="small">@item.FechaInicio.ToString("dd/MM/yyyy")</span>
                                    </td>
                                    <td>
                                        <span class="fw-semibold text-success">S/ @item.Ingresos.ToString("N2")</span>
                                    </td>
                                    <td>
                                        <span class="fw-semibold text-danger">S/ @item.Costos.ToString("N2")</span>
                                    </td>
                                    <td>
                                        <span class="fw-bold @utilidadColor">
                                            <svg class="icon icon-sm">
                                                <use href="#icon-@(item.Utilidad >= 0 ? "check-circle" : "x-circle")"></use>
                                            </svg>
                                            S/ @item.Utilidad.ToString("N2")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge @margenColor">
                                            @item.Margen.ToString("N1")%
                                        </span>
                                    </td>
                                </tr>
                                counter++;
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <svg class="icon icon-xl" style="color: var(--gray);"><use href="#icon-dollar"></use></svg>
                    <p class="mt-3 text-muted">No hay proyectos registrados</p>
                    <p class="text-muted small">No se encontraron proyectos que coincidan con los filtros</p>
                </div>
            }

        </div>
    </div>

    @if (Model.Any())
    {
        var mejorProyecto = Model.OrderByDescending(p => p.Utilidad).FirstOrDefault();
        var peorProyecto = Model.OrderBy(p => p.Utilidad).FirstOrDefault();
        var mayorMargen = Model.OrderByDescending(p => p.Margen).FirstOrDefault();

        <div class="card-modern mt-4">
            <div class="card-header" style="border-bottom: 3px solid var(--primary-medium);">
                <div class="d-flex align-items-center gap-2">
                    <div class="badge-circle primary">
                        <svg class="icon"><use href="#icon-file-text"></use></svg>
                    </div>
                    <div class="vidal-section-copy">
                        <span class="vidal-section-eyebrow">ANÁLISIS</span>
                        <strong class="vidal-section-title">Resumen ejecutivo</strong>
                        <small class="vidal-section-description">Comparativo de resultados y principales indicadores financieros.</small>
                    </div>
                </div>
                <div class="ms-auto">
                    <span class="badge bg-primary">Estadísticas</span>
                </div>
            </div>
            <div class="card-body">

                <div class="row g-3">

                    <div class="col-md-4">
                        <div class="summary-item">
                            <span class="summary-label">
                                <svg class="icon icon-sm"><use href="#icon-check-circle"></use></svg>
                                Mayor Utilidad
                            </span>
                            <span class="summary-value text-success">@mejorProyecto?.Nombre - S/ @mejorProyecto?.Utilidad.ToString("N2")</span>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="summary-item">
                            <span class="summary-label">
                                <svg class="icon icon-sm"><use href="#icon-x-circle"></use></svg>
                                Mayor Pérdida
                            </span>
                            <span class="summary-value text-danger">@peorProyecto?.Nombre - S/ @peorProyecto?.Utilidad.ToString("N2")</span>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="summary-item">
                            <span class="summary-label">
                                <svg class="icon icon-sm"><use href="#icon-chart-bar"></use></svg>
                                Mayor Margen
                            </span>
                            <span class="summary-value">@mayorMargen?.Nombre - @mayorMargen?.Margen.ToString("N1")%</span>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="summary-item">
                            <span class="summary-label">
                                <svg class="icon icon-sm"><use href="#icon-dollar"></use></svg>
                                Total Ingresos
                            </span>
                            <span class="summary-value text-success">S/ @totalIngresos.ToString("N2")</span>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="summary-item">
                            <span class="summary-label">
                                <svg class="icon icon-sm"><use href="#icon-dollar"></use></svg>
                                Total Costos
                            </span>
                            <span class="summary-value text-danger">S/ @totalCostos.ToString("N2")</span>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="summary-item">
                            <span class="summary-label">
                                <svg class="icon icon-sm"><use href="#icon-dollar"></use></svg>
                                Utilidad Neta
                            </span>
                            <span class="summary-value text-@(totalUtilidad >= 0 ? "success" : "danger")">S/ @totalUtilidad.ToString("N2")</span>
                        </div>
                    </div>

                </div>

            </div>
        </div>
    }

    @section Scripts {
        <script>
                document.addEventListener('DOMContentLoaded', function() {

                    var searchInput = document.getElementById('searchInput');
                    var table = document.getElementById('utilidadTable');

                    if (searchInput && table) {
                        searchInput.addEventListener('keyup', function() {
                            var filter = this.value.toLowerCase();
                            var rows = table.querySelectorAll('tbody tr');

                            rows.forEach(function(row) {
                                var text = row.textContent.toLowerCase();
                                row.style.display = text.indexOf(filter) > -1 ? '' : 'none';
                            });
                        });
                    }

                    document.querySelectorAll('.alert-modern').forEach(function(alert) {
                        setTimeout(function() {
                            alert.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
                            alert.style.opacity = '0';
                            alert.style.transform = 'translateY(-20px)';
                            setTimeout(function() {
                                if (alert.parentNode) alert.remove();
                            }, 600);
                        }, 6000);
                    });

                    document.querySelectorAll('.btn-close-custom').forEach(function(btn) {
                        btn.addEventListener('click', function() {
                            var alert = this.closest('.alert-modern');
                            if (alert) {
                                alert.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
                                alert.style.opacity = '0';
                                alert.style.transform = 'scale(0.95)';
                                setTimeout(function() {
                                    if (alert.parentNode) alert.remove();
                                }, 400);
                            }
                        });
                    });

                });
        </script>
    }

</div>

<style>
    .page-header-gradient {
        background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary-medium) 50%, var(--primary-light) 100%);
        border-radius: var(--radius-lg);
        padding: 1.8rem 2.2rem;
        margin-bottom: 1.5rem;
        box-shadow: 0 8px 32px rgba(13, 71, 161, 0.25);
        position: relative;
        overflow: hidden;
    }

        .page-header-gradient::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, rgba(255,255,255,0.05) 0%, transparent 70%);
            border-radius: 50%;
            pointer-events: none;
        }

    .page-header-content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
        position: relative;
        z-index: 1;
    }

    .header-icon-wrapper {
        width: 64px;
        height: 64px;
        background: rgba(255,255,255,0.12);
        border-radius: var(--radius-md);
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(255,255,255,0.15);
        backdrop-filter: blur(4px);
    }

    .header-actions {
        display: flex;
        gap: 0.6rem;
        flex-wrap: wrap;
    }

        .header-actions .btn {
            font-size: 0.82rem;
            padding: 0.4rem 1.2rem;
            border-radius: var(--radius-sm);
            font-weight: 600;
        }

        .header-actions .btn-light {
            background: var(--white);
            color: var(--primary-dark);
        }

            .header-actions .btn-light:hover {
                background: rgba(255,255,255,0.9);
                transform: translateY(-2px);
                box-shadow: 0 4px 16px rgba(0,0,0,0.15);
            }

        .header-actions .btn-outline-light {
            border-color: rgba(255,255,255,0.3);
            color: var(--white);
        }

            .header-actions .btn-outline-light:hover {
                background: rgba(255,255,255,0.1);
                border-color: rgba(255,255,255,0.5);
                transform: translateY(-2px);
            }

    .stat-card {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.2rem;
        background: var(--white);
        border-radius: var(--radius-md);
        border: 1px solid var(--gray-light);
        transition: var(--transition-normal);
        height: 100%;
    }

        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-md);
        }

    .stat-card-icon {
        width: 44px;
        height: 44px;
        border-radius: var(--radius-sm);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .stat-card-info {
        flex: 1;
    }

    .stat-card-value {
        display: block;
        font-size: 1.3rem;
        font-weight: 800;
        color: var(--black);
        line-height: 1.2;
    }

    .stat-card-label {
        display: block;
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--gray);
    }

    .badge-circle {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .badge-circle.primary {
            background: rgba(13, 110, 253, 0.15);
            color: #0d6efd;
        }

    .summary-item {
        display: flex;
        justify-content: space-between;
        padding: 0.4rem 0;
        border-bottom: 1px solid var(--gray-50);
        font-size: 0.85rem;
    }

        .summary-item:last-child {
            border-bottom: none;
        }

    .summary-label {
        display: flex;
        align-items: center;
        gap: 6px;
        font-weight: 600;
        color: var(--gray);
    }

        .summary-label .icon {
            color: var(--primary-medium);
        }

    .summary-value {
        font-weight: 700;
        color: var(--black);
        text-align: right;
        font-size: 1.1rem;
    }

    .btn-close-custom {
        background: none;
        border: none;
        padding: 0.2rem;
        margin-left: auto;
        cursor: pointer;
        color: currentColor;
        opacity: 0.5;
        transition: var(--transition-fast);
        flex-shrink: 0;
        border-radius: 4px;
    }

        .btn-close-custom:hover {
            opacity: 1;
            background: rgba(0, 0, 0, 0.06);
        }

    .text-success {
        color: var(--success) !important;
    }

    .text-danger {
        color: var(--danger) !important;
    }

    @@media (max-width: 768px) {
        .stat-card {
            padding: 0.8rem 1rem;
        }

        .stat-card-icon {
            width: 36px;
            height: 36px;
        }

        .stat-card-value {
            font-size: 1.1rem;
        }

        .page-header-gradient {
            padding: 1.2rem 1.4rem;
        }

        .page-header-content .d-flex {
            flex-direction: column;
            text-align: center;
        }

        .header-icon-wrapper {
            width: 50px;
            height: 50px;
        }

            .header-icon-wrapper .icon {
                width: 24px;
                height: 24px;
            }

        .page-header-content h1 {
            font-size: 1.3rem !important;
        }

        .card-header {
            flex-direction: column;
            align-items: stretch;
            gap: 0.5rem;
        }

            .card-header .ms-auto {
                margin-left: 0 !important;
            }

            .card-header .input-group {
                width: 100% !important;
            }

        .table-modern thead th {
            font-size: 0.6rem;
            padding: 0.4rem 0.5rem;
        }

        .table-modern tbody td {
            font-size: 0.7rem;
            padding: 0.4rem 0.5rem;
        }

        .summary-item {
            font-size: 0.78rem;
            flex-direction: column;
            align-items: flex-start;
            gap: 2px;
        }

        .summary-value {
            font-size: 1rem;
            text-align: left;
            width: 100%;
        }

        .summary-label {
            font-size: 0.78rem;
        }
    }

    @@media (max-width: 576px) {
        .page-header-gradient {
            padding: 1rem 1rem;
        }

        .header-actions {
            flex-direction: column;
        }

            .header-actions .btn {
                width: 100%;
                justify-content: center;
            }

        .table-modern thead th {
            font-size: 0.55rem;
            padding: 0.3rem 0.4rem;
        }

        .table-modern tbody td {
            font-size: 0.65rem;
            padding: 0.3rem 0.4rem;
        }

        .summary-item {
            flex-direction: column;
            align-items: flex-start;
            gap: 2px;
        }

        .summary-value {
            text-align: left;
            width: 100%;
        }
    }

    @@media print {
        .page-header-gradient {
            background: #0a1628 !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

            .page-header-gradient .text-white {
                color: white !important;
            }

            .page-header-gradient .text-white-50 {
                color: rgba(255,255,255,0.5) !important;
            }

        .header-actions .btn,
        .btn-close-custom,
        .card-header .input-group {
            display: none !important;
        }

        .card-modern {
            box-shadow: none !important;
            border: 1px solid #ddd !important;
            break-inside: avoid;
        }

        .stat-card {
            border: 1px solid #ddd !important;
            box-shadow: none !important;
        }

        .badge-circle {
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        .table-danger {
            background: #f8d7da !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }
    }

    /* ====================================================================
           VIDAL 2026 - UNIFICACION DE LOS REPORTES INDIVIDUALES.
           Presentacion exclusivamente. Conserva modelos, formularios, JS y rutas.
           ==================================================================== */
    .reports-unified-page {
        --vidal-report-navy: #102947;

@using Inventario_Vidal.DTOs
@model IEnumerable<ReporteContratistaDto>

@{
    ViewData["Title"] = "Reporte de Contratistas";
    ViewBag.Subtitle = "Recursos asignados y productividad";

    var totalRegistros = ViewBag.TotalRegistros ?? 0;
    var totalHoras = ViewBag.TotalHoras ?? 0;
    var totalPagado = ViewBag.TotalPagado ?? 0m;
}

<div class="reports-unified-page users-page">
    <section class="vidal-report-hero" aria-labelledby="report-contratistas-title">
        <div class="vidal-report-hero-main">
            <div class="vidal-report-hero-icon">
                <svg class="icon icon-xl"><use href="#icon-hardhat"></use></svg>
            </div>
            <div class="vidal-report-hero-copy">
                <div class="vidal-report-hero-eyebrow">CENTRO DE REPORTES</div>
                <h1 id="report-contratistas-title">Reporte de contratistas</h1>
                <p>Consulta las especialidades, horas trabajadas y pagos de contratistas.</p>
            </div>
        </div>
        <div class="vidal-report-hero-actions">
            <a asp-action="Index" class="vidal-report-hero-btn outline">
                <svg class="icon icon-sm"><use href="#icon-arrow-left"></use></svg>Volver a reportes
            </a>
            <a asp-action="ExportarContratistasExcel" class="vidal-report-hero-btn light">
                <svg class="icon icon-sm"><use href="#icon-download"></use></svg>Excel
            </a>
            <a asp-action="ExportarContratistasPdf" class="vidal-report-hero-btn light">
                <svg class="icon icon-sm"><use href="#icon-printer"></use></svg>PDF
            </a>
            <button type="button" class="vidal-report-hero-btn outline" onclick="window.print()">
                <svg class="icon icon-sm"><use href="#icon-print"></use></svg>Imprimir
            </button>
        </div>
    </section>

    <div class="row g-3 mb-4">

        <div class="col-md-3 col-6">
            <div class="stat-card">
                <div class="stat-card-icon" style="background: rgba(13, 110, 253, 0.12); color: #0d6efd;">
                    <svg class="icon"><use href="#icon-hardhat"></use></svg>
                </div>
                <div class="stat-card-info">
                    <span class="stat-card-label">TOTAL CONTRATISTAS</span>
                    <span class="stat-card-value">@totalRegistros</span>
                    <span class="stat-card-description">Contratistas incluidos en la consulta</span>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-6">
            <div class="stat-card">
                <div class="stat-card-icon" style="background: rgba(25, 135, 84, 0.12); color: #198754;">
                    <svg class="icon"><use href="#icon-clock"></use></svg>
                </div>
                <div class="stat-card-info">
                    <span class="stat-card-label">TOTAL DE HORAS</span>
                    <span class="stat-card-value">@totalHoras</span>
                    <span class="stat-card-description">Horas trabajadas registradas</span>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-6">
            <div class="stat-card">
                <div class="stat-card-icon" style="background: rgba(255, 193, 7, 0.12); color: #d97706;">
                    <svg class="icon"><use href="#icon-tag"></use></svg>
                </div>
                <div class="stat-card-info">
                    <span class="stat-card-label">ESPECIALIDADES</span>
                    <span class="stat-card-value">@Model.Select(c => c.Especialidad).Distinct().Count()</span>
                    <span class="stat-card-description">Especialidades distintas en el reporte</span>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-6">
            <div class="stat-card">
                <div class="stat-card-icon" style="background: rgba(111, 66, 193, 0.12); color: #6f42c1;">
                    <svg class="icon"><use href="#icon-dollar"></use></svg>
                </div>
                <div class="stat-card-info">
                    <span class="stat-card-label">TOTAL PAGADO</span>
                    <span class="stat-card-value">@totalPagado.ToString("N2")</span>
                    <span class="stat-card-description">Pagos acumulados de contratistas</span>
                </div>
            </div>
        </div>

    </div>

    <div class="card-modern mb-4">
        <div class="card-header">
            <div class="d-flex align-items-center gap-2">
                <svg class="icon"><use href="#icon-filter"></use></svg>
                <div class="vidal-section-copy">
                    <span class="vidal-section-eyebrow">CONSULTA</span>
                    <strong class="vidal-section-title">Filtros de contratistas</strong>
                    <small class="vidal-section-description">Busca por contratista, especialidad y orden de resultados.</small>
                </div>
            </div>
            <div class="ms-auto">
                <span class="badge bg-secondary">@totalRegistros contratistas</span>
            </div>
        </div>
        <div class="card-body">
            <form method="get" asp-action="Contratistas" class="row g-3">
                <div class="col-md-4">
                    <label class="form-label small fw-bold">Buscar Contratista</label>
                    <input type="text" name="search" class="form-control" placeholder="Nombre, especialidad o teléfono..." value="@ViewBag.Search" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold">Especialidad</label>
                    <select name="especialidad" class="form-control">
                        <option value="">-- Todas --</option>
                        <option value="Electricidad" selected="@(ViewBag.Especialidad == "Electricidad" ? "selected" : null)">Electricidad</option>
                        <option value="Soldadura" selected="@(ViewBag.Especialidad == "Soldadura" ? "selected" : null)">Soldadura</option>
                        <option value="Herrería" selected="@(ViewBag.Especialidad == "Herrería" ? "selected" : null)">Herrería</option>
                        <option value="Pintura" selected="@(ViewBag.Especialidad == "Pintura" ? "selected" : null)">Pintura</option>
                        <option value="Carpintería" selected="@(ViewBag.Especialidad == "Carpintería" ? "selected" : null)">Carpintería</option>
                        <option value="Montaje" selected="@(ViewBag.Especialidad == "Montaje" ? "selected" : null)">Montaje</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold">Ordenar por</label>
                    <select name="orden" class="form-control">
                        <option value="horas" selected="@(ViewBag.Orden == "horas" ? "selected" : null)">Más Horas</option>
                        <option value="pagado" selected="@(ViewBag.Orden == "pagado" ? "selected" : null)">Mayor Pago</option>
                        <option value="nombre" selected="@(ViewBag.Orden == "nombre" ? "selected" : null)">Nombre</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary-dark w-100">
                        <svg class="icon icon-sm"><use href="#icon-search"></use></svg>
                        Filtrar
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="card-modern">
        <div class="card-header">
            <div class="d-flex align-items-center gap-2">
                <svg class="icon"><use href="#icon-list"></use></svg>
                <div class="vidal-section-copy">
                    <span class="vidal-section-eyebrow">RESULTADOS</span>
                    <strong class="vidal-section-title">Listado de contratistas</strong>
                    <small class="vidal-section-description">Consulta especialidades, horas trabajadas, tarifas y pagos.</small>
                </div>
                <span class="badge bg-secondary ms-2">@totalRegistros registros</span>
            </div>
            <div class="ms-auto">
                <div class="input-group" style="width: 250px;">
                    <span class="input-group-text bg-transparent border-end-0">
                        <svg class="icon icon-sm"><use href="#icon-search"></use></svg>
                    </span>
                    <input type="text" class="form-control border-start-0" id="searchInput" placeholder="Buscar contratista..." />
                </div>
            </div>
        </div>
        <div class="card-body p-0">

            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table-modern table-hover mb-0" id="contratistasTable">
                        <thead>
                            <tr>
                                <th style="width: 5%;">#</th>
                                <th style="width: 10%;">DNI</th>
                                <th style="width: 20%;">Nombre</th>
                                <th style="width: 12%;">Especialidad</th>
                                <th style="width: 10%;">Teléfono</th>
                                <th style="width: 12%;">Email</th>
                                <th style="width: 8%;">Horas</th>
                                <th style="width: 10%;">Tarifa / Hora</th>
                                <th style="width: 13%;">Total Pagado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int counter = 1;
                            }
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@counter</td>
                                    <td>
                                        <code>@item.NumeroDocumento</code>
                                    </td>
                                    <td>
                                        <span class="fw-semibold">@item.NombreCompleto</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-@BadgeEspecialidad(item.Especialidad)">
                                            @item.Especialidad
                                        </span>
                                    </td>
                                    <td>@(item.Telefono ?? "-")</td>
                                    <td>
                                        <span class="small">@(item.CorreoElectronico ?? "-")</span>
                                    </td>
                                    <td>
                                        <span class="fw-semibold">@item.TotalHoras</span>
                                    </td>
                                    <td>
                                        <span>S/ @item.TarifaHora.ToString("N2")</span>
                                    </td>
                                    <td>
                                        <span class="fw-semibold">S/ @item.TotalPagado.ToString("N2")</span>
                                    </td>
                                </tr>
                                counter++;
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <svg class="icon icon-xl" style="color: var(--gray);"><use href="#icon-hardhat"></use></svg>
                    <p class="mt-3 text-muted">No hay contratistas registrados</p>
                    <p class="text-muted small">No se encontraron contratistas que coincidan con los filtros</p>
                </div>
            }

        </div>
    </div>

    @if (Model.Any())
    {
        var topContratista = Model.OrderByDescending(c => c.TotalPagado).FirstOrDefault();
        var topHoras = Model.OrderByDescending(c => c.TotalHoras).FirstOrDefault();

        <div class="card-modern mt-4">
            <div class="card-header" style="border-bottom: 3px solid var(--primary-medium);">
                <div class="d-flex align-items-center gap-2">
                    <div class="badge-circle primary">
                        <svg class="icon"><use href="#icon-file-text"></use></svg>
                    </div>
                    <div class="vidal-section-copy">
                        <span class="vidal-section-eyebrow">ANÁLISIS</span>
                        <strong class="vidal-section-title">Resumen ejecutivo</strong>
                        <small class="vidal-section-description">Principales indicadores de horas, pagos y especialidades.</small>
                    </div>
                </div>
                <div class="ms-auto">
                    <span class="badge bg-primary">Estadísticas</span>
                </div>
            </div>
            <div class="card-body">

                <div class="row g-3">

                    <div class="col-md-6">
                        <div class="summary-item">
                            <span class="summary-label">
                                <svg class="icon icon-sm"><use href="#icon-dollar"></use></svg>
                                Contratista con mayor pago
                            </span>
                            <span class="summary-value">@topContratista?.NombreCompleto - S/ @topContratista?.TotalPagado.ToString("N2")</span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="summary-item">
                            <span class="summary-label">
                                <svg class="icon icon-sm"><use href="#icon-clock"></use></svg>
                                Contratista con más horas
                            </span>
                            <span class="summary-value">@topHoras?.NombreCompleto - @topHoras?.TotalHoras horas</span>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="summary-item">
                            <span class="summary-label">Promedio de horas por contratista</span>
                            <span class="summary-value">@(totalRegistros > 0 ? (totalHoras / totalRegistros).ToString("N1") : "0.0")</span>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="summary-item">
                            <span class="summary-label">Promedio de pago por contratista</span>
                            <span class="summary-value">S/ @(totalRegistros > 0 ? (totalPagado / totalRegistros).ToString("N2") : "0.00")</span>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="summary-item">
                            <span class="summary-label">Especialidad más contratada</span>
                            <span class="summary-value">@Model.GroupBy(c => c.Especialidad).OrderByDescending(g => g.Count()).FirstOrDefault()?.Key</span>
                        </div>
                    </div>

                </div>

            </div>
        </div>
    }

    @{
        string BadgeEspecialidad(string especialidad)
        {
            return especialidad?.ToLower() switch
            {
                "electricidad" => "warning",
                "soldadura" => "danger",
                "herrería" => "secondary",
                "pintura" => "info",
                "carpintería" => "success",
                "montaje" => "primary",
                _ => "secondary"
            };
        }
    }


</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {

            var searchInput = document.getElementById('searchInput');
            var table = document.getElementById('contratistasTable');

            if (searchInput && table) {
                searchInput.addEventListener('keyup', function() {
                    var filter = this.value.toLowerCase();
                    var rows = table.querySelectorAll('tbody tr');

                    rows.forEach(function(row) {
                        var text = row.textContent.toLowerCase();
                        row.style.display = text.indexOf(filter) > -1 ? '' : 'none';
                    });
                });
            }

            document.querySelectorAll('.alert-modern').forEach(function(alert) {
                setTimeout(function() {
                    alert.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
                    alert.style.opacity = '0';
                    alert.style.transform = 'translateY(-20px)';
                    setTimeout(function() {
                        if (alert.parentNode) alert.remove();
                    }, 600);
                }, 6000);
            });

            document.querySelectorAll('.btn-close-custom').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    var alert = this.closest('.alert-modern');
                    if (alert) {
                        alert.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
                        alert.style.opacity = '0';
                        alert.style.transform = 'scale(0.95)';
                        setTimeout(function() {
                            if (alert.parentNode) alert.remove();
                        }, 400);
                    }
                });
            });

        });
    </script>
}

<style>
    .page-header-gradient {
        background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary-medium) 50%, var(--primary-light) 100%);
        border-radius: var(--radius-lg);
        padding: 1.8rem 2.2rem;
        margin-bottom: 1.5rem;
        box-shadow: 0 8px 32px rgba(13, 71, 161, 0.25);
        position: relative;
        overflow: hidden;
    }

        .page-header-gradient::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, rgba(255,255,255,0.05) 0%, transparent 70%);
            border-radius: 50%;
            pointer-events: none;
        }

    .page-header-content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
        position: relative;
        z-index: 1;
    }

    .header-icon-wrapper {
        width: 64px;
        height: 64px;
        background: rgba(255,255,255,0.12);
        border-radius: var(--radius-md);
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(255,255,255,0.15);
        backdrop-filter: blur(4px);
    }

    .header-actions {
        display: flex;
        gap: 0.6rem;
        flex-wrap: wrap;
    }

        .header-actions .btn {
            font-size: 0.82rem;
            padding: 0.4rem 1.2rem;
            border-radius: var(--radius-sm);
            font-weight: 600;
        }

        .header-actions .btn-light {
            background: var(--white);
            color: var(--primary-dark);
        }

            .header-actions .btn-light:hover {
                background: rgba(255,255,255,0.9);
                transform: translateY(-2px);
                box-shadow: 0 4px 16px rgba(0,0,0,0.15);
            }

        .header-actions .btn-outline-light {
            border-color: rgba(255,255,255,0.3);
            color: var(--white);
        }

            .header-actions .btn-outline-light:hover {
                background: rgba(255,255,255,0.1);
                border-color: rgba(255,255,255,0.5);
                transform: translateY(-2px);
            }

    .stat-card {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.2rem;
        background: var(--white);
        border-radius: var(--radius-md);
        border: 1px solid var(--gray-light);
        transition: var(--transition-normal);
        height: 100%;
    }

        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-md);
        }

    .stat-card-icon {
        width: 44px;
        height: 44px;
        border-radius: var(--radius-sm);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .stat-card-info {
        flex: 1;
    }

    .stat-card-value {
        display: block;
        font-size: 1.3rem;
        font-weight: 800;
        color: var(--black);
        line-height: 1.2;
    }

    .stat-card-label {
        display: block;
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--gray);
    }

    .badge-circle {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .badge-circle.primary {
            background: rgba(13, 110, 253, 0.15);
            color: #0d6efd;
        }

    .summary-item {
        display: flex;
        justify-content: space-between;
        padding: 0.4rem 0;
        border-bottom: 1px solid var(--gray-50);
        font-size: 0.85rem;
    }

        .summary-item:last-child {
            border-bottom: none;
        }

    .summary-label {
        font-weight: 600;
        color: var(--gray);
    }

    .summary-value {
        font-weight: 700;
        color: var(--black);
        text-align: right;
        font-size: 1.1rem;
    }

    .btn-close-custom {
        background: none;
        border: none;
        padding: 0.2rem;
        margin-left: auto;
        cursor: pointer;
        color: currentColor;
        opacity: 0.5;
        transition: var(--transition-fast);
        flex-shrink: 0;
        border-radius: 4px;
    }

        .btn-close-custom:hover {
            opacity: 1;
            background: rgba(0, 0, 0, 0.06);
        }

    @@media (max-width: 768px) {
        .stat-card {
            padding: 0.8rem 1rem;
        }

        .stat-card-icon {
            width: 36px;
            height: 36px;
        }

        .stat-card-value {
            font-size: 1.1rem;
        }

        .page-header-gradient {
            padding: 1.2rem 1.4rem;
        }

        .page-header-content .d-flex {
            flex-direction: column;
            text-align: center;
        }

        .header-icon-wrapper {
            width: 50px;
            height: 50px;
        }

            .header-icon-wrapper .icon {
                width: 24px;
                height: 24px;
            }

        .page-header-content h1 {
            font-size: 1.3rem !important;
        }

        .card-header {
            flex-direction: column;
            align-items: stretch;
            gap: 0.5rem;
        }

            .card-header .ms-auto {
                margin-left: 0 !important;
            }

            .card-header .input-group {
                width: 100% !important;
            }

        .table-modern thead th {
            font-size: 0.6rem;
            padding: 0.4rem 0.5rem;
        }

        .table-modern tbody td {
            font-size: 0.7rem;
            padding: 0.4rem 0.5rem;
        }

        .summary-item {
            font-size: 0.78rem;
        }

        .summary-value {
            font-size: 1rem;
        }
    }

    @@media (max-width: 576px) {
        .page-header-gradient {
            padding: 1rem 1rem;
        }

        .header-actions {
            flex-direction: column;
        }

            .header-actions .btn {
                width: 100%;
                justify-content: center;
            }

        .table-modern thead th {
            font-size: 0.55rem;
            padding: 0.3rem 0.4rem;
        }

        .table-modern tbody td {
            font-size: 0.65rem;
            padding: 0.3rem 0.4rem;
        }

        .summary-item {
            flex-direction: column;
            align-items: flex-start;
            gap: 2px;
        }

        .summary-value {
            text-align: left;
            width: 100%;
        }
    }

    @@media print {
        .page-header-gradient {
            background: #0a1628 !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

            .page-header-gradient .text-white {
                color: white !important;
            }

            .page-header-gradient .text-white-50 {
                color: rgba(255,255,255,0.5) !important;
            }

        .header-actions .btn,
        .btn-close-custom,
        .card-header .input-group {
            display: none !important;
        }

        .card-modern {
            box-shadow: none !important;
            border: 1px solid #ddd !important;
            break-inside: avoid;
        }

        .stat-card {
            border: 1px solid #ddd !important;
            box-shadow: none !important;
        }

        .badge-circle {
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }
    }
</style>
<style>
    /* CSS ORIGINAL DE USUARIOS/INDEX ADOPTADO PARA REPORTES */


    /* ================================================================
                       BASE
                       ================================================================ */

    .users-page {
        --navy: #102947;
        --blue: #17488e;
        --blue-light: #226cc2;
        --border: #dce3eb;
        --text: #344357;
        --muted: #7d8999;
        --surface: #ffffff;
        --success: #168957;
        --danger: #d1475b;
        --warning: #d99a24;
    }

    /* ================================================================
                       HERO
                       ================================================================ */

    .users-hero {
        min-height: 114px;
        padding: 23px 30px;
        margin-bottom: 17px;
        border-radius: 20px;
        background: linear-gradient( 100deg, #102947 0%, #17488e 49%, #226cc2 100%);
        color: white;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        position: relative;
        overflow: hidden;
    }

        .users-hero::after {
            content: "";
            position: absolute;
            width: 280px;
            height: 280px;
            top: -130px;
            right: -80px;
            border-radius: 50%;
            background: rgba(255,255,255,.05);
        }

    .hero-left {
        display: flex;
        align-items: center;
        gap: 18px;
        position: relative;
        z-index: 1;
    }

    .hero-icon {
        width: 60px;
        height: 60px;
        border-radius: 14px;
        background: rgba(255,255,255,.11);
        border: 1px solid rgba(255,255,255,.12);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .users-hero h1 {
        margin: 0;
        font-size: 1.65rem;
        font-weight: 800;
    }

    .hero-subtitle {
        margin-top: 6px;
        display: flex;
        align-items: center;
        gap: 7px;
        color: rgba(255,255,255,.72);
        font-size: .8rem;
    }

    .hero-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        position: relative;
        z-index: 1;
    }

    .hero-primary,
    .hero-secondary {
        min-height: 41px;
        padding: 0 15px;
        border-radius: 9px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        font-size: .72rem;
        font-weight: 750;
        text-decoration: none;
        cursor: pointer;
        transition: .18s ease;
    }

    .hero-primary {
        border: 1px solid white;
        background: white;
        color: var(--navy);
    }

    .hero-secondary {
        border: 1px solid rgba(255,255,255,.3);
        background: rgba(255,255,255,.05);
        color: white;
    }

    .hero-primary:hover {
        background: #f3f7fb;
        color: var(--navy);
        transform: translateY(-1px);
    }

    .hero-secondary:hover {
        background: rgba(255,255,255,.12);
        transform: translateY(-1px);
    }

    /* ================================================================
                       ALERTS
                       ================================================================ */

    .page-alert {
        margin-bottom: 15px;
        padding: 12px 14px;
        border-radius: 11px;
        display: flex;
        align-items: flex-start;
        gap: 10px;
        transition: opacity .35s ease, transform .35s ease;
    }

        .page-alert.success {
            background: #edf9f3;
            color: #146f48;
            border-left: 4px solid var(--success);
        }

        .page-alert.danger {
            background: #fff1f3;
            color: #a73547;
            border-left: 4px solid var(--danger);
        }

    .page-alert-content {
        flex: 1;
    }

        .page-alert-content strong,
        .page-alert-content span {
            display: block;
        }

        .page-alert-content strong {
            font-size: .72rem;
        }

        .page-alert-content span {
            margin-top: 2px;
            font-size: .66rem;
        }

    .page-alert.closing {
        opacity: 0;
        transform: translateY(-8px);
    }

    .alert-close {
        border: none;
        padding: 2px;
        background: transparent;
        color: currentColor;
        opacity: .6;
        cursor: pointer;
    }

    /* ================================================================
                       STATS
                       ================================================================ */

    .stats-grid {
        margin-bottom: 17px;
        display: grid;
        grid-template-columns: repeat( 4, minmax(0,1fr));
        gap: 12px;
    }

    .stat-card {
        min-height: 84px;
        padding: 14px 16px;
        border: 1px solid var(--border);
        border-radius: 13px;
        background: white;
        display: flex;
        align-items: center;
        gap: 12px;
        box-shadow: 0 4px 15px rgba(16,41,71,.035);
    }

    .stat-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .stat-icon.blue {
            color: #306ca7;
            background: #eaf2fb;
        }

        .stat-icon.green {
            color: #168957;
            background: #e9f7f0;
        }

        .stat-icon.gray {
            color: #687587;
            background: #edf0f4;
        }

        .stat-icon.red {
            color: #c34d5f;
            background: #fff0f2;
        }

    .stat-label {
        display: block;
        color: #8995a5;
        font-size: .57rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    .stat-value {
        display: block;
        margin-top: 2px;
        color: var(--navy);
        font-size: 1.3rem;
        font-weight: 800;
        line-height: 1;
    }

    /* ================================================================
                       CARD
                       ================================================================ */

    .users-card {
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 16px;
        background: white;
        box-shadow: 0 4px 18px rgba(16,41,71,.045);
    }

    .users-card-header {
        padding: 16px 18px;
        border-bottom: 1px solid #edf1f5;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
    }

    .card-heading {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .heading-icon {
        width: 36px;
        height: 36px;
        border-radius: 9px;
        color: #356fa7;
        background: #eaf2fb;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .card-heading span {
        display: block;
        color: #929dab;
        font-size: .52rem;
        font-weight: 800;
        letter-spacing: .8px;
    }

    .card-heading h2 {
        margin: 1px 0 0;
        color: var(--navy);
        font-size: .9rem;
        font-weight: 800;
    }

    .card-heading p {
        margin: 2px 0 0;
        color: #8793a3;
        font-size: .61rem;
    }

    /* ================================================================
                       TOOLBAR
                       ================================================================ */

    .users-toolbar {
        display: flex;
        align-items: center;
        gap: 7px;
    }

    .search-box {
        width: 245px;
        min-height: 39px;
        padding: 0 10px;
        border: 1px solid var(--border);
        border-radius: 9px;
        display: flex;
        align-items: center;
        gap: 7px;
    }

        .search-box:focus-within {
            border-color: #6f9ed0;
            box-shadow: 0 0 0 3px rgba(34,108,194,.08);
        }

        .search-box > .icon {
            color: #8b97a7;
        }

        .search-box input {
            flex: 1;
            min-width: 0;
            border: none;
            outline: none;
            background: transparent;
            color: #445368;
            font-size: .67rem;
        }

    .search-clear {
        padding: 2px;
        border: none;
        background: transparent;
        color: #929dab;
        cursor: pointer;
    }

    .toolbar-select {
        min-height: 39px;
        padding: 0 29px 0 10px;
        border: 1px solid var(--border);
        border-radius: 9px;
        background: white;
        color: #536174;
        font-size: .66rem;
        outline: none;
    }

    /* ================================================================
                       TABLE
                       ================================================================ */

    .table-container {
        width: 100%;
        overflow-x: auto;
    }

    .users-table {
        width: 100%;
        border-collapse: collapse;
    }

        .users-table thead th {
            padding: 10px 12px;
            border-bottom: 1px solid #e8edf3;
            background: #f8fafc;
            color: #7d8999;
            font-size: .56rem;
            font-weight: 800;
            letter-spacing: .5px;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .users-table tbody td {
            padding: 11px 12px;
            border-bottom: 1px solid #eef2f6;
            color: #536174;
            font-size: .66rem;
            vertical-align: middle;
        }

        .users-table tbody tr:last-child td {
            border-bottom: none;
        }

        .users-table tbody tr {
            transition: background .16s ease;
        }

            .users-table tbody tr:hover {
                background: #fafbfd;
            }

    /* ================================================================
                       USER
                       ================================================================ */

    .user-cell {
        min-width: 180px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .user-avatar {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        color: #346b9e;
        background: #eaf2fb;
        border: 1px solid #dce9f5;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .66rem;
        font-weight: 850;
        flex-shrink: 0;
    }

    .user-main strong {
        display: block;
        color: #344357;
        font-size: .7rem;
    }

    .user-main span {
        display: block;
        margin-top: 2px;
        color: #939dab;
        font-size: .54rem;
    }

    /* ================================================================
                       ACCOUNT / MAIL
                       ================================================================ */

    .account-cell,
    .mail-cell {
        min-width: 125px;
        display: flex;
        align-items: center;
        gap: 5px;
        color: #59687b;
    }

        .account-cell .icon,
        .mail-cell .icon {
            color: #8796a5;
            flex-shrink: 0;
        }

    .mail-cell {
        max-width: 220px;
    }

        .mail-cell span {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

    .empty-value {
        color: #a1aab6;
        font-style: italic;
    }

    /* ================================================================
                       ROLE
                       ================================================================ */

    .role-badge {
        padding: 5px 8px;
        border-radius: 999px;
        background: #edf3f8;
        color: #496783;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: .58rem;
        font-weight: 750;
        white-space: nowrap;
    }

    /* ================================================================
                       STATUS
                       ================================================================ */

    .status-badge {
        padding: 5px 8px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        font-size: .57rem;
        font-weight: 800;
        white-space: nowrap;
    }

        .status-badge.active {
            color: #15744b;
            background: #e9f7f0;
        }

        .status-badge.inactive {
            color: #667384;
            background: #edf0f4;
        }

        .status-badge.blocked {
            color: #b34052;
            background: #fff0f2;
        }

    .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
    }

    /* ================================================================
                       LAST ACCESS
                       ================================================================ */

    .last-access {
        min-width: 95px;
    }

        .last-access strong {
            display: block;
            color: #4d5c6f;
            font-size: .63rem;
        }

        .last-access span {
            display: block;
            margin-top: 1px;
            color: #939dab;
            font-size: .54rem;
        }

        .last-access .never-access {
            color: #8793a3;
        }

    /* ================================================================
                       SECURITY
                       ================================================================ */

    .security-state {
        min-width: 92px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-align: left;
    }

        .security-state > .icon {
            flex-shrink: 0;
        }

        .security-state strong {
            display: block;
            font-size: .57rem;
        }

        .security-state span {
            display: block;
            margin-top: 1px;
            font-size: .5rem;
        }

        .security-state.ok {
            color: #168957;
        }

        .security-state.warning {
            color: #ad7514;
        }

        .security-state.blocked {
            color: #ba4053;
        }

    /* ================================================================
                       ACTIONS
                       ================================================================ */

    .actions-column {
        width: 125px;
    }

    .action-group {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
    }

    .action-btn {
        width: 31px;
        height: 31px;
        padding: 0;
        border-radius: 7px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        cursor: pointer;
        transition: .16s ease;
    }

        .action-btn.view {
            border: 1px solid #cfe0f0;
            background: #f1f7fc;
            color: #3974aa;
        }

        .action-btn.edit {
            border: 1px solid #d9e3ee;
            background: #f7f9fc;
            color: #526e8b;
        }

        .action-btn.disable {
            border: 1px solid #f0ced4;
            background: #fff3f4;
            color: #c24d60;
        }

        .action-btn.enable {
            border: 1px solid #cce8da;
            background: #eefaf4;
            color: #168957;
        }

        .action-btn:hover {
            transform: translateY(-1px);
            filter: brightness(.97);
        }

    .toggle-form {
        margin: 0;
    }

    /* ================================================================
                       EMPTY
                       ================================================================ */

    .empty-state {
        min-height: 260px;
        padding: 35px 20px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    .empty-icon {
        width: 62px;
        height: 62px;
        border-radius: 16px;
        color: #7591ac;
        background: #edf3f8;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .empty-state h3 {
        margin: 14px 0 0;
        color: #344357;
        font-size: .86rem;
        font-weight: 800;
    }

    .empty-state p {
        max-width: 390px;
        margin: 5px 0 0;
        color: #8995a4;
        font-size: .66rem;
        line-height: 1.5;
    }

    .primary-button,
    .secondary-button {
        min-height: 38px;
        padding: 0 14px;
        margin-top: 14px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        font-size: .66rem;
        font-weight: 750;
        text-decoration: none;
        cursor: pointer;
    }

    .primary-button {
        border: none;
        background: linear-gradient( 135deg, #102947, #17488e);
        color: white;
    }

    .secondary-button {
        border: 1px solid #d8e0e9;
        background: white;
        color: #576678;
    }

    /* ================================================================
                       CONFIRM MODAL
                       ================================================================ */

    .confirm-overlay {
        position: fixed;
        inset: 0;
        z-index: 11000;
        padding: 20px;
        background: rgba(12,26,45,.58);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .confirm-modal {
        width: min( 390px, 100%);
        padding: 24px;
        border-radius: 15px;
        background: white;
        box-shadow: 0 20px 60px rgba(11,27,48,.2);
        text-align: center;
    }

    .confirm-icon {
        width: 48px;
        height: 48px;
        margin: 0 auto;
        border-radius: 13px;
        color: #496f95;
        background: #edf4fa;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .confirm-modal h3 {
        margin: 14px 0 0;
        color: #2f4054;
        font-size: .9rem;
        font-weight: 800;
    }

    .confirm-modal p {
        margin: 6px 0 0;
        color: #7c8898;
        font-size: .68rem;
        line-height: 1.5;
    }

    .confirm-warning {
        margin-top: 12px;
        padding: 9px 10px;
        border-radius: 8px;
        background: #fff7e8;
        color: #89641b;
        display: flex;
        align-items: flex-start;
        gap: 6px;
        text-align: left;
        font-size: .58rem;
        line-height: 1.45;
    }

    .confirm-actions {
        margin-top: 19px;
        display: flex;
        justify-content: center;
        gap: 8px;
    }

        .confirm-actions .secondary-button {
            margin-top: 0;
        }

    .confirm-button {
        min-height: 38px;
        padding: 0 15px;
        border: none;
        border-radius: 8px;
        color: white;
        font-size: .66rem;
        font-weight: 750;
        cursor: pointer;
    }

        .confirm-button.danger {
            background: #c8475a;
        }

        .confirm-button.success {
            background: #168957;
        }

    /* ================================================================
                       RESPONSIVE
                       ================================================================ */

    @@media (max-width: 1100px) {

        .users-card-header {
            align-items: stretch;
            flex-direction: column;
        }

        .users-toolbar {
            width: 100%;
        }

        .search-box {
            flex: 1;
            width: auto;
        }
    }

    @@media (max-width: 900px) {

        .stats-grid {
            grid-template-columns: repeat( 2, minmax(0,1fr));
        }
    }

    @@media (max-width: 760px) {

        .users-hero {
            flex-direction: column;
            align-items: stretch;
        }

        .hero-actions {
            width: 100%;
        }

        .hero-primary,
        .hero-secondary {
            flex: 1;
        }

        .users-toolbar {
            flex-direction: column;
        }

        .search-box,
        .toolbar-select {
            width: 100%;
        }
    }

    @@media (max-width: 520px) {

        .users-hero {
            padding: 20px;
        }

        .hero-left {
            align-items: flex-start;
        }

        .hero-icon {
            width: 50px;
            height: 50px;
        }

        .users-hero h1 {
            font-size: 1.35rem;
        }

        .hero-actions {
            flex-direction: column;
        }

        .hero-primary,
        .hero-secondary {
            width: 100%;
        }

        .stats-grid {
            grid-template-columns: 1fr;
        }

        .confirm-actions {
            flex-direction: column-reverse;
        }

            .confirm-actions button {
                width: 100%;
            }
    }


    /* Componentes exclusivos del módulo Reportes. La estructura del hero y los colores
                   reutilizan el CSS original de Usuarios/Index.cshtml. */
    .reports-page .reports-overview {
        margin-bottom: 21px;
    }

    .reports-page .reports-section-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin: 0 0 13px;
    }

    .reports-page .reports-eyebrow {
        font-size: .52rem;
        font-weight: 800;
        letter-spacing: .8px;
        color: #929dab;
    }

    .reports-page .reports-section-heading h2 {
        margin: 3px 0 0;
        font-size: .9rem;
        font-weight: 800;
        color: #102947;
    }

    .reports-page .reports-section-heading p {
        margin: 3px 0 0;
        color: #8793a3;
        font-size: .61rem;
    }

    .reports-page .reports-counter {
        padding: 6px 10px;
        color: #566c84;
        background: #eef3f8;
        border-radius: 8px;
        font-size: .58rem;
        font-weight: 750;
        white-space: nowrap;
    }

    .reports-page .reports-stats {
        display: grid;
        grid-template-columns: repeat(4,minmax(0,1fr));
        gap: 13px;
    }

    .reports-page .reports-stat {
        background: #fff;
        border: 1px solid #dce3eb;
        border-radius: 14px;
        padding: 16px;
        box-shadow: 0 4px 18px rgba(16,41,71,.045);
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .reports-page .reports-stat-icon, .reports-page .reports-link-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 10px;
    }

    .reports-page .reports-stat-icon {
        width: 41px;
        height: 41px;
    }

    .reports-page .blue {
        background: #eaf2fb;
        color: #356fa7;
    }

    .reports-page .green {
        background: #e9f7f0;
        color: #168957;
    }

    .reports-page .gold {
        background: #fff7e5;
        color: #a47517;
    }

    .reports-page .purple {
        background: #f0ebf8;
        color: #7554aa;
    }

    .reports-page .red {
        background: #fff1f3;
        color: #c7485a;
    }

    .reports-page .cyan {
        background: #e7f7fa;
        color: #237b94;
    }

    .reports-page .reports-stat-value {
        display: block;
        font-size: 1.28rem;
        font-weight: 800;
        line-height: 1.2;
        color: #102947;
    }

    .reports-page .reports-stat-label {
        display: block;
        margin-top: 3px;
        color: #8793a3;
        font-size: .59rem;
    }

    .reports-page .reports-grid {
        display: grid;
        grid-template-columns: repeat(2,minmax(0,1fr));
        gap: 13px;
    }

    .reports-page .reports-link {
        min-width: 0;
        padding: 17px;
        display: flex;
        gap: 13px;
        align-items: flex-start;
        border: 1px solid #dce3eb;
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 4px 18px rgba(16,41,71,.045);
        text-decoration: none;
        transition: transform .18s ease,box-shadow .18s ease,border-color .18s ease;
    }

        .reports-page .reports-link:hover {
            border-color: #acc6e2;
            box-shadow: 0 7px 22px rgba(16,41,71,.09);
            transform: translateY(-2px);
        }

        .reports-page .reports-link:focus-visible {
            outline: 3px solid rgba(34,108,194,.3);
            outline-offset: 2px;
        }

    .reports-page .reports-link-icon {
        width: 42px;
        height: 42px;
    }

    .reports-page .reports-link-content {
        display: flex;
        flex: 1;
        flex-direction: column;
        min-width: 0;
    }

        .reports-page .reports-link-content strong {
            font-size: .7rem;
            font-weight: 800;
            color: #344357;
        }

        .reports-page .reports-link-content small {
            margin-top: 5px;
            font-size: .58rem;
            line-height: 1.5;
            color: #8793a3;
        }

    .reports-page .reports-link-availability {
        display: inline-flex;
        gap: 4px;
        align-items: center;
        width: max-content;
        margin-top: 11px;
        font-size: .54rem;
        color: #168957;
        font-weight: 750;
    }

    .reports-page .reports-link-arrow {
        margin-top: 12px;
        color: #8b99a8;
    }

    @@media (max-width:950px) {
        .reports-page .reports-stats {
            grid-template-columns: repeat(2,minmax(0,1fr));
        }
    }

    @@media (max-width:720px) {
        .reports-page .reports-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width:520px) {
        .reports-page .reports-stats {
            grid-template-columns: 1fr 1fr;
        }

        .reports-page .reports-stat {
            padding: 12px;
            gap: 8px;
        }

        .reports-page .reports-stat-value {
            font-size: 1rem;
        }

        .reports-page .reports-stat-icon {
            width: 34px;
            height: 34px;
        }
    }



    /* COMPONENTES UNIFICADOS DE REPORTES: patrón Usuarios/Index */
    .reports-unified-page {
        --navy: #102947;
        --blue: #17488e;
        --blue-light: #226cc2;
        --border: #dce3eb;
        --text: #344357;
        --muted: #7d8999;
